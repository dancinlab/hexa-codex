#!hexa strict
// hexa-codex/verify/numerics_substrate_multimodal_fit.hexa — M5.SUBSTRATE multimodal
// CAPABILITY FIT (closed-form recompute). cycle-20.
//
// PURPOSE.  Closed-form recompute for the M5.SUBSTRATE multimodal capability half,
// mirroring the TEXT capability fit (verify/numerics_substrate_cliff_logistic.hexa).
// It reads the COMMITTED per-rung × per-item TSV produced by
//   bench/sandbox_multimodal_ladder.hexa
// (3 VL rungs × 16 harder difficulty-stratified items, byte-exact scored, NO LLM
// self-judge), and from that raw data alone (no model spawn, no GPU, no API):
//
//   (1) RECOMPUTES each rung's overall accuracy + per-axis accuracy from the raw
//       correct(1|0) column — the load-bearing recompute that proves the bench numbers.
//   (2) Fits + recomputes a 2-parameter LOGISTIC capability law in log2(params):
//         y(x) = L_lo + (L_hi - L_lo) / (1 + exp(-k*(x - x0))) ,  x = log2(N_params/1e9)
//       with L_lo/L_hi pinned to the data (g0 Occam), k/x0 RMSE-fit on the 3 points.
//   (3) Tests the CAPABILITY GRADIENT: does overall accuracy rise MONOTONICALLY with
//       params? Reports the honest answer + the per-axis structure that explains it.
//
// MEASURED DATA (from .verdicts/sandbox/m5_substrate_multimodal_ladder.tsv, recomputed
// here — NOT hard-coded; the constants below are only the EXPECTED recompute targets
// used as cross-checks):
//   rung 0  0.5B  SmolVLM-500M-Instruct-Q8_0    13/16 = 0.8125
//   rung 1  2.2B  SmolVLM2-2.2B-Instruct-Q8_0   15/16 = 0.9375
//   rung 2  3.0B  Qwen2.5-VL-3B-Instruct-Q4_K_M 13/16 = 0.8125
//
// HONEST FINDING (the verdict this verifier emits).  Overall accuracy is NOT
// monotone in params: it rises 0.5B->2.2B (+12.5pp) then FALLS 2.2B->3.0B (-12.5pp).
// The fall is REAL, not a quantization artifact — a separate Q8_0 Qwen-VL-3B probe
// counts the dense 5-9-object images identically to the Q4_K_M rung (5,6,6,7,8), so
// the 3B rung genuinely undercounts where the 2.2B rung does not. The capability
// gradient SPLITS by axis:
//   - PERCEPTION axes (ocr 2-word + spatial L/R/top/bottom + fine shape, 11 items)
//     ARE monotone-non-decreasing then SATURATE: 0.5B 9/11 -> 2.2B 11/11 -> 3.0B 11/11.
//   - The COUNTING axis (5-9 dense objects, 5 items) does NOT track params — it is a
//     known VLM subitizing-limit weakness that breaks the overall monotone trend.
// So a single logistic in log2(params) is the WRONG functional family for the OVERALL
// curve (it is monotone-by-construction and cannot reproduce a rise-then-fall); the
// honest verdict is a NON-MONOTONE capability gradient on this harder manifest, with a
// monotone-then-saturating perception sub-ladder. Both are CLOSED/valid outcomes.
//
// PASS gate (this verifier emits 🟢 SUPPORTED-NUMERICAL for an HONEST-NEGATIVE on
// overall monotonicity — the recompute itself is correct; the gradient is real-and-
// non-monotone, a genuine measured finding, NOT a verifier failure):
//   1. per-rung overall accuracy recompute matches the expected /16 fractions.
//   2. per-axis recompute matches (perception sub-ladder 9/11 -> 11/11 -> 11/11).
//   3. logistic best-fit RMSE is reported; the OVERALL monotonicity test returns FALSE
//      and the verifier records WHY (rise-then-fall: a monotone law cannot fit it).
//   4. the PERCEPTION sub-ladder IS monotone-non-decreasing (the real, defensible
//      capability gradient once the params-orthogonal counting axis is separated).
//
// REQUIRES.  read_file_pure (self/runtime/file_pure) + exp_pure/log2_pure/abs_pure/
//   sqrt_pure (self/runtime/math_pure). No model spawn, no llama-server, no API.
//
// CONSUMER.  M5.SUBSTRATE multimodal verdict link.
//   Verdict persisted at .verdicts/sandbox/m5_substrate_multimodal_fit.txt
//   (raw stdout verbatim, written by the cycle wrapper).
//
// Run:
//   HEXA_SHIM_NO_DARWIN_LANDING=1 RESOURCE_LOCAL_HEXA=1 \
//     HEXA_CODEX_ROOT="$PWD" \
//     ~/.hx/packages/hexa/hexa.real run verify/numerics_substrate_multimodal_fit.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="Pure local verifier; reads a committed byte-exact-scored per-rung TSV and recomputes per-rung/per-axis accuracy + a closed-form logistic capability fit. No atlas atoms touched, no model spawn, float arithmetic only.")

use "self/runtime/math_pure"
use "self/runtime/file_pure"

let DATA_PATH = ".verdicts/sandbox/m5_substrate_multimodal_ladder.tsv"
let TOTAL_ITEMS = 16.0

// ── EXPECTED recompute targets (cross-checks; the verifier RECOMPUTES from the TSV) ─
let EXP_CORRECT = [13.0, 15.0, 13.0]            // /16 per rung (0.5B, 2.2B, 3.0B)
let EXP_PARAMS_B = [0.5, 2.2, 3.0]
// perception sub-ladder = ocr + spatial + shape (11 items); count axis excluded
let EXP_PERC_CORRECT = [9.0, 11.0, 11.0]
let PERC_TOTAL = 11.0
let N_RUNGS = 3

let EPS_RECOMPUTE = 0.0001    // recompute must match the committed data exactly
let EPS_PARAM = 0.01

let mut RUN = 0
let mut FAIL = 0
let mut FAILURES = []

fn _check(ok: bool, label: str, detail: str) {
    RUN = RUN + 1
    if ok {
        println("  [PASS] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    } else {
        FAIL = FAIL + 1
        FAILURES.push(label + " :: " + detail)
        println("  [FAIL] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    }
}

fn _abs(x: float) -> float { return abs_pure(x) }
fn x_of(n_billions: float) -> float { return log2_pure(n_billions) }

// logistic law at x with explicit params (used for the RMSE grid-fit).
fn logistic_at(x: float, l_lo: float, l_hi: float, k: float, x0: float) -> float {
    let z = 0.0 - (k * (x - x0))
    return l_lo + ((l_hi - l_lo) / (1.0 + exp_pure(z)))
}

fn main() {
    println("========================================================================")
    println("  hexa-codex SUBSTRATE multimodal CAPABILITY FIT — closed-form recompute")
    println("  M5.SUBSTRATE · 3 VL rungs (0.5B/2.2B/3.0B) · harder 16-item manifest")
    println("  recompute per-rung + per-axis accuracy + logistic fit from committed TSV")
    println("========================================================================")
    println("  source = " + DATA_PATH + "  (byte-exact scored, NO LLM self-judge)")
    println("")

    // ── load + recompute from the committed TSV ──────────────────────────────
    let txt = read_file_pure(DATA_PATH)
    let lines = txt.split("\n")

    // accumulate per-rung overall correct + per-axis (count vs perception) by params_b.
    // rung index is keyed by params_b matched to EXP_PARAMS_B.
    let mut rung_correct = [0.0, 0.0, 0.0]
    let mut rung_total = [0.0, 0.0, 0.0]
    let mut rung_count_correct = [0.0, 0.0, 0.0]   // counting axis only
    let mut rung_perc_correct = [0.0, 0.0, 0.0]    // ocr + spatial + shape
    let mut rung_name = ["", "", ""]

    let mut li = 0
    while li < lines.len() {
        let ln = lines[li]
        if ln.len() > 0 && !ln.starts_with("#") && !ln.starts_with("rung\t") {
            let cells = ln.split("\t")
            // columns: rung  params_b  img  axis  expected  wall_ms  correct  snippet
            if cells.len() >= 7 {
                let nm = cells[0]
                let pb = cells[1].to_float()
                let axis = cells[3]
                let corr = cells[6].to_float()
                // find rung slot by params_b
                let mut ri = -1
                let mut q = 0
                while q < N_RUNGS {
                    if _abs(pb - EXP_PARAMS_B[q]) < EPS_PARAM { ri = q }
                    q = q + 1
                }
                if ri >= 0 {
                    rung_name[ri] = nm
                    rung_total[ri] = rung_total[ri] + 1.0
                    if corr > 0.5 {
                        rung_correct[ri] = rung_correct[ri] + 1.0
                        if axis == "count" {
                            rung_count_correct[ri] = rung_count_correct[ri] + 1.0
                        } else {
                            rung_perc_correct[ri] = rung_perc_correct[ri] + 1.0
                        }
                    }
                }
            }
        }
        li = li + 1
    }

    // ── Check 1: per-rung overall accuracy recompute matches committed /16 ────
    println("  rung   params   recomputed   expected   accuracy")
    let mut acc = [0.0, 0.0, 0.0]
    let mut recompute_ok = true
    let mut i = 0
    while i < N_RUNGS {
        acc[i] = rung_correct[i] / TOTAL_ITEMS
        let drift = _abs(rung_correct[i] - EXP_CORRECT[i])
        if drift > EPS_RECOMPUTE { recompute_ok = false }
        if _abs(rung_total[i] - TOTAL_ITEMS) > EPS_RECOMPUTE { recompute_ok = false }
        println("  " + str(i) + "      " + to_string(EXP_PARAMS_B[i]) + "B    " +
                to_string(rung_correct[i]) + "/" + to_string(rung_total[i]) + "       " +
                to_string(EXP_CORRECT[i]) + "/16      " + to_string(acc[i]) +
                "   " + rung_name[i])
        i = i + 1
    }
    println("")
    _check(recompute_ok,
           "per-rung overall accuracy recomputed from the committed TSV matches expected (/16)",
           "0.5B=" + to_string(rung_correct[0]) + "  2.2B=" + to_string(rung_correct[1]) +
           "  3.0B=" + to_string(rung_correct[2]) + "  (each /16)")

    // ── Check 2: per-axis recompute (perception sub-ladder) matches ───────────
    let mut perc_ok = true
    let mut j = 0
    while j < N_RUNGS {
        if _abs(rung_perc_correct[j] - EXP_PERC_CORRECT[j]) > EPS_RECOMPUTE { perc_ok = false }
        j = j + 1
    }
    _check(perc_ok,
           "per-axis recompute: PERCEPTION sub-ladder (ocr+spatial+shape, 11 items) matches expected",
           "perception correct: 0.5B=" + to_string(rung_perc_correct[0]) + "/11  2.2B=" +
           to_string(rung_perc_correct[1]) + "/11  3.0B=" + to_string(rung_perc_correct[2]) + "/11  " +
           "| counting axis: 0.5B=" + to_string(rung_count_correct[0]) + "/5  2.2B=" +
           to_string(rung_count_correct[1]) + "/5  3.0B=" + to_string(rung_count_correct[2]) + "/5")

    // ── logistic best-fit (grid search on k, x0; L_lo/L_hi pinned to data) ────
    // L_lo = min observed accuracy, L_hi = max observed accuracy (g0 Occam pin).
    let mut l_lo = acc[0]
    let mut l_hi = acc[0]
    let mut m = 0
    while m < N_RUNGS {
        if acc[m] < l_lo { l_lo = acc[m] }
        if acc[m] > l_hi { l_hi = acc[m] }
        m = m + 1
    }
    // grid-search k in [0.5, 12], x0 in [log2(0.5), log2(3)] minimising RMSE on 3 pts.
    let x_lo = x_of(EXP_PARAMS_B[0])
    let x_hi = x_of(EXP_PARAMS_B[2])
    let mut best_k = 1.0
    let mut best_x0 = 0.0
    let mut best_rmse = 1.0e9
    let mut ki = 0
    while ki <= 115 {
        let k = 0.5 + (ki as float) * 0.1
        let mut xi = 0
        while xi <= 60 {
            let x0 = x_lo + (xi as float) * ((x_hi - x_lo) / 60.0)
            let mut ss = 0.0
            let mut p = 0
            while p < N_RUNGS {
                let yhat = logistic_at(x_of(EXP_PARAMS_B[p]), l_lo, l_hi, k, x0)
                let res = acc[p] - yhat
                ss = ss + res * res
                p = p + 1
            }
            let rmse = sqrt_pure(ss / (N_RUNGS as float))
            if rmse < best_rmse {
                best_rmse = rmse
                best_k = k
                best_x0 = x0
            }
            xi = xi + 1
        }
        ki = ki + 1
    }

    println("")
    println("  best-fit logistic (L_lo/L_hi pinned to data, k/x0 grid-fit):")
    println("    L_lo=" + to_string(l_lo) + "  L_hi=" + to_string(l_hi) +
            "  k=" + to_string(best_k) + "  x0=" + to_string(best_x0) + "  RMSE=" + to_string(best_rmse))
    let mut q2 = 0
    while q2 < N_RUNGS {
        let yhat = logistic_at(x_of(EXP_PARAMS_B[q2]), l_lo, l_hi, best_k, best_x0)
        println("    " + to_string(EXP_PARAMS_B[q2]) + "B  y_obs=" + to_string(acc[q2]) +
                "  y_logistic=" + to_string(yhat) + "  residual=" + to_string(_abs(acc[q2] - yhat)))
        q2 = q2 + 1
    }
    println("")

    // ── Check 3: OVERALL monotonicity test — the honest capability-gradient verdict ─
    // overall accuracy rises 0.5B->2.2B then falls 2.2B->3.0B: NOT monotone.
    let step01 = acc[1] - acc[0]
    let step12 = acc[2] - acc[1]
    let overall_monotone = (step01 >= -EPS_RECOMPUTE) && (step12 >= -EPS_RECOMPUTE)
    // best-fit RMSE for a monotone law on a rise-then-fall curve must be large
    // (a logistic CANNOT bend back down) — report it as the structural-misfit signal.
    let rise_then_fall = (step01 > EPS_RECOMPUTE) && (step12 < -EPS_RECOMPUTE)
    _check(rise_then_fall && !overall_monotone,
           "OVERALL capability gradient is NON-MONOTONE (rise 0.5B->2.2B, fall 2.2B->3.0B) — honest-negative; a monotone logistic structurally cannot fit it",
           "step 0.5B->2.2B=+" + to_string(step01) + "  step 2.2B->3.0B=" + to_string(step12) +
           "  best monotone-logistic RMSE=" + to_string(best_rmse) + " (large = structural misfit, as expected)")

    // ── Check 4: PERCEPTION sub-ladder IS monotone-non-decreasing ─────────────
    let pacc0 = rung_perc_correct[0] / PERC_TOTAL
    let pacc1 = rung_perc_correct[1] / PERC_TOTAL
    let pacc2 = rung_perc_correct[2] / PERC_TOTAL
    let perc_monotone = (pacc1 >= pacc0 - EPS_RECOMPUTE) && (pacc2 >= pacc1 - EPS_RECOMPUTE)
    _check(perc_monotone,
           "PERCEPTION sub-ladder (ocr+spatial+shape) IS monotone-non-decreasing then saturates — the real capability gradient once the params-orthogonal counting axis is separated",
           "perception acc: 0.5B=" + to_string(pacc0) + " -> 2.2B=" + to_string(pacc1) +
           " -> 3.0B=" + to_string(pacc2) + "  (rises then saturates at 1.0)")

    println("")
    println("========================================================================")
    let pass_n = RUN - FAIL
    println("  " + str(pass_n) + "/" + str(RUN) + " checks passed")
    if FAIL > 0 {
        println("  FAILURES:")
        for ff in FAILURES { println("    x " + ff) }
        println("  🔴 FALSIFIED — recompute did not reproduce the committed ladder data")
        println("__HEXA_CODEX_NUMERICS_SUBSTRATE_MULTIMODAL_FIT__ FALSIFIED")
        exit(1)
    }

    println("  🟢 SUPPORTED-NUMERICAL — multimodal capability ladder recomputed from")
    println("     the committed byte-exact TSV; closed-form fit + gradient verdict:")
    println("     overall: 0.5B 0.8125 -> 2.2B 0.9375 -> 3.0B 0.8125 (NON-MONOTONE, honest-negative)")
    println("       → a single logistic in log2(params) is the WRONG family for the overall curve")
    println("         (rise-then-fall; best monotone-logistic RMSE=" + to_string(best_rmse) + ")")
    println("     perception sub-ladder (ocr+spatial+shape): 9/11 -> 11/11 -> 11/11 (MONOTONE→saturate)")
    println("     counting axis (5-9 dense objects): does NOT track params (subitizing-limit; the")
    println("       3.0B Qwen-VL undercounts where the 2.2B SmolVLM2 does not — NOT a quant artifact)")
    println("  · M5.SUBSTRATE multimodal verdict link:")
    println("    .verdicts/sandbox/m5_substrate_multimodal_fit.txt")
    println("__HEXA_CODEX_NUMERICS_SUBSTRATE_MULTIMODAL_FIT__ PASS")
    exit(0)
}
