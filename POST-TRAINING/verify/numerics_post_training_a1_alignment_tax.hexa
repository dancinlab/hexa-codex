#!hexa strict
// POST-TRAINING/verify/numerics_post_training_a1_alignment_tax.hexa
// orchestra "Post-Training" 누락 흡수 (cycle-10 orchestra-research) — closed-form
// verifier for the alignment-tax identity + 5pp threshold falsifier semantics.
//
// Asserts the alignment-tax identity is closed-form and the falsifier
// (over-aligned · capability-sacrifice detection) correctly classifies:
//   (1) tax identity (base_capability − post_capability) holds for all methods
//   (2) capability values ∈ [0, 100 pp] (× 100 ledger ∈ [0, 10000])
//   (3) zero-tax synthetic — base=post=80 pp → alignment_tax = 0 · silent
//   (4) over_aligned fires (tax=12pp > 5pp · capability 희생)
//   (5) good_dpo + sft_base + grpo + rlhf_ppo silent (tax ≤ 5pp · good alignment)
//   (6) determinism (re-call same tax + fires + retention)
//   (7) sanity — retention monotone vs tax (higher tax ⇒ lower retention) AND
//       all helpfulness_gain ≥ 0 (alignment never hurts helpfulness in this set)
//
// Source: POST-TRAINING/bench/post_training_a1_alignment_tax.hexa
// External anchors: Ouyang 2022 InstructGPT/RLHF (arXiv:2203.02155) ·
//                   Rafailov 2023 DPO (arXiv:2305.18290) ·
//                   Shao 2024 GRPO (arXiv:2402.03300) ·
//                   Bai 2022 Constitutional AI (arXiv:2212.08073)
//
// @no-lock-needed

let METHOD_NAMES = ["sft_base", "good_dpo", "rlhf_ppo", "grpo", "over_aligned"]

let BASE_CAP_x100 = [8000, 8000, 8000, 8000, 8000]
let POST_CAP_x100 = [7900, 7800, 7600, 7700, 6800]
let HELP_GAIN_x100 = [800, 1500, 2000, 1800, 2500]

let N_METHODS = 5
let THRESHOLD_x100 = 500            // > 5pp capability drop → over-aligned
let CAP_MAX_x100 = 100 * 100        // [0, 10000]

fn base_cap_x100(method_i: int) -> int {
    return BASE_CAP_x100[method_i]
}
fn post_cap_x100(method_i: int) -> int {
    return POST_CAP_x100[method_i]
}
fn help_gain_x100(method_i: int) -> int {
    return HELP_GAIN_x100[method_i]
}
fn alignment_tax_x100(method_i: int) -> int {
    return base_cap_x100(method_i) - post_cap_x100(method_i)
}
fn capability_retention_x100(method_i: int) -> int {
    return post_cap_x100(method_i) * 10000 / base_cap_x100(method_i)
}
fn falsifier_fires(method_i: int) -> bool {
    return alignment_tax_x100(method_i) > THRESHOLD_x100
}

print("hexa-codex POST-TRAINING A1 falsifier — alignment tax closed-form")
print("================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0
let n_methods = METHOD_NAMES.len()

// check 1 — tax identity for all methods
checks_total = checks_total + 1
let mut id_ok = true
let mut i = 0
while i < n_methods {
    let lhs = alignment_tax_x100(i)
    let rhs = base_cap_x100(i) - post_cap_x100(i)
    if lhs != rhs { id_ok = false }
    i = i + 1
}
if id_ok {
    print("  [PASS] tax identity (base_capability − post_capability) holds for all " +
          to_string(n_methods) + " methods")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] tax identity broken")
}

// check 2 — capability values ∈ [0, 100 pp] (× 100 ledger ∈ [0, 10000])
checks_total = checks_total + 1
let mut rb_ok = true
i = 0
while i < n_methods {
    let bc = base_cap_x100(i)
    let pc = post_cap_x100(i)
    if bc < 0 || bc > CAP_MAX_x100 { rb_ok = false }
    if pc < 0 || pc > CAP_MAX_x100 { rb_ok = false }
    i = i + 1
}
if rb_ok {
    print("  [PASS] capability values ∈ [0, 100 pp] (× 100 ledger ∈ [0, " +
          to_string(CAP_MAX_x100) + "]) for all " +
          to_string(n_methods * 2) + " entries")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] capability out of range")
}

// check 3 — zero-tax synthetic: base=post=80 pp → alignment_tax = 0 · silent
checks_total = checks_total + 1
let SYN_BASE = 8000  // 80 pp × 100
let SYN_POST = 8000
let syn_tax = SYN_BASE - SYN_POST
if syn_tax == 0 && syn_tax <= THRESHOLD_x100 {
    print("  [PASS] synthetic zero-tax (base=post=80pp) → alignment_tax=0/100 · silent")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] synthetic zero-tax tax=" + to_string(syn_tax))
}

// check 4 — over_aligned (idx 4) fires (tax 12pp > 5pp · capability 희생)
checks_total = checks_total + 1
if falsifier_fires(4) && alignment_tax_x100(4) == 1200 {
    print("  [PASS] over_aligned fires (alignment_tax=" + to_string(alignment_tax_x100(4)) +
          "/100 = 12pp > 5pp · helpfulness↑ 인데 capability 희생 · over-aligned)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] over_aligned fire detection broken")
}

// check 5 — sft_base + good_dpo + rlhf_ppo + grpo silent (tax ≤ 5pp · good alignment)
checks_total = checks_total + 1
if falsifier_fires(0) == false && falsifier_fires(1) == false
        && falsifier_fires(2) == false && falsifier_fires(3) == false
        && alignment_tax_x100(0) == 100 && alignment_tax_x100(1) == 200
        && alignment_tax_x100(2) == 400 && alignment_tax_x100(3) == 300 {
    print("  [PASS] good alignment silent: sft_base=1pp · good_dpo=2pp · rlhf_ppo=4pp · grpo=3pp drop — false-positive 회피")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] good alignment silent detection broken")
}

// check 6 — determinism (re-call same values)
checks_total = checks_total + 1
if alignment_tax_x100(4) == alignment_tax_x100(4)
        && falsifier_fires(4) == falsifier_fires(4)
        && capability_retention_x100(1) == capability_retention_x100(1) {
    print("  [PASS] formula deterministic (re-call same tax + fires + retention)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] formula non-deterministic")
}

// check 7 — sanity: retention monotone vs tax (higher tax ⇒ lower retention)
//   AND all helpfulness_gain ≥ 0 (alignment never hurts helpfulness in this set).
//   over_aligned (highest tax) must have the lowest retention; sft_base (lowest
//   tax) the highest. Pairwise: ret(over_aligned) < ret(sft_base).
checks_total = checks_total + 1
let mut help_nonneg = true
i = 0
while i < n_methods {
    if help_gain_x100(i) < 0 { help_nonneg = false }
    i = i + 1
}
let ret_monotone = capability_retention_x100(4) < capability_retention_x100(0)
        && capability_retention_x100(1) < capability_retention_x100(0)
if help_nonneg && ret_monotone {
    print("  [PASS] sanity — retention monotone vs tax (over_aligned " +
          to_string(capability_retention_x100(4)) + " < sft_base " +
          to_string(capability_retention_x100(0)) + ") AND all helpfulness_gain ≥ 0")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] sanity broken (help_nonneg=" + to_string(help_nonneg) +
          " · ret_monotone=" + to_string(ret_monotone) + ")")
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 STRUCTURAL (alignment-tax identity + 5pp threshold semantics 7/7) + 🟡 BY-CITATION (placeholder data · 5pp threshold = capability-sacrifice convention · cite Ouyang 2022 InstructGPT/RLHF + Rafailov 2023 DPO + Shao 2024 GRPO + Bai 2022 Constitutional AI)"
} else {
    verdict_tier = "🔴 FALSIFIED — alignment-tax formula contradicts identity (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
}
print("  " + verdict_tier)
print("")
print("POST-TRAINING A1 finding (orchestra Post-Training 흡수 · placeholder · closed-form):")
print("  - alignment_tax_x100 = base_capability − post_capability identity (7/7 closed-form checks)")
print("  - bidirectional discrimination: sft_base=1pp · good_dpo=2pp · grpo=3pp · rlhf_ppo=4pp silent (good alignment) · over_aligned=12pp fires (capability 희생)")
print("  - external anchors: Ouyang 2022 InstructGPT/RLHF · Rafailov 2023 DPO · Shao 2024 GRPO · Bai 2022 Constitutional AI")
print("  - 실측 (cycle-11+ T4): base vs post capability bench (MMLU/GSM8K/HumanEval pre/post alignment) on local SANDBOX stack (cx_lab_sandbox)")
print("")
print("__HEXA_CODEX_NUMERICS_POST_TRAINING_A1__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/POST-TRAINING/verdicts/a1_alignment_tax_verdict.txt"

let mut content = "# hexa-codex POST-TRAINING A1 — alignment tax verifier (orchestra Post-Training 흡수 · cycle-10)\n"
content = content + "# axis=POST-TRAINING/POST-TRAINING.md::A1 (alignment tax · 5 post-train methods · capability drop · 5pp threshold)\n"
content = content + "# bench=POST-TRAINING/bench/post_training_a1_alignment_tax.hexa\n"
content = content + "# verifier=POST-TRAINING/verify/numerics_post_training_a1_alignment_tax.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# formula=alignment_tax_x100 = base_capability − post_capability (× 100 ledger of pp); falsifier_fires = alignment_tax > 5pp (> 500 in × 100 ledger)\n"
content = content + "# placeholder_data=5 methods · sft_base (base=80 post=79 · tax 1pp · help +8 silent) · good_dpo (80/78 · 2pp · +15 silent) · rlhf_ppo (80/76 · 4pp · +20 silent) · grpo (80/77 · 3pp · +18 silent) · over_aligned (80/68 · 12pp · +25 FIRES)\n"
content = content + "# bidirectional_discrimination=4 silent (sft_base · good_dpo · rlhf_ppo · grpo) + 1 fires (over_aligned) — falsifier 정확 발화 only on capability-sacrifice (over-aligned)\n"
content = content + "# external_anchors=Ouyang 2022 InstructGPT/RLHF (arXiv:2203.02155) · Rafailov 2023 DPO (arXiv:2305.18290) · Shao 2024 GRPO (arXiv:2402.03300) · Bai 2022 Constitutional AI (arXiv:2212.08073)\n"
content = content + "# substrate_fire=DEFERRED (cycle-11+ · base vs post capability bench MMLU/GSM8K/HumanEval pre/post alignment on local SANDBOX stack · cx_lab_sandbox)\n"
content = content + "# absorbed_from=orchestra-research 20-skill 'Post-Training' (cycle-10 누락 흡수 · 신규 단독 도메인 POST-TRAINING)\n"
content = content + "# frontier_open=feedback_closure_is_physical_limit — tax identity close ≠ measured alignment-tax close · 새 post-train method·alignment 목표 마다 frontier 재오픈\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
