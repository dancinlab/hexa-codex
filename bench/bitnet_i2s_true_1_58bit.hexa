#!hexa strict
// bench/bitnet_i2s_true_1_58bit.hexa — BITNET M2+ bench: TRUE 1.58-bit i2_s.
//
// QUESTION (the /gap ROOT-B finding): BITNET M1/M2 served BitNet b1.58 2B4T as
// TQ2_0 (2.06 bpw) because the official microsoft i2_s GGUF (ggml type-id 36)
// does NOT load in stock brew llama.cpp 9150 (type 36 = TYPE_IQ4_NL_4_4 REMOVED).
// So the headline "1.58-bit" was actually tested at 2.06 bpw. This bench closes
// that gap: it serves the GENUINE i2_s ternary kernel via Microsoft's official
// inference engine bitnet.cpp (its forked llama-cli with the I2_S kernel), on
// the SAME canonical 20-task manifest + the SAME byte_exact_subset scorer as
// bench/bitnet_m1_accuracy_floor.hexa, so the i2_s (1.58 bpw) number is DIRECTLY
// comparable to the M1 TQ2_0 (2.06 bpw) number.
//
// ENGINE: ~/BitNet (github.com/microsoft/BitNet, official bitnet.cpp), built
// locally on Apple Silicon (arm64 i2_s kernel, codegen_tl1 header, ccache OFF).
// MODEL: ggml-model-i2s-bitnet.gguf, self-converted from the official bf16
// safetensors (microsoft/bitnet-b1.58-2B-4T-bf16) via bitnet.cpp's own
// utils/convert-helper-bitnet.py + build/bin/llama-quantize ... I2_S — i.e.
// the GGUF is guaranteed engine-matched (the pre-downloaded official i2_s GGUF
// is a community 'bitnet2b' Human:/BITNETAssistant: variant; the self-converted
// one applies the official 2B4T User:/Assistant: format and decodes coherently).
//
// SERVING MODE: raw "User: <q>\nAssistant:" prefix (the official 2B4T chat
// format) at --temp 0 greedy, -ngl 0 CPU (Apple Silicon ARM i2_s LUT/MAD path).
// This is the i2_s analogue of the M1 TQ2_0 assistant_prefix mode. NOTE: the
// embedded chat template applied via -cnv collapses to degenerate token-0
// ("!!!!"), so raw-prefix is the fair serving mode for this engine/GGUF.
//
// SCORER is byte-identical to bench/bitnet_m1_accuracy_floor.hexa run_one()
// (case-insensitive substring on expected_kw, with the stderr-trailer strip)
// so the i2_s number is DIRECTLY comparable to the TQ2_0 floor.
//
// Parameterized by env:
//   BITNET_I2S_BIN     absolute bitnet.cpp llama-cli path (default ~/BitNet/build/bin/llama-cli)
//   BITNET_MODEL_PATH  absolute .gguf path (default the self-converted i2s gguf)
//   BITNET_MODEL_NAME  label for the summary
//   BITNET_OUT_PREFIX  .verdicts/bitnet/<prefix> (default m2plus_i2s_true_1_58bit)
//
// Run:
//   HEXA_SHIM_NO_DARWIN_LANDING=1 RESOURCE_LOCAL_HEXA=1 \
//     HEXA_CODEX_ROOT="$PWD" \
//     ~/.hx/packages/hexa/hexa.real run bench/bitnet_i2s_true_1_58bit.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="External CLI subprocess (bitnet.cpp llama-cli + /usr/bin/time) + filesystem write — no atlas atoms touched.")

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()
let OUT_DIR = ROOT + "/.verdicts/bitnet"

fn _bin() -> str {
    let b = env("BITNET_I2S_BIN")
    if b.len() > 0 { return b }
    return HOME + "/BitNet/build/bin/llama-cli"
}
fn _model_path() -> str {
    let p = env("BITNET_MODEL_PATH")
    if p.len() > 0 { return p }
    return HOME + "/Models/bitnet-bf16/ggml-model-i2s-bitnet.gguf"
}
fn _model_name() -> str {
    let n = env("BITNET_MODEL_NAME")
    if n.len() > 0 { return n }
    return "BitNet-b1.58-2B-4T-i2_s"
}
fn _out_prefix() -> str {
    let p = env("BITNET_OUT_PREFIX")
    if p.len() > 0 { return p }
    return "m2plus_i2s_true_1_58bit"
}

let BIN = _bin()
let MODEL_PATH = _model_path()
let MODEL_NAME = _model_name()
let OUT_PREFIX = _out_prefix()
let MAX_TOK = 96            // identical headroom to sandbox_stage0_baseline / M1
let USABLE_THRESHOLD = 15   // >= 15/20 = usable floor reached (SANDBOX parity)

// 20-task fixed manifest — VERBATIM from bench/bitnet_m1_accuracy_floor.hexa
// (itself verbatim from sandbox_stage0_baseline.hexa / economics_routing_2tier.hexa).
let TASKS = [
    ["What is 2+2? Reply with the digit only.",                                                    "4"],
    ["Capital of France? One word.",                                                                "paris"],
    ["Reverse the string 'hello'. Reply with the reversed string only.",                            "olleh"],
    ["Square of 7? Reply with the number only.",                                                    "49"],
    ["First prime number greater than 10? Reply with the number only.",                             "11"],
    ["Smallest prime number? Reply with the number only.",                                          "2"],
    ["How many continents? Reply with the number only.",                                            "7"],
    ["Boiling point of water in Celsius at sea level? Reply with the number only.",                 "100"],
    ["ASCII decimal code for 'A'? Reply with the number only.",                                     "65"],
    ["Days in February 2024? Reply with the number only.",                                          "29"],
    ["Write a Python one-liner that sums integers 1..100. Reply with code only.",                   "sum(range"],
    ["Time complexity of binary search? Reply with big-O only.",                                    "log n"],
    ["Python: reverse a list lst in one expression. Reply with the expression only.",               "[::-1]"],
    ["Sort {3,1,2} ascending. Reply with the result only.",                                         "1, 2, 3"],
    ["TCP vs UDP in one sentence — which is connection-oriented?",                                  "tcp"],
    ["Explain BFS vs DFS in 2 sentences.",                                                          "breadth"],
    ["Write Python Fibonacci with memoization (use functools.cache).",                              "fib"],
    ["Convert binary 1101 to decimal, show one-line sum.",                                          "13"],
    ["Why is mergesort O(n log n)? One-sentence justification.",                                    "merge"],
    ["Halting problem — what is it? One sentence.",                                                  "halt"],
]

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

// Run one task via bitnet.cpp llama-cli, wrapped in /usr/bin/time -l for RSS.
// Returns tab-separated:
//   wall_ms \t prompt_wc \t output_tok_est \t correct(1|0) \t rss_bytes \t output_snippet
//
// PROMPT: raw "User: <q>\nAssistant:" (official 2B4T format).
// PARSER + SCORER byte-identical to bitnet_m1_accuracy_floor.hexa assistant_prefix:
// collapse to one line, strip up to last "Assistant:", strip [end of text] /
// common_perf_print trailer, case-insensitive substring match on expected_kw.
// --no-display-prompt keeps llama-cli from echoing the prompt into the answer.
fn run_one(prompt: str, expected_kw: str) -> str {
    let wc = str(prompt.len())   // byte-length; cheap proxy for word-count

    // assistant_prefix: collapse to one line, strip up to last "Assistant:".
    let extract = "tr '\\n' ' ' | sed 's/.*Assistant: *//'"

    // raw 2B4T format prompt — literal newline between the User line and Assistant:.
    let templated = "User: " + prompt + "\nAssistant:"

    let cmd = "t_start=$(date +%s%N); " +
              "tmperr=$(mktemp); " +
              "out=$(/usr/bin/time -l " + shq(BIN) + " -m " + shq(MODEL_PATH) +
              " -ngl 0 --no-warmup --no-display-prompt" +
              " -p " + shq(templated) +
              " -n " + str(MAX_TOK) + " --temp 0 2>\"$tmperr\"); " +
              "t_end=$(date +%s%N); " +
              "wall_ms=$(( (t_end - t_start) / 1000000 )); " +
              "rss=$(grep 'maximum resident set size' \"$tmperr\" | awk '{print $1}' | tail -1); " +
              "rm -f \"$tmperr\"; " +
              "ans_raw=$(printf '%s\\n' \"$out\" | " + extract + " | sed 's/  */ /g; s/^ //; s/ $//'); " +
              // SCORER parity: strip [end of text] + common_perf_print trailer
              "ans=$(printf '%s' \"$ans_raw\" | sed 's/ *\\[end of text\\].*$//' | sed 's/ *common_perf_print:.*$//'); " +
              "tok_est=$(printf '%s' \"$ans\" | wc -w | tr -d ' '); " +
              "low=$(printf '%s' \"$ans\" | tr 'A-Z' 'a-z'); " +
              "kw=$(printf '%s' " + shq(expected_kw) + " | tr 'A-Z' 'a-z'); " +
              "if printf '%s' \"$low\" | grep -qF \"$kw\"; then correct=1; else correct=0; fi; " +
              "snippet=$(printf '%s' \"$ans\" | cut -c1-120); " +
              "printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s' \"$wall_ms\" \"" + wc + "\" \"$tok_est\" \"$correct\" \"${rss:-0}\" \"$snippet\""
    return exec(cmd).trim()
}

fn main() {
    println("========================================================================")
    println("  bench/bitnet_i2s_true_1_58bit — TRUE 1.58-bit i2_s via bitnet.cpp")
    println("  model:    " + MODEL_NAME)
    println("  path:     " + MODEL_PATH)
    println("  engine:   " + BIN + " (Microsoft bitnet.cpp, I2_S ternary kernel)")
    println("  manifest: 20 tasks (VERBATIM from bitnet_m1_accuracy_floor.hexa)")
    println("  threshold: >= " + str(USABLE_THRESHOLD) + "/20 = usable floor reached")
    println("========================================================================")

    exec("mkdir -p " + shq(OUT_DIR))
    let tsv_path = OUT_DIR + "/" + OUT_PREFIX + ".tsv"
    exec("rm -f " + shq(tsv_path))
    exec("echo 'idx\tprompt_wc\toutput_tok_est\twall_ms\tcorrect\trss_bytes\toutput_snippet' >> " + shq(tsv_path))

    let mut total_ms = 0
    let mut n_correct = 0
    let mut peak_rss = 0
    let mut i = 0
    while i < len(TASKS) {
        let task = TASKS[i]
        let prompt = task[0]
        let expected = task[1]
        println("  [" + str(i+1) + "/" + str(len(TASKS)) + "] kw=" + expected + " prompt=" + prompt.substr(0, 50))
        let line = run_one(prompt, expected)
        let parts = line.split("\t")
        if parts.len() < 6 {
            println("    ! parse error, raw=" + line)
            let bad = str(i+1) + "\t" + str(prompt.len()) + "\t0\t0\t0\t0\tPARSE_ERROR:" + line.substr(0, 80)
            exec("echo " + shq(bad) + " >> " + shq(tsv_path))
            i = i + 1
            continue
        }
        let wall_ms = int(parts[0])
        let prompt_wc = parts[1]
        let tok_est = parts[2]
        let correct = parts[3]
        let rss = int(parts[4])
        let snippet = parts[5].replace("\t", " ")
        total_ms = total_ms + wall_ms
        if correct == "1" { n_correct = n_correct + 1 }
        if rss > peak_rss { peak_rss = rss }
        let row = str(i+1) + "\t" + prompt_wc + "\t" + tok_est + "\t" + str(wall_ms) + "\t" + correct + "\t" + str(rss) + "\t" + snippet.substr(0, 120)
        exec("echo " + shq(row) + " >> " + shq(tsv_path))
        println("    -> wall_ms=" + str(wall_ms) + " correct=" + correct + " rss=" + str(rss) + " ans=" + snippet.substr(0, 50))
        i = i + 1
    }

    let total = len(TASKS)
    let mut acc_pct_x100 = 0
    if total > 0 { acc_pct_x100 = (n_correct * 10000) / total }
    let mut floor_ok = "false"
    if n_correct >= USABLE_THRESHOLD { floor_ok = "true" }

    let peak_rss_mb = peak_rss / 1048576

    println("")
    println("========================================================================")
    println("  SUMMARY — BITNET M2+ TRUE 1.58-bit i2_s")
    println("========================================================================")
    println("  model            : " + MODEL_NAME)
    println("  total_tasks      : " + str(total))
    println("  correct          : " + str(n_correct) + "/" + str(total))
    println("  accuracy_pct     : " + str(acc_pct_x100 / 100) + "." + str(acc_pct_x100 % 100) + "%")
    println("  total_wall_ms    : " + str(total_ms))
    println("  peak_rss_bytes   : " + str(peak_rss))
    println("  peak_rss_mb      : " + str(peak_rss_mb))
    println("  threshold        : >= " + str(USABLE_THRESHOLD) + "/20")
    println("  usable_floor     : " + floor_ok)
    println("")

    let summary_path = OUT_DIR + "/" + OUT_PREFIX + ".txt"
    exec("rm -f " + shq(summary_path))
    exec("echo " + shq("# model=" + MODEL_NAME) + " >> " + shq(summary_path))
    exec("echo " + shq("# model_path=" + MODEL_PATH) + " >> " + shq(summary_path))
    exec("echo " + shq("# engine=" + BIN) + " >> " + shq(summary_path))
    exec("echo " + shq("# total_tasks=" + str(total)) + " >> " + shq(summary_path))
    exec("echo " + shq("# correct=" + str(n_correct) + "/" + str(total)) + " >> " + shq(summary_path))
    exec("echo " + shq("# accuracy_pct=" + str(acc_pct_x100 / 100) + "." + str(acc_pct_x100 % 100)) + " >> " + shq(summary_path))
    exec("echo " + shq("# total_wall_ms=" + str(total_ms)) + " >> " + shq(summary_path))
    exec("echo " + shq("# peak_rss_bytes=" + str(peak_rss)) + " >> " + shq(summary_path))
    exec("echo " + shq("# peak_rss_mb=" + str(peak_rss_mb)) + " >> " + shq(summary_path))
    exec("echo " + shq("# usable_threshold=" + str(USABLE_THRESHOLD)) + " >> " + shq(summary_path))
    exec("echo " + shq("# usable_floor_reached=" + floor_ok) + " >> " + shq(summary_path))
    exec("echo " + shq("# tool=bitnet.cpp llama-cli (Microsoft official, I2_S ternary kernel, arm64 -ngl 0 CPU)") + " >> " + shq(summary_path))
    exec("echo " + shq("# quant=i2_s (file-type 40, ggml type-id 36 = I2_S; ~1.58 bpw TRUE ternary, NOT TQ2_0 2.06 bpw)") + " >> " + shq(summary_path))
    exec("echo " + shq("# serving_mode=raw User:/Assistant: prefix --temp 0 greedy (official 2B4T format; -cnv template collapses to token-0)") + " >> " + shq(summary_path))
    exec("echo " + shq("# host=mac-mini-m3 (24 GB UMA, arm64 NEON+ACCELERATE)") + " >> " + shq(summary_path))
    exec("echo " + shq("# scorer=byte_exact_subset (case-insensitive, VERBATIM from bitnet_m1_accuracy_floor.hexa)") + " >> " + shq(summary_path))
    exec("echo " + shq("# cost_usd=0  (local serving; wall_ms is the proxy cost surface)") + " >> " + shq(summary_path))

    println("  tsv     persisted: " + tsv_path)
    println("  summary persisted: " + summary_path)
    println("")
    println("__HEXA_CODEX_BENCH_BITNET_I2S__ PASS")
    exit(0)
}
