#!hexa strict
// bench/sandbox_stage4_slo_under_load.hexa — SANDBOX Stage 4: OPS SLO
// under-load harness (M1.OPS milestone — script-only, NOT yet executed).
//
// CONTEXT (.discoveries/sandbox.tape `d_slo_under_load`, cross-cut OPS+ECONOMICS):
//   OPS owns the SLO falsifier class (p50/p99/p999 latency, queue depth,
//   throughput saturation) but has zero substrate to measure on outside
//   the metered API (no per-request scheduling exposed, no concurrency
//   knob, no offered-load sweep). cycle-6 confirmed the substrate primitive
//   (`d_continuous_batching_server`: -np 4 wins +30.65% at 20-task scale)
//   and located the np=8 OOM ceiling on 16GB UMA mac-mini M3 — so np ∈
//   {1, 2, 4} is the honest cell range, np=8 skipped per cycle-6 finding.
//
// QUESTION:
//   At Stage-2 N=2000 manifest scale, on a long-lived llama-server with -cb
//   continuous batching, how do p50 / p99 / p999 latencies behave as the
//   OFFERED load rate sweeps from comfortably-under-peak to over-peak?
//   Classic M/M/c queue prediction: p99 stays within ~3x of p50 below ~70%
//   utilization, knee at 80-90%, p999 explodes once arrival rate ≥ service
//   rate. The substrate exposes that whole curve; the API surface hides it.
//
// METHOD (3x3 SLO grid):
//   For each cell in {-np ∈ {1,2,4}} × {target_rate_qps ∈ {5,20,100}}:
//     1. boot `llama-server -m <model> --host 127.0.0.1 --port 8090
//        -np <N> -cb --log-disable --slot-save-path <slotdir>`
//        (port 8090 — distinct from sibling benches at 8081/8082/8083/8088)
//     2. poll /health until 200 (~3-4s warmup)
//     3. WARM-UP phase (~30s): fire requests at target_rate_qps using a
//        Poisson-like inter-arrival timer (sleep $(rand_exp_ms)); responses
//        recorded but EXCLUDED from percentile rollup
//     4. MEASURE phase (~60s): same arrival rate; per-request bracket
//        enqueue_t (date +%s%N just before curl) → complete_t (just after
//        curl returns); pair file written to per-request stat shard
//     5. teardown: kill server (SIGTERM, then SIGKILL after 2s); clear shards
//   Percentiles computed offline from the measurement-phase shards: sort
//   the latency array, pick indices floor(N*0.50), floor(N*0.95),
//   floor(N*0.99), floor(N*0.999). p999 only meaningful if N_completed ≥
//   1000 per cell — flagged in the per-cell row when violated.
//
// GRID CELLS (9 total — 3 np × 3 rate):
//                    rate=5 qps    rate=20 qps   rate=100 qps
//   np=1             cell (1,5)    cell (1,20)   cell (1,100)
//   np=2             cell (2,5)    cell (2,20)   cell (2,100)
//   np=4             cell (4,5)    cell (4,20)   cell (4,100)
//
//   np=8 INTENTIONALLY OMITTED — cycle-6 d_continuous_batching_server
//   showed np=8 is 27.9% SLOWER than np=4 on this 16GB UMA box
//   (memory-bandwidth saturation), and a sustained-load run at np=8
//   would OOM or thrash. Documented in honest_limit_2 below.
//
// HARNESS DISPATCHER:
//   Each request fires via a `_dispatch_one` shell helper that brackets
//   the curl POST with `date +%s%N` (enqueue_t, complete_t), parses the
//   JSON for output_tok + correctness, and appends a TSV row to a
//   per-cell shard at /tmp/sandbox_stage4_slo_shards/<np>_<rate>.tsv.
//   xargs -P <concurrency> -n 1 fans out fire-and-forget calls; an outer
//   `seq` produces (idx, sleep_us) pairs to space the arrivals at the
//   target rate. Concurrency cap = max(np*4, 16) — enough to absorb a
//   queue without becoming the bottleneck itself.
//
// PERCENTILES:
//   Computed in main() by reading the shard back, sorting wall_ms with
//   shell `sort -n`, then picking the index nearest each target quantile.
//   Why offline: hexa loop math on 2000+ latencies in-script would be
//   slow vs `sort -n` + `awk NR==floor(N*p)` — keep hot path in shell,
//   keep verdict math in hexa.
//
// MANIFEST CYCLING:
//   N=2000 manifest is cycled mod len(manifest); offered_rate × duration
//   may exceed 2000 (e.g., 100qps × 60s = 6000 reqs), so we wrap around.
//   The order is sequential by idx (NOT shuffled) — deterministic re-runs
//   are an honesty gate per SANDBOX.md §"Honesty rules".
//
// HONESTY GATES:
//   - server killed between cells (clean -np state per cell)
//   - p999 ONLY reported if n_completed ≥ 1000 (else row flag p999=NA);
//     the M2.OPS run is sized so each cell clears 1000 by virtue of the
//     60s measurement window at >= 20 qps; the 5 qps cells will fall
//     short of 1000 — by design, they show only p50/p95/p99
//   - error_rate captured separately from latency (non-2xx responses
//     contribute to error_rate but NOT to the latency array, which would
//     otherwise be polluted by sub-ms HTTP failures masquerading as p50)
//   - accuracy_drop_under_load tracked as a secondary signal: byte-exact
//     correctness on the manifest's expected_kw column at each rate
//     compared against the np=1 / rate=5 reference cell (lowest contention)
//
// Output:
//   .verdicts/sandbox/stage4_slo_under_load.tsv          (1 row per cell)
//   .verdicts/sandbox/stage4_slo_under_load_summary.txt  (run-time filled)
//
// Run (LATER — this commit ships harness only):
//   HEXA_SHIM_NO_DARWIN_LANDING=1 RESOURCE_LOCAL_HEXA=1 \
//     HEXA_CODEX_ROOT="$PWD" \
//     ~/.hx/packages/hexa/hexa.real run bench/sandbox_stage4_slo_under_load.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="External HTTP subprocess (curl → llama-server) + filesystem write — no atlas atoms touched.")

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()
let OUT_DIR = ROOT + "/.verdicts/sandbox"
let MANIFEST_PATH = ROOT + "/.verdicts/sandbox/stage2_manifest.tsv"
let MODEL_PATH = HOME + "/Models/gguf/Qwen2.5-0.5B-Instruct-Q4_K_M.gguf"
let MODEL_NAME = "Qwen2.5-0.5B-Instruct-Q4_K_M"
let SERVER_HOST = "127.0.0.1"
let SERVER_PORT = "8090"
let SERVER_URL  = "http://127.0.0.1:8090"
let MAX_TOK = 64
let SHARD_DIR    = "/tmp/sandbox_stage4_slo_shards"
let PAYLOAD_DIR  = "/tmp/sandbox_stage4_slo_payloads"
let SERVER_LOG   = "/tmp/sandbox_stage4_slo_server.log"
let SERVER_PIDF  = "/tmp/sandbox_stage4_slo_server.pid"
let SLOT_DIR     = "/tmp/sandbox_stage4_slo_slots"

let WARMUP_SEC   = 30      // EXCLUDED from percentile rollup
let MEASURE_SEC  = 60      // included
let MIN_FOR_P999 = 1000    // n_completed gate

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn json_escape(s: str) -> str {
    let mut t = s.replace("\\", "\\\\")
    t = t.replace("\"", "\\\"")
    t = t.replace("\n", "\\n")
    t = t.replace("\r", "\\r")
    t = t.replace("\t", "\\t")
    return t
}

// Kill any stale server on our port + remove pidfile. Idempotent.
fn kill_server() {
    exec("if [ -f " + shq(SERVER_PIDF) + " ]; then " +
         "  pid=$(cat " + shq(SERVER_PIDF) + " 2>/dev/null); " +
         "  if [ -n \"$pid\" ] && kill -0 $pid 2>/dev/null; then " +
         "    kill -TERM $pid 2>/dev/null; sleep 1; " +
         "    if kill -0 $pid 2>/dev/null; then kill -KILL $pid 2>/dev/null; fi; " +
         "  fi; " +
         "  rm -f " + shq(SERVER_PIDF) + "; " +
         "fi; " +
         "for p in $(lsof -iTCP:" + SERVER_PORT + " -sTCP:LISTEN -t 2>/dev/null); do " +
         "  kill -TERM $p 2>/dev/null; sleep 1; kill -KILL $p 2>/dev/null; " +
         "done; " +
         "true")
}

// Boot llama-server with given -np N. Returns "ok" or "fail:<reason>".
// Double-fork nohup pattern per cycle-6 d_kv_prefix_share_persistent:
// the hexa exec() subshell propagates SIGHUP otherwise.
fn boot_server(np: int) -> str {
    kill_server()
    exec("sleep 1")
    exec("mkdir -p " + shq(SLOT_DIR))
    let inner = "nohup llama-server -m " + shq(MODEL_PATH) +
                " --host " + SERVER_HOST + " --port " + SERVER_PORT +
                " -np " + str(np) + " -cb --log-disable " +
                " -c 4096" +
                " --slot-save-path " + shq(SLOT_DIR) +
                " > " + shq(SERVER_LOG) + " 2>&1 < /dev/null " +
                " & echo $! > " + shq(SERVER_PIDF)
    let launch = "( " + inner + " ) &"
    exec("/bin/sh -c " + shq(launch))
    // wait for pidfile
    exec("for i in 1 2 3 4 5; do [ -s " + shq(SERVER_PIDF) + " ] && break; sleep 1; done")
    let pid = exec("cat " + shq(SERVER_PIDF) + " 2>/dev/null").trim()
    if pid.len() == 0 {
        return "fail:no_pid"
    }
    // poll /health for up to 30s
    let probe = "for i in $(seq 1 60); do " +
                "  code=$(curl -s -o /dev/null -w '%{http_code}' " + SERVER_URL + "/health 2>/dev/null); " +
                "  if [ \"$code\" = \"200\" ]; then echo READY; exit 0; fi; " +
                "  if ! kill -0 " + pid + " 2>/dev/null; then echo DIED; exit 1; fi; " +
                "  sleep 0.5; " +
                "done; echo TIMEOUT; exit 1"
    let r = exec(probe).trim()
    if r.contains("READY") { return "ok" }
    if r.contains("DIED")  { return "fail:server_died" }
    return "fail:health_timeout"
}

// Stage payloads — load Stage-2 manifest, emit per-idx JSON request bodies
// into PAYLOAD_DIR/<idx>.json (idx 1..2000 from manifest column 1).
// Done ONCE at startup; cells reuse the staged bodies (mod 2000 cycling).
fn stage_payloads() -> int {
    exec("rm -rf " + shq(PAYLOAD_DIR) + "; mkdir -p " + shq(PAYLOAD_DIR))
    // Each row: idx \t wc \t stratum \t prompt \t expected_kw \t difficulty
    // We read with awk -F'\t' and emit one JSON per row.
    let cmd = "awk -F'\\t' 'NR>1 {" +
              "  idx=$1; prompt=$4; " +
              "  gsub(/\\\\/, \"\\\\\\\\\", prompt); " +
              "  gsub(/\"/,  \"\\\\\\\"\", prompt); " +
              "  gsub(/\\n/, \"\\\\n\", prompt); " +
              "  body=\"{\\\"messages\\\":[{\\\"role\\\":\\\"user\\\",\\\"content\\\":\\\"\" prompt \"\\\"}],\\\"max_tokens\\\":" + str(MAX_TOK) + ",\\\"temperature\\\":0}\"; " +
              "  path=\"" + PAYLOAD_DIR + "/\" idx \".json\"; " +
              "  print body > path; close(path); " +
              "  cnt++; " +
              "} END { print cnt }' " + shq(MANIFEST_PATH)
    let out = exec(cmd).trim()
    if out.len() == 0 { return 0 }
    return int(out)
}

// Also stage an idx-to-expected_kw lookup table (TSV: idx \t expected_kw)
// so the per-request scorer can fetch the gold string by id.
fn stage_keywords() -> str {
    let kw_path = "/tmp/sandbox_stage4_slo_kw.tsv"
    exec("awk -F'\\t' 'NR>1 { print $1 \"\\t\" $5 }' " + shq(MANIFEST_PATH) +
         " > " + shq(kw_path))
    return kw_path
}

// Drive one cell. Writes shard at SHARD_DIR/<np>_<rate>.tsv with rows:
//   phase \t enqueue_ns \t complete_ns \t wall_ms \t http_code \t output_tok \t correct
// phase ∈ {warmup, measure}. Caller filters measure-only for percentiles.
// Returns "n_total \t n_completed \t n_errors \t n_correct" for measure phase.
fn drive_cell(np: int, target_rate_qps: int, manifest_n: int, kw_path: str) -> str {
    let shard = SHARD_DIR + "/" + str(np) + "_" + str(target_rate_qps) + ".tsv"
    exec("rm -f " + shq(shard) + "; mkdir -p " + shq(SHARD_DIR))
    exec("printf 'phase\\tenqueue_ns\\tcomplete_ns\\twall_ms\\thttp_code\\toutput_tok\\tcorrect\\n' > " + shq(shard))

    // dispatch_one shell helper — reads idx, phase from xargs, fires curl,
    // brackets the call, appends a row to the shard. Atomic append via
    // `>> $shard` is safe under Linux/macOS for line-sized writes (PIPE_BUF).
    // The kw lookup uses awk -v on the staged TSV (cheap, no jq required).
    let body =
        "_dispatch_one() { " +
        "  local phase=\"$1\"; local idx=\"$2\"; " +
        "  local payload=" + shq(PAYLOAD_DIR) + "/${idx}.json; " +
        "  local t0=$(date +%s%N); " +
        "  local resp=$(curl -s --max-time 30 -X POST " + SERVER_URL + "/v1/chat/completions " +
        "       -H 'Content-Type: application/json' --data-binary @${payload} " +
        "       -w '\\n__HTTP_CODE__=%{http_code}'); " +
        "  local t1=$(date +%s%N); " +
        "  local wall_ms=$(( (t1 - t0) / 1000000 )); " +
        "  local http_code=$(printf '%s' \"$resp\" | grep -o '__HTTP_CODE__=[0-9]*' | tail -1 | cut -d= -f2); " +
        "  local payload_resp=$(printf '%s' \"$resp\" | sed 's/__HTTP_CODE__=.*$//'); " +
        "  local ans=$(printf '%s' \"$payload_resp\" | jq -r '.choices[0].message.content // \"\"' 2>/dev/null | tr '\\n' ' '); " +
        "  local otok=$(printf '%s' \"$payload_resp\" | jq -r '.usage.completion_tokens // 0' 2>/dev/null); " +
        "  local kw=$(awk -F'\\t' -v i=\"$idx\" '$1==i {print $2; exit}' " + shq(kw_path) + "); " +
        "  local low=$(printf '%s' \"$ans\" | tr 'A-Z' 'a-z'); " +
        "  local kwl=$(printf '%s' \"$kw\" | tr 'A-Z' 'a-z'); " +
        "  local correct=0; " +
        "  if [ -n \"$kwl\" ] && printf '%s' \"$low\" | grep -qF \"$kwl\"; then correct=1; fi; " +
        "  printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \"$phase\" \"$t0\" \"$t1\" \"$wall_ms\" \"$http_code\" \"$otok\" \"$correct\" >> " + shq(shard) + "; " +
        "}; export -f _dispatch_one; "

    // Arrival generator — produces "<phase> <idx>" lines at target rate.
    // For target_rate_qps R: inter-arrival ~ 1/R seconds. We use a fixed
    // tick (no jitter) — Poisson would be more realistic but `sleep`
    // resolution on macOS isn't sub-millisecond reliable, and the queue
    // statistics under continuous batching dominate the arrival jitter.
    // duration_sec is WARMUP + MEASURE; loop fires n = R * duration arrivals.
    let total_sec = WARMUP_SEC + MEASURE_SEC
    let total_n = target_rate_qps * total_sec
    let warmup_n = target_rate_qps * WARMUP_SEC

    // Concurrency cap (xargs -P) — generous so the harness isn't the bottleneck.
    let mut concurrency = np * 4
    if concurrency < 16 { concurrency = 16 }
    if concurrency > 64 { concurrency = 64 }

    // sleep_us per tick. macOS sleep accepts decimal seconds.
    // We use `sleep $(awk -v r=R 'BEGIN{printf "%.4f", 1/r}')` per tick.
    let gen =
        "tick_s=$(awk -v r=" + str(target_rate_qps) + " 'BEGIN{printf \"%.4f\", 1.0/r}'); " +
        "i=0; while [ $i -lt " + str(total_n) + " ]; do " +
        "  if [ $i -lt " + str(warmup_n) + " ]; then phase=warmup; else phase=measure; fi; " +
        "  idx=$(( (i % " + str(manifest_n) + ") + 1 )); " +
        "  printf '%s %s\\n' \"$phase\" \"$idx\"; " +
        "  sleep $tick_s; " +
        "  i=$((i+1)); " +
        "done"

    // xargs reads "phase idx" pairs, spawns _dispatch_one in parallel.
    let cmd = body +
              "(" + gen + ") | xargs -n 2 -P " + str(concurrency) +
              " bash -c '_dispatch_one \"$0\" \"$1\"'"

    exec(cmd)

    // Roll up measure-phase rows
    let roll =
        "awk -F'\\t' 'NR>1 && $1==\"measure\" { " +
        "  n++; " +
        "  if ($5 ~ /^2/) { ok++; } else { err++; } " +
        "  if ($7==\"1\") corr++; " +
        "} END { printf \"%d\\t%d\\t%d\\t%d\", n, ok, err, corr }' " + shq(shard)
    return exec(roll).trim()
}

// Compute percentile from shard's measure rows. Returns wall_ms at quantile.
// q is 0..10000 (i.e., q=5000 = p50, q=9990 = p99, q=9999 = p999).
fn percentile_ms(np: int, target_rate_qps: int, q_x10000: int) -> int {
    let shard = SHARD_DIR + "/" + str(np) + "_" + str(target_rate_qps) + ".tsv"
    // pull successful-measure wall_ms, sort numerically, index by quantile
    let cmd = "awk -F'\\t' 'NR>1 && $1==\"measure\" && $5 ~ /^2/ {print $4}' " + shq(shard) +
              " | sort -n | awk -v q=" + str(q_x10000) +
              " 'BEGIN{n=0} {a[++n]=$1} END{ " +
              "  if (n==0) {print -1; exit} " +
              "  idx=int(n*q/10000); if (idx<1) idx=1; if (idx>n) idx=n; " +
              "  print a[idx] " +
              "}'"
    let out = exec(cmd).trim()
    if out.len() == 0 { return -1 }
    return int(out)
}

fn main() {
    println("========================================================================")
    println("  bench/sandbox_stage4_slo_under_load")
    println("  model:    " + MODEL_NAME)
    println("  surface:  llama-server -np N -cb on " + SERVER_URL)
    println("  manifest: " + MANIFEST_PATH + " (N=2000, stratified wc[5..200])")
    println("  grid:     np ∈ {1,2,4} × rate_qps ∈ {5,20,100} = 9 cells")
    println("  M1.OPS:   SLO under-load harness (script-only commit, no exec)")
    println("========================================================================")

    exec("mkdir -p " + shq(OUT_DIR))
    let tsv_path = OUT_DIR + "/stage4_slo_under_load.tsv"
    exec("rm -f " + shq(tsv_path))
    exec("printf '%s\\n' " +
         shq("np\ttarget_rate_qps\tn_total_arrivals\tn_completed\tn_errors\tn_correct\tp50_ms\tp95_ms\tp99_ms\tp999_ms\tthroughput_qps\terror_rate\taccuracy") +
         " >> " + shq(tsv_path))

    // Pre-flight: stage payloads + keyword table
    let manifest_n = stage_payloads()
    println("  staged_payloads=" + str(manifest_n))
    if manifest_n < 100 {
        println("  ! manifest too small or missing — abort")
        exit(2)
    }
    let kw_path = stage_keywords()
    println("  staged_keywords=" + kw_path)

    // Grid definition — literal table per task spec
    let grid = [
        [1,   5],
        [1,  20],
        [1, 100],
        [2,   5],
        [2,  20],
        [2, 100],
        [4,   5],
        [4,  20],
        [4, 100],
    ]

    let mut cells_run = 0
    let mut gi = 0
    while gi < len(grid) {
        let cell = grid[gi]
        let np = int(cell[0])
        let rate = int(cell[1])
        println("")
        println("  --- cell np=" + str(np) + " rate=" + str(rate) + "qps ---")

        let boot = boot_server(np)
        if boot != "ok" {
            println("  ! boot failed: " + boot + " — skipping cell")
            let row = str(np) + "\t" + str(rate) + "\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA"
            exec("echo " + shq(row) + " >> " + shq(tsv_path))
            kill_server()
            gi = gi + 1
            continue
        }

        let totals = drive_cell(np, rate, manifest_n, kw_path)
        let parts = totals.split("\t")
        let mut n_total = 0
        let mut n_done  = 0
        let mut n_err   = 0
        let mut n_corr  = 0
        if parts.len() >= 4 {
            n_total = int(parts[0])
            n_done  = int(parts[1])
            n_err   = int(parts[2])
            n_corr  = int(parts[3])
        }

        let p50  = percentile_ms(np, rate, 5000)
        let p95  = percentile_ms(np, rate, 9500)
        let p99  = percentile_ms(np, rate, 9900)
        // p999 honesty gate: only meaningful if n_done >= MIN_FOR_P999
        let mut p999_str = "NA"
        if n_done >= MIN_FOR_P999 {
            let p999 = percentile_ms(np, rate, 9990)
            p999_str = str(p999)
        }

        // throughput = n_done / MEASURE_SEC
        let throughput_x100 = (n_done * 100) / MEASURE_SEC
        let throughput_str = str(throughput_x100 / 100) + "." +
                             (if (throughput_x100 % 100) < 10 { "0" } else { "" }) +
                             str(throughput_x100 % 100)

        // error_rate = n_err / n_total (x10000 for 2dp percent)
        let mut error_rate_x10000 = 0
        if n_total > 0 { error_rate_x10000 = (n_err * 10000) / n_total }
        let error_rate_str = str(error_rate_x10000 / 100) + "." +
                             (if (error_rate_x10000 % 100) < 10 { "0" } else { "" }) +
                             str(error_rate_x10000 % 100)

        // accuracy = n_corr / n_done
        let mut acc_x10000 = 0
        if n_done > 0 { acc_x10000 = (n_corr * 10000) / n_done }
        let acc_str = str(acc_x10000 / 100) + "." +
                      (if (acc_x10000 % 100) < 10 { "0" } else { "" }) +
                      str(acc_x10000 % 100)

        println("  n_total=" + str(n_total) + " n_done=" + str(n_done) +
                " n_err=" + str(n_err) + " n_correct=" + str(n_corr))
        println("  p50=" + str(p50) + "ms p95=" + str(p95) + "ms p99=" + str(p99) + "ms p999=" + p999_str + "ms")
        println("  throughput=" + throughput_str + " qps  error_rate=" + error_rate_str + "%  accuracy=" + acc_str + "%")

        let row = str(np) + "\t" + str(rate) + "\t" + str(n_total) + "\t" + str(n_done) +
                  "\t" + str(n_err) + "\t" + str(n_corr) +
                  "\t" + str(p50) + "\t" + str(p95) + "\t" + str(p99) + "\t" + p999_str +
                  "\t" + throughput_str + "\t" + error_rate_str + "\t" + acc_str
        exec("echo " + shq(row) + " >> " + shq(tsv_path))

        kill_server()
        exec("sleep 1")
        cells_run = cells_run + 1
        gi = gi + 1
    }

    println("")
    println("========================================================================")
    println("  SUMMARY — Stage 4 SLO under load")
    println("  cells_run = " + str(cells_run) + "/9")
    println("========================================================================")

    // Persist summary (RUN-TIME version — replaces the placeholder)
    let sp = OUT_DIR + "/stage4_slo_under_load_summary.txt"
    exec("rm -f " + shq(sp))
    exec("echo " + shq("# status=executed") + " >> " + shq(sp))
    exec("echo " + shq("# model=" + MODEL_NAME) + " >> " + shq(sp))
    exec("echo " + shq("# host=mac-mini-m3 (brew llama.cpp + Metal)") + " >> " + shq(sp))
    exec("echo " + shq("# llama_server_port=" + SERVER_PORT) + " >> " + shq(sp))
    exec("echo " + shq("# manifest=" + MANIFEST_PATH + " (N=" + str(manifest_n) + ")") + " >> " + shq(sp))
    exec("echo " + shq("# np_grid={1,2,4}") + " >> " + shq(sp))
    exec("echo " + shq("# rate_grid_qps={5,20,100}") + " >> " + shq(sp))
    exec("echo " + shq("# cells_total=9") + " >> " + shq(sp))
    exec("echo " + shq("# cells_run=" + str(cells_run)) + " >> " + shq(sp))
    exec("echo " + shq("# warmup_sec=" + str(WARMUP_SEC)) + " >> " + shq(sp))
    exec("echo " + shq("# measure_sec=" + str(MEASURE_SEC)) + " >> " + shq(sp))
    exec("echo " + shq("# p999_min_n=" + str(MIN_FOR_P999)) + " >> " + shq(sp))
    exec("echo " + shq("# np_8_skipped=cycle-6 d_continuous_batching_server found np=8 is 27.9% slower than np=4 (UMA mem-bw saturation, 16GB ceiling); sustained-load run at np=8 would OOM/thrash") + " >> " + shq(sp))

    // teardown
    kill_server()
    exec("rm -rf " + shq(PAYLOAD_DIR) + " " + shq(SHARD_DIR) + " " + shq(SLOT_DIR))
    exec("rm -f " + kw_path)

    println("  tsv     persisted: " + tsv_path)
    println("  summary persisted: " + sp)
    println("")
    println("__HEXA_CODEX_BENCH_SANDBOX_STAGE4_SLO_UNDER_LOAD__ PASS")
    exit(0)
}
