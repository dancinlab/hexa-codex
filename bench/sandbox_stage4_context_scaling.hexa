#!hexa strict
// bench/sandbox_stage4_context_scaling.hexa — SANDBOX Stage 4: F-CODEX-2
// context-grid bench harness (HARNESS ONLY — NO EXEC in this commit).
//
// CONTEXT (.discoveries/sandbox.tape `d_context_scaling_bench`, cross-cut ECONOMICS+OPS):
//   ECONOMICS v1.3.0 release-gate (per ECONOMICS.md §M5.ECON, cycle-11
//   f4d6585) is currently 🟠 0/4 — F-CODEX-2 (inference_cost ∝ context^τ,
//   τ=4 on the n=6 lattice) has zero empirical context-rung data. The
//   M3.ECON harness `verify/numerics_economics_empirical_landing.hexa`
//   (cycle-9 843b241) ships `LATENCY_MS_PENDING = [-1.0, -1.0, -1.0, -1.0]`
//   for the 4-row CONTEXT_GRID `{1024, 2048, 4096, 8192}` and check 9
//   (`check_f_codex_2_residual`) records DEFERRED with `f_codex_2_residual()`
//   returning NAN_SLOPE. THIS bench produces those 4 wall_ms numbers.
//
// QUESTION:
//   Does measured inference wall_ms scale as `context^τ` with τ ≈ 4 on
//   the SANDBOX substrate at the {1k, 2k, 4k, 8k} grid points? The
//   F-CODEX-2 falsifier predicts τ = 4; honest failure modes include
//   sub-quartic (τ ≈ 2, paged-attention era, modern KV-cache scheduler
//   dominates) and super-quartic (τ > 5, KV-cache fragmentation or
//   attention recomputation under context overflow).
//
// METHOD (4 cells, one per context rung):
//   For each context_len in CONTEXT_GRID:
//     1. boot `llama-server -m <model> --host 127.0.0.1 --port 8091
//        -np 1 -cb --log-disable -c <ctx_max>`  (port 8091 — distinct
//        from sibling benches at 8081/8082/8083/8088/8090)
//     2. poll /health until 200 (~3-4s warmup)
//     3. build a deterministic boilerplate prefix calibrated to
//        target_token_count = context_len (using a 50-word repeating
//        unit; word-count × 1.3 ≈ tokens for Qwen2.5 BPE)
//     4. for each of 20 canonical suffix-tasks (verbatim from
//        `bench/sandbox_stage0_baseline.hexa`):
//          - POST /v1/chat/completions with system=prefix, user=suffix
//          - bracket the curl with `date +%s%N` (enqueue → complete)
//          - parse response: choices[0].message.content,
//            usage.prompt_tokens, usage.completion_tokens,
//            timings.predicted_ms, timings.prompt_ms
//          - score answer against the task's expected_kw (byte_exact_subset)
//     5. kill server (SIGTERM, then SIGKILL after 2s); rm payload dir
//
// GRID CELLS (4 total — verbatim mirror of
// verify/numerics_economics_empirical_landing.hexa L211–216 CONTEXT_GRID):
//
//   context_len ∈ {1024, 2048, 4096, 8192}
//
//   Per rung output: context_len · n_correct/20 · mean_wall_ms ·
//                    total_wall_ms · mean_input_tokens · throughput_tok_per_s
//
// HARNESS DISPATCHER:
//   Each request fires via a `dispatch_one` shell helper that brackets
//   the curl POST with `date +%s%N` (enqueue_ns, complete_ns), parses
//   the JSON for input_tokens / output_tokens / correctness, and returns
//   a 4-tuple TSV line: input_tokens \t output_tokens \t wall_ms \t correct.
//   Serial dispatch (np=1) — context-scaling claim isolates per-request
//   wall as a function of context only, NOT concurrency interleaving.
//
// PREFIX CALIBRATION:
//   `build_calibrated_prefix(target_token_count)` generates a fixed
//   boilerplate string repeated N times to approximate the target token
//   count. Token approximation: words × 1.3 (empirical Qwen2.5 BPE ratio
//   on English boilerplate). The harness records the ACTUAL prompt_tokens
//   from the server response in the TSV — the F-CODEX-2 fit uses the
//   measured input_tokens, NOT the target. This keeps the closed-form
//   recompute honest even if calibration drifts by ±10%.
//
// HONESTY GATES:
//   - server killed between cells (clean -c context-budget state per cell)
//   - mean_input_tokens reported alongside target — fit consumer uses
//     measured input_tokens, not nominal context_len, so calibration
//     drift surfaces as data not bias
//   - accuracy reported per rung; if accuracy collapses at long context
//     (e.g. 0/20 at 8k because Qwen2.5-1.5B forgets the suffix instruction
//     buried after 8k tokens of boilerplate) the latency claim still
//     stands but the consumer (M3.ECON harness) MUST disclose the
//     accuracy floor — the F-CODEX-2 fit measures wall_ms scaling,
//     accuracy is a side-channel honesty signal
//   - 8k rung MAY OOM or refuse boot on 16GB UMA mac-mini M3 — recorded
//     as UNAVAILABLE row (no extrapolation), v1.3.0 gate then closes at
//     k=3 PARTIAL instead of k=4 GREEN
//
// Output:
//   .verdicts/sandbox/stage4_context_scaling.tsv          (1 row per rung)
//   .verdicts/sandbox/stage4_context_scaling_summary.txt  (run-time filled)
//
// Run (LATER — this commit ships harness only, no exec):
//   HEXA_SHIM_NO_DARWIN_LANDING=1 RESOURCE_LOCAL_HEXA=1 \
//     HEXA_CODEX_ROOT="$PWD" \
//     ~/.hx/packages/hexa/hexa.real run bench/sandbox_stage4_context_scaling.hexa
//
// Next consumer:
//   verify/numerics_economics_empirical_landing.hexa LATENCY_MS_PENDING
//   array (cycle-9 843b241) — populate the 4 entries from this bench's
//   .verdicts/sandbox/stage4_context_scaling.tsv mean_wall_ms column,
//   then re-run the harness; check 9 flips from DEFERRED to either
//   GREEN (residual ≤ 0.10) or FALSIFIED (residual > 0.10).
//
// @no-lock-needed
// @resolver-bypass(reason="External HTTP subprocess (curl → llama-server) + filesystem write — no atlas atoms touched.")

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()
let OUT_DIR = ROOT + "/.verdicts/sandbox"
// Base model: same as cycle-9 M2.SUBSTRATE (Qwen2.5-1.5B-Instruct-Q4_K_M)
// per cycle-11 d_context_scaling_bench candidate spec — smaller model =
// faster context-grid sweep; does NOT need 7B for cost-curve fit since
// F-CODEX-2 isolates context-axis scaling at fixed N.
let MODEL_PATH = HOME + "/Models/gguf/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf"
let MODEL_NAME = "Qwen2.5-1.5B-Instruct-Q4_K_M"
let SERVER_HOST = "127.0.0.1"
let SERVER_PORT = "8091"
let SERVER_URL  = "http://127.0.0.1:8091"
let MAX_TOK = 64
let PAYLOAD_DIR  = "/tmp/sandbox_stage4_ctx_payloads"
let RESP_DIR     = "/tmp/sandbox_stage4_ctx_responses"
let PREFIX_DIR   = "/tmp/sandbox_stage4_ctx_prefixes"
let SERVER_LOG   = "/tmp/sandbox_stage4_ctx_server.log"
let SERVER_PIDF  = "/tmp/sandbox_stage4_ctx_server.pid"

// ── CONTEXT_GRID — verbatim mirror of
// verify/numerics_economics_empirical_landing.hexa L211–216 ───────────────
//
// {1024, 2048, 4096, 8192} tokens. The 8192 entry is the CTX_REF anchor
// in verify/numerics_economics_scaling_laws.hexa; CHANGING ANY OF THESE
// breaks the F-CODEX-2 harness contract — the closed-form OLS slope
// expects these exact x-axis values.
let CONTEXT_GRID = [
    1024,    // 1k
    2048,    // 2k
    4096,    // 4k
    8192,    // 8k   ← CTX_REF anchor in scaling_laws.hexa
]

// Server -c budget per cell: ceil(context_len * 1.25) to leave headroom
// for the suffix-task tokens + max_tokens output on top of the prefix.
fn ctx_budget_for(context_len: int) -> int {
    return (context_len * 5) / 4
}

// Canonical 20-task manifest — verbatim parity with Stage 0/1/3/4 benches.
let TASKS = [
    ["What is 2+2? Reply with the digit only.",                                                    "4"],
    ["Capital of France? One word.",                                                                "paris"],
    ["Reverse the string 'hello'. Reply with the reversed string only.",                            "olleh"],
    ["Square of 7? Reply with the number only.",                                                    "49"],
    ["First prime number greater than 10? Reply with the number only.",                             "11"],
    ["Smallest prime number? Reply with the number only.",                                          "2"],
    ["How many continents? Reply with the number only.",                                            "7"],
    ["Boiling point of water in Celsius at sea level? Reply with the number only.",                 "100"],
    ["ASCII decimal code for 'A'? Reply with the number only.",                                     "65"],
    ["Days in February 2024? Reply with the number only.",                                          "29"],
    ["Write a Python one-liner that sums integers 1..100. Reply with code only.",                   "sum(range"],
    ["Time complexity of binary search? Reply with big-O only.",                                    "log n"],
    ["Python: reverse a list lst in one expression. Reply with the expression only.",               "[::-1]"],
    ["Sort {3,1,2} ascending. Reply with the result only.",                                         "1, 2, 3"],
    ["TCP vs UDP in one sentence — which is connection-oriented?",                                  "tcp"],
    ["Explain BFS vs DFS in 2 sentences.",                                                          "breadth"],
    ["Write Python Fibonacci with memoization (use functools.cache).",                              "fib"],
    ["Convert binary 1101 to decimal, show one-line sum.",                                          "13"],
    ["Why is mergesort O(n log n)? One-sentence justification.",                                    "merge"],
    ["Halting problem — what is it? One sentence.",                                                  "halt"],
]

// 50-word boilerplate unit (~65 tokens per Qwen2.5 BPE on English prose).
// Deterministic, fixed — re-runs build identical prefixes for identical
// target_token_count, preserving the "deterministic re-runs" honesty gate
// (SANDBOX.md §"Honesty rules").
let BOILERPLATE_UNIT = "The quick brown fox jumps over the lazy dog near the riverbank where the willows bend and sway in the morning breeze. " +
                       "Sunlight filters through the leaves and dapples the stones along the path that winds beside the slow-moving water. " +
                       "Birds call from the branches above as the day begins anew. "

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn json_escape(s: str) -> str {
    let mut t = s.replace("\\", "\\\\")
    t = t.replace("\"", "\\\"")
    t = t.replace("\n", "\\n")
    t = t.replace("\r", "\\r")
    t = t.replace("\t", "\\t")
    return t
}

// Build a calibrated boilerplate prefix of approximately target_token_count
// tokens, using BOILERPLATE_UNIT (~50 words ≈ 65 tokens for Qwen2.5 BPE).
// Approximation: word_count × 1.3 ≈ token_count. Returns the prefix string.
// The ACTUAL token count is recorded from the server response in the TSV
// (usage.prompt_tokens) — calibration drift surfaces as data, not bias.
fn build_calibrated_prefix(target_token_count: int) -> str {
    // 50 words/unit × 1.3 tok/word ≈ 65 tok/unit; need
    // n_units = ceil(target_token_count / 65). Round up to safely
    // overshoot the target; the M3.ECON consumer reads the actual
    // measured prompt_tokens, so a slight overshoot is honest.
    let mut n_units = target_token_count / 65
    if n_units * 65 < target_token_count { n_units = n_units + 1 }
    if n_units < 1 { n_units = 1 }
    let mut prefix = ""
    let mut i = 0
    while i < n_units {
        prefix = prefix + BOILERPLATE_UNIT
        i = i + 1
    }
    return prefix
}

// Kill any stale server on our port + remove pidfile. Idempotent.
fn kill_server() {
    exec("if [ -f " + shq(SERVER_PIDF) + " ]; then " +
         "  pid=$(cat " + shq(SERVER_PIDF) + " 2>/dev/null); " +
         "  if [ -n \"$pid\" ] && kill -0 $pid 2>/dev/null; then " +
         "    kill -TERM $pid 2>/dev/null; sleep 1; " +
         "    if kill -0 $pid 2>/dev/null; then kill -KILL $pid 2>/dev/null; fi; " +
         "  fi; " +
         "  rm -f " + shq(SERVER_PIDF) + "; " +
         "fi; " +
         "for p in $(lsof -iTCP:" + SERVER_PORT + " -sTCP:LISTEN -t 2>/dev/null); do " +
         "  kill -TERM $p 2>/dev/null; sleep 1; kill -KILL $p 2>/dev/null; " +
         "done; " +
         "true")
}

// Boot llama-server with the given -c context budget. Returns "ok" or
// "fail:<reason>". Double-fork nohup pattern per cycle-6/cycle-8 SLO
// harness: the hexa exec() subshell propagates SIGHUP otherwise.
fn boot_server(ctx_budget: int) -> str {
    kill_server()
    exec("sleep 1")
    let inner = "nohup llama-server -m " + shq(MODEL_PATH) +
                " --host " + SERVER_HOST + " --port " + SERVER_PORT +
                " -np 1 -cb --log-disable " +
                " -c " + str(ctx_budget) +
                " > " + shq(SERVER_LOG) + " 2>&1 < /dev/null " +
                " & echo $! > " + shq(SERVER_PIDF)
    let launch = "( " + inner + " ) &"
    exec("/bin/sh -c " + shq(launch))
    exec("for i in 1 2 3 4 5; do [ -s " + shq(SERVER_PIDF) + " ] && break; sleep 1; done")
    let pid = exec("cat " + shq(SERVER_PIDF) + " 2>/dev/null").trim()
    if pid.len() == 0 {
        return "fail:no_pid"
    }
    let probe = "for i in $(seq 1 60); do " +
                "  code=$(curl -s -o /dev/null -w '%{http_code}' " + SERVER_URL + "/health 2>/dev/null); " +
                "  if [ \"$code\" = \"200\" ]; then echo READY; exit 0; fi; " +
                "  if ! kill -0 " + pid + " 2>/dev/null; then echo DIED; exit 1; fi; " +
                "  sleep 0.5; " +
                "done; echo TIMEOUT; exit 1"
    let r = exec(probe).trim()
    if r.contains("READY") { return "ok" }
    if r.contains("DIED")  { return "fail:server_died" }
    return "fail:health_timeout"
}

// Stage per-task payloads for one context cell. The prefix lands in the
// "system" role; the suffix-task lands in the "user" role. Writes one
// JSON file per task at PAYLOAD_DIR/<idx>.json (idx 0..19).
fn stage_payloads(prefix: str) {
    exec("rm -rf " + shq(PAYLOAD_DIR) + "; mkdir -p " + shq(PAYLOAD_DIR))
    let prefix_j = json_escape(prefix)
    let mut i = 0
    while i < len(TASKS) {
        let suffix_j = json_escape(TASKS[i][0])
        let body = "{\"messages\":[" +
                   "{\"role\":\"system\",\"content\":\"" + prefix_j + "\"}," +
                   "{\"role\":\"user\",\"content\":\"" + suffix_j + "\"}" +
                   "],\"max_tokens\":" + str(MAX_TOK) +
                   ",\"temperature\":0}"
        let path = PAYLOAD_DIR + "/" + str(i) + ".json"
        exec("printf '%s' " + shq(body) + " > " + shq(path))
        i = i + 1
    }
}

// Dispatch one task — POST /v1/chat/completions, bracket with date +%s%N,
// parse the JSON response. Returns tab-separated:
//   input_tokens \t output_tokens \t wall_ms \t correct
// (correct ∈ {"0", "1"} from byte_exact_subset on lowercased ans vs kw.)
fn dispatch_one(idx: int, expected_kw: str, port: int) -> str {
    let payload = PAYLOAD_DIR + "/" + str(idx) + ".json"
    let resp    = RESP_DIR + "/" + str(idx) + ".json"
    let cmd =
        "t0=$(date +%s%N); " +
        "curl -s --max-time 120 -o " + shq(resp) +
        " -X POST http://" + SERVER_HOST + ":" + str(port) + "/v1/chat/completions " +
        " -H 'Content-Type: application/json' --data-binary @" + shq(payload) + "; " +
        "t1=$(date +%s%N); " +
        "wall_ms=$(( (t1 - t0) / 1000000 )); " +
        "if [ ! -s " + shq(resp) + " ]; then " +
        "  printf '%s' '0\\t0\\t' $wall_ms '\\t0'; exit 0; fi; " +
        "ans=$(jq -r '.choices[0].message.content // \"\"' < " + shq(resp) +
        " 2>/dev/null | tr '\\n' ' ' | sed 's/  */ /g; s/^ //; s/ $//'); " +
        "in_tok=$(jq -r '.usage.prompt_tokens // 0' < " + shq(resp) + " 2>/dev/null); " +
        "out_tok=$(jq -r '.usage.completion_tokens // 0' < " + shq(resp) + " 2>/dev/null); " +
        "low=$(printf '%s' \"$ans\" | tr 'A-Z' 'a-z'); " +
        "kw=$(printf '%s' " + shq(expected_kw) + " | tr 'A-Z' 'a-z'); " +
        "if [ -n \"$kw\" ] && printf '%s' \"$low\" | grep -qF \"$kw\"; then correct=1; else correct=0; fi; " +
        "printf '%s\\t%s\\t%s\\t%s' \"$in_tok\" \"$out_tok\" \"$wall_ms\" \"$correct\""
    return exec(cmd).trim()
}

// Drive one context-rung. Boots server at appropriate -c budget, stages
// payloads with the calibrated prefix, runs 20 fixed-suffix tasks serially
// (np=1, no concurrency — context-axis claim isolates per-request wall),
// returns tab-separated rung row:
//   context_len \t n_correct \t mean_wall_ms \t total_wall_ms \t
//   mean_input_tokens \t throughput_tok_per_s_int_x100
fn context_grid_run(context_len: int, port: int) -> str {
    let ctx_budget = ctx_budget_for(context_len)
    let boot = boot_server(ctx_budget)
    if boot != "ok" {
        return str(context_len) + "\t-1\t-1\t-1\t-1\t-1"
    }
    let prefix = build_calibrated_prefix(context_len)
    stage_payloads(prefix)
    exec("rm -rf " + shq(RESP_DIR) + "; mkdir -p " + shq(RESP_DIR))

    let mut n_correct = 0
    let mut sum_wall_ms = 0
    let mut sum_input_tok = 0
    let mut sum_output_tok = 0
    let k = len(TASKS)
    let mut i = 0
    while i < k {
        let expected = TASKS[i][1]
        let line = dispatch_one(i, expected, port)
        let parts = line.split("\t")
        let mut in_tok = 0
        let mut out_tok = 0
        let mut wall_ms = 0
        let mut correct = "0"
        if parts.len() >= 4 {
            in_tok = int(parts[0])
            out_tok = int(parts[1])
            wall_ms = int(parts[2])
            correct = parts[3]
        }
        sum_wall_ms = sum_wall_ms + wall_ms
        sum_input_tok = sum_input_tok + in_tok
        sum_output_tok = sum_output_tok + out_tok
        if correct == "1" { n_correct = n_correct + 1 }
        i = i + 1
    }
    let mut mean_wall = 0
    let mut mean_in_tok = 0
    if k > 0 {
        mean_wall = sum_wall_ms / k
        mean_in_tok = sum_input_tok / k
    }
    // throughput_tok_per_s × 100 (avoid floats): tokens / seconds × 100.
    // total_decode_tokens = sum_output_tok; total_seconds = sum_wall_ms / 1000.
    // throughput_x100 = (sum_output_tok * 100 * 1000) / sum_wall_ms
    let mut throughput_x100 = 0
    if sum_wall_ms > 0 {
        throughput_x100 = (sum_output_tok * 100000) / sum_wall_ms
    }
    return str(context_len) + "\t" + str(n_correct) +
           "\t" + str(mean_wall) + "\t" + str(sum_wall_ms) +
           "\t" + str(mean_in_tok) + "\t" + str(throughput_x100)
}

fn render_throughput(x100: int) -> str {
    let whole = x100 / 100
    let frac = x100 % 100
    let mut frac_str = str(frac)
    if frac < 10 { frac_str = "0" + frac_str }
    return str(whole) + "." + frac_str
}

fn main() {
    println("========================================================================")
    println("  bench/sandbox_stage4_context_scaling")
    println("  model:    " + MODEL_NAME)
    println("  surface:  llama-server -np 1 -cb on " + SERVER_URL)
    println("  manifest: 20 canonical tasks × 4 context rungs {1k,2k,4k,8k}")
    println("  consumer: verify/numerics_economics_empirical_landing.hexa")
    println("            LATENCY_MS_PENDING array (cycle-9 843b241)")
    println("  gate:     M5.ECON v1.3.0 F-CODEX-2 (currently 🟠 0/4)")
    println("========================================================================")

    exec("mkdir -p " + shq(OUT_DIR))
    let tsv_path = OUT_DIR + "/stage4_context_scaling.tsv"
    exec("rm -f " + shq(tsv_path))
    exec("printf '%s\\n' " +
         shq("context_len\tn_correct\ttotal\tmean_wall_ms\ttotal_wall_ms\tmean_input_tokens\tthroughput_tok_per_s") +
         " >> " + shq(tsv_path))

    // ── LITERAL grid table per task spec ─────────────────────────────────
    //
    //   context_len ∈ {1024, 2048, 4096, 8192}
    //   port:        8091 (distinct from 8081/8082/8083/8088/8090)
    //   base_model:  Qwen2.5-1.5B-Instruct-Q4_K_M (cycle-9 M2.SUBSTRATE)
    //   cells_total: 4
    //
    let grid = [
        1024,
        2048,
        4096,
        8192,
    ]

    let mut rung_lens   = []
    let mut rung_correct = []
    let mut rung_mean_wall = []
    let mut rung_total_wall = []
    let mut rung_mean_in_tok = []
    let mut rung_tps_x100 = []

    let mut gi = 0
    while gi < len(grid) {
        let context_len = int(grid[gi])
        println("")
        println("  --- rung context_len=" + str(context_len) + " (ctx_budget=" + str(ctx_budget_for(context_len)) + ") ---")
        let port = int(SERVER_PORT)
        let row = context_grid_run(context_len, port)
        let parts = row.split("\t")
        let mut n_correct = -1
        let mut mean_wall = -1
        let mut total_wall = -1
        let mut mean_in_tok = -1
        let mut tps_x100 = -1
        if parts.len() >= 6 {
            n_correct = int(parts[1])
            mean_wall = int(parts[2])
            total_wall = int(parts[3])
            mean_in_tok = int(parts[4])
            tps_x100 = int(parts[5])
        }
        println("  n_correct=" + str(n_correct) + "/" + str(len(TASKS)) +
                "  mean_wall_ms=" + str(mean_wall) +
                "  total_wall_ms=" + str(total_wall) +
                "  mean_input_tokens=" + str(mean_in_tok) +
                "  throughput_tok_per_s=" + render_throughput(tps_x100))
        let tsv_row = str(context_len) + "\t" + str(n_correct) + "\t" + str(len(TASKS)) +
                      "\t" + str(mean_wall) + "\t" + str(total_wall) +
                      "\t" + str(mean_in_tok) + "\t" + render_throughput(tps_x100)
        exec("echo " + shq(tsv_row) + " >> " + shq(tsv_path))

        rung_lens         = rung_lens         + [context_len]
        rung_correct      = rung_correct      + [n_correct]
        rung_mean_wall    = rung_mean_wall    + [mean_wall]
        rung_total_wall   = rung_total_wall   + [total_wall]
        rung_mean_in_tok  = rung_mean_in_tok  + [mean_in_tok]
        rung_tps_x100     = rung_tps_x100     + [tps_x100]

        kill_server()
        exec("sleep 1")
        gi = gi + 1
    }

    // ── summary text — RUN-TIME version (replaces the placeholder) ──────
    println("")
    println("========================================================================")
    println("  SUMMARY — Stage 4 context scaling")
    println("========================================================================")
    let mut si = 0
    while si < len(rung_lens) {
        println("  ctx=" + str(rung_lens[si]) +
                "  n_correct=" + str(rung_correct[si]) + "/20" +
                "  mean_wall_ms=" + str(rung_mean_wall[si]) +
                "  mean_in_tok=" + str(rung_mean_in_tok[si]) +
                "  tps=" + render_throughput(rung_tps_x100[si]))
        si = si + 1
    }

    let sp = OUT_DIR + "/stage4_context_scaling_summary.txt"
    exec("rm -f " + shq(sp))
    exec("echo " + shq("# status=executed") + " >> " + shq(sp))
    exec("echo " + shq("# llama_server_port=" + SERVER_PORT) + " >> " + shq(sp))
    exec("echo " + shq("# base_model=" + MODEL_NAME) + " >> " + shq(sp))
    exec("echo " + shq("# context_grid={1024,2048,4096,8192}") + " >> " + shq(sp))
    exec("echo " + shq("# cells_total=4") + " >> " + shq(sp))
    let mut sj = 0
    while sj < len(rung_lens) {
        exec("echo " + shq("# rung_ctx=" + str(rung_lens[sj]) +
                            "  n_correct=" + str(rung_correct[sj]) +
                            "  mean_wall_ms=" + str(rung_mean_wall[sj]) +
                            "  mean_input_tokens=" + str(rung_mean_in_tok[sj]) +
                            "  throughput_tok_per_s=" + render_throughput(rung_tps_x100[sj])) +
             " >> " + shq(sp))
        sj = sj + 1
    }
    exec("echo " + shq("# f_codex_2_predicted=4  (n=6 lattice tau)") + " >> " + shq(sp))
    exec("echo " + shq("# f_codex_2_exponent_measured=COMPUTED_BY_CONSUMER") + " >> " + shq(sp))
    exec("echo " + shq("# f_codex_2_residual=COMPUTED_BY_CONSUMER") + " >> " + shq(sp))
    exec("echo " + shq("# next_cmd=hexa.real run verify/numerics_economics_empirical_landing.hexa") + " >> " + shq(sp))
    exec("echo " + shq("# next_consumer=verify/numerics_economics_empirical_landing.hexa LATENCY_MS_PENDING array (cycle-9 843b241)") + " >> " + shq(sp))
    exec("echo " + shq("# honest_note_1=mean_input_tokens is the MEASURED prompt_tokens from server response (usage.prompt_tokens); calibration drift surfaces as data, not bias") + " >> " + shq(sp))
    exec("echo " + shq("# honest_note_2=accuracy reported per rung; if long-context accuracy collapses (e.g. 0/20 at 8k), latency claim still stands but consumer MUST disclose floor") + " >> " + shq(sp))
    exec("echo " + shq("# honest_note_3=8k rung may OOM/refuse boot on 16GB UMA mac-mini M3; UNAVAILABLE row → v1.3.0 closes at k=3 PARTIAL not k=4 GREEN") + " >> " + shq(sp))

    kill_server()
    exec("rm -rf " + shq(PAYLOAD_DIR) + " " + shq(RESP_DIR) + " " + shq(PREFIX_DIR))

    println("  tsv     persisted: " + tsv_path)
    println("  summary persisted: " + sp)
    println("")
    println("__HEXA_CODEX_BENCH_SANDBOX_STAGE4_CONTEXT_SCALING__ PASS")
    exit(0)
}
