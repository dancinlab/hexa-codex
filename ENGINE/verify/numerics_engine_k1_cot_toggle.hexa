#!hexa strict
// hexa-codex/ENGINE/verify/numerics_engine_k1_cot_toggle.hexa
// ENGINE axis K1 — falsifier verifier for the CoT-toggle scratch-pad serving wire.
//
// Asserts that cot_toggle is a faithful, deterministic decision rule that CONSUMES
// the HALLUCINATION/N1 REASONING-DEPTH finding (cot_delta × 100 pp ledger · 5pp
// scratch-pad-utility lower bound · 4 frontier load-bearing · pattern_match inert):
//   (1) decision rule identity — cot_delta < 5pp → "direct" (scratch-pad inert)
//   (2) cot_delta ≥ 5pp + complex → "thinking" (utility 활용)
//   (3) cot_delta ≥ 5pp + simple  → "direct" (간단 task 비용절감)
//   (4) FALSIFIER wire — a rule that ignores the finding (forces "thinking" on a
//       cot_delta<5pp pattern_match task) is detected as WRONG vs cot_toggle's "direct"
//   (5) determinism (re-call → identical decision)
//   (6) source-finding consistency — HALLUCINATION/N1 cot_delta (× 100): frontier
//       4400/4200/4700/4000 ≥ 500 · pattern_match 300 < 500
//   (7) decision ∈ {direct, thinking} for every test case (valid output domain)
// Any FAIL = wire contradicts the HALLUCINATION/N1 finding ⇒ ENGINE K1 FALSIFIED.
//
// SOURCE.  ENGINE/wires/wire_k1_cot_toggle.hexa (verifier replicates the decision
// rule — closed-form recompute, no import of emitted state).
// HALLUCINATION/N1 source: HALLUCINATION/verify/numerics_hallucination_n1_reasoning_depth_scratchpad.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="Pure closed-form recompute of the K1 decision rule.")

let UTILITY_THRESHOLD_x100 = 500   // 5pp scratch-pad-utility lower bound (× 100 ledger)

// HALLUCINATION/N1 cot_delta × 100 ledger (scratchpad − direct · consumed data)
let N1_COT_DELTA_x100 = [4400, 4200, 4700, 4000, 300]   // gpt5 · claude5 · gemma4 · qwen3.6 · pattern_match

fn cot_toggle(cot_delta_pp_x100: int, task_complexity: str) -> str {
    if cot_delta_pp_x100 < UTILITY_THRESHOLD_x100 { return "direct" }
    if task_complexity == "complex" { return "thinking" }
    return "direct"
}

// FALSIFIER reference — a (deliberately wrong) rule that IGNORES the finding:
// it forces "thinking" whenever the task is complex, even when cot_delta < 5pp
// (pattern_match · scratch-pad inert) — burning scratch-pad tokens for zero benefit.
fn cot_toggle_finding_ignorant(cot_delta_pp_x100: int, task_complexity: str) -> str {
    if task_complexity == "complex" { return "thinking" }
    return "direct"
}

print("hexa-codex ENGINE K1 falsifier — CoT-toggle scratch-pad serving wire (cycle-10)")
print("===============================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0

// check 1 — decision rule identity: cot_delta < 5pp → "direct" (scratch-pad inert)
checks_total = checks_total + 1
if cot_toggle(300, "complex") == "direct" &&
   cot_toggle(300, "simple") == "direct" &&
   cot_toggle(499, "complex") == "direct" {
    print("  [PASS] identity: cot_delta < 5pp (< 500) → direct (scratch-pad inert · pattern_match · 300 · 499 boundary)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] cot_delta < 5pp did not map to direct")
}

// check 2 — cot_delta ≥ 5pp + complex → "thinking" (utility 활용)
checks_total = checks_total + 1
if cot_toggle(4400, "complex") == "thinking" &&
   cot_toggle(4700, "complex") == "thinking" &&
   cot_toggle(500, "complex") == "thinking" {
    print("  [PASS] cot_delta ≥ 5pp + complex → thinking (gpt5 4400 · gemma4 4700 · 500 boundary · utility활용)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] cot_delta ≥ 5pp + complex did not map to thinking")
}

// check 3 — cot_delta ≥ 5pp + simple → "direct" (간단 task 비용절감)
checks_total = checks_total + 1
if cot_toggle(4400, "simple") == "direct" &&
   cot_toggle(4700, "simple") == "direct" &&
   cot_toggle(500, "simple") == "direct" {
    print("  [PASS] cot_delta ≥ 5pp + simple → direct (utility 존재하나 simple task 비용절감)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] cot_delta ≥ 5pp + simple did not map to direct")
}

// check 4 — FALSIFIER wire: finding-ignorant rule detected as WRONG
checks_total = checks_total + 1
let correct = cot_toggle(300, "complex")                          // "direct" (finding honored)
let ignorant = cot_toggle_finding_ignorant(300, "complex")        // "thinking" (finding ignored)
if correct == "direct" && ignorant == "thinking" && correct != ignorant {
    print("  [PASS] FALSIFIER caught: finding-ignorant rule → thinking ≠ cot_toggle → direct " +
          "(Δ3pp<5pp pattern_match MUST be direct · forcing thinking = token waste · wire honors HALLUCINATION/N1)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] falsifier wire NOT detected (correct=" + correct + " ignorant=" + ignorant + ")")
}

// check 5 — determinism (re-call → identical)
checks_total = checks_total + 1
if cot_toggle(4400, "complex") == cot_toggle(4400, "complex") &&
   cot_toggle(300, "complex") == cot_toggle(300, "complex") &&
   cot_toggle(4400, "simple") == cot_toggle(4400, "simple") {
    print("  [PASS] deterministic (re-call same decision)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] non-deterministic")
}

// check 6 — source-finding consistency: HALLUCINATION/N1 cot_delta × 100 ledger
checks_total = checks_total + 1
let EXPECT_DELTA = [4400, 4200, 4700, 4000, 300]
let mut src_ok = true
let mut m = 0
while m < N1_COT_DELTA_x100.len() {
    if N1_COT_DELTA_x100[m] != EXPECT_DELTA[m] { src_ok = false }
    m = m + 1
}
// + threshold-crossing consistency: 4 frontier ≥ 500 · pattern_match < 500
let mut frontier_above = 0
let mut f = 0
while f < 4 {
    if N1_COT_DELTA_x100[f] >= UTILITY_THRESHOLD_x100 { frontier_above = frontier_above + 1 }
    f = f + 1
}
if src_ok && frontier_above == 4 && N1_COT_DELTA_x100[4] < UTILITY_THRESHOLD_x100 {
    print("  [PASS] HALLUCINATION/N1 consumed: cot_delta × 100 = 4400·4200·4700·4000 (≥ 500 · CoT load-bearing) · pattern_match 300 (< 500 · inert) — wire ↔ finding consistent")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] HALLUCINATION/N1 cot_delta mismatch (frontier_above=" + to_string(frontier_above) + " pattern_match=" + to_string(N1_COT_DELTA_x100[4]) + ")")
}

// check 7 — decision ∈ {direct, thinking} for every test case (valid output domain)
checks_total = checks_total + 1
let CASE_DELTA = [4400, 4400, 4700, 300, 300]
let CASE_TASK  = ["complex", "simple", "complex", "complex", "simple"]
let mut domain_ok = true
let mut k = 0
while k < CASE_DELTA.len() {
    let d = cot_toggle(CASE_DELTA[k], CASE_TASK[k])
    if d != "direct" && d != "thinking" { domain_ok = false }
    k = k + 1
}
if domain_ok {
    print("  [PASS] decision ∈ {direct, thinking} for all " + to_string(CASE_DELTA.len()) + " cases (valid output domain)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] a decision escaped {direct, thinking}")
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 STRUCTURAL (decision rule 7/7) + 🟡 BY-CITATION (HALLUCINATION/N1 cot_delta finding consume · Wei 2022 CoT arXiv:2201.11903 · 5pp scratch-pad-utility lower bound) — cot_toggle wires reasoning-depth utility into a direct-vs-thinking serving toggle · task-complexity gated"
} else {
    verdict_tier = "🔴 FALSIFIED — decision rule contradicts HALLUCINATION/N1 finding (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
}
print("  " + verdict_tier)
print("")
print("ENGINE K1 finding (closed-form decision rule · cycle-10):")
print("  - cot_toggle(cot_delta_pp_x100, task_complexity) → {direct, thinking}; <5pp→direct (inert) · ≥5pp+complex→thinking · ≥5pp+simple→direct (비용절감)")
print("  - HALLUCINATION/N1 frontier Δ40-47pp (≥5pp · CoT load-bearing) → complex tasks route to THINKING (scratch-pad utility 활용)")
print("  - pattern_match Δ3pp (<5pp · scratch-pad inert) → ALWAYS direct, even on complex tasks (forcing thinking = pure token waste · no 환각 reduction)")
print("  - falsifier wire (finding-ignorant complex-always-thinking) detected — proves the rule actually honors the measurement")
print("  - honest residual: live serving CoT-toggle (lm_foundry · SANDBOX local llama-server thinking-mode switch) wiring DEFERRED to cycle-11+ T4 (cx_lab_sandbox · feedback_closure_is_physical_limit — rule close != measured close)")
print("")
print("__HEXA_CODEX_NUMERICS_ENGINE_K1__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/ENGINE/verdicts/k1_cot_toggle_verdict.txt"

let mut content = "# hexa-codex ENGINE K1 — CoT-toggle scratch-pad serving verifier (cycle-10)\n"
content = content + "# axis=ENGINE/ENGINE.md::K1 (HALLUCINATION/N1 REASONING-DEPTH finding → serving scratch-pad/CoT toggle decision rule)\n"
content = content + "# wire=ENGINE/wires/wire_k1_cot_toggle.hexa\n"
content = content + "# verifier=ENGINE/verify/numerics_engine_k1_cot_toggle.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# rule=cot_toggle(cot_delta_pp_x100, task_complexity): cot_delta<500 -> direct (scratch-pad inert); cot_delta>=500 & complex -> thinking (utility활용); cot_delta>=500 & simple -> direct (비용절감)\n"
content = content + "# source_finding=HALLUCINATION/N1 cot_delta_pp_x100 = scratchpad_x100 - direct_x100; frontier 4400/4200/4700/4000 (>= 500 · CoT load-bearing) · pattern_match 300 (< 500 · scratch-pad inert)\n"
content = content + "# threshold=500/100 = 5pp scratch-pad-utility lower bound (separates deep-reasoning regime from pattern-matching regime · HALLUCINATION/N1)\n"
content = content + "# cases=gpt5_o1[4400,complex]->thinking · gpt5_o1[4400,simple]->direct · gemma4_31b[4700,complex]->thinking · pattern_match[300,complex]->direct · pattern_match[300,simple]->direct\n"
content = content + "# falsifier=finding-ignorant rule (complex-always-thinking, ignores cot_delta) forces thinking on Δ3pp pattern_match -> detected as WRONG vs cot_toggle direct (check 4)\n"
content = content + "# external_anchor=Wei 2022 Chain-of-Thought (arXiv:2201.11903) · OpenAI o1 system card 2024 · Anthropic extended-thinking 2025 (consumed via HALLUCINATION/N1)\n"
content = content + "# task_complexity_gated=CoT thinking enabled only when scratch-pad utility >= 5pp AND task is complex · simple tasks + inert utility default to direct (cost-saving)\n"
content = content + "# honest_residual=live serving CoT-toggle wiring (lm_foundry · SANDBOX local llama-server thinking-mode switch) DEFERRED to cycle-11+ T4 (cx_lab_sandbox · feedback_closure_is_physical_limit — rule close != measured close)\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
