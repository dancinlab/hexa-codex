#!hexa strict
// hexa-codex/ENGINE/verify/numerics_engine_p1_ckpt_verify.hexa
// ENGINE axis P1 — falsifier verifier for the checkpoint-resume integrity-gate wire.
//
// Asserts that verify_resume is a faithful, deterministic decision rule that
// CONSUMES the RELIABILITY/N1 CHECKPOINT-INTEGRITY finding (integrity_pass =
// (mismatch_ppm == 0) AND (format_loss_pct_x100 < 500) · dual-falsifier):
//   (1) rule identity — mismatch_ppm > 0 → "reject" (save→load bit-exact 깨짐)
//   (2) corrupted_shard reject — 50000ppm → "reject" (RELIABILITY/N1 datum)
//   (3) safetensors~gguf_q4 accept — mismatch 0 · loss ≤ 5% → "accept" (silent OK)
//   (4) FALSIFIER wire — a rule that ignores the finding (accepts mismatch>0
//       resume · silently loads broken weights) is detected as WRONG vs "reject"
//   (5) determinism (re-call → identical decision)
//   (6) source-finding consume — RELIABILITY/N1 mismatch + loss thresholds (0 / 500)
//   (7) decision ∈ {accept, reject} for every test case (valid output domain)
// Any FAIL = wire contradicts the RELIABILITY/N1 finding ⇒ ENGINE P1 FALSIFIED.
//
// SOURCE.  ENGINE/wires/wire_p1_ckpt_verify.hexa (verifier replicates the
// decision rule — closed-form recompute, no import of emitted state).
// RELIABILITY/N1 source: RELIABILITY/verify/numerics_reliability_n1_checkpoint_integrity.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="Pure closed-form recompute of the P1 decision rule.")

let MISMATCH_REJECT_THRESHOLD_PPM = 0
let LOSS_REJECT_THRESHOLD_x100    = 500

// RELIABILITY/N1 scenario registry (mirror · 5 scenarios · integer ledger)
let SCN_NAMES    = ["safetensors", "pytorch", "gguf_q8", "gguf_q4", "corrupted_shard"]
let SCN_MISMATCH = [0, 0, 0, 0, 50000]
let SCN_LOSS     = [0, 0, 50, 320, 0]

fn verify_resume(mismatch_ppm: int, format_loss_pct_x100: int) -> str {
    if mismatch_ppm > MISMATCH_REJECT_THRESHOLD_PPM { return "reject" }
    if format_loss_pct_x100 > LOSS_REJECT_THRESHOLD_x100 { return "reject" }
    return "accept"
}

// FALSIFIER reference — a (deliberately wrong) rule that IGNORES the finding:
// it ALWAYS accepts, even when mismatch_ppm > 0 (silently resumes broken weights).
fn verify_resume_finding_ignorant(mismatch_ppm: int, format_loss_pct_x100: int) -> str {
    return "accept"
}

print("hexa-codex ENGINE P1 falsifier — checkpoint-resume integrity gate (cycle-10)")
print("============================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0

// check 1 — rule identity: mismatch_ppm > 0 → "reject"
checks_total = checks_total + 1
if verify_resume(1, 0) == "reject" &&
   verify_resume(50000, 0) == "reject" &&
   verify_resume(1000000, 0) == "reject" {
    print("  [PASS] identity: mismatch_ppm > 0 → reject (1ppm · 50000ppm · 100% mismatch · bit-exact 깨짐)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] mismatch_ppm > 0 did not map to reject")
}

// check 2 — corrupted_shard reject: RELIABILITY/N1 50000ppm → "reject"
checks_total = checks_total + 1
let cs_mismatch = SCN_MISMATCH[4]
let cs_loss = SCN_LOSS[4]
if cs_mismatch == 50000 && verify_resume(cs_mismatch, cs_loss) == "reject" {
    print("  [PASS] corrupted_shard reject: mismatch=" + to_string(cs_mismatch) +
          "ppm → reject (RELIABILITY/N1 datum · resume on broken shard blocked)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] corrupted_shard did not reject (got " + verify_resume(cs_mismatch, cs_loss) + ")")
}

// check 3 — safetensors~gguf_q4 accept: mismatch 0 · loss ≤ 5% → "accept"
checks_total = checks_total + 1
let mut accept_ok = true
let mut j = 0
while j < 4 {
    // scenarios 0..3 (safetensors, pytorch, gguf_q8, gguf_q4) are all clean accepts
    if SCN_MISMATCH[j] != 0 { accept_ok = false }
    if SCN_LOSS[j] > LOSS_REJECT_THRESHOLD_x100 { accept_ok = false }
    if verify_resume(SCN_MISMATCH[j], SCN_LOSS[j]) != "accept" { accept_ok = false }
    j = j + 1
}
if accept_ok {
    print("  [PASS] clean accepts silent: safetensors(0/0) · pytorch(0/0) · gguf_q8(0/0.5%) · gguf_q4(0/3.2%) → accept (mismatch 0 · loss ≤ 5%)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] a clean roundtrip did not accept")
}

// check 4 — FALSIFIER wire: finding-ignorant rule (accepts mismatch>0) detected WRONG
checks_total = checks_total + 1
let correct = verify_resume(50000, 0)                          // "reject" (finding honored)
let ignorant = verify_resume_finding_ignorant(50000, 0)        // "accept" (finding ignored · silent)
if correct == "reject" && ignorant == "accept" && correct != ignorant {
    print("  [PASS] FALSIFIER caught: finding-ignorant rule → accept ≠ verify_resume → reject " +
          "(mismatch 50000ppm > 0 MUST reject · wire honors RELIABILITY/N1 · no silent broken-weight resume)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] falsifier wire NOT detected (correct=" + correct + " ignorant=" + ignorant + ")")
}

// check 5 — determinism (re-call → identical)
checks_total = checks_total + 1
if verify_resume(50000, 0) == verify_resume(50000, 0) &&
   verify_resume(0, 320) == verify_resume(0, 320) &&
   verify_resume(0, 800) == verify_resume(0, 800) {
    print("  [PASS] deterministic (re-call same decision · reject + accept + loss-reject)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] non-deterministic")
}

// check 6 — source-finding consume: RELIABILITY/N1 mismatch + loss thresholds (0 / 500)
checks_total = checks_total + 1
// the wire's reject thresholds MUST equal RELIABILITY/N1's integrity identity boundaries:
//   integrity_pass = (mismatch_ppm == 0) AND (format_loss_pct_x100 < 500)
// ⇒ reject when mismatch_ppm > 0 OR format_loss_pct_x100 > 500 (≥ 500 boundary: 500 accepts, 501 rejects)
if MISMATCH_REJECT_THRESHOLD_PPM == 0 && LOSS_REJECT_THRESHOLD_x100 == 500 &&
   verify_resume(0, 500) == "accept" && verify_resume(0, 501) == "reject" {
    print("  [PASS] RELIABILITY/N1 consumed: reject iff (mismatch_ppm > 0) OR (loss_x100 > 500) " +
          "(boundary 500 accept · 501 reject · matches integrity identity)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] RELIABILITY/N1 threshold mismatch (mismatch_thr=" + to_string(MISMATCH_REJECT_THRESHOLD_PPM) +
          " loss_thr=" + to_string(LOSS_REJECT_THRESHOLD_x100) + ")")
}

// check 7 — decision ∈ {accept, reject} for every test case (valid output domain)
checks_total = checks_total + 1
let mut domain_ok = true
let mut k = 0
while k < SCN_NAMES.len() {
    let d = verify_resume(SCN_MISMATCH[k], SCN_LOSS[k])
    if d != "accept" && d != "reject" { domain_ok = false }
    k = k + 1
}
// also exercise the synthetic loss-excess (gguf_q2 8%) to confirm domain validity
let q2 = verify_resume(0, 800)
if q2 != "accept" && q2 != "reject" { domain_ok = false }
if domain_ok {
    print("  [PASS] decision ∈ {accept, reject} for all " + to_string(SCN_NAMES.len()) +
          " scenarios + synthetic gguf_q2 loss-excess (valid output domain)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] a decision escaped {accept, reject}")
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 STRUCTURAL (decision rule 7/7) + 🟡 BY-CITATION (RELIABILITY/N1 finding consume · safetensors/PyTorch/GGUF quant + ZeRO checkpoint convention) — verify_resume wires the checkpoint-integrity identity into an lm_foundry resume accept/reject gate · dual-falsifier (mismatch + format-loss)"
} else {
    verdict_tier = "🔴 FALSIFIED — decision rule contradicts RELIABILITY/N1 finding (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
}
print("  " + verdict_tier)
print("")
print("ENGINE P1 finding (closed-form decision rule · cycle-10):")
print("  - verify_resume(mismatch_ppm, format_loss_pct_x100) → {accept, reject}; mismatch>0→reject · loss_x100>500(5%)→reject · else→accept")
print("  - RELIABILITY/N1 5 scenarios: safetensors(0/0) pytorch(0/0) gguf_q8(0/0.5%) gguf_q4(0/3.2%) → accept · corrupted_shard(50000ppm) → reject")
print("  - dual falsifier consumed: (a) mismatch_ppm > 0 → resume bit-exact 깨짐 · (b) format_loss > 5% → 변환 손실 과다")
print("  - falsifier wire (finding-ignorant accept-always) detected — proves the gate actually blocks silent broken-weight resume")
print("  - honest residual: live lm_foundry ckpt-resume hook (real save→load roundtrip + llama.cpp quantize fidelity diff) DEFERRED to cycle-11+ T4 (feedback_closure_is_physical_limit — rule close ≠ measured close)")
print("")
print("__HEXA_CODEX_NUMERICS_ENGINE_P1__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/ENGINE/verdicts/p1_ckpt_verify_verdict.txt"

let mut content = "# hexa-codex ENGINE P1 — checkpoint-resume integrity-gate verifier (cycle-10)\n"
content = content + "# axis=ENGINE/ENGINE.md::P1 (RELIABILITY/N1 CHECKPOINT-INTEGRITY finding → lm_foundry checkpoint-resume auto-verify hook)\n"
content = content + "# wire=ENGINE/wires/wire_p1_ckpt_verify.hexa\n"
content = content + "# verifier=ENGINE/verify/numerics_engine_p1_ckpt_verify.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# rule=verify_resume(mismatch_ppm, format_loss_pct_x100): mismatch_ppm > 0 -> reject (resume bit-exact 깨짐); format_loss_pct_x100 > 500 (5%) -> reject (변환 손실 과다); else -> accept (무결)\n"
content = content + "# source_finding=RELIABILITY/N1 integrity_pass = (mismatch_ppm == 0) AND (format_loss_pct_x100 < 500); dual-falsifier (a) mismatch>0 · (b) loss_x100 > 500\n"
content = content + "# cases=safetensors[0ppm/0%]->accept · pytorch[0ppm/0%]->accept · gguf_q8[0ppm/0.5%]->accept · gguf_q4[0ppm/3.2%]->accept · corrupted_shard[50000ppm/0%]->reject\n"
content = content + "# falsifier=finding-ignorant rule (accept-always for mismatch>0 · silent broken-weight resume) detected as WRONG vs verify_resume reject (check 4)\n"
content = content + "# external_anchor=safetensors spec (HuggingFace) · PyTorch torch.save/load · llama.cpp GGUF quant (Q8/Q4/Q2) · ZeRO checkpoint (Rajbhandari 2020 arXiv:1910.02054) · consumed via RELIABILITY/N1\n"
content = content + "# honest_residual=live lm_foundry checkpoint-resume hook (real ckpt save→load roundtrip + llama.cpp quantize fidelity diff · mac M3 · vast.ai pod) DEFERRED to cycle-11+ T4 (feedback_closure_is_physical_limit — rule close != measured close)\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
