#!hexa strict
// bench/sandbox_multimodal_ladder.hexa — M5.SUBSTRATE multimodal CAPABILITY LADDER (cycle-20).
//
// QUESTION (M5.SUBSTRATE multimodal half, CAPABILITY-FIT):
//   The PR #59 first rung proved the substrate SERVES vision-language at $0 (stock brew
//   llama.cpp `llama-mtmd-cli`, CLIP on MTL0/UMA) and a 500M VL model cleared an EASY
//   10-item smoke 10/10 — saturated, so NO capability gradient. This bench closes the
//   capability half: does VL accuracy rise with parameter count on a HARDER,
//   difficulty-stratified image manifest that does NOT saturate at the small rung?
//
// THREE VL RUNGS (all served locally, $0 Metal, mac-mini-m3, llama-mtmd-cli):
//   rung 0  SmolVLM-500M-Instruct-Q8_0   ~0.5B total (SigLIP-Base + 360M llama, idefics3)
//   rung 1  SmolVLM2-2.2B-Instruct-Q8_0  ~2.2B total (SigLIP-SO400M + 1.7B llama, idefics3)
//   rung 2  Qwen2.5-VL-3B-Instruct-Q4_K_M ~3B  total (Qwen2.5-VL native ViT + 3B llama)
//   → real param gradient 0.5B / 2.2B / 3B (log2 span ≈ 2.58 octaves).
//   Sources (HF GGUF, mmproj paired, all load on 24GB UMA):
//     ggml-org/SmolVLM-500M-Instruct-GGUF   (~546MB)
//     ggml-org/SmolVLM2-2.2B-Instruct-GGUF  (~2.3GB)
//     ggml-org/Qwen2.5-VL-3B-Instruct-GGUF  (~3.0GB)
//
// HARDER MANIFEST (16 items, 4 difficulty-stratified axes; non-saturating by design):
//   The bench GENERATES its own images via PIL (seed-pinned, bit-reproducible) so ground
//   truth is unambiguous — no external dataset, no human label. Difficulty is dialled UP
//   vs the smoke (which capped at 4 circles / single word / single digit):
//     axis count   (5): multi-object counting, 5–9 black circles (deterministic layout)
//     axis ocr     (4): OCR of 2-word uppercase phrases (multi-word, not a single word)
//     axis spatial (4): left/right/above relation between two colored squares
//     axis shape   (3): fine color+shape discrimination (which shape is the odd one out)
//   Pre-probe confirmed non-saturation: the 500M rung MISCOUNTS 7 circles ("6") where the
//   2.2B + 3B rungs answer "7" — the count axis is the load-bearing capability gradient.
//
// SCORER is the SAME non-self-judging family as the smoke + text floor
// (bench/sandbox_multimodal_smoke.hexa / rwkv_m1_accuracy_floor.hexa): lowercase the
// answer, collapse whitespace, case-insensitive SUBSTRING match on the expected keyword.
// NO LLM judges correctness — pure byte compare. Seed-pinned greedy (--temp 0 -s 42).
//
// Output:
//   .verdicts/sandbox/m5_substrate_multimodal_ladder.tsv          (per-rung × per-item rows)
//   .verdicts/sandbox/m5_substrate_multimodal_ladder_summary.txt  (per-rung accuracy ladder)
// The per-rung accuracy TSV is the committed source-of-truth consumed by the closed-form
// capability fit: verify/numerics_substrate_multimodal_fit.hexa.
//
// Run:
//   HEXA_SHIM_NO_DARWIN_LANDING=1 RESOURCE_LOCAL_HEXA=1 \
//     HEXA_CODEX_ROOT="$PWD" \
//     ~/.hx/packages/hexa/hexa.real run bench/sandbox_multimodal_ladder.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="External CLI subprocess (llama-mtmd-cli × 3 rungs + python3 PIL image-gen) + filesystem write — no atlas atoms touched.")

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()
let OUT_DIR = ROOT + "/.verdicts/sandbox"
let IMG_DIR = "/tmp/vl_ladder_imgs"        // generated each run, deterministic
let OUT_PREFIX = "m5_substrate_multimodal_ladder"
let MAX_TOK = 24                  // short factual answers; deterministic greedy
let SEED = 42                     // pinned RNG seed for byte-exact replay

// ── THE THREE RUNGS: [name, params_b, model_path, mmproj_path] ───────────────
// params_b = total model parameters in billions (the x-axis of the capability fit).
let RUNGS = [
    ["SmolVLM-500M-Instruct-Q8_0",   "0.5",
        HOME + "/Models/gguf/smolvlm/SmolVLM-500M-Instruct-Q8_0.gguf",
        HOME + "/Models/gguf/smolvlm/mmproj-SmolVLM-500M-Instruct-Q8_0.gguf"],
    ["SmolVLM2-2.2B-Instruct-Q8_0",  "2.2",
        HOME + "/Models/gguf/smolvlm2_2b/SmolVLM2-2.2B-Instruct-Q8_0.gguf",
        HOME + "/Models/gguf/smolvlm2_2b/mmproj-SmolVLM2-2.2B-Instruct-Q8_0.gguf"],
    ["Qwen2.5-VL-3B-Instruct-Q4_K_M", "3.0",
        HOME + "/Models/gguf/qwen25vl3b/Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf",
        HOME + "/Models/gguf/qwen25vl3b/mmproj-Qwen2.5-VL-3B-Instruct-f16.gguf"],
]

// ── 16-item harder manifest: [img_basename, prompt, expected_kw, axis] ───────
let TASKS = [
    // axis count (5): multi-object counting, 5–9 objects (the non-saturating axis)
    ["count_5",  "How many black circles are in this image? Answer with the number only.",            "5", "count"],
    ["count_6",  "How many black circles are in this image? Answer with the number only.",            "6", "count"],
    ["count_7",  "How many black circles are in this image? Answer with the number only.",            "7", "count"],
    ["count_8",  "How many black circles are in this image? Answer with the number only.",            "8", "count"],
    ["count_9",  "How many black circles are in this image? Answer with the number only.",            "9", "count"],
    // axis ocr (4): OCR of 2-word uppercase phrases (the SECOND word is the keyword)
    ["ocr_opengate",  "What text is written in this image? Answer with the exact words.",             "gate",  "ocr"],
    ["ocr_redtruck",  "What text is written in this image? Answer with the exact words.",             "truck", "ocr"],
    ["ocr_bluestone", "What text is written in this image? Answer with the exact words.",             "stone", "ocr"],
    ["ocr_greenleaf", "What text is written in this image? Answer with the exact words.",             "leaf",  "ocr"],
    // axis spatial (4): left/right/above relation between two colored squares
    ["spatial_left_red",    "Which color square is on the left? Answer with one color word.",         "red",    "spatial"],
    ["spatial_right_blue",  "Which color square is on the right? Answer with one color word.",        "blue",   "spatial"],
    ["spatial_above_green", "Which color square is on the top? Answer with one color word.",          "green",  "spatial"],
    ["spatial_below_orange","Which color square is on the bottom? Answer with one color word.",       "orange", "spatial"],
    // axis shape (3): fine color+shape discrimination
    ["shape_triangle", "What shape is the single red shape in this image? Answer with one word.",     "triangle", "shape"],
    ["shape_square",   "What shape is the single blue shape in this image? Answer with one word.",    "square",   "shape"],
    ["shape_circle",   "What shape is the single green shape in this image? Answer with one word.",    "circle",   "shape"],
]

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

// Generate the deterministic harder synthetic manifest images via PIL (idempotent,
// seed-pinned). Returns "OK" or an error string. Ground truth is unambiguous +
// bit-reproducible: fixed object positions, fixed text, fixed colors/shapes.
fn gen_images() -> str {
    let py = "from PIL import Image, ImageDraw, ImageFont\n" +
        "import os\n" +
        "D='" + IMG_DIR + "'\n" +
        "os.makedirs(D, exist_ok=True)\n" +
        "def font(sz):\n" +
        "    for p in ['/System/Library/Fonts/Supplemental/Arial Bold.ttf','/System/Library/Fonts/Helvetica.ttc','/Library/Fonts/Arial.ttf']:\n" +
        "        if os.path.exists(p):\n" +
        "            try: return ImageFont.truetype(p, sz)\n" +
        "            except: pass\n" +
        "    return ImageFont.load_default()\n" +
        // ── count axis: 5..9 black circles on a 3x3 deterministic grid (384x384) ──
        "GRID=[(40,40),(170,40),(300,40),(40,170),(170,170),(300,170),(40,300),(170,300),(300,300)]\n" +
        "def count_img(name,n):\n" +
        "    im=Image.new('RGB',(384,384),'white'); d=ImageDraw.Draw(im)\n" +
        "    for i in range(n):\n" +
        "        x,y=GRID[i]; d.ellipse([x,y,x+50,y+50],fill='black')\n" +
        "    im.save(f'{D}/{name}.png')\n" +
        "for nm,n in [('count_5',5),('count_6',6),('count_7',7),('count_8',8),('count_9',9)]:\n" +
        "    count_img(nm,n)\n" +
        // ── ocr axis: 2-word uppercase phrases (480x160) ──
        "def ocr_img(name,phrase):\n" +
        "    im=Image.new('RGB',(480,160),'white'); d=ImageDraw.Draw(im)\n" +
        "    f=font(56); bb=d.textbbox((0,0),phrase,font=f); w=bb[2]-bb[0]; h=bb[3]-bb[1]\n" +
        "    d.text(((480-w)/2-bb[0],(160-h)/2-bb[1]),phrase,fill='black',font=f); im.save(f'{D}/{name}.png')\n" +
        "for nm,ph in [('ocr_opengate','OPEN GATE'),('ocr_redtruck','RED TRUCK'),('ocr_bluestone','BLUE STONE'),('ocr_greenleaf','GREEN LEAF')]:\n" +
        "    ocr_img(nm,ph)\n" +
        // ── spatial axis: two colored squares, relation in {left,right,top,bottom} ──
        "def sq(d,box,col): d.rectangle(box,fill=col)\n" +
        "def horiz(name,leftcol,rightcol):\n" +  // 480x200: left square + right square
        "    im=Image.new('RGB',(480,200),'white'); d=ImageDraw.Draw(im)\n" +
        "    sq(d,[40,60,150,170],leftcol); sq(d,[330,60,440,170],rightcol); im.save(f'{D}/{name}.png')\n" +
        "def vert(name,topcol,botcol):\n" +      // 200x480: top square + bottom square
        "    im=Image.new('RGB',(200,480),'white'); d=ImageDraw.Draw(im)\n" +
        "    sq(d,[45,40,155,150],topcol); sq(d,[45,330,155,440],botcol); im.save(f'{D}/{name}.png')\n" +
        "horiz('spatial_left_red','red','yellow')\n" +       // left=red, ask left -> red
        "horiz('spatial_right_blue','yellow','blue')\n" +    // right=blue, ask right -> blue
        "vert('spatial_above_green','green','purple')\n" +   // top=green, ask top -> green
        "vert('spatial_below_orange','purple','orange')\n" + // bottom=orange, ask bottom -> orange
        // ── shape axis: a single colored shape (triangle/square/circle) on white ──
        "def tri(d,col):\n" +
        "    d.polygon([(192,70),(110,290),(274,290)],fill=col)\n" +
        "def shape_img(name,kind,col):\n" +
        "    im=Image.new('RGB',(384,384),'white'); d=ImageDraw.Draw(im)\n" +
        "    if kind=='triangle': tri(d,col)\n" +
        "    elif kind=='square': d.rectangle([110,110,274,274],fill=col)\n" +
        "    else: d.ellipse([110,110,274,274],fill=col)\n" +
        "    im.save(f'{D}/{name}.png')\n" +
        "shape_img('shape_triangle','triangle','red')\n" +
        "shape_img('shape_square','square','blue')\n" +
        "shape_img('shape_circle','circle','green')\n" +
        "print('OK')\n"
    let cmd = "python3 - <<'__PYEOF__'\n" + py + "__PYEOF__"
    return exec(cmd).trim()
}

// Run one VL task via llama-mtmd-cli (-m model + --mmproj projector + --image FILE).
// Greedy (--temp 0) + pinned -s SEED for byte-exact replay. Returns tab-separated:
//   wall_ms \t correct(1|0) \t output_snippet
// SCORER: lowercase, collapse whitespace, case-insensitive SUBSTRING match on
// expected_kw. NO LLM self-judge — pure byte compare.
fn run_one(model: str, mmproj: str, img_base: str, prompt: str, expected_kw: str) -> str {
    let img = IMG_DIR + "/" + img_base + ".png"
    let cmd = "t_start=$(date +%s%N); " +
              "out=$(llama-mtmd-cli -m " + shq(model) +
              " --mmproj " + shq(mmproj) +
              " --image " + shq(img) +
              " -p " + shq(prompt) +
              " -n " + str(MAX_TOK) + " --temp 0 -s " + str(SEED) + " 2>/dev/null); " +
              "t_end=$(date +%s%N); " +
              "wall_ms=$(( (t_end - t_start) / 1000000 )); " +
              "ans=$(printf '%s' \"$out\" | tr '\\n' ' ' | sed 's/  */ /g; s/^ //; s/ $//'); " +
              "low=$(printf '%s' \"$ans\" | tr 'A-Z' 'a-z'); " +
              "kw=$(printf '%s' " + shq(expected_kw) + " | tr 'A-Z' 'a-z'); " +
              "if printf '%s' \"$low\" | grep -qF \"$kw\"; then correct=1; else correct=0; fi; " +
              "snippet=$(printf '%s' \"$ans\" | cut -c1-100); " +
              "printf '%s\\t%s\\t%s' \"$wall_ms\" \"$correct\" \"$snippet\""
    return exec(cmd).trim()
}

fn main() {
    println("========================================================================")
    println("  bench/sandbox_multimodal_ladder — M5.SUBSTRATE multimodal CAPABILITY LADDER")
    println("  rungs:    3 VL models (0.5B / 2.2B / 3.0B params) served locally on MTL0")
    println("  tool:     llama-mtmd-cli (stock brew llama.cpp, ggml, CLIP on MTL0 Metal/UMA)")
    println("  manifest: 16 HARDER synthetic images (count×5 / ocr×4 / spatial×4 / shape×3)")
    println("  scorer:   byte_exact_subset (NO LLM self-judge; same family as smoke + text floor)")
    println("  decode:   greedy --temp 0 -s " + str(SEED) + " -n " + str(MAX_TOK) + " (seed-pinned)")
    println("========================================================================")

    println("  generating deterministic harder manifest images via PIL ...")
    let gen = gen_images()
    if gen != "OK" {
        println("  ! image generation FAILED: " + gen)
        println("__HEXA_CODEX_BENCH_MM_LADDER__ FAIL_IMG_GEN")
        exit(1)
    }
    println("  images OK in " + IMG_DIR)

    exec("mkdir -p " + shq(OUT_DIR))
    let tsv_path = OUT_DIR + "/" + OUT_PREFIX + ".tsv"
    exec("rm -f " + shq(tsv_path))
    exec("echo 'rung\tparams_b\timg\taxis\texpected\twall_ms\tcorrect\toutput_snippet' >> " + shq(tsv_path))

    let total = len(TASKS)
    // per-rung accuracy ladder (the capability-fit source data)
    let mut ladder_names = []
    let mut ladder_params = []
    let mut ladder_correct = []

    let mut r = 0
    while r < len(RUNGS) {
        let rung = RUNGS[r]
        let rname = rung[0]
        let rparams = rung[1]
        let rmodel = rung[2]
        let rmmproj = rung[3]
        println("")
        println("  ── RUNG " + str(r) + ": " + rname + "  (" + rparams + "B params) ──────────")

        let mut n_correct = 0
        let mut total_ms = 0
        // per-axis tallies
        let mut c_count = 0
        let mut c_ocr = 0
        let mut c_spatial = 0
        let mut c_shape = 0
        let mut i = 0
        while i < total {
            let task = TASKS[i]
            let img_base = task[0]
            let prompt = task[1]
            let expected = task[2]
            let axis = task[3]
            let line = run_one(rmodel, rmmproj, img_base, prompt, expected)
            let parts = line.split("\t")
            if parts.len() < 3 {
                println("    ! parse error img=" + img_base + " raw=" + line)
                let bad = rname + "\t" + rparams + "\t" + img_base + "\t" + axis + "\t" + expected + "\t0\t0\tPARSE_ERROR:" + line.substr(0, 60)
                exec("echo " + shq(bad) + " >> " + shq(tsv_path))
                i = i + 1
                continue
            }
            let wall_ms = int(parts[0])
            let correct = parts[1]
            let snippet = parts[2].replace("\t", " ")
            total_ms = total_ms + wall_ms
            if correct == "1" {
                n_correct = n_correct + 1
                if axis == "count"   { c_count = c_count + 1 }
                if axis == "ocr"     { c_ocr = c_ocr + 1 }
                if axis == "spatial" { c_spatial = c_spatial + 1 }
                if axis == "shape"   { c_shape = c_shape + 1 }
            }
            let row = rname + "\t" + rparams + "\t" + img_base + "\t" + axis + "\t" + expected + "\t" + str(wall_ms) + "\t" + correct + "\t" + snippet.substr(0, 100)
            exec("echo " + shq(row) + " >> " + shq(tsv_path))
            println("    [" + str(i+1) + "/" + str(total) + "] axis=" + axis + " img=" + img_base +
                    " expect=" + expected + " -> correct=" + correct + " ans=" + snippet.substr(0, 36))
            i = i + 1
        }
        let mut acc_x100 = 0
        if total > 0 { acc_x100 = (n_correct * 10000) / total }
        println("    RUNG " + rname + " : " + str(n_correct) + "/" + str(total) +
                " (" + str(acc_x100 / 100) + "." + str(acc_x100 % 100) + "%)" +
                "  [count " + str(c_count) + "/5  ocr " + str(c_ocr) + "/4  spatial " + str(c_spatial) + "/4  shape " + str(c_shape) + "/3]" +
                "  wall_ms=" + str(total_ms))
        ladder_names.push(rname)
        ladder_params.push(rparams)
        ladder_correct.push(str(n_correct))
        r = r + 1
    }

    // ── capability ladder summary (the closed-form-fit source-of-truth) ──────
    println("")
    println("========================================================================")
    println("  CAPABILITY LADDER — accuracy vs params (the gradient)")
    println("========================================================================")
    let mut monotone = "true"
    let mut prev = -1
    let mut k = 0
    while k < len(ladder_names) {
        let nc = int(ladder_correct[k])
        let ax100 = (nc * 10000) / total
        println("  rung " + str(k) + "  " + ladder_params[k] + "B  " +
                ladder_correct[k] + "/" + str(total) + "  = " + str(ax100 / 100) + "." + str(ax100 % 100) + "%  " + ladder_names[k])
        if nc < prev { monotone = "false" }
        prev = nc
        k = k + 1
    }
    println("  monotone_nondecreasing : " + monotone)

    let summary_path = OUT_DIR + "/" + OUT_PREFIX + "_summary.txt"
    exec("rm -f " + shq(summary_path))
    exec("echo " + shq("# bench=sandbox_multimodal_ladder (M5.SUBSTRATE multimodal CAPABILITY LADDER, cycle-20)") + " >> " + shq(summary_path))
    exec("echo " + shq("# rungs=3  params_b=0.5,2.2,3.0  tool=llama-mtmd-cli (stock brew llama.cpp, CLIP on MTL0 Metal/UMA)") + " >> " + shq(summary_path))
    exec("echo " + shq("# manifest=16 synthetic PIL images, 4 difficulty-stratified axes (count x5 [5-9 objects] / ocr x4 [2-word phrases] / spatial x4 / shape x3)") + " >> " + shq(summary_path))
    exec("echo " + shq("# scorer=byte_exact_subset (case-insensitive substring on expected_kw; NO LLM self-judge; same family as smoke + rwkv_m1)") + " >> " + shq(summary_path))
    exec("echo " + shq("# decode=greedy --temp 0 -s " + str(SEED) + " -n " + str(MAX_TOK) + " (seed-pinned byte-exact replay)") + " >> " + shq(summary_path))
    exec("echo " + shq("# host=mac-mini-m3 (Apple M3, 24GB UMA; PRE-M5 Metal, MTL0 backend active); cost_usd=0") + " >> " + shq(summary_path))
    exec("echo " + shq("# total_items=" + str(total)) + " >> " + shq(summary_path))
    let mut k2 = 0
    while k2 < len(ladder_names) {
        let nc = int(ladder_correct[k2])
        let ax100 = (nc * 10000) / total
        exec("echo " + shq("# rung" + str(k2) + "_name=" + ladder_names[k2]) + " >> " + shq(summary_path))
        exec("echo " + shq("# rung" + str(k2) + "_params_b=" + ladder_params[k2]) + " >> " + shq(summary_path))
        exec("echo " + shq("# rung" + str(k2) + "_correct=" + ladder_correct[k2] + "/" + str(total)) + " >> " + shq(summary_path))
        exec("echo " + shq("# rung" + str(k2) + "_accuracy_pct=" + str(ax100 / 100) + "." + str(ax100 % 100)) + " >> " + shq(summary_path))
        k2 = k2 + 1
    }
    exec("echo " + shq("# monotone_nondecreasing=" + monotone) + " >> " + shq(summary_path))
    exec("echo " + shq("# model_sources=ggml-org/SmolVLM-500M-Instruct-GGUF · ggml-org/SmolVLM2-2.2B-Instruct-GGUF · ggml-org/Qwen2.5-VL-3B-Instruct-GGUF (HF)") + " >> " + shq(summary_path))
    exec("echo " + shq("# fit_consumer=verify/numerics_substrate_multimodal_fit.hexa (closed-form logistic in log2(params), recompute from this TSV)") + " >> " + shq(summary_path))

    println("")
    println("  tsv     persisted: " + tsv_path)
    println("  summary persisted: " + summary_path)
    println("__HEXA_CODEX_BENCH_MM_LADDER__ DONE")
    exit(0)
}
