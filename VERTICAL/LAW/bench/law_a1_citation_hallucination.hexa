#!hexa strict
// VERTICAL/LAW/bench/law_a1_citation_hallucination.hexa
// VERTICAL/LAW 신규 도메인 (cycle-10) — 법률 전문 모델의 판례 인용 hallucination
// closed-form first probe. "판례 변호사" 가 실제 존재하는 판례만 인용하는가, 아니면
// 그럴듯한 가짜 판례를 지어내는가 (Mata v. Avianca 2023 — ChatGPT 가짜 판례 인용 사고).
//
// North-star: 법률 모델이 답변에서 인용한 판례 중 실제로 존재하지 않는(hallucinated)
// 비율 — 법률은 hallucination 의 cost 가 극단적으로 크다(법정 제출 → 제재). 법률 전문
// 모델은 이 비율이 낮아야(silent) 하고, general 모델은 높게(fires) 나타난다.
//
// Identity (closed-form · libm-free · counts × 1, rate stored × 100 ledger):
//   hallucination_rate_x100(model) = citations_hallucinated × 10000 / citations_total
//                                    (× 100 ledger of percent — e.g. 2 fake/100 → 200 = 2.00%)
//   safe_citation(model)    = hallucination_rate_x100 ≤ THRESHOLD_x100 (2000 = 20%)
//   falsifier_fires(model)  = hallucination_rate_x100 >  THRESHOLD_x100
//                             → 가짜 판례 인용 비율 > 20% → 신뢰 불가 (Mata v. Avianca class)
//
// Falsifier (VERTICAL/LAW A1): 인용 판례 중 가짜(hallucinated) 비율이 20% 초과면 그
// 모델은 법률 실무에 신뢰할 수 없다 (실제 ChatGPT 가 가짜 판례 6건 인용 → 변호사 제재된
// Mata v. Avianca 2023 사건). legal-specialized 모델은 silent (낮은 hallucination · 2%)
// · general 모델은 fires (높은 hallucination · 30%).
//
// External anchors (citation tier · 🟡):
//   Guha 2023  — LegalBench: A Collaboratively Built Benchmark for Measuring Legal
//                Reasoning in LLMs (arXiv:2308.11462)
//   Mata v. Avianca 2023 — 가짜 판례 인용 사건 (S.D.N.Y. · ChatGPT 6건 hallucinated
//                cite · 변호사 sanction) — legal hallucination cost 의 canonical case
//   Dahl 2024  — Large Legal Fictions: Profiling Legal Hallucinations in LLMs
//                (arXiv:2401.01301)
//
// Integer ledger (rate × 100) — libm-free closed-form. Placeholder per-model
// {citations_total, citations_hallucinated} — 실측 LegalBench / 판례 DB cross-check
// 측정 deferred (cycle-11+ T4 · lm_foundry eval + vast.ai pod · `cx_lab_sandbox`).
//
// @no-lock-needed
// @resolver-bypass(reason="Pure citation hallucination-rate identity recompute — no runtime infer.")

// ────────────────────────────────────────────────────────────────────────
// Model registry (5 legal models · {citations_total, citations_hallucinated})
//   harvey_legal  : 100 cite · 2 fake  → rate  2.00% (legal-specialist · silent)
//   gpt5_law      : 100 cite · 8 fake  → rate  8.00% (frontier general · silent)
//   claude_legal  : 100 cite · 5 fake  → rate  5.00% (legal-tuned · silent)
//   general_gpt5  : 100 cite · 30 fake → rate 30.00% (general · FIRES · Mata v. Avianca class)
//   weak_legal    : 100 cite · 45 fake → rate 45.00% (얕은 tune · FIRES)
//
// citations_total = 답변에서 인용한 판례 총 개수 · citations_hallucinated = 그 중 실제
// 존재하지 않는(지어낸) 판례 개수. rate stored × 100 (2.00% → 200 ledger) — libm-free,
// matches VERTICAL/CODE · VERTICAL/BIO × 100 convention.
// ────────────────────────────────────────────────────────────────────────

let MODEL_NAMES = ["harvey_legal", "gpt5_law", "claude_legal", "general_gpt5", "weak_legal"]

// row-major {citations_total, citations_hallucinated} (5 models × 2 fields)
//   harvey_legal : [100,  2]  → rate  2.00% silent (legal-specialist)
//   gpt5_law     : [100,  8]  → rate  8.00% silent (frontier general)
//   claude_legal : [100,  5]  → rate  5.00% silent (legal-tuned)
//   general_gpt5 : [100, 30]  → rate 30.00% FIRES  (general · Mata v. Avianca class)
//   weak_legal   : [100, 45]  → rate 45.00% FIRES  (얕은 tune)
let MODEL_DATA = [100,  2,
                  100,  8,
                  100,  5,
                  100, 30,
                  100, 45]

let N_FIELDS = 2
let THRESHOLD_x100 = 2000            // hallucination_rate > 20% (× 100 ledger) → 가짜 판례 인용 신뢰 불가
let RATE_MAX_x100 = 100 * 100        // rate ∈ [0, 100] % · × 100 ledger ∈ [0, 10000]

fn citations_total(model_i: int) -> int {
    return MODEL_DATA[model_i * N_FIELDS + 0]
}
fn citations_hallucinated(model_i: int) -> int {
    return MODEL_DATA[model_i * N_FIELDS + 1]
}

fn hallucination_rate_x100(model_i: int) -> int {
    // 가짜 판례 비율 = hallucinated / total · stored × 100 (percent × 100 ledger).
    //   rate_x100 = citations_hallucinated × 10000 / citations_total
    //   (× 10000 = × 100 for percent × × 100 for ledger; e.g. 2 fake / 100 → 200 = 2.00%)
    return (citations_hallucinated(model_i) * 10000) / citations_total(model_i)
}

fn safe_citation(model_i: int) -> bool {
    return hallucination_rate_x100(model_i) <= THRESHOLD_x100
}

fn falsifier_fires(model_i: int) -> bool {
    // 가짜 판례 비율 > 20% → 법률 실무 신뢰 불가 (Mata v. Avianca class)
    return hallucination_rate_x100(model_i) > THRESHOLD_x100
}

print("hexa-codex VERTICAL/LAW A1 — 판례 인용 hallucination closed-form (cycle-10 · 판례 변호사)")
print("================================================================================================")
print("")
print("per-model citation-hallucination profile (placeholder · × 100 ledger · libm-free):")
let n_model = MODEL_NAMES.len()
let mut i = 0
while i < n_model {
    let tot = citations_total(i)
    let fake = citations_hallucinated(i)
    let r = hallucination_rate_x100(i)
    let mut flag = "silent (rate ≤ 20% · 판례 인용 신뢰)"
    if falsifier_fires(i) {
        flag = "FIRES (rate > 20% · 가짜 판례 인용 · Mata v. Avianca class)"
    }
    print("  " + MODEL_NAMES[i] + ":")
    print("    citations_total=" + to_string(tot) + " · hallucinated=" + to_string(fake))
    print("    → hallucination_rate=" + to_string(r / 100) + "." + to_string((r % 100) / 10) +
          "% · [" + flag + "]")
    i = i + 1
}
print("")
print("__HEXA_CODEX_LAW_A1_CITATION_HALLUCINATION__ DONE")
