#!hexa strict
// ENERGY/verify/numerics_energy_n2_quantization_quality_size.hexa
// ENERGY N2 NOVEL — closed-form verifier for the quantization quality-size
// trade-off identity + anti-overcompression falsifier semantics
// (ENERGY 의 weight-precision 축소로 메모리/대역폭/에너지 절감 · CYCLE-10 reorg Batch B · 2026-05-28).
//
// Asserts the quality-size identity recompute + anti-overcompression falsifier:
//   (1) loss + compression identity:
//         quality_loss_pct_x100(gguf_q4) = 10000 − 9700 = 300
//         compression_ratio_x100(gguf_q4) = 1400 × 100 / 350 = 400
//   (2) range bound — all size > 0 and all quality ∈ [0, 10000] per-cent × 100
//   (3) fp16 self — loss = 0 (lossless) · compression = 100 (= 1.00× · baseline / baseline)
//   (4) gguf_q2 fires — quality_loss = 1500 > 500 (> 5% · over-compression)
//   (5) fp16 ~ gguf_q4 silent — all four (fp16/int8/gguf_q8/gguf_q4) loss ≤ 500
//   (6) determinism (recompute identical · recursively delicious)
//   (7) sanity: 압축 클수록 손실 monotone 비감소 — loss(q2) ≥ loss(q4) ≥ loss(q8)
//
// Source: ENERGY/bench/energy_n2_quantization_quality_size.hexa
// External anchors:
//   Frantar 2023 GPTQ (arXiv:2210.17323)
//   Lin 2023 AWQ (arXiv:2306.00978)
//   Dettmers 2022 LLM.int8() (arXiv:2208.07339)
//   llama.cpp GGUF Q-levels (Q8_0 · Q4_K_M · Q2_K) · Gemma 4 GGUF release
//
// @no-lock-needed

let LEVEL_NAMES = [
    "fp16",
    "int8",
    "gguf_q8",
    "gguf_q4",
    "gguf_q2",
]
let SIZE_GB_x100      = [1400, 700, 715, 350, 175]
let QUALITY_PCT_x100  = [10000, 9950, 9950, 9700, 8500]

let FP16_SIZE_GB_x100 = 1400
let LOSS_FIRE_THRESHOLD_x100 = 500
let PCT_MIN_x100 = 0
let PCT_MAX_x100 = 10000

fn quality_loss_pct_x100(idx: int) -> int {
    return 10000 - QUALITY_PCT_x100[idx]
}

fn compression_ratio_x100(idx: int) -> int {
    let s = SIZE_GB_x100[idx]
    if s <= 0 { return 0 }
    return (FP16_SIZE_GB_x100 * 100) / s
}

fn falsifier_fires(idx: int) -> bool {
    return quality_loss_pct_x100(idx) > LOSS_FIRE_THRESHOLD_x100
}

print("hexa-codex ENERGY N2 falsifier — Quantization quality-size trade closed-form (cycle-10 reorg Batch B)")
print("============================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0

// check 1 — loss + compression identity for gguf_q4 (idx 3)
checks_total = checks_total + 1
let loss_expect = 300
let comp_expect = 400
let loss_actual = quality_loss_pct_x100(3)
let comp_actual = compression_ratio_x100(3)
if loss_actual == loss_expect && comp_actual == comp_expect {
    print("  [PASS] gguf_q4 identity: loss = 10000 − 9700 = " + to_string(loss_actual) +
          " · compression = 1400 × 100 / 350 = " + to_string(comp_actual) + " (= 3.0% · 4.00×)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] gguf_q4 identity expected loss=" + to_string(loss_expect) +
          " comp=" + to_string(comp_expect) +
          " got loss=" + to_string(loss_actual) + " comp=" + to_string(comp_actual))
}

// check 2 — range bound: all size > 0 and all quality ∈ [0, 10000]
checks_total = checks_total + 1
let mut range_ok = true
let mut j = 0
while j < LEVEL_NAMES.len() {
    if SIZE_GB_x100[j] <= 0 { range_ok = false }
    let q = QUALITY_PCT_x100[j]
    if q < PCT_MIN_x100 { range_ok = false }
    if q > PCT_MAX_x100 { range_ok = false }
    j = j + 1
}
if range_ok {
    print("  [PASS] all " + to_string(LEVEL_NAMES.len()) +
          " levels: size > 0 · quality ∈ [0, 10000] (per-cent × 100 range invariant)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] some level out of range — size ≤ 0 or quality ∉ [0, 10000]")
}

// check 3 — fp16 self: loss = 0 (lossless) · compression = 100 (= 1.00× baseline)
checks_total = checks_total + 1
let fp16_loss = quality_loss_pct_x100(0)
let fp16_comp = compression_ratio_x100(0)
if fp16_loss == 0 && fp16_comp == 100 {
    print("  [PASS] fp16 self: loss = " + to_string(fp16_loss) +
          " (lossless) · compression = " + to_string(fp16_comp) + " (= 1.00× · baseline / baseline)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] fp16 self broken: loss=" + to_string(fp16_loss) +
          " (want 0) comp=" + to_string(fp16_comp) + " (want 100)")
}

// check 4 — gguf_q2 fires: quality_loss = 1500 > 500 (over-compression)
checks_total = checks_total + 1
let q2_fires = falsifier_fires(4)
let q2_loss = quality_loss_pct_x100(4)
if q2_fires && q2_loss > LOSS_FIRE_THRESHOLD_x100 {
    print("  [PASS] gguf_q2 FIRES 🔴 (quality_loss=" + to_string(q2_loss) +
          " > 500 · 15.0% · over-compression · 8× buys only 85% quality)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] gguf_q2 anti-overcompression falsifier broken (loss=" + to_string(q2_loss) + ")")
}

// check 5 — fp16 ~ gguf_q4 silent: fp16/int8/gguf_q8/gguf_q4 all loss ≤ 500
checks_total = checks_total + 1
let mut silent_ok = true
let mut k = 0
while k < 4 {   // idx 0..3 = fp16, int8, gguf_q8, gguf_q4
    if falsifier_fires(k) { silent_ok = false }
    if quality_loss_pct_x100(k) > LOSS_FIRE_THRESHOLD_x100 { silent_ok = false }
    k = k + 1
}
if silent_ok {
    print("  [PASS] fp16/int8/gguf_q8/gguf_q4 all silent (loss ≤ 5% · safe-compression regime · proves verifier is bidirectional · NOT one-sided)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] some safe-compression level (fp16..gguf_q4) erroneously fires")
}

// check 6 — determinism (recompute identical)
checks_total = checks_total + 1
if quality_loss_pct_x100(3) == quality_loss_pct_x100(3) &&
   compression_ratio_x100(3) == compression_ratio_x100(3) &&
   falsifier_fires(4) == falsifier_fires(4) {
    print("  [PASS] formula deterministic (re-call same loss + compression + fires · recursively delicious)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] formula non-deterministic")
}

// check 7 — sanity: 압축 클수록 손실 monotone 비감소 (loss(q2) ≥ loss(q4) ≥ loss(q8))
//   gguf_q2 (175 GB·100) > gguf_q4 (350) > gguf_q8 (715) in compression order;
//   their quality_loss must be non-increasing-in-size = non-decreasing-in-compression.
checks_total = checks_total + 1
let loss_q8 = quality_loss_pct_x100(2)
let loss_q4 = quality_loss_pct_x100(3)
let loss_q2 = quality_loss_pct_x100(4)
if loss_q2 >= loss_q4 && loss_q4 >= loss_q8 {
    print("  [PASS] monotonicity: loss(q2)=" + to_string(loss_q2) +
          " ≥ loss(q4)=" + to_string(loss_q4) +
          " ≥ loss(q8)=" + to_string(loss_q8) +
          " (압축 클수록 손실 monotone 비감소 · ordered trade-off · 압축은 공짜가 아니다)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] monotonicity broken: loss(q2)=" + to_string(loss_q2) +
          " loss(q4)=" + to_string(loss_q4) + " loss(q8)=" + to_string(loss_q8))
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 STRUCTURAL (quality-size trade identity 7/7) + 🟡 BY-CITATION (per-level size/quality tiers from GPTQ/AWQ/LLM.int8/GGUF published data) — over-compression fires at gguf_q2 (15% loss) · fp16~gguf_q4 silent (≤ 5%) · level-dependent"
} else {
    verdict_tier = "🔴 FALSIFIED — quality-size trade formula contradicts identity (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
}
print("  " + verdict_tier)
print("")
print("ENERGY N2 finding (placeholder data · closed-form · cycle-10 reorg Batch B):")
print("  - quality-size trade identity (loss = 100% − quality% · compression = fp16_size / level_size) — 7/7 closed-form checks")
print("  - bidirectional discrimination: gguf_q2 fires (loss 1500 · 15%) · fp16/int8/gguf_q8/gguf_q4 silent (≤ 5%)")
print("  - external anchors: Frantar 2023 GPTQ (2210.17323) · Lin 2023 AWQ (2306.00978) · Dettmers 2022 LLM.int8 (2208.07339) · llama.cpp GGUF Q-levels · Gemma 4 GGUF")
print("  - anti-overcompression: '이 양자화 레벨이 5% 초과 손실 없이 압축한다' — gguf_q2 (2-bit) 에서 FALSIFIED (loss 15% > 5%)")
print("  - monotonicity: 압축 클수록 손실 monotone 비감소 (loss q2 ≥ q4 ≥ q8 · 압축은 공짜가 아니다)")
print("  - 실측 per-level MMLU/GSM8K re-eval on local 7B GGUF mac M3 (cycle-11+ T4 · `cx_lab_sandbox`)")
print("")
print("__HEXA_CODEX_NUMERICS_ENERGY_N2__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/ENERGY/verdicts/n2_quantization_quality_size_verdict.txt"

let mut content = "# hexa-codex ENERGY N2 — Quantization quality-size trade verifier (cycle-10 reorg Batch B · 2026-05-28)\n"
content = content + "# axis=ENERGY/ENERGY.md::N2 QUANTIZATION (품질-크기 trade-off · weight-precision 축소로 메모리/대역폭/에너지 절감 · NOVEL)\n"
content = content + "# bench=ENERGY/bench/energy_n2_quantization_quality_size.hexa\n"
content = content + "# verifier=ENERGY/verify/numerics_energy_n2_quantization_quality_size.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# formula=quality_loss_pct_x100 = 10000 − quality_pct_x100; compression_ratio_x100 = fp16_size × 100 / level_size; falsifier_fires = quality_loss_pct_x100 > 500 (anti-overcompression · 5% 초과 손실)\n"
content = content + "# placeholder_data=5 levels @7B (fp16 1400GB·100/10000 · int8 700/9950 · gguf_q8 715/9950 · gguf_q4 350/9700 · gguf_q2 175/8500 · size GB×100 / quality %×100)\n"
content = content + "# gguf_q4_worked=loss = 10000 − 9700 = 300 (= 3.0% ≤ 5% → silent) · compression = 1400 × 100 / 350 = 400 (= 4.00× vs fp16)\n"
content = content + "# gguf_q2_fire=loss = 10000 − 8500 = 1500 (= 15.0% > 5%) → 🔴 FIRES (over-compression · compression 1400 × 100 / 175 = 800 = 8.00× buys only 85% quality)\n"
content = content + "# silent_control=fp16 (loss 0) · int8 (50) · gguf_q8 (50) · gguf_q4 (300) all ≤ 500 → silent (safe-compression regime · proves verifier is bidirectional · NOT one-sided)\n"
content = content + "# monotonicity=loss(gguf_q2)=1500 ≥ loss(gguf_q4)=300 ≥ loss(gguf_q8)=50 (압축 클수록 손실 monotone 비감소 · ordered trade-off · 압축은 공짜가 아니다)\n"
content = content + "# external_anchors=Frantar 2023 GPTQ (arXiv:2210.17323) · Lin 2023 AWQ (arXiv:2306.00978) · Dettmers 2022 LLM.int8 (arXiv:2208.07339) · llama.cpp GGUF Q-levels (Q8_0/Q4_K_M/Q2_K) · Gemma 4 GGUF release\n"
content = content + "# stack=train/infer/serve — quantization 은 추론/서빙 메모리·대역폭·에너지 절감 lever (fp16→gguf_q4 4× 압축 · 3% 손실)\n"
content = content + "# cycle=CYCLE-10 reorg Batch B (2026-05-28 · ENERGY NOVEL N2 신규 추가 · N1 sparse-MoE 보존)\n"
content = content + "# substrate_fire=DEFERRED (cycle-11+ T4 · SANDBOX mac M3 llama-server + local 7B GGUF · per-level MMLU/GSM8K real measured re-eval)\n"
content = content + "# frontier_open=feedback_closure_is_physical_limit — identity close ≠ measured close · placeholder size/quality from GPTQ/AWQ/GGUF published tiers; 새 quant scheme (Q3_K · IQ-levels · per-channel) 등장 시 axis 재오픈\n"
content = content + "# honest_residual=real per-level MMLU/GSM8K re-eval on local 7B GGUF mac M3 DEFERRED to cycle-11+ T4 (cx_lab_sandbox · cx_empirical_contact)\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
