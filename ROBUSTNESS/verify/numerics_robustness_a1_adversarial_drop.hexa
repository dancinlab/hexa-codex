#!hexa strict
// ROBUSTNESS/verify/numerics_robustness_a1_adversarial_drop.hexa
// ROBUSTNESS A1 — closed-form verifier for adversarial drop identity.
//
// Asserts the drop identity + threshold semantics + sanity:
//   (1) drop identity (clean − adv) holds for all models
//   (2) drop ∈ [-100, 100] (percentage-point range)
//   (3) synthetic zero-drop model (clean = adv) → drop = 0
//   (4) drop > 30pp models fire (weak=40 · brittle=56)
//   (5) drop ≤ 30pp models silent (robust=6 · standard=30) — false-positive 회피
//   (6) determinism
//   (7) clean_acc ≥ adv_acc sanity (attack 가 clean 초과 불가능 · reasonable attack)
//
// Source: ROBUSTNESS/bench/robustness_a1_adversarial_drop.hexa
// External anchors: Madry 2018 adversarial · Goodfellow 2015 FGSM · Hendrycks 2021 OOD · Morris 2020 TextAttack
//
// @no-lock-needed

let MODEL_NAMES     = ["robust",  "standard", "weak", "brittle"]
let CLEAN_ACC_x100  = [88,         85,         80,     78]
let ADV_ACC_x100    = [82,         55,         40,     22]
let DROP_THRESHOLD_x100 = 30

fn drop_x100(i: int) -> int { return CLEAN_ACC_x100[i] - ADV_ACC_x100[i] }
fn falsifier_fires(i: int) -> bool { return drop_x100(i) > DROP_THRESHOLD_x100 }

print("hexa-codex ROBUSTNESS A1 falsifier — adversarial drop closed-form")
print("==================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0
let n = MODEL_NAMES.len()

// check 1 — drop identity (clean − adv) for all
checks_total = checks_total + 1
let mut id_ok = true
let mut i = 0
while i < n {
    if drop_x100(i) != CLEAN_ACC_x100[i] - ADV_ACC_x100[i] { id_ok = false }
    i = i + 1
}
if id_ok {
    print("  [PASS] drop identity (clean − adv) holds for all " + to_string(n) + " models")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] drop identity broken")
}

// check 2 — drop range [-100, 100] (percentage-point bound)
checks_total = checks_total + 1
let mut rb_ok = true
i = 0
while i < n {
    if drop_x100(i) < -100 || drop_x100(i) > 100 { rb_ok = false }
    i = i + 1
}
if rb_ok {
    print("  [PASS] drop ∈ [-100, 100] (percentage-point range)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] drop out of range")
}

// check 3 — synthetic zero-drop (clean = adv = 80) → drop = 0
checks_total = checks_total + 1
let synth_drop = 80 - 80
if synth_drop == 0 {
    print("  [PASS] synthetic zero-drop (clean = adv) → drop = 0 (no degradation)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] zero-drop synthetic ≠ 0")
}

// check 4 — drop > 30pp models fire (weak=40 · brittle=56)
checks_total = checks_total + 1
if falsifier_fires(2) && falsifier_fires(3) && drop_x100(2) == 40 && drop_x100(3) == 56 {
    print("  [PASS] drop>30pp models fire: weak=" + to_string(drop_x100(2)) + " · brittle=" + to_string(drop_x100(3)))
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] drop>30pp fire detection broken")
}

// check 5 — drop ≤ 30pp models silent (robust=6 · standard=30)
checks_total = checks_total + 1
if falsifier_fires(0) == false && falsifier_fires(1) == false && drop_x100(0) == 6 && drop_x100(1) == 30 {
    print("  [PASS] drop≤30pp models silent: robust=" + to_string(drop_x100(0)) + " · standard=" + to_string(drop_x100(1)) + " — false-positive 회피")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] drop≤30pp silent detection broken")
}

// check 6 — determinism
checks_total = checks_total + 1
if drop_x100(2) == drop_x100(2) && falsifier_fires(3) == falsifier_fires(3) {
    print("  [PASS] deterministic (re-call same drop + fires)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] non-deterministic")
}

// check 7 — clean_acc ≥ adv_acc sanity (reasonable attack doesn't exceed clean)
checks_total = checks_total + 1
let mut sanity_ok = true
i = 0
while i < n {
    if CLEAN_ACC_x100[i] < ADV_ACC_x100[i] { sanity_ok = false }
    i = i + 1
}
if sanity_ok {
    print("  [PASS] clean_acc ≥ adv_acc sanity for all models (reasonable attack)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] sanity broken (some adv > clean — attack improving accuracy?)")
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 STRUCTURAL (drop identity + threshold semantics + sanity 7/7) + 🟡 BY-CITATION (30pp threshold = Madry 2018 / TextAttack convention)"
} else {
    verdict_tier = "🔴 FALSIFIED — drop formula contradicts identity (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
}
print("  " + verdict_tier)
print("")
print("ROBUSTNESS A1 finding (placeholder · closed-form):")
print("  - adversarial drop = clean_acc − adv_acc identity (7/7 closed-form checks)")
print("  - bidirectional discrimination: robust=6 · standard=30 silent · weak=40 · brittle=56 fire")
print("  - sanity: clean_acc ≥ adv_acc for reasonable attack (no accuracy gain from perturbation)")
print("  - external anchor: Madry 2018 adversarial · Goodfellow 2015 FGSM · Hendrycks 2021 OOD · Morris 2020 TextAttack")
print("  - 실측 (cycle-10+ T4): TextAttack · AdvGLUE · ANLI on ubu-1 HF transformers · per-model")
print("")
print("__HEXA_CODEX_NUMERICS_ROBUSTNESS_A1_ADVERSARIAL_DROP__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/ROBUSTNESS/verdicts/a1_adversarial_drop_verdict.txt"

let mut content = "# hexa-codex ROBUSTNESS A1 — adversarial drop verifier (cycle-9 round-6)\n"
content = content + "# axis=ROBUSTNESS/ROBUSTNESS.md::A1 (adversarial attack success rate · clean accuracy)\n"
content = content + "# bench=ROBUSTNESS/bench/robustness_a1_adversarial_drop.hexa\n"
content = content + "# verifier=ROBUSTNESS/verify/numerics_robustness_a1_adversarial_drop.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# formula=drop = clean_acc − adv_acc (× 100); falsifier_fires = drop > 30\n"
content = content + "# placeholder_data=4 models × {clean, adv}; robust=88/82 drop=6 · standard=85/55 drop=30 silent · weak=80/40 drop=40 · brittle=78/22 drop=56 fire\n"
content = content + "# sanity=clean_acc ≥ adv_acc (reasonable attack doesn't exceed clean)\n"
content = content + "# external_anchors=Madry 2018 adversarial (arXiv:1706.06083) · Goodfellow 2015 FGSM (arXiv:1412.6572) · Hendrycks 2021 OOD (arXiv:2006.16241) · Morris 2020 TextAttack (arXiv:2005.05909)\n"
content = content + "# substrate_fire=DEFERRED (cycle-10+ · TextAttack · AdvGLUE · ANLI · ubu-1 HF)\n"
content = content + "# frontier_open=feedback_closure_is_physical_limit — identity close ≠ measured close\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
