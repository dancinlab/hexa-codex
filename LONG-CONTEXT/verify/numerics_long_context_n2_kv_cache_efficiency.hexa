#!hexa strict
// LONG-CONTEXT/verify/numerics_long_context_n2_kv_cache_efficiency.hexa
// LONG-CONTEXT N2 — closed-form verifier for KV-cache utilization identity.
//
// Asserts the ratio identity + over-allocation sanity + threshold:
//   (1) utilization identity (used × 10000 / allocated) for all strategies
//   (2) ranges (allocated ≥ used > 0 for every strategy)
//   (3) perfect synthetic (alloc = used → 100% util · 10000)
//   (4) contiguous_padded + static_maxlen fire (util < 50% · over-allocation)
//   (5) paged_vllm / paged_conservative / dynamic_good silent (util ≥ 50%)
//   (6) determinism
//   (7) sanity: allocated ≥ used (over-allocation only · under-allocation 불가)
//
// Source: LONG-CONTEXT/bench/long_context_n2_kv_cache_efficiency.hexa
// External anchors: Kwon 2023 vLLM PagedAttention (arXiv:2309.06180) · Sheng 2023 FlexGen (arXiv:2303.06865)
//                   · Hooper 2024 KVQuant (arXiv:2401.18079) · Pope 2022 efficiently scaling inference (arXiv:2211.05102)
//
// @no-lock-needed

let STRATEGY_NAMES = ["paged_vllm", "paged_conservative", "dynamic_good", "contiguous_padded", "static_maxlen"]
let ALLOCATED_BLOCKS = [105, 115, 110, 220, 250]
let USED_BLOCKS      = [100, 100, 100, 100, 100]
let UTIL_THRESHOLD_x100 = 5000

fn utilization_x100(s: int) -> int { return (USED_BLOCKS[s] * 10000) / ALLOCATED_BLOCKS[s] }
fn waste_x100(s: int) -> int { return 10000 - utilization_x100(s) }
fn falsifier_fires(s: int) -> bool { return utilization_x100(s) < UTIL_THRESHOLD_x100 }

print("hexa-codex LONG-CONTEXT N2 falsifier — KV-cache utilization closed-form")
print("========================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0
let n = STRATEGY_NAMES.len()

// check 1 — utilization identity (used × 10000 / allocated) for all
checks_total = checks_total + 1
let mut id_ok = true
let mut i = 0
while i < n {
    if utilization_x100(i) != (USED_BLOCKS[i] * 10000) / ALLOCATED_BLOCKS[i] { id_ok = false }
    i = i + 1
}
if id_ok {
    print("  [PASS] utilization identity (used · 10000 / allocated) holds for all " + to_string(n) + " strategies")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] utilization identity broken")
}

// check 2 — ranges: allocated ≥ used > 0 for every strategy
checks_total = checks_total + 1
let mut rb_ok = true
i = 0
while i < n {
    if USED_BLOCKS[i] <= 0 { rb_ok = false }
    if ALLOCATED_BLOCKS[i] < USED_BLOCKS[i] { rb_ok = false }
    i = i + 1
}
if rb_ok {
    print("  [PASS] ranges valid (allocated ≥ used > 0 for all strategies)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] range invariant broken (allocated < used OR used ≤ 0)")
}

// check 3 — perfect synthetic (alloc = used = 100 → 100% util · 10000)
checks_total = checks_total + 1
let synth_util = (100 * 10000) / 100
if synth_util == 10000 {
    print("  [PASS] synthetic perfect-fit (alloc = used) → util = 10000 (100% · zero waste)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] perfect-fit synthetic ≠ 10000")
}

// check 4 — contiguous_padded (idx 3) + static_maxlen (idx 4) fire (util < 50%)
checks_total = checks_total + 1
// contiguous_padded: 100·10000/220 = 4545 < 5000 → fires
// static_maxlen:     100·10000/250 = 4000 < 5000 → fires
if falsifier_fires(3) && falsifier_fires(4) {
    print("  [PASS] contiguous_padded (util=" + to_string(utilization_x100(3)) + ") · static_maxlen (util=" + to_string(utilization_x100(4)) + ") fire (< 5000 · over-allocation)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] contiguous_padded/static_maxlen fire detection broken")
}

// check 5 — paged_vllm (0) · paged_conservative (1) · dynamic_good (2) silent (util ≥ 50%)
checks_total = checks_total + 1
// paged_vllm: 9523 ≥ 5000 · paged_conservative: 8695 ≥ 5000 · dynamic_good: 9090 ≥ 5000
if falsifier_fires(0) == false && falsifier_fires(1) == false && falsifier_fires(2) == false {
    print("  [PASS] paged_vllm (util=" + to_string(utilization_x100(0)) + ") · paged_conservative (util=" + to_string(utilization_x100(1)) + ") · dynamic_good (util=" + to_string(utilization_x100(2)) + ") silent (≥ 5000) — false-positive 회피")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] paged_vllm/paged_conservative/dynamic_good silent detection broken")
}

// check 6 — determinism
checks_total = checks_total + 1
if utilization_x100(3) == utilization_x100(3) && falsifier_fires(4) == falsifier_fires(4) && waste_x100(0) == waste_x100(0) {
    print("  [PASS] deterministic (re-call same util + waste + fires)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] non-deterministic")
}

// check 7 — sanity: allocated ≥ used (over-allocation only · under-allocation 불가)
checks_total = checks_total + 1
let mut over_ok = true
i = 0
while i < n {
    // KV-cache 는 항상 used 이상을 할당 → util ≤ 100% (10000). under-allocation 은 모델 불가능 상태.
    if ALLOCATED_BLOCKS[i] < USED_BLOCKS[i] { over_ok = false }
    if utilization_x100(i) > 10000 { over_ok = false }
    i = i + 1
}
if over_ok {
    print("  [PASS] over-allocation sanity: allocated ≥ used → util ≤ 100% (under-allocation 불가)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] over-allocation sanity broken (util > 100% OR allocated < used)")
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 STRUCTURAL (utilization identity + over-allocation sanity 7/7) + 🟡 BY-CITATION (50% util threshold = vLLM PagedAttention / Pope 2022 inference-scaling convention)"
} else {
    verdict_tier = "🔴 FALSIFIED — utilization formula contradicts identity (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
}
print("  " + verdict_tier)
print("")
print("LONG-CONTEXT N2 finding (closed-form):")
print("  - KV-cache utilization = used_blocks / allocated_blocks identity (7/7 closed-form checks)")
print("  - bidirectional discrimination: paged_vllm · paged_conservative · dynamic_good silent · contiguous_padded · static_maxlen fire (< 50%)")
print("  - over-allocation sanity: allocated ≥ used → util ≤ 100% (paged attention block-granular vs max_len 통째 예약)")
print("  - external anchor: Kwon 2023 vLLM PagedAttention · Sheng 2023 FlexGen · Hooper 2024 KVQuant · Pope 2022 inference scaling")
print("  - 실측 (cycle-10+ T4): vLLM gpu_memory_utilization vs KV-cache block stats on serving stack")
print("")
print("__HEXA_CODEX_NUMERICS_LONG_CONTEXT_N2__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/LONG-CONTEXT/verdicts/n2_kv_cache_efficiency_verdict.txt"

let mut content = "# hexa-codex LONG-CONTEXT N2 — KV-cache utilization verifier (cycle-10 reorg Batch C)\n"
content = content + "# axis=LONG-CONTEXT/LONG-CONTEXT.md::N2 (KV-cache 메모리 효율 · paged attention utilization vs over-allocation fragmentation)\n"
content = content + "# bench=LONG-CONTEXT/bench/long_context_n2_kv_cache_efficiency.hexa\n"
content = content + "# verifier=LONG-CONTEXT/verify/numerics_long_context_n2_kv_cache_efficiency.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# formula=utilization = used_blocks / allocated_blocks (× 10000); waste = 100 − util; falsifier_fires = util < 50%\n"
content = content + "# placeholder_data=5 cache strategies · used=100 fixed · paged_vllm/paged_conservative/dynamic_good silent (≥50%) · contiguous_padded/static_maxlen fire (<50%)\n"
content = content + "# over_allocation_sanity=allocated ≥ used → util ≤ 100% (under-allocation 불가; paged block-granular vs max_len 통째 예약)\n"
content = content + "# external_anchors=Kwon 2023 vLLM PagedAttention (arXiv:2309.06180) · Sheng 2023 FlexGen (arXiv:2303.06865) · Hooper 2024 KVQuant (arXiv:2401.18079) · Pope 2022 efficiently scaling transformer inference (arXiv:2211.05102)\n"
content = content + "# substrate_fire=DEFERRED (cycle-10+ · vLLM gpu_memory_utilization vs KV-cache block stats on serving stack)\n"
content = content + "# frontier_open=feedback_closure_is_physical_limit — identity close ≠ measured close\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
