#!hexa strict
// hexa-codex/verify/numerics_economics_oracle_optimal.hexa — closed-form
// instance-optimal $/task oracle floor on the 20-task economics-routing
// manifest.
//
// PURPOSE.  Compute the INSTANCE-OPTIMAL oracle floor: for each task i,
//
//   oracle_floor_i  =  min { cost(s, i)  |  s ∈ S,  correct(s, i) = 1 }
//
// where S = {baseline, length3, length2} is the empirical strategy grid
// actually sampled in `.verdicts/economics-routing-savings/2tier.tsv`.
// Sum over i to get the manifest oracle floor:
//
//   oracle_total  =  Σ_{i=1..20} oracle_floor_i.
//
// This is the SECOND independent BLUE-tier formal proof of a lower bound
// on $/task at 20/20 accuracy for this manifest. The cycle-2 5bbb9ad
// proof (`verify/numerics_economics_pareto_floor.hexa`) framed the same
// quantity as a distribution-level analytic Pareto floor; THIS proof
// frames it as a per-task argmin over the empirical strategy grid. Both
// are closed-form, both read the same 2tier.tsv source data, and they
// MUST agree exactly (modulo tie-break selection, |gap| ≤ 1e-12 USD).
//
// HONEST CALIBRATION.  Because the sampled strategy grid S in
// 2tier.tsv is EXACTLY the set {baseline, length3, length2} that the
// pareto_floor proof also operates over, the oracle floor computed
// here equals the pareto_floor by construction (same per-task argmin,
// same data). The value of THIS proof is not a tighter bound — it is
// an INDEPENDENT recomputation from a different framing that confirms
// the previous result. If a richer strategy grid were sampled (e.g.
// adding class / dlg / threshold_sweep tiers as orthogonal strategies),
// the oracle floor could in principle drop below pareto_floor; here it
// does not, and we report that honestly. See check 8 (ε-gap = 0).
//
// Verified invariants (10 checks):
//
//   1. data shape — 2tier.tsv produces a 3×20 cost matrix (60 cells),
//      reconciled to the COST table inlined below
//   2. every task has ≥1 correct strategy (else oracle is unbounded;
//      task 14 has baseline=0 but length3=length2=1, so still OK)
//   3. oracle_floor is finite (sum of 20 per-task minima, all > 0)
//   4. oracle_floor ≤ length2_cost ($0.058171, the canonical 2-tier
//      at 20/20 accuracy with 81.79% saving)
//   5. oracle_floor ≤ length3_cost ($0.079218, the 3-tier ablation)
//   6. oracle_floor ≤ baseline_cost ($0.319375, opus×20)
//   7. oracle_saving_pct ≥ length2_saving_pct (81.79%) — strict ≥
//   8. ε-agreement: |oracle_floor − pareto_floor| ≤ 1e-9 USD.
//      The two BLUE proofs operate on identical {baseline, length3,
//      length2} data, so they MUST agree exactly up to float rounding.
//      A genuine gap would indicate a witness construction bug.
//   9. ORACLE_TIER_IDX[i] is the per-task argmin{cost(s,i) | correct
//      (s,i)=1} for all i ∈ [1,20] (witness consistency)
//  10. length2 within ε of oracle: length2_cost − oracle_floor ≤ 0.005
//      USD on this manifest (the canonical 2-tier captures essentially
//      all achievable saving among sampled strategies)
//
// PASS criterion: 10/10 at math_pure precision.
//
// Run:
//   HEXA_SHIM_NO_DARWIN_LANDING=1 RESOURCE_LOCAL_HEXA=1 \
//     HEXA_CODEX_ROOT="$PWD" \
//     ~/.hx/packages/hexa/hexa.real run verify/numerics_economics_oracle_optimal.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="Pure local verifier; integer + float arithmetic only. No atlas atoms touched.")

use "self/runtime/math_pure"

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()

// ── per-task cost matrix (USD) — verbatim from 2tier.tsv ────────────────
//
// Rows i=1..20.  Columns: [BASELINE, LENGTH3, LENGTH2].
//
// Indices: 0=baseline, 1=length3, 2=length2.
let BASELINE_IDX = 0
let LENGTH3_IDX  = 1
let LENGTH2_IDX  = 2

let COST = [
    [0.01528275,  0.0073117500000000005, 0.0011364],          // 1
    [0.015263,    0.0022310000000000003, 0.00252585],         // 2
    [0.015353499999999999, 0.00204735,   0.001144],           // 3
    [0.01476125,  0.00254435,            0.0011438],          // 4
    [0.01531625,  0.0025736,             0.0011627],          // 5
    [0.01528075,  0.00254435,            0.0011388000000000001], // 6
    [0.015257,    0.0025343500000000003, 0.0011338],          // 7
    [0.01536,     0.0026023500000000002, 0.0011641999999999998], // 8
    [0.015332250000000002, 0.0025683499999999996, 0.0011589999999999999], // 9
    [0.015454,    0.00380255,            0.0011614],          // 10
    [0.0159485,   0.0022866,             0.0013955],          // 11
    [0.01502375,  0.00261435,            0.0006774],          // 12
    [0.015681999999999998, 0.0026636,    0.0034285500000000003], // 13
    [0.0156095,   0.0026686,             0.0026737],          // 14
    [0.01707275,  0.00339435,            0.00339945],         // 15
    [0.018947750000000003, 0.00452935,   0.00454945],         // 16
    [0.0179485,   0.0166296,             0.0165348],          // 17
    [0.016786,    0.0063688500000000006, 0.0050389499999999995], // 18
    [0.016785249999999998, 0.0037530999999999997, 0.0038481999999999995], // 19
    [0.0169105,   0.0035496,             0.0037546999999999997], // 20
]

// Per-task accuracy: 1 = correct, 0 = wrong. Verbatim from 2tier.tsv.
// Task 14 baseline = 0 (baseline answered "{1,2,3}" not "1, 2, 3"
// substring — the only baseline miss on this manifest, hence 19/20).
let CORRECT = [
    [1, 1, 1],  // 1
    [1, 1, 1],  // 2
    [1, 1, 1],  // 3
    [1, 1, 1],  // 4
    [1, 1, 1],  // 5
    [1, 1, 1],  // 6
    [1, 1, 1],  // 7
    [1, 1, 1],  // 8
    [1, 1, 1],  // 9
    [1, 1, 1],  // 10
    [1, 1, 1],  // 11
    [1, 1, 1],  // 12
    [1, 1, 1],  // 13
    [0, 1, 1],  // 14   ← lone baseline miss
    [1, 1, 1],  // 15
    [1, 1, 1],  // 16
    [1, 1, 1],  // 17
    [1, 1, 1],  // 18
    [1, 1, 1],  // 19
    [1, 1, 1],  // 20
]

// Per-task ORACLE witness — the argmin strategy index that solves task i
// most cheaply among CORRECT=1 strategies (instance-optimal assignment).
// Constructed by direct argmin over COST[i][*] restricted to CORRECT[i][*]=1.
// Tie-break (operationally cheapest dispatch surface): LENGTH2 > LENGTH3 > BASELINE.
let ORACLE_TIER_IDX = [
    LENGTH2_IDX,   // 1   (l2 $0.001136 < l3 $0.007312 < baseline)
    LENGTH3_IDX,   // 2   (l3 $0.002231 < l2 $0.002526 < baseline)
    LENGTH2_IDX,   // 3   (l2 $0.001144 < l3 $0.002047 < baseline)
    LENGTH2_IDX,   // 4   (l2 $0.001144)
    LENGTH2_IDX,   // 5   (l2 $0.001163)
    LENGTH2_IDX,   // 6   (l2 $0.001139)
    LENGTH2_IDX,   // 7   (l2 $0.001134)
    LENGTH2_IDX,   // 8   (l2 $0.001164)
    LENGTH2_IDX,   // 9   (l2 $0.001159)
    LENGTH2_IDX,   // 10  (l2 $0.001161)
    LENGTH2_IDX,   // 11  (l2 $0.001396)
    LENGTH2_IDX,   // 12  (l2 $0.000677)
    LENGTH3_IDX,   // 13  (l3 $0.002664 < l2 $0.003429)
    LENGTH3_IDX,   // 14  (baseline=0 excluded; l3 $0.002669 < l2 $0.002674)
    LENGTH3_IDX,   // 15  (l3 $0.003394 < l2 $0.003399)
    LENGTH3_IDX,   // 16  (l3 $0.004529 < l2 $0.004549)
    LENGTH2_IDX,   // 17  (l2 $0.016535 < l3 $0.016630)
    LENGTH2_IDX,   // 18  (l2 $0.005039 < l3 $0.006369)
    LENGTH3_IDX,   // 19  (l3 $0.003753 < l2 $0.003848)
    LENGTH3_IDX,   // 20  (l3 $0.003550 < l2 $0.003755)
]

let N_TASKS = 20
let N_STRATS = 3

// ── reconciliation anchors (from 2tier_summary.txt header) ────────────
let BASELINE_TOTAL_REF = 0.319375
let LENGTH3_TOTAL_REF  = 0.0792181
let LENGTH2_TOTAL_REF  = 0.0581707
let LENGTH2_SAVING_REF = 81.7861

// Pareto floor cross-check: the cycle-2 5bbb9ad analytic-Pareto proof
// publishes its FLOOR_TIER_IDX over the same {baseline, length3, length2}
// grid. We recompute it inline below from COST + CORRECT and check
// ε-agreement against the oracle floor (check 8). The published cycle-2
// value (manifest-conditional) is $0.05677995 (see pareto_floor_summary.txt).
let PARETO_FLOOR_REF = 0.05677995

let FALSIFIERS = [
    "ECONOMICS instance-optimal oracle $/task floor: per-task argmin certificate · independent BLUE proof joining cycle-2 5bbb9ad",
]

// ── helpers ───────────────────────────────────────────────────────────

let mut RUN = 0
let mut FAIL = 0
let mut FAILURES = []

fn _check(ok: bool, label: str, detail: str) {
    RUN = RUN + 1
    if ok {
        println("  [PASS] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    } else {
        FAIL = FAIL + 1
        FAILURES.push(label + " :: " + detail)
        println("  [FAIL] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    }
}

fn _abs(x: float) -> float { return abs_pure(x) }

fn col_sum(col: int) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < N_TASKS {
        s = s + COST[i][col]
        i = i + 1
    }
    return s
}

fn oracle_total() -> float {
    let mut s = 0.0
    let mut i = 0
    while i < N_TASKS {
        let t = ORACLE_TIER_IDX[i]
        s = s + COST[i][t]
        i = i + 1
    }
    return s
}

// Recompute the pareto floor inline (per-task argmin restricted to
// correct=1) so that check 8 compares the oracle floor against an
// independently-derived pareto floor from THIS file's COST/CORRECT,
// not just the published reference constant.
fn pareto_floor_inline() -> float {
    let mut s = 0.0
    let mut i = 0
    while i < N_TASKS {
        // find min cost across correct=1 strategies for task i
        let mut min_cost = -1.0
        let mut j = 0
        while j < N_STRATS {
            if CORRECT[i][j] == 1 {
                if min_cost < 0.0 {
                    min_cost = COST[i][j]
                } else {
                    if COST[i][j] < min_cost { min_cost = COST[i][j] }
                }
            }
            j = j + 1
        }
        s = s + min_cost
        i = i + 1
    }
    return s
}

fn saving_pct(b_cost: float, x_cost: float) -> float {
    return ((b_cost - x_cost) / b_cost) * 100.0
}

// ── checks ────────────────────────────────────────────────────────────

// Check 1: data shape — 60 cells (3 strategies × 20 tasks), and column
// sums reconcile to 2tier_summary header.
fn check_data_shape() {
    let cells = N_TASKS * N_STRATS
    let b = col_sum(BASELINE_IDX)
    let l3 = col_sum(LENGTH3_IDX)
    let l2 = col_sum(LENGTH2_IDX)
    let d_b  = _abs(b - BASELINE_TOTAL_REF)
    let d_l3 = _abs(l3 - LENGTH3_TOTAL_REF)
    let d_l2 = _abs(l2 - LENGTH2_TOTAL_REF)
    let ok = (cells == 60) && (d_b < 1.0e-5) && (d_l3 < 1.0e-5) && (d_l2 < 1.0e-5)
    _check(ok,
           "data shape: 3×20 grid (60 cells), column sums reconcile to 2tier_summary header",
           "cells=" + str(cells) +
           "  drift_b=" + to_string(d_b) +
           "  drift_l3=" + to_string(d_l3) +
           "  drift_l2=" + to_string(d_l2))
}

// Check 2: every task has ≥1 correct strategy (else oracle unbounded).
fn check_every_task_has_correct() {
    let mut bad = 0
    let mut bad_idx = -1
    let mut i = 0
    while i < N_TASKS {
        let mut k = 0
        let mut j = 0
        while j < N_STRATS {
            if CORRECT[i][j] == 1 { k = k + 1 }
            j = j + 1
        }
        if k < 1 {
            if bad == 0 { bad_idx = i + 1 }
            bad = bad + 1
        }
        i = i + 1
    }
    _check(bad == 0,
           "every task has ≥1 correct strategy in sampled grid (oracle is defined for all i)",
           "tasks_without_correct=" + str(bad) +
           (if bad > 0 { " first_bad=" + str(bad_idx) } else { "" }))
}

// Check 3: oracle floor is finite (positive sum of 20 per-task minima).
fn check_oracle_finite() {
    let f = oracle_total()
    _check(f > 0.0,
           "oracle_floor is finite and positive (sum of 20 per-task minima)",
           "oracle_floor=$" + to_string(f))
}

// Check 4: oracle_floor ≤ length2_cost.
fn check_oracle_le_length2() {
    let f = oracle_total()
    let l2 = col_sum(LENGTH2_IDX)
    _check(f <= l2 + 1.0e-12,
           "oracle_floor ≤ length2_cost (manifest-level lower-bound property)",
           "oracle=$" + to_string(f) +
           "  length2=$" + to_string(l2) +
           "  gap=$" + to_string(l2 - f))
}

// Check 5: oracle_floor ≤ length3_cost.
fn check_oracle_le_length3() {
    let f = oracle_total()
    let l3 = col_sum(LENGTH3_IDX)
    _check(f <= l3 + 1.0e-12,
           "oracle_floor ≤ length3_cost (3-tier ablation also above floor)",
           "oracle=$" + to_string(f) +
           "  length3=$" + to_string(l3) +
           "  gap=$" + to_string(l3 - f))
}

// Check 6: oracle_floor ≤ baseline_cost (opus×20).
fn check_oracle_le_baseline() {
    let f = oracle_total()
    let b = col_sum(BASELINE_IDX)
    _check(f <= b + 1.0e-12,
           "oracle_floor ≤ baseline_cost (opus×20 is far above floor)",
           "oracle=$" + to_string(f) +
           "  baseline=$" + to_string(b) +
           "  gap=$" + to_string(b - f))
}

// Check 7: oracle_saving_pct ≥ length2_saving_pct.
fn check_oracle_saving_ge_length2() {
    let b = col_sum(BASELINE_IDX)
    let f = oracle_total()
    let l2 = col_sum(LENGTH2_IDX)
    let f_sav  = saving_pct(b, f)
    let l2_sav = saving_pct(b, l2)
    _check(f_sav + 1.0e-9 >= l2_sav,
           "oracle_saving% ≥ length2_saving% (saving monotone-decreasing in cost)",
           "oracle_saving=" + to_string(f_sav) + "%" +
           "  length2_saving=" + to_string(l2_sav) + "%" +
           "  Δ=" + to_string(f_sav - l2_sav) + "pp")
}

// Check 8: ε-agreement with pareto_floor (independent BLUE proof).
// Two formal proofs over the SAME {baseline, length3, length2} grid
// must agree exactly modulo float rounding (target |gap| ≤ 1e-9 USD).
// We also cross-check against the published cycle-2 5bbb9ad reference
// constant PARETO_FLOOR_REF ($0.05677995).
fn check_pareto_eps_agreement() {
    let oracle = oracle_total()
    let pareto_inline = pareto_floor_inline()
    let gap_inline = _abs(oracle - pareto_inline)
    let gap_ref = _abs(oracle - PARETO_FLOOR_REF)
    let ok = (gap_inline < 1.0e-9) && (gap_ref < 1.0e-4)
    _check(ok,
           "ε-agreement: |oracle − pareto_floor| ≤ 1e-9 USD inline; ≤ 1e-4 vs cycle-2 5bbb9ad ref",
           "oracle=$" + to_string(oracle) +
           "  pareto_inline=$" + to_string(pareto_inline) +
           "  pareto_ref=$" + to_string(PARETO_FLOOR_REF) +
           "  gap_inline=$" + to_string(gap_inline) +
           "  gap_ref=$" + to_string(gap_ref))
}

// Check 9: ORACLE_TIER_IDX is the per-task argmin{cost | correct=1}.
fn check_oracle_witness_consistent() {
    let mut bad = 0
    let mut bad_idx = -1
    let mut i = 0
    while i < N_TASKS {
        let t = ORACLE_TIER_IDX[i]
        // The selected strategy must be correct.
        if CORRECT[i][t] != 1 {
            if bad == 0 { bad_idx = i + 1 }
            bad = bad + 1
            i = i + 1
            continue
        }
        let c_pick = COST[i][t]
        // It must equal the true argmin over correct=1 strategies.
        let mut min_cost = c_pick
        let mut j = 0
        while j < N_STRATS {
            if CORRECT[i][j] == 1 {
                if COST[i][j] < min_cost { min_cost = COST[i][j] }
            }
            j = j + 1
        }
        if _abs(c_pick - min_cost) > 1.0e-12 {
            if bad == 0 { bad_idx = i + 1 }
            bad = bad + 1
        }
        i = i + 1
    }
    _check(bad == 0,
           "ORACLE_TIER_IDX[i] is the per-task argmin{cost(s,i) | correct(s,i)=1} for all 20 tasks",
           "mismatches=" + str(bad) +
           (if bad > 0 { " first_bad_task=" + str(bad_idx) } else { "" }))
}

// Check 10: length2 within ε of oracle (length2_cost − oracle ≤ 0.005 USD).
// On this manifest the canonical 2-tier length router captures essentially
// all achievable saving among sampled strategies.
fn check_length2_within_eps() {
    let f = oracle_total()
    let l2 = col_sum(LENGTH2_IDX)
    let delta = l2 - f
    _check(delta <= 0.005 + 1.0e-9,
           "length2_cost − oracle_floor ≤ 0.005 USD (length2 within ε of oracle on this manifest)",
           "delta=$" + to_string(delta) +
           "  oracle=$" + to_string(f) +
           "  length2=$" + to_string(l2))
}

// ── main ─────────────────────────────────────────────────────────────

fn main() {
    println("========================================================================")
    println("  hexa-codex ECONOMICS instance-optimal oracle $/task floor")
    println("  20-task manifest · per-task argmin certificate · INDEPENDENT BLUE proof")
    println("  joining cycle-2 5bbb9ad (verify/numerics_economics_pareto_floor.hexa)")
    println("========================================================================")

    let b = col_sum(BASELINE_IDX)
    let l3 = col_sum(LENGTH3_IDX)
    let l2 = col_sum(LENGTH2_IDX)
    let f = oracle_total()
    let p_inline = pareto_floor_inline()
    let l3_sav = saving_pct(b, l3)
    let l2_sav = saving_pct(b, l2)
    let f_sav  = saving_pct(b, f)
    let delta_l2 = l2 - f
    let gap_pareto = _abs(f - p_inline)

    println("  baseline (opus×20)        : $" + to_string(b)  + "  (saving = baseline reference)")
    println("  length3  (haiku/son/opus) : $" + to_string(l3) + "  saving=" + to_string(l3_sav) + "%")
    println("  length2  (sonnet/opus)    : $" + to_string(l2) + "  saving=" + to_string(l2_sav) + "%")
    println("  ORACLE  (argmin-witness)  : $" + to_string(f)  + "  saving=" + to_string(f_sav) + "%")
    println("  pareto_floor (inline)     : $" + to_string(p_inline))
    println("  length2 − oracle gap      : $" + to_string(delta_l2))
    println("  oracle − pareto_floor gap : $" + to_string(gap_pareto))
    println("")

    check_data_shape()
    check_every_task_has_correct()
    check_oracle_finite()
    check_oracle_le_length2()
    check_oracle_le_length3()
    println("")
    check_oracle_le_baseline()
    check_oracle_saving_ge_length2()
    check_pareto_eps_agreement()
    check_oracle_witness_consistent()
    check_length2_within_eps()

    println("")
    println("========================================================================")
    let pass_n = RUN - FAIL
    println("  " + str(pass_n) + "/" + str(RUN) + " checks passed")
    if FAIL > 0 {
        println("  FAILURES:")
        for ff in FAILURES { println("    ✗ " + ff) }
        println("__HEXA_CODEX_NUMERICS_ECONOMICS_ORACLE_OPTIMAL__ FAIL")
        println("🔴 FALSIFIED")
        exit(1)
    }
    println("  🔵 ORACLE FLOOR closed: $" + to_string(f) +
            " (saving " + to_string(f_sav) + "%)" +
            " · length2 within $" + to_string(delta_l2) + " of oracle" +
            " · pareto_floor agrees within ε=$" + to_string(gap_pareto))
    println("  Instance-optimal $/task lower bound (manifest-conditional) certified.")
    println("__HEXA_CODEX_NUMERICS_ECONOMICS_ORACLE_OPTIMAL__ PASS")
    exit(0)
}
