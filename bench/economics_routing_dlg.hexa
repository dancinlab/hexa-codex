#!hexa strict
// bench/economics_routing_dlg.hexa — Claude Code CLI 4-strategy routing benchmark.
//
// Four strategies on a 20-task fixed manifest (identical to
// bench/economics_routing.hexa + economics_routing_class.hexa for parity):
//   baseline : every task → claude --bare -p --model opus (always-opus)
//   router   : every task → tier picked by prompt-length heuristic
//                 len <=  30  → haiku
//                 len <=  80  → sonnet
//                 else        → opus
//   class    : every task → tier picked by regex prompt-class heuristic
//                 trivial-fact prefix → haiku; code/explain token → sonnet; else opus
//   dlg      : every task → tier picked by the DLG-mk0 learned-style classifier
//                 (lm_foundry/tool/classify_prompt.py + select_vendor_tier.py),
//                 bridged to a Claude tier by lm_foundry/tool/dlg_mk0_wrapper.py:
//                   label=hexa   → sonnet (local-ish mid stand-in)
//                   label=refuse → haiku  (cheap canned refusal)
//                   label=ood    → select_vendor_tier → cost-class → {opus|sonnet|haiku}
//
// Each call captured via `--output-format json` — fields used:
//   total_cost_usd · duration_ms · result · usage.{input,output}_tokens
//
// Per task, correctness = expected_kw substring present (case-insensitive)
// in result string.
//
// Output per-task TSV to .verdicts/economics-routing-savings/<strategy>.tsv
// and a 4-strategy dlg_summary.txt comparison.
//
// Run:
//   ANTHROPIC_API_KEY=$(secret get anthropic.api_key) \
//     HEXA_SHIM_NO_DARWIN_LANDING=1 RESOURCE_LOCAL_HEXA=1 \
//     HEXA_CODEX_ROOT="$PWD" \
//     ~/.hx/packages/hexa/hexa.real run bench/economics_routing_dlg.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="External CLI subprocess + JSON parse — no atlas atoms touched.")

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()
let OUT_DIR = ROOT + "/.verdicts/economics-routing-savings"
let DLG_WRAPPER = ROOT + "/lm_foundry/tool/dlg_mk0_wrapper.py"

// 20-task fixed manifest — identical to the 2- and 3-strategy benches for parity.
let TASKS = [
    ["What is 2+2? Reply with the digit only.",                                                    "4"],
    ["Capital of France? One word.",                                                                "paris"],
    ["Reverse the string 'hello'. Reply with the reversed string only.",                            "olleh"],
    ["Square of 7? Reply with the number only.",                                                    "49"],
    ["First prime number greater than 10? Reply with the number only.",                             "11"],
    ["Smallest prime number? Reply with the number only.",                                          "2"],
    ["How many continents? Reply with the number only.",                                            "7"],
    ["Boiling point of water in Celsius at sea level? Reply with the number only.",                 "100"],
    ["ASCII decimal code for 'A'? Reply with the number only.",                                     "65"],
    ["Days in February 2024? Reply with the number only.",                                          "29"],
    ["Write a Python one-liner that sums integers 1..100. Reply with code only.",                   "sum(range"],
    ["Time complexity of binary search? Reply with big-O only.",                                    "log n"],
    ["Python: reverse a list lst in one expression. Reply with the expression only.",               "[::-1]"],
    ["Sort {3,1,2} ascending. Reply with the result only.",                                         "1, 2, 3"],
    ["TCP vs UDP in one sentence — which is connection-oriented?",                                  "tcp"],
    ["Explain BFS vs DFS in 2 sentences.",                                                          "breadth"],
    ["Write Python Fibonacci with memoization (use functools.cache).",                              "fib"],
    ["Convert binary 1101 to decimal, show one-line sum.",                                          "13"],
    ["Why is mergesort O(n log n)? One-sentence justification.",                                    "merge"],
    ["Halting problem — what is it? One sentence.",                                                  "halt"],
]

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn pick_tier_router(prompt: str) -> str {
    let n = prompt.len()
    if n <= 30 { return "haiku" }
    if n <= 80 { return "sonnet" }
    return "opus"
}

fn pick_tier_baseline(prompt: str) -> str {
    return "opus"
}

// Regex-based prompt-class router (identical to economics_routing_class.hexa).
fn pick_tier_class(prompt: str) -> str {
    let p = prompt.to_lower()

    let trivial_prefixes = [
        "what is", "capital of", "how many", "when", "where",
        "smallest", "first prime", "days in", "ascii", "reverse",
        "square of", "boiling",
    ]
    let mut i = 0
    while i < len(trivial_prefixes) {
        if p.starts_with(trivial_prefixes[i]) { return "haiku" }
        i = i + 1
    }

    let code_tokens = [
        "python", "code", "function", "implement", "sort",
        "reverse a list", "one-liner", "complexity",
    ]
    i = 0
    while i < len(code_tokens) {
        if p.contains(code_tokens[i]) { return "sonnet" }
        i = i + 1
    }

    let explain_tokens = [
        "explain", "why", "justify", "describe", "sentence",
        "compare", "difference between",
    ]
    i = 0
    while i < len(explain_tokens) {
        if p.contains(explain_tokens[i]) { return "sonnet" }
        i = i + 1
    }

    return "opus"
}

// DLG-mk0 learned-style router. Shells out to the pure-python classifier
// wrapper, which prints one of {haiku, sonnet, opus} on stdout.
fn pick_tier_dlg(prompt: str) -> str {
    let t = exec("python3 " + DLG_WRAPPER + " " + shq(prompt)).trim()
    if t == "haiku" { return "haiku" }
    if t == "sonnet" { return "sonnet" }
    if t == "opus" { return "opus" }
    // Defensive fallback — if the wrapper errors, default mid (sonnet).
    return "sonnet"
}

// Run one task. Returns 7 tab-separated fields:
//   cost \t duration_ms \t input_tokens \t output_tokens \t result_snippet \t model \t correct(1|0)
fn run_one(prompt: str, model: str, expected_kw: str) -> str {
    let cmd = "claude --bare -p --output-format json --model " + model + " " + shq(prompt) +
              " 2>/dev/null | jq -r --arg kw " + shq(expected_kw) +
              " '[" +
              ".total_cost_usd, .duration_ms, .usage.input_tokens, .usage.output_tokens, " +
              "(.result // \"\" | gsub(\"[\\n\\t]\"; \" \")), " +
              "(.modelUsage | keys[0]), " +
              "((.result // \"\") | ascii_downcase | contains($kw | ascii_downcase) | " +
              "if . then \"1\" else \"0\" end)" +
              "] | @tsv'"
    return exec(cmd).trim()
}

// Run a strategy across all tasks. Append per-task rows to a verdict file.
// strategy_mode: "baseline" | "router" | "class" | "dlg"
// Returns "total_cost\ttotal_ms\tn_correct\tn_total".
fn run_strategy(name: str, strategy_mode: str) -> str {
    let path = OUT_DIR + "/" + name + ".tsv"
    exec("rm -f " + shq(path))
    exec("mkdir -p " + shq(OUT_DIR))
    exec("echo 'task_idx\tmodel\tcost_usd\tduration_ms\tinput_tokens\toutput_tokens\tcorrect\tresult_snippet' >> " + shq(path))

    let mut total_cost = 0.0
    let mut total_ms   = 0
    let mut n_correct  = 0
    let mut i = 0
    while i < len(TASKS) {
        let task = TASKS[i]
        let prompt = task[0]
        let expected = task[1]
        let mut model = "opus"
        if strategy_mode == "baseline" { model = pick_tier_baseline(prompt) }
        if strategy_mode == "router"   { model = pick_tier_router(prompt) }
        if strategy_mode == "class"    { model = pick_tier_class(prompt) }
        if strategy_mode == "dlg"      { model = pick_tier_dlg(prompt) }
        println("  [" + name + " " + str(i+1) + "/" + str(len(TASKS)) + "] model=" + model + " prompt=" + prompt.substr(0, 50))
        let line = run_one(prompt, model, expected)
        let parts = line.split("\t")
        if parts.len() < 7 {
            println("    ! parse error, raw=" + line)
            i = i + 1
            continue
        }
        let cost = to_float(parts[0])
        let ms   = int(parts[1])
        let in_t = parts[2]
        let out_t = parts[3]
        let result_snippet = parts[4].replace("\t", " ").replace("\n", " ")
        let model_used = parts[5]
        let correct = parts[6]
        total_cost = total_cost + cost
        total_ms = total_ms + ms
        if correct == "1" { n_correct = n_correct + 1 }
        let row = str(i+1) + "\t" + model_used + "\t" + parts[0] + "\t" + parts[1] + "\t" +
                  in_t + "\t" + out_t + "\t" + correct + "\t" + result_snippet.substr(0, 80)
        exec("echo " + shq(row) + " >> " + shq(path))
        i = i + 1
    }
    return to_string(total_cost) + "\t" + str(total_ms) + "\t" + str(n_correct) + "\t" + str(len(TASKS))
}

fn saving_pct(b_cost: float, x_cost: float) -> float {
    if b_cost > 0.0 { return ((b_cost - x_cost) / b_cost) * 100.0 }
    return 0.0
}

fn main() {
    println("========================================================================")
    println("  bench/economics_routing_dlg — Claude Code CLI 4-strategy routing")
    println("  manifest: 20 tasks · 4 strategies (baseline · length · class · dlg-mk0)")
    println("  output:   " + OUT_DIR + "/{baseline,router,class,dlg}.tsv")
    println("========================================================================")

    println("")
    println("─── baseline strategy (always opus) ───")
    let b = run_strategy("baseline", "baseline")
    let bp = b.split("\t")
    let b_cost = to_float(bp[0])
    let b_ms   = int(bp[1])
    let b_acc  = int(bp[2])

    println("")
    println("─── router strategy (length-heuristic) ───")
    let r = run_strategy("router", "router")
    let rp = r.split("\t")
    let r_cost = to_float(rp[0])
    let r_ms   = int(rp[1])
    let r_acc  = int(rp[2])

    println("")
    println("─── class strategy (regex prompt-class) ───")
    let c = run_strategy("class", "class")
    let cp = c.split("\t")
    let c_cost = to_float(cp[0])
    let c_ms   = int(cp[1])
    let c_acc  = int(cp[2])

    println("")
    println("─── dlg strategy (DLG-mk0 classifier) ───")
    let d = run_strategy("dlg", "dlg")
    let dp = d.split("\t")
    let d_cost = to_float(dp[0])
    let d_ms   = int(dp[1])
    let d_acc  = int(dp[2])

    let r_sav = saving_pct(b_cost, r_cost)
    let c_sav = saving_pct(b_cost, c_cost)
    let d_sav = saving_pct(b_cost, d_cost)

    println("")
    println("========================================================================")
    println("  SUMMARY (4 strategies)")
    println("========================================================================")
    println("  baseline (opus×20)     : cost=$" + to_string(b_cost) + "  ms=" + str(b_ms) + "  correct=" + str(b_acc) + "/20")
    println("  router   (length tier) : cost=$" + to_string(r_cost) + "  ms=" + str(r_ms) + "  correct=" + str(r_acc) + "/20  saving=" + to_string(r_sav) + "%")
    println("  class    (regex class) : cost=$" + to_string(c_cost) + "  ms=" + str(c_ms) + "  correct=" + str(c_acc) + "/20  saving=" + to_string(c_sav) + "%")
    println("  dlg      (DLG-mk0)     : cost=$" + to_string(d_cost) + "  ms=" + str(d_ms) + "  correct=" + str(d_acc) + "/20  saving=" + to_string(d_sav) + "%")

    println("")
    println("  router savings : " + to_string(r_sav) + "% · acc Δ=" + str(r_acc - b_acc))
    println("  class  savings : " + to_string(c_sav) + "% · acc Δ=" + str(c_acc - b_acc))
    println("  dlg    savings : " + to_string(d_sav) + "% · acc Δ=" + str(d_acc - b_acc))
    println("  dlg − length savings Δ : " + to_string(d_sav - r_sav) + " pp (positive = dlg saves more)")

    // Persist 4-strategy summary
    let summary_path = OUT_DIR + "/dlg_summary.txt"
    exec("rm -f " + shq(summary_path))
    let header = "strategy\tcost_usd\tduration_ms\tcorrect\ttotal\tsaving_pct"
    exec("echo " + shq(header) + " >> " + shq(summary_path))
    exec("echo " + shq("baseline\t" + to_string(b_cost) + "\t" + str(b_ms) + "\t" + str(b_acc) + "\t20\t0.0") + " >> " + shq(summary_path))
    exec("echo " + shq("router\t"   + to_string(r_cost) + "\t" + str(r_ms) + "\t" + str(r_acc) + "\t20\t" + to_string(r_sav)) + " >> " + shq(summary_path))
    exec("echo " + shq("class\t"    + to_string(c_cost) + "\t" + str(c_ms) + "\t" + str(c_acc) + "\t20\t" + to_string(c_sav)) + " >> " + shq(summary_path))
    exec("echo " + shq("dlg\t"      + to_string(d_cost) + "\t" + str(d_ms) + "\t" + str(d_acc) + "\t20\t" + to_string(d_sav)) + " >> " + shq(summary_path))
    exec("echo " + shq("# router_savings_pct=" + to_string(r_sav)) + " >> " + shq(summary_path))
    exec("echo " + shq("# class_savings_pct="  + to_string(c_sav)) + " >> " + shq(summary_path))
    exec("echo " + shq("# dlg_savings_pct="    + to_string(d_sav)) + " >> " + shq(summary_path))
    exec("echo " + shq("# dlg_minus_length_pp=" + to_string(d_sav - r_sav)) + " >> " + shq(summary_path))

    println("")
    println("  summary persisted: " + summary_path)
    println("")
    println("__HEXA_CODEX_BENCH_ECONOMICS_ROUTING_DLG__ PASS")
    exit(0)
}
