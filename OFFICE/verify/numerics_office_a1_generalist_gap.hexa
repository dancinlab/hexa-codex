#!hexa strict
// OFFICE/verify/numerics_office_a1_generalist_gap.hexa
// OFFICE 신규 도메인 (cycle-10) — closed-form verifier for the generalist-vs-specialist
// gap ratio identity + 70% threshold falsifier semantics. OFFICE 는 VERTICAL/* (CODE·
// BIO·MATH... 12 전문 모델 = "한 분야 깊게") 의 horizontal 짝 — 범용 사무 (이메일·
// 요약·번역·문서·표·일정 6-task) generalist 능력 측정의 첫 probe.
//
// Asserts the ratio identity is closed-form and the falsifier (전문 못 따라감 detection)
// correctly classifies:
//   (1) ratio identity (office_multitask × 100 / specialist_avg) holds for all 5 models
//   (2) score values ∈ [0, 100 %] (× 100 ledger ∈ [0, 10000]) AND office ≤ specialist
//   (3) equal synthetic — office=spec=90% → ratio=100% → silent (generalist = specialist)
//   (4) weak_generalist fires (ratio 59% < 70% · office 55 ≪ spec 92 · 전문 못 따라감)
//   (5) gpt5/claude/gemini silent (ratio ≥ 70% · 강 generalist · 거의 대등) AND
//       tiny_general fires (ratio 43% < 70% · 전문 한참 못 따라감)
//   (6) determinism (re-call same ratio + fires)
//   (7) sanity — office ≤ specialist for all (generalist 분야별 깊이 못 넘음) AND ratio
//       ladder monotone: gpt5 ≥ claude ≥ gemini ≥ weak_generalist ≥ tiny_general
//
// Source: OFFICE/bench/office_a1_generalist_gap.hexa
// External anchors: Liang 2022 HELM (arXiv:2211.09110) · Hendrycks 2020 MMLU
//                   (arXiv:2009.03300) · Srivastava 2022 BIG-bench (arXiv:2206.04615) ·
//                   "Small is the New Big" DSLM specialist-swarm trend 2026
//
// @no-lock-needed

let MODEL_NAMES = ["gpt5_office", "claude_office", "gemini_office", "weak_generalist", "tiny_general"]

let MODEL_DATA = [8800, 9200,
                  8600, 9100,
                  8400, 9000,
                  5500, 9200,
                  4000, 9200]

let N_FIELDS = 2
let THRESHOLD_PCT = 70             // < 70% generalist ratio → 전문 모델 못 따라감
let SCORE_MAX_x100 = 100 * 100     // score × 100 ledger ∈ [0, 10000]

fn office_multitask_x100(model_i: int) -> int {
    return MODEL_DATA[model_i * N_FIELDS + 0]
}
fn specialist_avg_x100(model_i: int) -> int {
    return MODEL_DATA[model_i * N_FIELDS + 1]
}
fn generalist_ratio_pct(model_i: int) -> int {
    // generalist 6-task 사무 평균 as % of specialist 분야별 깊이 평균. Both operands
    // share the × 100 ledger so the × 100 factors cancel → result is plain percent.
    //   ratio% = office_multitask_x100 × 100 / specialist_avg_x100
    return (office_multitask_x100(model_i) * 100) / specialist_avg_x100(model_i)
}
fn falsifier_fires(model_i: int) -> bool {
    return generalist_ratio_pct(model_i) < THRESHOLD_PCT
}

print("hexa-codex OFFICE A1 falsifier — generalist-vs-specialist gap closed-form")
print("========================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0
let n_model = MODEL_NAMES.len()

// check 1 — ratio identity for all 5 models
checks_total = checks_total + 1
let mut id_ok = true
let mut i = 0
while i < n_model {
    let lhs = generalist_ratio_pct(i)
    let rhs = (office_multitask_x100(i) * 100) / specialist_avg_x100(i)
    if lhs != rhs { id_ok = false }
    i = i + 1
}
if id_ok {
    print("  [PASS] ratio identity (office_multitask × 100 / specialist_avg) holds for all " +
          to_string(n_model) + " models")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] ratio identity broken")
}

// check 2 — score values ∈ [0, 100 %] AND office ≤ specialist (generalist 깊이 못 넘음)
checks_total = checks_total + 1
let mut rb_ok = true
i = 0
while i < n_model {
    let mut f = 0
    while f < N_FIELDS {
        let v = MODEL_DATA[i * N_FIELDS + f]
        if v < 0 || v > SCORE_MAX_x100 { rb_ok = false }
        f = f + 1
    }
    if office_multitask_x100(i) > specialist_avg_x100(i) { rb_ok = false }
    i = i + 1
}
if rb_ok {
    print("  [PASS] score values ∈ [0, 100 %] (× 100 ledger ∈ [0, " +
          to_string(SCORE_MAX_x100) + "]) AND office ≤ specialist for all " +
          to_string(n_model) + " models")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] value out of range or office > specialist")
}

// check 3 — equal synthetic: office=spec=90% → ratio=100% → silent (generalist = specialist)
checks_total = checks_total + 1
let SYN = 9000  // 90% × 100
let syn_ratio = (SYN * 100) / SYN
if syn_ratio == 100 && syn_ratio >= THRESHOLD_PCT {
    print("  [PASS] synthetic equal (office=spec=90%) → ratio=100% · silent (generalist = specialist · 완전 대등)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] synthetic equal ratio=" + to_string(syn_ratio))
}

// check 4 — weak_generalist (idx 3) fires (ratio 59% < 70% · 전문 못 따라감)
checks_total = checks_total + 1
if falsifier_fires(3) && generalist_ratio_pct(3) == 59 {
    print("  [PASS] weak_generalist fires: ratio=" + to_string(generalist_ratio_pct(3)) +
          "% (office 55 ≪ spec 92) — < 70% · 전문 모델 못 따라감 · DSLM specialist swarm 정당화")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] weak_generalist fire detection broken (ratio=" + to_string(generalist_ratio_pct(3)) + ")")
}

// check 5 — gpt5/claude/gemini silent (ratio ≥ 70% · 강 generalist) AND tiny_general fires
checks_total = checks_total + 1
if falsifier_fires(0) == false && falsifier_fires(1) == false
        && falsifier_fires(2) == false && falsifier_fires(4) == true
        && generalist_ratio_pct(0) == 95 && generalist_ratio_pct(1) == 94
        && generalist_ratio_pct(2) == 93 && generalist_ratio_pct(4) == 43 {
    print("  [PASS] strong-generalist silent: gpt5_office ratio=" + to_string(generalist_ratio_pct(0)) +
          "% · claude_office=" + to_string(generalist_ratio_pct(1)) +
          "% · gemini_office=" + to_string(generalist_ratio_pct(2)) +
          "% (≥ 70% · 거의 대등 · 통합 이점) — AND tiny_general=" + to_string(generalist_ratio_pct(4)) +
          "% FIRES (전문 한참 못 따라감 · bidirectional)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] strong-generalist silent / tiny fire detection broken")
}

// check 6 — determinism (re-call same values)
checks_total = checks_total + 1
if generalist_ratio_pct(0) == generalist_ratio_pct(0)
        && falsifier_fires(3) == falsifier_fires(3)
        && generalist_ratio_pct(4) == generalist_ratio_pct(4) {
    print("  [PASS] formula deterministic (re-call same ratio + fires · recursively delicious)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] formula non-deterministic")
}

// check 7 — sanity: office ≤ specialist for all (generalist 분야별 깊이 못 넘음) AND ratio
//   ladder monotone (gpt5 ≥ claude ≥ gemini ≥ weak_generalist ≥ tiny_general · 등급 정합).
checks_total = checks_total + 1
let mut spec_dominates = true
i = 0
while i < n_model {
    if office_multitask_x100(i) > specialist_avg_x100(i) { spec_dominates = false }
    i = i + 1
}
let ladder_monotone = generalist_ratio_pct(0) >= generalist_ratio_pct(1)
        && generalist_ratio_pct(1) >= generalist_ratio_pct(2)
        && generalist_ratio_pct(2) >= generalist_ratio_pct(3)
        && generalist_ratio_pct(3) >= generalist_ratio_pct(4)
if spec_dominates && ladder_monotone {
    print("  [PASS] sanity — office ≤ specialist all (전문 깊이 우위) AND ratio ladder monotone (gpt5 ≥ claude ≥ gemini ≥ weak_generalist ≥ tiny_general)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] sanity broken (spec_dominates=" + to_string(spec_dominates) +
          " · ladder_monotone=" + to_string(ladder_monotone) + ")")
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 STRUCTURAL (ratio identity + 70% threshold semantics 7/7) + 🟡 BY-CITATION (placeholder data · 70% threshold = 전문-못-따라감 convention · cite Liang 2022 HELM arXiv:2211.09110 + Hendrycks 2020 MMLU arXiv:2009.03300 + Srivastava 2022 BIG-bench arXiv:2206.04615 + DSLM 'Small is the New Big' 2026)"
} else {
    verdict_tier = "🔴 FALSIFIED — generalist gap formula contradicts identity (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
}
print("  " + verdict_tier)
print("")
print("OFFICE A1 finding (VERTICAL 메타검증 · placeholder · closed-form):")
print("  - generalist_ratio_pct = office_multitask × 100 / specialist_avg identity (7/7 closed-form checks)")
print("  - bidirectional discrimination: gpt5_office=95% · claude_office=94% · gemini_office=93% silent (거의 대등 · 통합 이점) · weak_generalist=59% · tiny_general=43% fires (전문 못 따라감 · DSLM 정당화)")
print("  - external anchors: Liang 2022 (arXiv:2211.09110) · Hendrycks 2020 (arXiv:2009.03300) · Srivastava 2022 (arXiv:2206.04615) · DSLM 'Small is the New Big' 2026")
print("  - VERTICAL 메타검증: generalist 가 전문(specialist) 못 따라가면 (ratio < 70%) VERTICAL/* 12 전문 모델 존재 정당화 — generalist 대체론 반증")
print("  - 실측 (cycle-11+ T4): 6-task 사무 harness (이메일·요약·번역·문서·표·일정) vs 분야별 전문 모델 on SANDBOX + vast.ai pod (cx_lab_sandbox)")
print("")
print("__HEXA_CODEX_NUMERICS_OFFICE_A1__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/OFFICE/verdicts/a1_generalist_gap_verdict.txt"

let mut content = "# hexa-codex OFFICE A1 — generalist-vs-specialist gap verifier (VERTICAL 메타검증 · cycle-10)\n"
content = content + "# axis=OFFICE/OFFICE.md::A1 (generalist-vs-specialist gap · 5 models · 70% generalist-ratio threshold)\n"
content = content + "# bench=OFFICE/bench/office_a1_generalist_gap.hexa\n"
content = content + "# verifier=OFFICE/verify/numerics_office_a1_generalist_gap.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# formula=generalist_ratio_pct = office_multitask × 100 / specialist_avg (scores stored × 100 ledger; × 100 factors cancel → ratio in plain %); falsifier_fires = ratio < 70% → office 평균 < specialist 평균 × 0.7 → 전문 모델 못 따라감\n"
content = content + "# placeholder_data=5 models · gpt5_office (88/92 · ratio 95% silent) · claude_office (86/91 · 94% silent) · gemini_office (84/90 · 93% silent) · weak_generalist (55/92 · 59% FIRES) · tiny_general (40/92 · 43% FIRES · 전문 한참 못 따라감)\n"
content = content + "# bidirectional_discrimination=3 silent (gpt5_office · claude_office · gemini_office — 거의 대등 · 통합 이점) + 2 fires (weak_generalist · tiny_general — 전문 못 따라감)\n"
content = content + "# external_anchors=Liang 2022 HELM (arXiv:2211.09110) · Hendrycks 2020 MMLU (arXiv:2009.03300) · Srivastava 2022 BIG-bench (arXiv:2206.04615) · DSLM 'Small is the New Big' specialist-swarm trend 2026\n"
content = content + "# vertical_meta_verification=OFFICE 의 falsifier 가 VERTICAL 존재 이유를 메타-검증 — generalist multi-task 평균 < 전문 모델 × 0.7 (ratio < 70%) 이면 generalist 가 전문 모델 대체 못 함 → VERTICAL/* (CODE·BIO·MATH... 12 전문 모델) 존재 정당화 · DSLM 'Small is the New Big' 정당화 · generalist 대체론 반증\n"
content = content + "# horizontal_vs_vertical=OFFICE (범용 넓이 · horizontal) vs VERTICAL/* (전문 깊이 · vertical) — 같은 능력 공간의 직교 dimension\n"
content = content + "# substrate_fire=DEFERRED (cycle-11+ · 6-task 사무 harness 이메일·요약·번역·문서·표·일정 vs 분야별 전문 모델 on SANDBOX bench + vast.ai pod · cx_lab_sandbox)\n"
content = content + "# frontier_open=feedback_closure_is_physical_limit — generalist gap ratio identity close ≠ measured close · 새 generalist model·task·전문 모델 마다 frontier 재오픈 · 범용-전문 경제 교차점 (축 N⭐) 도착지 없음\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
