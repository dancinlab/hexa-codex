#!hexa strict
// VERTICAL/SCIENCE/bench/science_a1_multistep_derive.hexa
// VERTICAL 전문 모델 측정 도메인군 · SCIENCE (과학 전문 모델 — 물리·화학·일반과학) — closed-form first probe.
// "과학 모델이 단답 사실(single fact lookup)을 맞히는 것과, 그 사실들을 엮어 다단계
//  유도(multi-step derivation)까지 실제로 해내는 것 사이의 gap (derive gap)" 의 측정.
//
// ⚠ SCIENCE ≠ MATH ≠ BIO ≠ MEDICAL — 다른 vertical · 다른 falsifier:
//   VERTICAL/MATH    = 수학 (formal-proof 검증율 · Lean/Coq kernel-check · answer-proof coherence)
//   VERTICAL/BIO     = 생명과학 (specialization gain · in-silico↔in-vitro · wet-lab 검증)
//   VERTICAL/MEDICAL = 임상 (clinical safety · 진단/처방)
//   VERTICAL/SCIENCE = 물리·화학·일반과학 추론 (GPQA · multi-step 유도 · 단위/차원 일관성 · 가설 생성)
// SCIENCE 의 핵심 특이점: 단답 사실 암기(single_fact) 와 다단계 유도(multistep) 는 분리 가능한 다른 능력.
// 사실은 알아도 그것을 엮어 유도하지 못할 수 있음 (derive gap · shallow knowledge).
//
// ⚠ recipe ≠ measurement — 다른 layer:
//   (build recipe) = 어떻게 과학 모델을 만드나 (science SFT/RL · multi-step CoT corpus)
//   VERTICAL/SCIENCE 도메인 = MEASUREMENT (얼마나 잘 유도하나 · multistep derive 정확도)
// GPQA (Google-proof Q&A) 의 graduate-level science reasoning 이 본 측정의 task surface.
//
// Identity (closed-form · libm-free · percentage ledger):
//   derive_ratio_pct(model) = multistep_x100 × 100 / single_fact_x100
//                           = (다단계 유도 정확도) / (단답 사실 정확도) × 100
//                           → "단답으로 아는 것 중 몇 % 를 다단계 유도까지 해내는가"
//   derive_gap_ok(model)    = derive_ratio_pct ≥ THRESHOLD_pct (40%)
//   falsifier_fires(model)  = derive_ratio_pct <  THRESHOLD_pct
//                             → 다단계 유도 < 단답 × 0.4
//                             → 사실 암기는 되나 유도 못함 (derive gap · shallow knowledge)
//
// Falsifier (SCIENCE A1): 다단계 유도 정확도가 단답 사실 정확도의 0.4 미만이면 (derive_ratio < 40%)
// 그 모델은 "사실은 암기했으나 유도는 못하는" derive gap 을 가짐 (shallow knowledge). 진짜 reasoner 는
// silent (유도가 사실을 따라옴) · lookup-only 모델은 fires (단답은 맞지만 다단계 유도 붕괴).
//
// Bidirectional 예시 (단위테스트 검증): o1_science (single 88 · multi 78 → 88% silent · int-div floor) vs
//   lookup_model (single 85 · multi 25 → 29% fires).
//
// External anchors (citation tier · 🟡):
//   Rein 2023  — GPQA: A Graduate-Level Google-Proof Q&A Benchmark (arXiv:2311.12022)
//   Wang 2023  — SciBench: Evaluating College-Level Scientific Problem-Solving (arXiv:2307.10635)
//   He 2024    — OlympiadBench: Olympiad-level bilingual multimodal science (arXiv:2402.14008)
//
// Integer ledger (pct × 100) — libm-free closed-form. Placeholder per-model
// {single_fact_acc, multistep_derive_acc} — 실측 GPQA + SciBench multi-step derive eval deferred
// (cycle-11+ T4 · HF transformers infer · vast.ai pod · `cx_lab_sandbox`).
//
// @no-lock-needed
// @resolver-bypass(reason="Pure multi-step derive-ratio identity recompute — no runtime infer.")

// ────────────────────────────────────────────────────────────────────────
// Model registry (5 models · {single_fact_acc_x100, multistep_derive_acc_x100} · pct × 100)
//   gpt5_science : single 88.0 · multi 76.0 (ratio 86% · strong reasoner · silent)
//   o1_reasoning : single 85.0 · multi 74.0 (ratio 87% · CoT reasoner · silent)
//   gemini_science : single 86.0 · multi 72.0 (ratio 83% · silent)
//   lookup_model : single 85.0 · multi 25.0 (ratio 29% · 사실만 암기 · FIRES · derive gap)
//   weak_sci     : single 70.0 · multi 20.0 (ratio 28% · 얕은 지식 · FIRES · derive gap)
//
// single_fact_acc   = 단답 사실 정답률 (e.g. "물의 끓는점?") of THIS model.
// multistep_derive  = 그 사실들을 엮어 다단계 유도까지 해낸 정답률 (e.g. GPQA 물리/화학 유도) of THIS model.
//   derive_ratio = multi/single × 100 → "단답으로 아는 것 중 다단계 유도까지 해내는 비율".
//   lookup_model · weak_sci 는 derive-gap 행 (single 은 맞지만 multi 붕괴 → ratio < 40% → fires by design).
// ────────────────────────────────────────────────────────────────────────

let MODEL_NAMES = ["gpt5_science", "o1_reasoning", "gemini_science", "lookup_model", "weak_sci"]

// row-major {single_fact_acc_x100, multistep_derive_acc_x100} (5 models × 2 fields)
//   gpt5_science   : [8800, 7600]  → single 88.0 · multi 76.0 · ratio 86% silent
//   o1_reasoning   : [8500, 7400]  → single 85.0 · multi 74.0 · ratio 87% silent
//   gemini_science : [8600, 7200]  → single 86.0 · multi 72.0 · ratio 83% silent
//   lookup_model   : [8500, 2500]  → single 85.0 · multi 25.0 · ratio 29% FIRES (derive gap)
//   weak_sci       : [7000, 2000]  → single 70.0 · multi 20.0 · ratio 28% FIRES (derive gap)
let MODEL_DATA = [8800, 7600,
                  8500, 7400,
                  8600, 7200,
                  8500, 2500,
                  7000, 2000]

let N_FIELDS = 2
let THRESHOLD_pct = 40              // derive_ratio < 40% → 다단계 유도 < 단답 × 0.4 → derive gap
let ACC_MAX_x100 = 100 * 100        // acc ∈ [0, 100] pct · × 100 ledger ∈ [0, 10000]

fn single_fact_x100(model_i: int) -> int {
    return MODEL_DATA[model_i * N_FIELDS + 0]
}
fn multistep_x100(model_i: int) -> int {
    return MODEL_DATA[model_i * N_FIELDS + 1]
}

fn derive_ratio_pct(model_i: int) -> int {
    // multi-step derive ratio (%) = multistep_derive / single_fact × 100.
    //   x100 ledger cancels (both × 100) so multiply multistep by 100 then divide by single_fact.
    //   "단답으로 아는 것 중 다단계 유도까지 해내는 비율" — fact lookup 과 multi-step derive 의 gap.
    return multistep_x100(model_i) * 100 / single_fact_x100(model_i)
}

fn derive_gap_ok(model_i: int) -> bool {
    return derive_ratio_pct(model_i) >= THRESHOLD_pct
}

fn falsifier_fires(model_i: int) -> bool {
    // 다단계 유도 < 단답 사실 × 0.4 → 사실 암기는 되나 유도 못함 (derive gap · shallow knowledge)
    return derive_ratio_pct(model_i) < THRESHOLD_pct
}

print("hexa-codex VERTICAL/SCIENCE A1 — multi-step derive-ratio closed-form (과학 전문 모델 측정 · cycle-10)")
print("=========================================================================================================")
print("")
print("⚠ SCIENCE ≠ MATH (formal-proof) ≠ BIO (specialization gain) — 물리·화학·일반과학 추론 · 다단계 유도")
print("⚠ recipe ≠ measurement — build recipe = 만들기 · SCIENCE 도메인 = 측정 (multistep derive 정확도)")
print("")
print("per-model multi-step derive profile (placeholder · pct × 100 ledger · libm-free):")
let n_model = MODEL_NAMES.len()
let mut i = 0
while i < n_model {
    let fact = single_fact_x100(i)
    let multi = multistep_x100(i)
    let r = derive_ratio_pct(i)
    let mut flag = "silent (derive_ratio ≥ 40% · 유도가 사실을 따라옴)"
    if falsifier_fires(i) {
        flag = "FIRES (derive_ratio < 40% · 사실 암기는 되나 유도 못함 · derive gap · shallow knowledge)"
    }
    print("  " + MODEL_NAMES[i] + ":")
    print("    single_fact_acc=" + to_string(fact / 100) + "pct · multistep_derive=" +
          to_string(multi / 100) + "pct")
    print("    → derive_ratio=" + to_string(r) + "% · [" + flag + "]")
    i = i + 1
}
print("")
print("__HEXA_CODEX_SCIENCE_A1_MULTISTEP_DERIVE__ DONE")
