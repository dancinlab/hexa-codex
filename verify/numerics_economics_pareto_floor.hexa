#!hexa strict
// hexa-codex/verify/numerics_economics_pareto_floor.hexa — closed-form
// $/task lower bound on the 20-task economics-routing manifest.
//
// QUESTION (round 2 ECONOMICS): is the canonical 2-tier length router
// (sonnet/opus, 81.79% saving @ 20/20) within ε of the analytic Pareto
// floor on this manifest, or is there a known cheaper assignment?
//
// PROOF-OF-CONSTRUCTION FLOOR.  Given strategies S = {baseline, length3,
// length2} and per-(strategy, task) measurements (cost_usd, correct)
// from `.verdicts/economics-routing-savings/2tier.tsv`, define the
// analytic floor on the per-task cost as
//
//   floor_i  =  min { cost(s, i)  |  s ∈ S  and  correct(s, i) = 1 }
//
// and the manifest floor as
//
//   floor    =  Σ_{i=1..20} floor_i.
//
// floor is a strict lower bound on any router operating in S at 20/20
// accuracy (every router that hits 20/20 on task i picks some s* with
// correct(s*, i) = 1, so its cost on task i is ≥ floor_i; summing over
// i preserves the inequality).  This bound is TIGHT in the closed-form
// sense — the witness assignment T_i ∈ S that achieves floor_i for
// every i is constructed explicitly in the FLOOR_TIER_IDX table below.
//
// Verified invariants (10 checks):
//
//   1. baseline cost reconciles to .verdicts/.../2tier_summary.txt header
//      ($0.319375 to within float-rounding ε)
//   2. length2 cost reconciles to summary ($0.058171, 81.79% saving)
//   3. floor cost is the elementwise minimum of the 3-strategy
//      cost vectors restricted to correct=1
//   4. floor ≤ length2_cost (lower-bound property — manifest level)
//   5. per-task: floor_i ≤ length2_i for ALL i (lower-bound property —
//      task level, the elementwise inequality that powers (4))
//   6. floor_saving% ≥ length2_saving% (saving is monotone-decreasing
//      in cost given fixed baseline)
//   7. gap = length2_saving − floor_saving lies within the ε-band
//      |gap| < 1.0 pp on this manifest — i.e. the canonical 2-tier
//      sits less than 1 pp from the analytic floor at 20/20
//   8. cost monotonicity baseline > length2 > floor (the chain that
//      ranks the three witnesses on this manifest)
//   9. 20/20 accuracy preserved at the floor witness (every floor_i is
//      drawn from a strategy with correct(s, i) = 1)
//  10. baseline-task-15 mis-correct flag (T_BLUE structural assertion —
//      the lone baseline correct=0 row is task 15 by direct lookup in
//      2tier.tsv; this anchors the floor proof to a specific row in the
//      audit trail rather than just a sum)
//
// HONEST LIMITATIONS.  (a) The floor is "manifest-conditional" — it
// holds for THIS 20-task workload and the strategies actually run; a
// genuinely cheaper tier that was never sampled cannot lower it.
// (b) The strategy-level cost reading uses Anthropic's authoritative
// `total_cost_usd` field; per-task model column is unreliable under
// `claude --bare -p` (cf. 2tier_summary CAVEAT) so we treat each
// (strategy, task) pair as the proof atom rather than (tier, task).
//
// PASS criterion: 10/10 checks at math_pure precision.
//
// Run:
//   HEXA_SHIM_NO_DARWIN_LANDING=1 RESOURCE_LOCAL_HEXA=1 \
//     HEXA_CODEX_ROOT="$PWD" \
//     ~/.hx/packages/hexa/hexa.real run verify/numerics_economics_pareto_floor.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="Pure local verifier; integer + float arithmetic only. No atlas atoms touched.")

use "self/runtime/math_pure"

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()

// ── per-task cost matrix (USD) — verbatim from 2tier.tsv ────────────────
//
// Rows i=1..20.  Columns: [BASELINE, LENGTH3, LENGTH2].
//
// Reconciled against .verdicts/economics-routing-savings/2tier.tsv:
//   baseline strategy → opus×20  (total $0.319375)
//   length3  strategy → haiku/sonnet/opus 3-tier (total $0.0792181)
//   length2  strategy → sonnet/opus 2-tier (total $0.0581707)
//
// Indices: 0=baseline, 1=length3, 2=length2.
let BASELINE_IDX = 0
let LENGTH3_IDX  = 1
let LENGTH2_IDX  = 2

let COST = [
    [0.01528275,  0.0073117500000000005, 0.0011364],          // 1
    [0.015263,    0.0022310000000000003, 0.00252585],         // 2
    [0.015353499999999999, 0.00204735,   0.001144],           // 3
    [0.01476125,  0.00254435,            0.0011438],          // 4
    [0.01531625,  0.0025736,             0.0011627],          // 5
    [0.01528075,  0.00254435,            0.0011388000000000001], // 6
    [0.015257,    0.0025343500000000003, 0.0011338],          // 7
    [0.01536,     0.0026023500000000002, 0.0011641999999999998], // 8
    [0.015332250000000002, 0.0025683499999999996, 0.0011589999999999999], // 9
    [0.015454,    0.00380255,            0.0011614],          // 10
    [0.0159485,   0.0022866,             0.0013955],          // 11
    [0.01502375,  0.00261435,            0.0006774],          // 12
    [0.015681999999999998, 0.0026636,    0.0034285500000000003], // 13
    [0.0156095,   0.0026686,             0.0026737],          // 14
    [0.01707275,  0.00339435,            0.00339945],         // 15
    [0.018947750000000003, 0.00452935,   0.00454945],         // 16
    [0.0179485,   0.0166296,             0.0165348],          // 17
    [0.016786,    0.0063688500000000006, 0.0050389499999999995], // 18
    [0.016785249999999998, 0.0037530999999999997, 0.0038481999999999995], // 19
    [0.0169105,   0.0035496,             0.0037546999999999997], // 20
]

// Per-task accuracy: 1 = correct, 0 = wrong.  Verbatim from 2tier.tsv.
// Note: task 14 baseline = 0 (baseline answered "{1,2,3}" not "1, 2, 3"
// substring — the only baseline miss on this manifest, hence 19/20).
let CORRECT = [
    [1, 1, 1],  // 1
    [1, 1, 1],  // 2
    [1, 1, 1],  // 3
    [1, 1, 1],  // 4
    [1, 1, 1],  // 5
    [1, 1, 1],  // 6
    [1, 1, 1],  // 7
    [1, 1, 1],  // 8
    [1, 1, 1],  // 9
    [1, 1, 1],  // 10
    [1, 1, 1],  // 11
    [1, 1, 1],  // 12
    [1, 1, 1],  // 13
    [0, 1, 1],  // 14   ← lone baseline miss
    [1, 1, 1],  // 15
    [1, 1, 1],  // 16
    [1, 1, 1],  // 17
    [1, 1, 1],  // 18
    [1, 1, 1],  // 19
    [1, 1, 1],  // 20
]

// Per-task floor witness — the argmin strategy index that solves task i
// most cheaply (constructed offline from the COST table, restricted to
// CORRECT[i][s] = 1).  Sticky tie-break: prefer LENGTH2 > LENGTH3 >
// BASELINE (operationally cheapest dispatch surface among ties).
let FLOOR_TIER_IDX = [
    LENGTH2_IDX,   // 1
    LENGTH3_IDX,   // 2
    LENGTH2_IDX,   // 3
    LENGTH2_IDX,   // 4
    LENGTH2_IDX,   // 5
    LENGTH2_IDX,   // 6
    LENGTH2_IDX,   // 7
    LENGTH2_IDX,   // 8
    LENGTH2_IDX,   // 9
    LENGTH2_IDX,   // 10
    LENGTH2_IDX,   // 11
    LENGTH2_IDX,   // 12
    LENGTH3_IDX,   // 13
    LENGTH3_IDX,   // 14
    LENGTH3_IDX,   // 15
    LENGTH3_IDX,   // 16
    LENGTH2_IDX,   // 17
    LENGTH2_IDX,   // 18
    LENGTH3_IDX,   // 19
    LENGTH3_IDX,   // 20
]

let N_TASKS = 20

// ── reconciliation anchors (from 2tier_summary.txt header) ────────────
let BASELINE_TOTAL_REF = 0.319375
let LENGTH2_TOTAL_REF  = 0.0581707
let LENGTH2_SAVING_REF = 81.7861

let FALSIFIERS = [
    "ECONOMICS Pareto $/task floor: 20-task manifest closed-form lower bound · canonical 2-tier within-ε",
]

// ── helpers ───────────────────────────────────────────────────────────

let mut RUN = 0
let mut FAIL = 0
let mut FAILURES = []

fn _check(ok: bool, label: str, detail: str) {
    RUN = RUN + 1
    if ok {
        println("  [PASS] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    } else {
        FAIL = FAIL + 1
        FAILURES.push(label + " :: " + detail)
        println("  [FAIL] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    }
}

fn _abs(x: float) -> float { return abs_pure(x) }

fn col_sum(col: int) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < N_TASKS {
        s = s + COST[i][col]
        i = i + 1
    }
    return s
}

fn col_correct(col: int) -> int {
    let mut k = 0
    let mut i = 0
    while i < N_TASKS {
        if CORRECT[i][col] == 1 { k = k + 1 }
        i = i + 1
    }
    return k
}

fn floor_total() -> float {
    let mut s = 0.0
    let mut i = 0
    while i < N_TASKS {
        let t = FLOOR_TIER_IDX[i]
        s = s + COST[i][t]
        i = i + 1
    }
    return s
}

fn saving_pct(b_cost: float, x_cost: float) -> float {
    return ((b_cost - x_cost) / b_cost) * 100.0
}

// ── checks ────────────────────────────────────────────────────────────

// Check 1: baseline total reconciles to summary header.
fn check_baseline_reconcile() {
    let b = col_sum(BASELINE_IDX)
    let drift = _abs(b - BASELINE_TOTAL_REF)
    _check(drift < 1.0e-5,
           "baseline column sum reconciles to 2tier_summary header ($0.319375)",
           "computed=$" + to_string(b) + "  ref=$" + to_string(BASELINE_TOTAL_REF) +
           "  drift=" + to_string(drift))
}

// Check 2: length2 total reconciles + 81.79% saving reproduces.
fn check_length2_reconcile() {
    let l2 = col_sum(LENGTH2_IDX)
    let b  = col_sum(BASELINE_IDX)
    let sav = saving_pct(b, l2)
    let cost_drift = _abs(l2 - LENGTH2_TOTAL_REF)
    let sav_drift  = _abs(sav - LENGTH2_SAVING_REF)
    let ok = (cost_drift < 1.0e-5) && (sav_drift < 0.01)
    _check(ok,
           "length2 column sum + saving% reproduce 2tier_summary (81.79%)",
           "cost=$" + to_string(l2) + "  saving=" + to_string(sav) + "%" +
           "  cost_drift=" + to_string(cost_drift) +
           "  sav_drift=" + to_string(sav_drift) + "pp")
}

// Check 3: FLOOR_TIER_IDX really is the per-task argmin restricted to correct=1.
fn check_floor_is_elementwise_argmin() {
    let mut bad = 0
    let mut bad_idx = -1
    let mut i = 0
    while i < N_TASKS {
        let t_floor = FLOOR_TIER_IDX[i]
        let c_floor = COST[i][t_floor]
        // Scan all strategies, find the genuine min among correct=1 entries.
        let mut min_cost = c_floor
        let mut j = 0
        while j < 3 {
            if CORRECT[i][j] == 1 {
                if COST[i][j] < min_cost {
                    min_cost = COST[i][j]
                }
            }
            j = j + 1
        }
        // c_floor must equal the min (within ε) AND CORRECT[i][t_floor] must be 1.
        if (_abs(c_floor - min_cost) > 1.0e-12) || (CORRECT[i][t_floor] != 1) {
            if bad == 0 { bad_idx = i + 1 }
            bad = bad + 1
        }
        i = i + 1
    }
    _check(bad == 0,
           "FLOOR_TIER_IDX[i] is the per-task argmin{cost | correct=1} for all 20 tasks",
           "mismatches=" + str(bad) + (if bad > 0 { " first_bad_task=" + str(bad_idx) } else { "" }))
}

// Check 4: floor ≤ length2_cost (manifest-level lower-bound property).
fn check_floor_le_length2() {
    let f = floor_total()
    let l2 = col_sum(LENGTH2_IDX)
    _check(f <= l2 + 1.0e-12,
           "floor_cost ≤ length2_cost (manifest-level lower-bound property)",
           "floor=$" + to_string(f) + "  length2=$" + to_string(l2) +
           "  gap=$" + to_string(l2 - f))
}

// Check 5: per-task floor_i ≤ length2_i for ALL i (elementwise lower-bound).
fn check_floor_le_length2_elementwise() {
    let mut bad = 0
    let mut bad_idx = -1
    let mut i = 0
    while i < N_TASKS {
        let t = FLOOR_TIER_IDX[i]
        let f_i = COST[i][t]
        let l2_i = COST[i][LENGTH2_IDX]
        // Allow equality (when floor = length2 because length2 IS the cheapest
        // correct strategy on this task), forbid strict floor > length2.
        if f_i > l2_i + 1.0e-12 {
            if bad == 0 { bad_idx = i + 1 }
            bad = bad + 1
        }
        i = i + 1
    }
    _check(bad == 0,
           "per-task: floor_i ≤ length2_i for all i (elementwise lower-bound)",
           "violations=" + str(bad) + (if bad > 0 { " first_bad_task=" + str(bad_idx) } else { "" }))
}

// Check 6: floor_saving% ≥ length2_saving%.
fn check_floor_saving_ge_length2() {
    let b = col_sum(BASELINE_IDX)
    let f = floor_total()
    let l2 = col_sum(LENGTH2_IDX)
    let f_sav  = saving_pct(b, f)
    let l2_sav = saving_pct(b, l2)
    _check(f_sav + 1.0e-9 >= l2_sav,
           "floor_saving% ≥ length2_saving% (saving is monotone-decreasing in cost)",
           "floor_saving=" + to_string(f_sav) + "%" +
           "  length2_saving=" + to_string(l2_sav) + "%" +
           "  Δ=" + to_string(f_sav - l2_sav) + "pp")
}

// Check 7: gap |length2_saving − floor_saving| < 1.0 pp (within-ε of floor).
fn check_within_eps_of_floor() {
    let b = col_sum(BASELINE_IDX)
    let f = floor_total()
    let l2 = col_sum(LENGTH2_IDX)
    let f_sav  = saving_pct(b, f)
    let l2_sav = saving_pct(b, l2)
    let gap = _abs(f_sav - l2_sav)
    _check(gap < 1.0,
           "gap |length2_saving − floor_saving| < 1.0 pp (canonical 2-tier is within-ε of floor)",
           "floor=" + to_string(f_sav) + "%" +
           "  length2=" + to_string(l2_sav) + "%" +
           "  gap=" + to_string(gap) + "pp")
}

// Check 8: cost monotonicity baseline > length2 > floor (three-way chain).
fn check_cost_chain_monotone() {
    let b = col_sum(BASELINE_IDX)
    let f = floor_total()
    let l2 = col_sum(LENGTH2_IDX)
    let ok = (b > l2) && (l2 > f)
    _check(ok,
           "cost chain: baseline > length2 > floor (strict on this manifest)",
           "baseline=$" + to_string(b) +
           "  length2=$" + to_string(l2) +
           "  floor=$" + to_string(f))
}

// Check 9: 20/20 accuracy preserved at floor witness.
fn check_floor_accuracy_20_of_20() {
    let mut k = 0
    let mut i = 0
    while i < N_TASKS {
        let t = FLOOR_TIER_IDX[i]
        if CORRECT[i][t] == 1 { k = k + 1 }
        i = i + 1
    }
    _check(k == N_TASKS,
           "floor witness preserves 20/20 accuracy (every FLOOR_TIER_IDX[i] picks a correct=1 strategy)",
           "correct_at_floor=" + str(k) + "/" + str(N_TASKS))
}

// Check 10: baseline correctness count = 19/20 + the lone miss is task 14.
//   Structural T_BLUE assertion: anchors the floor proof to a specific
//   row in 2tier.tsv rather than letting accuracy be "implicit".
fn check_baseline_lone_miss_is_task_14() {
    let b_correct = col_correct(BASELINE_IDX)
    let task14_baseline_correct = CORRECT[13][BASELINE_IDX]   // 0-indexed: i=13 ↔ task 14
    let mut other_miss = 0
    let mut i = 0
    while i < N_TASKS {
        if (i != 13) && (CORRECT[i][BASELINE_IDX] == 0) { other_miss = other_miss + 1 }
        i = i + 1
    }
    let ok = (b_correct == 19) && (task14_baseline_correct == 0) && (other_miss == 0)
    _check(ok,
           "baseline 19/20: lone miss is task 14 (sort {3,1,2}, baseline emitted '{1,2,3}')",
           "baseline_correct=" + str(b_correct) + "/" + str(N_TASKS) +
           "  task14_baseline_correct=" + str(task14_baseline_correct) +
           "  other_baseline_misses=" + str(other_miss))
}

// ── main ─────────────────────────────────────────────────────────────

fn main() {
    println("========================================================================")
    println("  hexa-codex ECONOMICS Pareto $/task floor (manifest-conditional)")
    println("  20-task manifest · closed-form lower bound · canonical 2-tier within-ε")
    println("========================================================================")

    let b = col_sum(BASELINE_IDX)
    let l3 = col_sum(LENGTH3_IDX)
    let l2 = col_sum(LENGTH2_IDX)
    let f = floor_total()
    let l3_sav = saving_pct(b, l3)
    let l2_sav = saving_pct(b, l2)
    let f_sav  = saving_pct(b, f)
    let gap = l2_sav - f_sav

    println("  baseline (opus×20)        : $" + to_string(b)  + "  (saving = baseline reference)")
    println("  length3  (haiku/son/opus) : $" + to_string(l3) + "  saving=" + to_string(l3_sav) + "%")
    println("  length2  (sonnet/opus)    : $" + to_string(l2) + "  saving=" + to_string(l2_sav) + "%")
    println("  floor    (argmin-witness) : $" + to_string(f)  + "  saving=" + to_string(f_sav) + "%")
    println("  gap (length2_sav − floor_sav) = " + to_string(gap) + " pp")
    println("")

    check_baseline_reconcile()
    check_length2_reconcile()
    check_floor_is_elementwise_argmin()
    check_floor_le_length2()
    check_floor_le_length2_elementwise()
    println("")
    check_floor_saving_ge_length2()
    check_within_eps_of_floor()
    check_cost_chain_monotone()
    check_floor_accuracy_20_of_20()
    check_baseline_lone_miss_is_task_14()

    println("")
    println("========================================================================")
    let pass_n = RUN - FAIL
    println("  " + str(pass_n) + "/" + str(RUN) + " checks passed")
    if FAIL > 0 {
        println("  FAILURES:")
        for ff in FAILURES { println("    ✗ " + ff) }
        println("__HEXA_CODEX_NUMERICS_ECONOMICS_PARETO_FLOOR__ FAIL")
        exit(1)
    }
    println("  ECONOMICS Pareto $/task floor: closed (manifest-conditional).")
    println("__HEXA_CODEX_NUMERICS_ECONOMICS_PARETO_FLOOR__ PASS")
    exit(0)
}
