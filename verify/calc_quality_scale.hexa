#!hexa strict
// hexa-codex/verify/calc_quality_scale.hexa — quality_scale loss-fit calculator (T1).
//
// Closed form per quality_scale/ai-quality-scale.md (atlas n=6 projection):
//
//     loss(N, D) = E + A·N^(-α) + B·D^(-β)
//
//   where the two power-law exponents collapse to the single n=6
//   lattice constant
//
//     α = β = φ(6) / σ(6) = 2 / 12 = 1/6 = 1/n   (≈ 0.1667)
//
//   E = 1.69  (Chinchilla 2022 irreducible-loss anchor, nats/token)
//   A = 406.4, B = 410.7  (Chinchilla 2022 fit coefficients)
//
// quality_scale carries NO single F-CODEX falsifier — it is the 3rd
// ECONOMICS verb, a loss-surface cross-cutter beside F-CODEX-1
// (train_cost) and F-CODEX-2 (infer_cost). Its falsifier is MILD: the
// n=6 exponent α = 1/6 ≈ 0.167 competes with Chinchilla's measured
// α ≈ 0.34; both fits coexist unless one wins the data clearly.
//
// Falsifier-floor (T1 algebraic, this script — integer arithmetic):
//   · α = φ(6)/σ(6) and σ = φ·n  ⇒  α = 1/n exactly               MUST
//   · n=6 collapses α=β (symmetric); Chinchilla measured α ≠ β     MUST
//   · α ≈ 0.1667  (φ/σ as per-mille)                              MUST
//   · Chinchilla α ≈ φ(6)·α_n6  (the 2× comparison band)          MUST
//   · β ≤ α ordering holds (n=6 equality; Chinchilla 0.28 ≤ 0.34)  MUST
//   · loss-form sanity 0 < E < A, E < B  (irreducible floor)       MUST
//   · spec anchor ships Chinchilla + scaling + compression tokens  MUST
//   · cross-link: 0 < α(1/n) < train_cost exp J₂/(J₂+1) < 1        MUST
//
// T2 (numerical fit over an anchor grid) and T3 (published-loss
// parity) are deferred to numerics_quality_scale{,_solver,_parity}.hexa.
//
// Run:
//   hexa run verify/calc_quality_scale.hexa
//   HEXA_CODEX_ROOT=/path hexa run verify/calc_quality_scale.hexa
//
// Cost: $0 (integer arithmetic + spec scan).
//
// @no-lock-needed
// @resolver-bypass(reason="Pure local verifier; reads project docs only.")

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()
let DOC_SPEC = ROOT + "/quality_scale/ai-quality-scale.md"

// ── n=6 lattice (own copy — also asserted in lattice_check) ──────────────
let N       = 6
let SIGMA_6 = 12
let TAU_6   = 4
let PHI_6   = 2
let J2      = 24

// ── quality_scale closed form (Chinchilla 2022, arxiv 2203.15556) ────────
// Exponents in ‰ (per-mille) to stay in integer arithmetic:
//   n=6 α = φ/σ = 2/12 → 166‰ (0.1667)
//   Chinchilla α = 340‰ (0.34) ; β = 280‰ (0.28)  — Hoffmann 2022 measured
let N6_ALPHA_PERMILLE         = 166
let CHINCHILLA_ALPHA_PERMILLE = 340
let CHINCHILLA_BETA_PERMILLE  = 280
// Loss coefficients in /100 (centi-nats per token):
let E_CENTI = 169       // irreducible loss 1.69
let A_CENTI = 40640     // 406.4
let B_CENTI = 41070     // 410.7

// FALSIFIERS list (recipe lint requires this array name).
let FALSIFIERS = ["quality_scale loss-fit α=β=φ/σ=1/n (Chinchilla-comparable; n6 exp 1/6 vs measured 0.34)"]

// ── helpers ──────────────────────────────────────────────────────────────

fn _read(p: str) -> str {
    if file_exists(p) == false { return "" }
    return read_file(p)
}

fn _has(t: str, s: str) -> bool {
    if t.len() == 0 { return false }
    if s.len() == 0 { return true }
    return t.find(s) >= 0
}

fn _any(t: str, ss: [str]) -> bool {
    for s in ss { if _has(t, s) { return true } }
    return false
}

let mut RUN = 0
let mut FAIL = 0
let mut FAILURES = []

fn _check(ok: bool, label: str, detail: str) {
    RUN = RUN + 1
    if ok {
        println("  [PASS] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    } else {
        FAIL = FAIL + 1
        FAILURES.push(label + " :: " + detail)
        println("  [FAIL] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    }
}

// ── checks ───────────────────────────────────────────────────────────────

// Check 1: α = φ(6)/σ(6) and σ = φ·n  ⇒  the exponent is 1/n exactly.
fn check_alpha_lattice_identity() {
    let ok = (SIGMA_6 == PHI_6 * N)
    _check(ok,
           "α = φ(6)/σ(6) = 2/12 = 1/n  (σ = φ·n ⇒ exponent is 1/n)",
           "σ=" + str(SIGMA_6) + " ; φ·n=" + str(PHI_6 * N))
}

// Check 2: n=6 symmetry — one lattice constant α=β=φ/σ for both power-law
//   terms, vs Chinchilla's asymmetric measured pair (α=0.34 ≠ β=0.28).
fn check_n6_symmetry() {
    let chin_asymmetric = (CHINCHILLA_ALPHA_PERMILLE != CHINCHILLA_BETA_PERMILLE)
    _check(chin_asymmetric,
           "n=6 collapses α=β=φ/σ (symmetric); Chinchilla measured α ≠ β",
           "Chinchilla α=" + str(CHINCHILLA_ALPHA_PERMILLE) +
           "‰ ≠ β=" + str(CHINCHILLA_BETA_PERMILLE) + "‰")
}

// Check 3: α ≈ 0.1667 — φ/σ as per-mille.
fn check_alpha_permille() {
    let computed = PHI_6 * 1000 / SIGMA_6     // 2000/12 = 166 (integer floor)
    _check(computed == N6_ALPHA_PERMILLE,
           "n=6 α = φ/σ = 166‰ ≈ 0.1667",
           "φ·1000/σ = " + str(computed) + "‰")
}

// Check 4: Chinchilla α ≈ φ(6)·α_n6 — the 2× comparison band.
//   n6 α = 166‰ ; φ·166 = 332‰ ; Chinchilla measured = 340‰.
//   |340 − 332| = 8 ≤ 20‰ tolerance → both fits coexist (mild falsifier).
fn check_chinchilla_comparison() {
    let n6_doubled = PHI_6 * N6_ALPHA_PERMILLE      // 2·166 = 332
    let mut diff = CHINCHILLA_ALPHA_PERMILLE - n6_doubled
    if diff < 0 { diff = -diff }
    let tol = 20
    _check(diff <= tol,
           "Chinchilla α≈0.34 within 20‰ of φ(6)·α_n6 = 2·166‰",
           "|340-332| = " + str(diff) + "‰ ≤ " + str(tol) + "‰")
}

// Check 5: β ≤ α ordering — D-exponent not steeper than N-exponent.
//   n=6: α = β ⇒ holds with equality. Chinchilla: 0.28 ≤ 0.34.
fn check_beta_ordering() {
    let chin_ok = (CHINCHILLA_BETA_PERMILLE <= CHINCHILLA_ALPHA_PERMILLE)
    _check(chin_ok,
           "β ≤ α : Chinchilla 0.28 ≤ 0.34 ; n=6 α=β (equality)",
           "chin β=" + str(CHINCHILLA_BETA_PERMILLE) +
           "‰ ≤ α=" + str(CHINCHILLA_ALPHA_PERMILLE) + "‰")
}

// Check 6: loss-form sanity — irreducible floor E below both coefficients.
fn check_loss_form_floor() {
    let ok = (E_CENTI > 0) && (E_CENTI < A_CENTI) && (E_CENTI < B_CENTI)
    _check(ok,
           "loss form E + A·N^-α + B·D^-β : 0 < E < A, E < B",
           "E=" + str(E_CENTI) + " A=" + str(A_CENTI) +
           " B=" + str(B_CENTI) + " (centi-nats)")
}

// Check 7: spec anchor — ai-quality-scale.md ships the expected tokens.
fn check_spec_anchor() {
    let txt = _read(DOC_SPEC)
    if txt.len() == 0 {
        _check(false, "spec anchor: quality_scale/ai-quality-scale.md exists",
               DOC_SPEC + " missing")
        return
    }
    let ok_chnch = _has(txt, "Chinchilla")
    let ok_scale = _any(txt, ["scaling", "Scaling"])
    let ok_qual  = _any(txt, ["Compression", "compression", "Pareto", "quality"])
    _check(ok_chnch && ok_scale && ok_qual,
           "spec ships Chinchilla + scaling + compression/quality tokens",
           "chinchilla=" + str(ok_chnch) +
           " scaling=" + str(ok_scale) +
           " quality=" + str(ok_qual))
}

// Check 8: cross-link to F-CODEX-1 (train_cost).
//   quality_scale loss-exponent α = 1/n ; train_cost cost-exponent
//   J₂/(J₂+1) = 24/25. Both are n=6 projections — verify they are
//   distinct, ordered exponents in the open interval (0, 1).
fn check_train_cost_crosslink() {
    let qs_exp = N6_ALPHA_PERMILLE          // 1/n     = 166‰
    let tc_exp = J2 * 1000 / (J2 + 1)       // 24/25   = 960‰
    let ok = (0 < qs_exp) && (qs_exp < tc_exp) && (tc_exp < 1000)
    _check(ok,
           "0 < quality_scale α (1/n) < train_cost exp (J₂/(J₂+1)) < 1",
           "qs=" + str(qs_exp) + "‰ < tc=" + str(tc_exp) + "‰ < 1000‰")
}

// ── main ─────────────────────────────────────────────────────────────────

fn main() {
    println("========================================================================")
    println("  hexa-codex quality_scale loss-fit calculator (T1 algebraic)")
    println("  loss = E + A·N^-α + B·D^-β ; α = β = φ(6)/σ(6) = 1/n ≈ 0.1667")
    println("========================================================================")
    println("  spec: " + DOC_SPEC)
    println("")

    check_alpha_lattice_identity()
    check_n6_symmetry()
    check_alpha_permille()
    check_chinchilla_comparison()
    check_beta_ordering()
    println("")
    check_loss_form_floor()
    check_spec_anchor()
    check_train_cost_crosslink()

    println("========================================================================")
    let pass_n = RUN - FAIL
    println("  " + str(pass_n) + "/" + str(RUN) + " checks passed")
    if FAIL > 0 {
        println("  FAILURES:")
        for f in FAILURES { println("    ✗ " + f) }
        println("__HEXA_CODEX_CALC_QUALITY_SCALE__ FAIL")
        exit(1)
    }
    println("  quality_scale T1 algebraic floor: closed.")
    println("__HEXA_CODEX_CALC_QUALITY_SCALE__ PASS")
    exit(0)
}
