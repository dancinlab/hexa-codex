#!hexa strict
// VERTICAL/LAW/verify/numerics_law_a1_citation_hallucination.hexa
// VERTICAL/LAW 신규 도메인 (cycle-10) — closed-form verifier for the 판례 인용
// hallucination-rate identity + 20% threshold falsifier semantics. "판례 변호사" 가
// 실제 존재하는 판례만 인용하는가를 측정하는 법률 전문 모델 측정 layer 의 첫 probe.
//
// Asserts the rate identity is closed-form and the falsifier (가짜 판례 detection)
// correctly classifies:
//   (1) rate identity (hallucinated × 10000 / total) holds for all 5 models
//   (2) counts ≥ 0 · hallucinated ≤ total · rate_x100 ∈ [0, 10000] (0–100 %)
//   (3) synthetic boundary — 20 fake / 100 → rate 2000 = 20.0% exactly → silent (≤ 20%)
//   (4) general_gpt5 (idx 3) fires (rate 3000 = 30% > 2000 · Mata v. Avianca class)
//       AND weak_legal (idx 4) fires (rate 4500 = 45% > 2000)
//   (5) harvey/gpt5_law/claude_legal silent (rate ≤ 2000 · 판례 인용 신뢰)
//   (6) determinism (re-call same rate + fires)
//   (7) sanity — hallucinated ≤ total for all (가짜 ≤ 전체, 단조) AND rate ladder
//       monotone: harvey ≤ claude ≤ gpt5_law ≤ general_gpt5 ≤ weak_legal (등급 정합)
//
// Source: VERTICAL/LAW/bench/law_a1_citation_hallucination.hexa
// External anchors: Guha 2023 LegalBench (arXiv:2308.11462) · Mata v. Avianca 2023
//                   (가짜 판례 인용 사건 · S.D.N.Y. · 변호사 sanction) · Dahl 2024
//                   legal hallucination (arXiv:2401.01301)
//
// @no-lock-needed

let MODEL_NAMES = ["harvey_legal", "gpt5_law", "claude_legal", "general_gpt5", "weak_legal"]

let MODEL_DATA = [100,  2,
                  100,  8,
                  100,  5,
                  100, 30,
                  100, 45]

let N_FIELDS = 2
let THRESHOLD_x100 = 2000           // > 20% 가짜 판례 비율 → 신뢰 불가 (Mata v. Avianca class)
let RATE_MAX_x100 = 100 * 100       // rate × 100 ledger ∈ [0, 10000]

fn citations_total(model_i: int) -> int {
    return MODEL_DATA[model_i * N_FIELDS + 0]
}
fn citations_hallucinated(model_i: int) -> int {
    return MODEL_DATA[model_i * N_FIELDS + 1]
}
fn hallucination_rate_x100(model_i: int) -> int {
    // 가짜 판례 비율 stored × 100 (percent × 100 ledger):
    //   rate_x100 = citations_hallucinated × 10000 / citations_total
    return (citations_hallucinated(model_i) * 10000) / citations_total(model_i)
}
fn falsifier_fires(model_i: int) -> bool {
    return hallucination_rate_x100(model_i) > THRESHOLD_x100
}

print("hexa-codex VERTICAL/LAW A1 falsifier — 판례 인용 hallucination closed-form")
print("========================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0
let n_model = MODEL_NAMES.len()

// check 1 — rate identity for all 5 models
checks_total = checks_total + 1
let mut id_ok = true
let mut i = 0
while i < n_model {
    let lhs = hallucination_rate_x100(i)
    let rhs = (citations_hallucinated(i) * 10000) / citations_total(i)
    if lhs != rhs { id_ok = false }
    i = i + 1
}
if id_ok {
    print("  [PASS] rate identity (hallucinated × 10000 / total) holds for all " +
          to_string(n_model) + " models")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] rate identity broken")
}

// check 2 — counts ≥ 0 · hallucinated ≤ total · rate_x100 ∈ [0, 10000]
checks_total = checks_total + 1
let mut rb_ok = true
i = 0
while i < n_model {
    let mut f = 0
    while f < N_FIELDS {
        let v = MODEL_DATA[i * N_FIELDS + f]
        if v < 0 { rb_ok = false }
        f = f + 1
    }
    if citations_hallucinated(i) > citations_total(i) { rb_ok = false }
    let r = hallucination_rate_x100(i)
    if r < 0 || r > RATE_MAX_x100 { rb_ok = false }
    i = i + 1
}
if rb_ok {
    print("  [PASS] counts ≥ 0 · hallucinated ≤ total · rate × 100 ∈ [0, " +
          to_string(RATE_MAX_x100) + "] for all " + to_string(n_model) + " models")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] count out of range or hallucinated > total")
}

// check 3 — synthetic boundary: 20 fake / 100 → rate 2000 = 20.0% exactly → silent (≤ 20%)
checks_total = checks_total + 1
let syn_rate = (20 * 10000) / 100
if syn_rate == 2000 && syn_rate <= THRESHOLD_x100 {
    print("  [PASS] synthetic boundary (20 fake / 100 = 20.0%) → rate=2000 · silent (≤ 20% · boundary inclusive)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] synthetic boundary rate=" + to_string(syn_rate))
}

// check 4 — general_gpt5 (idx 3) fires (30% > 20%) AND weak_legal (idx 4) fires (45% > 20%)
checks_total = checks_total + 1
if falsifier_fires(3) && hallucination_rate_x100(3) == 3000
        && falsifier_fires(4) && hallucination_rate_x100(4) == 4500 {
    print("  [PASS] general_gpt5 fires: rate=" + to_string(hallucination_rate_x100(3) / 100) +
          "% (30 fake / 100 · Mata v. Avianca class) · weak_legal fires: rate=" +
          to_string(hallucination_rate_x100(4) / 100) + "% (45 fake / 100) — both > 20%")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] high-hallucination fire detection broken (general_gpt5=" +
          to_string(hallucination_rate_x100(3)) + " · weak_legal=" + to_string(hallucination_rate_x100(4)) + ")")
}

// check 5 — harvey/gpt5_law/claude_legal silent (rate ≤ 20% · 판례 인용 신뢰)
checks_total = checks_total + 1
if falsifier_fires(0) == false && falsifier_fires(1) == false && falsifier_fires(2) == false
        && hallucination_rate_x100(0) == 200 && hallucination_rate_x100(1) == 800
        && hallucination_rate_x100(2) == 500 {
    print("  [PASS] legal-trusted models silent: harvey_legal rate=" + to_string(hallucination_rate_x100(0) / 100) +
          "% (legal-specialist) · gpt5_law=" + to_string(hallucination_rate_x100(1) / 100) +
          "% · claude_legal=" + to_string(hallucination_rate_x100(2) / 100) +
          "% — all ≤ 20% · 판례 인용 신뢰 (false-positive 회피)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] legal-trusted silent detection broken")
}

// check 6 — determinism (re-call same values)
checks_total = checks_total + 1
if hallucination_rate_x100(0) == hallucination_rate_x100(0)
        && falsifier_fires(3) == falsifier_fires(3)
        && hallucination_rate_x100(4) == hallucination_rate_x100(4) {
    print("  [PASS] formula deterministic (re-call same rate + fires · recursively delicious)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] formula non-deterministic")
}

// check 7 — sanity: hallucinated ≤ total for all (가짜 ≤ 전체 단조) AND rate ladder
//   monotone (harvey ≤ claude ≤ gpt5_law ≤ general_gpt5 ≤ weak_legal · 등급 정합).
checks_total = checks_total + 1
let mut fake_le_total = true
i = 0
while i < n_model {
    if citations_hallucinated(i) > citations_total(i) { fake_le_total = false }
    i = i + 1
}
let ladder_monotone = hallucination_rate_x100(0) <= hallucination_rate_x100(2)
        && hallucination_rate_x100(2) <= hallucination_rate_x100(1)
        && hallucination_rate_x100(1) <= hallucination_rate_x100(3)
        && hallucination_rate_x100(3) <= hallucination_rate_x100(4)
if fake_le_total && ladder_monotone {
    print("  [PASS] sanity — hallucinated ≤ total all (가짜 ≤ 전체) AND rate ladder monotone (harvey ≤ claude ≤ gpt5_law ≤ general_gpt5 ≤ weak_legal)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] sanity broken (fake_le_total=" + to_string(fake_le_total) +
          " · ladder_monotone=" + to_string(ladder_monotone) + ")")
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 STRUCTURAL (rate identity + 20% threshold semantics 7/7) + 🟡 BY-CITATION (placeholder data · 20% threshold = 가짜 판례 신뢰-불가 convention · cite Guha 2023 LegalBench arXiv:2308.11462 + Mata v. Avianca 2023 가짜 판례 사건 + Dahl 2024 legal hallucination arXiv:2401.01301)"
} else {
    verdict_tier = "🔴 FALSIFIED — citation hallucination formula contradicts identity (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
}
print("  " + verdict_tier)
print("")
print("VERTICAL/LAW A1 finding (판례 변호사 · placeholder · closed-form):")
print("  - hallucination_rate_x100 = hallucinated × 10000 / total identity (7/7 closed-form checks)")
print("  - bidirectional discrimination: harvey_legal=2% · gpt5_law=8% · claude_legal=5% silent (판례 인용 신뢰) · general_gpt5=30% · weak_legal=45% fires (가짜 판례 · Mata v. Avianca class)")
print("  - external anchors: Guha 2023 LegalBench (arXiv:2308.11462) · Mata v. Avianca 2023 (가짜 판례 사건) · Dahl 2024 (arXiv:2401.01301)")
print("  - 실측 (cycle-11+ T4): LegalBench / 판례 DB cross-check hallucination harness on lm_foundry eval + vast.ai pod (cx_lab_sandbox)")
print("")
print("__HEXA_CODEX_NUMERICS_LAW_A1__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/VERTICAL/LAW/verdicts/a1_citation_hallucination_verdict.txt"

let mut content = "# hexa-codex VERTICAL/LAW A1 — 판례 인용 hallucination verifier (판례 변호사 · cycle-10)\n"
content = content + "# axis=VERTICAL/LAW/LAW.md::A1 (판례 인용 정확도 · 5 legal models · 20% hallucination-rate threshold)\n"
content = content + "# bench=VERTICAL/LAW/bench/law_a1_citation_hallucination.hexa\n"
content = content + "# verifier=VERTICAL/LAW/verify/numerics_law_a1_citation_hallucination.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# formula=hallucination_rate_x100 = citations_hallucinated × 10000 / citations_total (rate stored × 100 percent ledger; e.g. 2 fake/100 → 200 = 2.00%); falsifier_fires = rate_x100 > 2000 (20%) → 가짜 판례 인용 신뢰 불가 (Mata v. Avianca class)\n"
content = content + "# placeholder_data=5 legal models · harvey_legal (100/2 · rate 2% silent · legal-specialist) · gpt5_law (100/8 · 8% silent) · claude_legal (100/5 · 5% silent) · general_gpt5 (100/30 · 30% FIRES · Mata v. Avianca class) · weak_legal (100/45 · 45% FIRES)\n"
content = content + "# bidirectional_discrimination=3 silent (harvey_legal · gpt5_law · claude_legal — 판례 인용 신뢰) + 2 fires (general_gpt5 · weak_legal — 가짜 판례 인용)\n"
content = content + "# external_anchors=Guha 2023 LegalBench (arXiv:2308.11462) · Mata v. Avianca 2023 (가짜 판례 인용 사건 · S.D.N.Y. · 변호사 sanction) · Dahl 2024 Large Legal Fictions (arXiv:2401.01301)\n"
content = content + "# substrate_fire=DEFERRED (cycle-11+ · LegalBench / 판례 DB cross-check hallucination harness on lm_foundry eval + vast.ai pod · cx_lab_sandbox)\n"
content = content + "# frontier_open=feedback_closure_is_physical_limit — hallucination-rate identity close ≠ measured close · 새 legal model·관할·판례 DB 마다 frontier 재오픈 · jurisdiction 일관성 (축 N⭐) 도착지 없음\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
