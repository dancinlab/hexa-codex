#!hexa strict
// bench/rwkv_m1_accuracy_floor.hexa — RWKV M1 Surface accuracy floor + RSS.
//
// QUESTION (M1 Surface): can RWKV-7 "Goose" 2.9B — a 100%-attention-free RNN LLM
// (linear-time inference, constant memory, NO KV-cache) — reach the SANDBOX
// "usable" accuracy floor on the SAME canonical 20-task economics-routing manifest
// used by bench/sandbox_stage0_baseline.hexa (clean Qwen2.5-0.5B-Q4 = 16/20)?
// Engine: stock brew llama.cpp 9150 — RWKV-7 IS natively supported (general
// .architecture = "rwkv7", 902 tensors, ctx 1048576, embedding 2560, 32 blocks).
//
// ENGINE NOTES (the load-bearing M1 recipe, verified before benching):
//   - RWKV-7 GGUF loads + RUNS on stock brew llama.cpp 9150 on Metal (UMA GPU);
//     decodes coherently ("capital of France is Paris.") @ ~13 tok/s.
//   - The World/base GGUF ships a BUILT-IN jinja chat_template = "rwkv-world",
//     but it is BROKEN on this engine — `--jinja` leaks the literal template name
//     and decodes garbage ("rwkv-world-cup-2022-qatar-..."). So we DO NOT use
//     --jinja; instead we wrap each prompt in the model's native plain
//     "User: <prompt>\n\nAssistant:" frame (the World-tokenizer convention),
//     which decodes coherently.
//   - The World model is a base/continuation model: after "Assistant: <answer>" it
//     keeps generating ("User: <next>..."). PARSE: strip up to the LAST "Assistant:",
//     then CUT at the next "User:" — see run_one().
//   - RWKV is an RNN: NO KV-cache, constant state — the M1 RSS captured here is the
//     M2 Constant-memory baseline at ctx=0 (one prompt).
//
// SCORER is byte-identical to bench/bitnet_m1_accuracy_floor.hexa (itself byte
// -identical to sandbox_stage0_baseline.hexa: case-insensitive substring on
// expected_kw, with the 2026-05-23 stderr-trailer strip), so the RWKV number is
// DIRECTLY comparable to BitNet 2B4T (6/20) and Qwen-0.5B-Q4 (16/20).
//
// Parameterized by env (one harness, reusable):
//   RWKV_MODEL_PATH   absolute .gguf path        (required-ish; has default)
//   RWKV_MODEL_NAME   label for the summary      (default RWKV7-Goose-World3-2.9B-q5_k_m)
//   RWKV_OUT_PREFIX   .verdicts/rwkv/<prefix>    (default m1_accuracy_floor)
//   RWKV_EXTRA_FLAGS  llama-completion flags     (default "" = Metal/UMA, no jinja)
//
// Output:
//   .verdicts/rwkv/<prefix>.tsv          (per-task rows incl. per-task RSS)
//   .verdicts/rwkv/<prefix>_summary.txt  (aggregate accuracy + peak RSS)
//
// Run:
//   HEXA_SHIM_NO_DARWIN_LANDING=1 RESOURCE_LOCAL_HEXA=1 \
//     HEXA_CODEX_ROOT="$PWD" \
//     RWKV_MODEL_PATH="$HOME/Models/gguf/rwkv/RWKV7-Goose-World3-2.9B-HF-q5_k_m.gguf" \
//     RWKV_MODEL_NAME="RWKV7-Goose-World3-2.9B-q5_k_m" \
//     ~/.hx/packages/hexa/hexa.real run bench/rwkv_m1_accuracy_floor.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="External CLI subprocess (llama-completion + /usr/bin/time) + filesystem write — no atlas atoms touched.")

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()
let OUT_DIR = ROOT + "/.verdicts/rwkv"

fn _model_path() -> str {
    let p = env("RWKV_MODEL_PATH")
    if p.len() > 0 { return p }
    return HOME + "/Models/gguf/rwkv/RWKV7-Goose-World3-2.9B-HF-q5_k_m.gguf"
}
fn _model_name() -> str {
    let n = env("RWKV_MODEL_NAME")
    if n.len() > 0 { return n }
    return "RWKV7-Goose-World3-2.9B-q5_k_m"
}
fn _out_prefix() -> str {
    let p = env("RWKV_OUT_PREFIX")
    if p.len() > 0 { return p }
    return "m1_accuracy_floor"
}

let MODEL_PATH = _model_path()
let MODEL_NAME = _model_name()
let OUT_PREFIX = _out_prefix()
let MAX_TOK = 96            // identical headroom to sandbox_stage0_baseline / bitnet_m1
let USABLE_THRESHOLD = 15   // >= 15/20 = usable floor reached (SANDBOX parity)

// Extra flags. RWKV-7 runs on the brew Metal backend (UMA GPU) with NO special
// flags — unlike BitNet TQ2_0 it has a working Metal kernel, and unlike BitNet it
// does NOT take --jinja (the built-in "rwkv-world" template is broken on this
// engine and leaks garbage). Default = "" (Metal, plain prompt). Override via
// RWKV_EXTRA_FLAGS; "NONE" forces empty.
fn _extra_flags() -> str {
    let e = env("RWKV_EXTRA_FLAGS")
    if e.len() > 0 {
        if e == "NONE" { return "" }
        return e
    }
    return ""
}
let EXTRA_FLAGS = _extra_flags()

// 20-task fixed manifest — VERBATIM from bench/bitnet_m1_accuracy_floor.hexa
// (itself verbatim from sandbox_stage0_baseline.hexa / economics_routing_2tier.hexa)
// for DIRECT comparability: RWKV vs BitNet 2B4T (6/20) vs Qwen-0.5B-Q4 (16/20).
let TASKS = [
    ["What is 2+2? Reply with the digit only.",                                                    "4"],
    ["Capital of France? One word.",                                                                "paris"],
    ["Reverse the string 'hello'. Reply with the reversed string only.",                            "olleh"],
    ["Square of 7? Reply with the number only.",                                                    "49"],
    ["First prime number greater than 10? Reply with the number only.",                             "11"],
    ["Smallest prime number? Reply with the number only.",                                          "2"],
    ["How many continents? Reply with the number only.",                                            "7"],
    ["Boiling point of water in Celsius at sea level? Reply with the number only.",                 "100"],
    ["ASCII decimal code for 'A'? Reply with the number only.",                                     "65"],
    ["Days in February 2024? Reply with the number only.",                                          "29"],
    ["Write a Python one-liner that sums integers 1..100. Reply with code only.",                   "sum(range"],
    ["Time complexity of binary search? Reply with big-O only.",                                    "log n"],
    ["Python: reverse a list lst in one expression. Reply with the expression only.",               "[::-1]"],
    ["Sort {3,1,2} ascending. Reply with the result only.",                                         "1, 2, 3"],
    ["TCP vs UDP in one sentence — which is connection-oriented?",                                  "tcp"],
    ["Explain BFS vs DFS in 2 sentences.",                                                          "breadth"],
    ["Write Python Fibonacci with memoization (use functools.cache).",                              "fib"],
    ["Convert binary 1101 to decimal, show one-line sum.",                                          "13"],
    ["Why is mergesort O(n log n)? One-sentence justification.",                                    "merge"],
    ["Halting problem — what is it? One sentence.",                                                  "halt"],
]

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

// Run one task via llama-completion, wrapped in /usr/bin/time -l for RSS.
// Returns tab-separated:
//   wall_ms \t prompt_wc \t output_tok_est \t correct(1|0) \t rss_bytes \t output_snippet
//
// Prompt frame: the World-tokenizer plain chat convention
//   "User: <prompt>\n\nAssistant:"
// PARSE: collapse newlines -> strip everything up to+incl. the LAST "Assistant:"
// -> CUT at the next "User:" (the base model keeps continuing into a new turn) ->
// strip the [end of text] / common_perf_print stderr trailer -> case-insensitive
// substring match on expected_kw. RSS from `maximum resident set size` (/usr/bin
// /time -l on stderr, captured separately so it never pollutes $ans). Scorer +
// trailer-strip byte-identical to bitnet_m1_accuracy_floor.hexa / stage0.
fn run_one(prompt: str, expected_kw: str) -> str {
    let wc = str(prompt.len())   // byte-length; cheap proxy for word-count

    // World-tokenizer chat frame: "User: <prompt>\n\nAssistant:"
    let framed = "User: " + prompt + "\n\nAssistant:"

    let cmd = "t_start=$(date +%s%N); " +
              "tmperr=$(mktemp); " +
              "out=$(/usr/bin/time -l llama-completion -m " + shq(MODEL_PATH) +
              " " + EXTRA_FLAGS +
              " -p " + shq(framed) +
              " -n " + str(MAX_TOK) + " --temp 0 -st 2>\"$tmperr\"); " +
              "t_end=$(date +%s%N); " +
              "wall_ms=$(( (t_end - t_start) / 1000000 )); " +
              "rss=$(grep 'maximum resident set size' \"$tmperr\" | awk '{print $1}' | tail -1); " +
              "rm -f \"$tmperr\"; " +
              // assistant_prefix parse: one line, strip up to LAST "Assistant:", CUT at next "User:"
              "ans_raw=$(printf '%s\\n' \"$out\" | tr '\\n' ' ' | sed 's/.*Assistant: *//' | sed 's/User:.*$//' | sed 's/  */ /g; s/^ //; s/ $//'); " +
              // SCORER trailer-strip (byte-identical to bitnet_m1 / stage0 2026-05-23 fix)
              "ans=$(printf '%s' \"$ans_raw\" | sed 's/ *\\[end of text\\].*$//' | sed 's/ *common_perf_print:.*$//'); " +
              "tok_est=$(printf '%s' \"$ans\" | wc -w | tr -d ' '); " +
              "low=$(printf '%s' \"$ans\" | tr 'A-Z' 'a-z'); " +
              "kw=$(printf '%s' " + shq(expected_kw) + " | tr 'A-Z' 'a-z'); " +
              "if printf '%s' \"$low\" | grep -qF \"$kw\"; then correct=1; else correct=0; fi; " +
              "snippet=$(printf '%s' \"$ans\" | cut -c1-120); " +
              "printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s' \"$wall_ms\" \"" + wc + "\" \"$tok_est\" \"$correct\" \"${rss:-0}\" \"$snippet\""
    return exec(cmd).trim()
}

fn main() {
    println("========================================================================")
    println("  bench/rwkv_m1_accuracy_floor — RWKV-7 'Goose' accuracy floor + RSS")
    println("  model:    " + MODEL_NAME)
    println("  path:     " + MODEL_PATH)
    println("  tool:     llama-completion (stock brew llama.cpp 9150, native rwkv7 arch)")
    println("  manifest: 20 tasks (VERBATIM from bitnet_m1 / sandbox_stage0_baseline)")
    println("  threshold: >= " + str(USABLE_THRESHOLD) + "/20 = usable floor reached")
    println("========================================================================")

    exec("mkdir -p " + shq(OUT_DIR))
    let tsv_path = OUT_DIR + "/" + OUT_PREFIX + ".tsv"
    exec("rm -f " + shq(tsv_path))
    exec("echo 'idx\tprompt_wc\toutput_tok_est\twall_ms\tcorrect\trss_bytes\toutput_snippet' >> " + shq(tsv_path))

    let mut total_ms = 0
    let mut n_correct = 0
    let mut peak_rss = 0
    let mut i = 0
    while i < len(TASKS) {
        let task = TASKS[i]
        let prompt = task[0]
        let expected = task[1]
        println("  [" + str(i+1) + "/" + str(len(TASKS)) + "] kw=" + expected + " prompt=" + prompt.substr(0, 50))
        let line = run_one(prompt, expected)
        let parts = line.split("\t")
        if parts.len() < 6 {
            println("    ! parse error, raw=" + line)
            let bad = str(i+1) + "\t" + str(prompt.len()) + "\t0\t0\t0\t0\tPARSE_ERROR:" + line.substr(0, 80)
            exec("echo " + shq(bad) + " >> " + shq(tsv_path))
            i = i + 1
            continue
        }
        let wall_ms = int(parts[0])
        let prompt_wc = parts[1]
        let tok_est = parts[2]
        let correct = parts[3]
        let rss = int(parts[4])
        let snippet = parts[5].replace("\t", " ")
        total_ms = total_ms + wall_ms
        if correct == "1" { n_correct = n_correct + 1 }
        if rss > peak_rss { peak_rss = rss }
        let row = str(i+1) + "\t" + prompt_wc + "\t" + tok_est + "\t" + str(wall_ms) + "\t" + correct + "\t" + str(rss) + "\t" + snippet.substr(0, 120)
        exec("echo " + shq(row) + " >> " + shq(tsv_path))
        println("    -> wall_ms=" + str(wall_ms) + " correct=" + correct + " rss=" + str(rss) + " ans=" + snippet.substr(0, 50))
        i = i + 1
    }

    let total = len(TASKS)
    let mut acc_pct_x100 = 0
    if total > 0 { acc_pct_x100 = (n_correct * 10000) / total }
    let mut floor_ok = "false"
    if n_correct >= USABLE_THRESHOLD { floor_ok = "true" }

    // peak RSS in MB (integer) for the readable summary.
    let peak_rss_mb = peak_rss / 1048576

    println("")
    println("========================================================================")
    println("  SUMMARY — RWKV M1 accuracy floor + RSS (M2 constant-memory baseline)")
    println("========================================================================")
    println("  model            : " + MODEL_NAME)
    println("  total_tasks      : " + str(total))
    println("  correct          : " + str(n_correct) + "/" + str(total))
    println("  accuracy_pct     : " + str(acc_pct_x100 / 100) + "." + str(acc_pct_x100 % 100) + "%")
    println("  total_wall_ms    : " + str(total_ms))
    println("  peak_rss_bytes   : " + str(peak_rss))
    println("  peak_rss_mb      : " + str(peak_rss_mb))
    println("  threshold        : >= " + str(USABLE_THRESHOLD) + "/20")
    println("  usable_floor     : " + floor_ok)
    println("")

    let summary_path = OUT_DIR + "/" + OUT_PREFIX + "_summary.txt"
    exec("rm -f " + shq(summary_path))
    exec("echo " + shq("# model=" + MODEL_NAME) + " >> " + shq(summary_path))
    exec("echo " + shq("# model_path=" + MODEL_PATH) + " >> " + shq(summary_path))
    exec("echo " + shq("# total_tasks=" + str(total)) + " >> " + shq(summary_path))
    exec("echo " + shq("# correct=" + str(n_correct) + "/" + str(total)) + " >> " + shq(summary_path))
    exec("echo " + shq("# accuracy_pct=" + str(acc_pct_x100 / 100) + "." + str(acc_pct_x100 % 100)) + " >> " + shq(summary_path))
    exec("echo " + shq("# total_wall_ms=" + str(total_ms)) + " >> " + shq(summary_path))
    exec("echo " + shq("# peak_rss_bytes=" + str(peak_rss)) + " >> " + shq(summary_path))
    exec("echo " + shq("# peak_rss_mb=" + str(peak_rss_mb)) + " >> " + shq(summary_path))
    exec("echo " + shq("# usable_threshold=" + str(USABLE_THRESHOLD)) + " >> " + shq(summary_path))
    exec("echo " + shq("# usable_floor_reached=" + floor_ok) + " >> " + shq(summary_path))
    exec("echo " + shq("# tool=llama-completion (stock brew llama.cpp 9150, native rwkv7 arch, 902 tensors)") + " >> " + shq(summary_path))
    exec("echo " + shq("# extra_flags='" + EXTRA_FLAGS + "'  (RWKV-7: Metal/UMA GPU; NO --jinja — built-in 'rwkv-world' template broken on this engine, leaks garbage; plain 'User:/Assistant:' frame instead)") + " >> " + shq(summary_path))
    exec("echo " + shq("# prompt_frame=User: <prompt> [blank line] Assistant:  (literal newlines in the actual prompt; NO --jinja)") + " >> " + shq(summary_path))
    exec("echo " + shq("# parse_mode=assistant_prefix+cut_at_next_User") + " >> " + shq(summary_path))
    exec("echo " + shq("# arch=rwkv7 (attention-free RNN, NO KV-cache, ctx_len=1048576, embd=2560, 32 blocks)") + " >> " + shq(summary_path))
    exec("echo " + shq("# host=mac-mini-m3 (brew llama.cpp 9150, Metal/UMA)") + " >> " + shq(summary_path))
    exec("echo " + shq("# scorer=byte_exact_subset (case-insensitive, VERBATIM from bitnet_m1 / sandbox_stage0_baseline.hexa)") + " >> " + shq(summary_path))
    exec("echo " + shq("# comparators=BitNet-2B4T 6/20 (30.0%) · Qwen2.5-0.5B-Q4 16/20 (80.0%) — SAME manifest+scorer") + " >> " + shq(summary_path))
    exec("echo " + shq("# cost_usd=0  (local serving; wall_ms is the proxy cost surface)") + " >> " + shq(summary_path))

    println("  tsv     persisted: " + tsv_path)
    println("  summary persisted: " + summary_path)
    println("")
    println("__HEXA_CODEX_BENCH_RWKV_M1__ PASS")
    exit(0)
}
