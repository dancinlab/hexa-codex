#!hexa strict
// bench/sandbox_stage4_json_schema.hexa — SANDBOX Stage 4 (cycle-6 ROI):
// JSON-schema-constrained decoding on llama-server /v1/chat/completions.
//
// QUESTION: does forcing structured JSON output cut wall_ms (less prose
// padding) at no accuracy cost? Hypothesis: constrained decoding cuts
// output_tokens >= 30% with accuracy >= unconstrained baseline.
//
// PROBE (2026-05-24, .discoveries/sandbox-llama-server-jsonschema.raw):
//   llama-server b9150 EXPOSES BOTH response_format levels:
//     {"type":"json_object"}                — accepted, behaves as a HINT
//       (no grammar enforcement; the model emits JSON only if the prompt
//       requests it. In probe with prompt "Put the digit in the answer
//       field." returned bare prose "2+2 equals 4." NOT JSON.)
//     {"type":"json_schema","json_schema":{"schema":{...}}}
//                                           — accepted, ENFORCES grammar
//       (output is bit-for-bit valid JSON conforming to schema; required
//        keys + types guaranteed by llama-server's grammar sampler.)
//   Verdict: substrate-level json_schema lever ALIVE; json_object alone is
//   a no-op hint without prompt scaffolding.
//
// STRATEGIES (3):
//   unconstrained — REFERENCE: no response_format, free-form output.
//                   Server-mode parity for cycle-1 baselines (no Metal-init
//                   floor; one server boot amortizes over all 60 calls).
//   json_object   — response_format: {"type":"json_object"} + prompt asks
//                   for JSON {"answer":"..."}. Loose — model MAY emit JSON
//                   but is not grammar-forced.
//   json_strict   — response_format: {"type":"json_schema","json_schema":
//                                     {"schema":{"type":"object",
//                                      "properties":{"answer":{"type":"string"}},
//                                      "required":["answer"]}}}
//                   Hard grammar constraint — output guaranteed-JSON.
//
// MANIFEST: canonical 20-task verbatim from sandbox_stage0_baseline.hexa.
//
// SCORING:
//   For unconstrained — substring-match raw .choices[0].message.content.
//   For json_object/json_strict — parse .choices[0].message.content as JSON,
//     extract .answer field, substring-match. If .answer absent (parse
//     failure / hint mode model rambled), fall back to raw-content match
//     AND set fallback flag (per-row) so the summary can count fallbacks.
//
// MEASUREMENT:
//   wall_ms      — date +%s%N before/after curl
//   output_tokens— .usage.completion_tokens from server response
//   correct      — substring match on .answer (or raw content if fallback)
//   fallback     — 1 if json_object/json_strict but JSON parse failed
//
// PORT: 8083 (sibling agents use 8081/8082).
//
// OUTPUTS:
//   .verdicts/sandbox/stage4_json_schema.tsv         (per-task per-strategy rows)
//   .verdicts/sandbox/stage4_json_schema_summary.txt (aggregate + verdict)
//
// HONESTY:
//   - Server killed on every exit path (trap EXIT in launch_server, and an
//     explicit teardown at end of main()).
//   - If json_object/json_strict returns malformed JSON, that's a HARD
//     failure of the substrate lever — not a "model issue".
//   - If accuracy DROPS under JSON constraint vs unconstrained, the lever
//     is HONESTLY reported as negative — constrained decoding can hurt
//     simple-question tasks where bare prose was sufficient.
//
// Run:
//   HEXA_SHIM_NO_DARWIN_LANDING=1 RESOURCE_LOCAL_HEXA=1 \
//     HEXA_CODEX_ROOT="$PWD" \
//     ~/.hx/packages/hexa/hexa.real run bench/sandbox_stage4_json_schema.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="External subprocess (llama-server + curl + jq) + filesystem write — no atlas atoms touched.")

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()
let OUT_DIR = ROOT + "/.verdicts/sandbox"
let MODEL_PATH = HOME + "/Models/gguf/Qwen2.5-0.5B-Instruct-Q4_K_M.gguf"
let MODEL_NAME = "Qwen2.5-0.5B-Instruct-Q4_K_M"
let PORT = "8083"
let HOST = "127.0.0.1"
let BASE_URL = "http://" + HOST + ":" + PORT
let LOG_PATH = "/tmp/sandbox_stage4_llama_8083.log"
let PID_PATH = "/tmp/sandbox_stage4_llama_8083.pid"
let MAX_TOK = 96
let REDUCTION_TARGET_PCT = 30  // hypothesis: >=30% output_tok reduction

// 20-task fixed manifest — verbatim from sandbox_stage0_baseline.hexa.
let TASKS = [
    ["What is 2+2? Reply with the digit only.",                                                    "4"],
    ["Capital of France? One word.",                                                                "paris"],
    ["Reverse the string 'hello'. Reply with the reversed string only.",                            "olleh"],
    ["Square of 7? Reply with the number only.",                                                    "49"],
    ["First prime number greater than 10? Reply with the number only.",                             "11"],
    ["Smallest prime number? Reply with the number only.",                                          "2"],
    ["How many continents? Reply with the number only.",                                            "7"],
    ["Boiling point of water in Celsius at sea level? Reply with the number only.",                 "100"],
    ["ASCII decimal code for 'A'? Reply with the number only.",                                     "65"],
    ["Days in February 2024? Reply with the number only.",                                          "29"],
    ["Write a Python one-liner that sums integers 1..100. Reply with code only.",                   "sum(range"],
    ["Time complexity of binary search? Reply with big-O only.",                                    "log n"],
    ["Python: reverse a list lst in one expression. Reply with the expression only.",               "[::-1]"],
    ["Sort {3,1,2} ascending. Reply with the result only.",                                         "1, 2, 3"],
    ["TCP vs UDP in one sentence — which is connection-oriented?",                                  "tcp"],
    ["Explain BFS vs DFS in 2 sentences.",                                                          "breadth"],
    ["Write Python Fibonacci with memoization (use functools.cache).",                              "fib"],
    ["Convert binary 1101 to decimal, show one-line sum.",                                          "13"],
    ["Why is mergesort O(n log n)? One-sentence justification.",                                    "merge"],
    ["Halting problem — what is it? One sentence.",                                                  "halt"],
]

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

// Boot llama-server in background, wait for /health 200. Persist PID for
// teardown. Fails LOUDLY if /health doesn't come up in 30s.
fn launch_server() -> bool {
    println("  [server] launching llama-server on port " + PORT + " ...")
    let cmd = "pkill -f 'llama-server.*" + PORT + "' 2>/dev/null; sleep 1; " +
              "nohup llama-server -m " + shq(MODEL_PATH) +
              " --port " + PORT + " --host " + HOST +
              " -np 1 > " + shq(LOG_PATH) + " 2>&1 & echo $! > " + shq(PID_PATH) + "; " +
              "for i in $(seq 1 30); do " +
              "  code=$(curl -s -o /dev/null -w '%{http_code}' " + BASE_URL + "/health 2>/dev/null); " +
              "  if [ \"$code\" = \"200\" ]; then echo READY; exit 0; fi; " +
              "  sleep 1; " +
              "done; echo TIMEOUT; exit 1"
    let out = exec(cmd).trim()
    if out.contains("READY") {
        println("  [server] healthy on " + BASE_URL)
        return true
    }
    println("  [server] FAILED to come up: " + out)
    return false
}

fn teardown_server() {
    println("  [server] teardown ...")
    exec("pkill -f 'llama-server.*" + PORT + "' 2>/dev/null; sleep 1; rm -f " + shq(PID_PATH))
}

// JSON-escape a string for embedding in a curl payload. Minimal: backslash,
// double-quote, newlines, tabs.
fn json_escape(s: str) -> str {
    let mut r = s.replace("\\", "\\\\")
    r = r.replace("\"", "\\\"")
    r = r.replace("\n", "\\n")
    r = r.replace("\r", "\\r")
    r = r.replace("\t", "\\t")
    return r
}

// Build the JSON request body for the 3 strategies.
//   strategy = "unconstrained" | "json_object" | "json_strict"
fn build_body(prompt: str, strategy: str) -> str {
    let mut user_content = prompt
    // For JSON modes, instruct the model to wrap the answer.
    if strategy == "json_object" || strategy == "json_strict" {
        user_content = prompt + " Respond with a JSON object: {\"answer\":\"<your answer>\"}"
    }
    let esc_user = json_escape(user_content)
    let mut rf = ""
    if strategy == "json_object" {
        rf = ",\"response_format\":{\"type\":\"json_object\"}"
    }
    if strategy == "json_strict" {
        rf = ",\"response_format\":{\"type\":\"json_schema\",\"json_schema\":{\"schema\":{\"type\":\"object\",\"properties\":{\"answer\":{\"type\":\"string\"}},\"required\":[\"answer\"]}}}"
    }
    let body = "{\"model\":\"qwen\"," +
               "\"messages\":[{\"role\":\"user\",\"content\":\"" + esc_user + "\"}]," +
               "\"max_tokens\":" + str(MAX_TOK) + "," +
               "\"temperature\":0" + rf + "}"
    return body
}

// Dispatch one task. Returns tab-separated:
//   wall_ms \t completion_tokens \t correct(1|0) \t fallback(1|0) \t snippet
fn run_one(prompt: str, expected_kw: str, strategy: str) -> str {
    let body = build_body(prompt, strategy)
    // We let the shell handle JSON parsing of the response via jq. The
    // `--data-binary` form preserves embedded special chars in body.
    let cmd = "set -eo pipefail; " +
              "BODY=" + shq(body) + "; " +
              "t_start=$(date +%s%N); " +
              "resp=$(curl -s --max-time 60 -X POST -H 'Content-Type: application/json' " +
              "  --data-binary \"$BODY\" " + BASE_URL + "/v1/chat/completions); " +
              "t_end=$(date +%s%N); " +
              "wall_ms=$(( (t_end - t_start) / 1000000 )); " +
              "raw_content=$(printf '%s' \"$resp\" | jq -r '.choices[0].message.content // \"\"'); " +
              "comp_tok=$(printf '%s' \"$resp\" | jq -r '.usage.completion_tokens // 0'); " +
              "strategy=" + shq(strategy) + "; " +
              "fallback=0; " +
              "if [ \"$strategy\" = \"unconstrained\" ]; then " +
              "  ans=\"$raw_content\"; " +
              "else " +
              "  parsed=$(printf '%s' \"$raw_content\" | jq -r '.answer // empty' 2>/dev/null || true); " +
              "  if [ -n \"$parsed\" ]; then " +
              "    ans=\"$parsed\"; " +
              "  else " +
              "    ans=\"$raw_content\"; fallback=1; " +
              "  fi; " +
              "fi; " +
              "kw=$(printf '%s' " + shq(expected_kw) + " | tr 'A-Z' 'a-z'); " +
              "low=$(printf '%s' \"$ans\" | tr 'A-Z' 'a-z'); " +
              "if printf '%s' \"$low\" | grep -qF \"$kw\"; then correct=1; else correct=0; fi; " +
              "snippet=$(printf '%s' \"$ans\" | tr '\\n\\t' '  ' | cut -c1-120); " +
              "printf '%s\\t%s\\t%s\\t%s\\t%s' \"$wall_ms\" \"$comp_tok\" \"$correct\" \"$fallback\" \"$snippet\""
    return exec(cmd).trim()
}

fn run_strategy(strategy: str, tsv_path: str) -> str {
    // Returns tab-separated: n_correct \t total_wall_ms \t total_tok \t n_fallback
    let mut n_correct = 0
    let mut total_ms = 0
    let mut total_tok = 0
    let mut n_fallback = 0
    let mut i = 0
    while i < len(TASKS) {
        let task = TASKS[i]
        let prompt = task[0]
        let expected = task[1]
        println("  [" + strategy + " " + str(i+1) + "/" + str(len(TASKS)) + "] kw=" + expected + " p=" + prompt.substr(0, 40))
        let line = run_one(prompt, expected, strategy)
        let parts = line.split("\t")
        if parts.len() < 5 {
            println("    ! parse error, raw=" + line)
            let bad = strategy + "\t" + str(i+1) + "\t0\t0\t0\t0\tPARSE_ERROR:" + line.substr(0, 80)
            exec("echo " + shq(bad) + " >> " + shq(tsv_path))
            i = i + 1
            continue
        }
        let wall_ms = int(parts[0])
        let comp_tok = int(parts[1])
        let correct = parts[2]
        let fallback = parts[3]
        let snippet = parts[4].replace("\t", " ")
        total_ms = total_ms + wall_ms
        total_tok = total_tok + comp_tok
        if correct == "1" { n_correct = n_correct + 1 }
        if fallback == "1" { n_fallback = n_fallback + 1 }
        let row = strategy + "\t" + str(i+1) + "\t" + str(wall_ms) + "\t" + str(comp_tok) + "\t" + correct + "\t" + fallback + "\t" + snippet.substr(0, 120)
        exec("echo " + shq(row) + " >> " + shq(tsv_path))
        println("    -> wall_ms=" + str(wall_ms) + " tok=" + str(comp_tok) + " correct=" + correct + " fb=" + fallback + " ans=" + snippet.substr(0, 50))
        i = i + 1
    }
    return str(n_correct) + "\t" + str(total_ms) + "\t" + str(total_tok) + "\t" + str(n_fallback)
}

fn main() {
    println("========================================================================")
    println("  bench/sandbox_stage4_json_schema — JSON-schema-constrained decoding")
    println("  model:    " + MODEL_NAME)
    println("  endpoint: " + BASE_URL + "/v1/chat/completions")
    println("  manifest: 20 tasks (verbatim from sandbox_stage0_baseline.hexa)")
    println("  strategies: unconstrained, json_object, json_strict")
    println("  target:   output_tok reduction >= " + str(REDUCTION_TARGET_PCT) + "% at acc >= baseline")
    println("========================================================================")

    exec("mkdir -p " + shq(OUT_DIR))
    let tsv_path = OUT_DIR + "/stage4_json_schema.tsv"
    exec("rm -f " + shq(tsv_path))
    exec("echo 'strategy\tidx\twall_ms\tcompletion_tokens\tcorrect\tfallback\toutput_snippet' >> " + shq(tsv_path))

    let ok = launch_server()
    if !ok {
        teardown_server()
        let summary_path = OUT_DIR + "/stage4_json_schema_summary.txt"
        exec("rm -f " + shq(summary_path))
        exec("echo '# llama_server_json_schema_exposed=false  [BLOCKED_AT_BUILD]' >> " + shq(summary_path))
        println("__HEXA_CODEX_BENCH_SANDBOX_STAGE4_JSON_SCHEMA__ FAIL_SERVER_LAUNCH")
        exit(1)
    }

    // unconstrained
    let r_unc = run_strategy("unconstrained", tsv_path)
    let p_unc = r_unc.split("\t")
    let unc_correct = int(p_unc[0])
    let unc_wall = int(p_unc[1])
    let unc_tok = int(p_unc[2])
    let unc_fb = int(p_unc[3])

    // json_object
    let r_obj = run_strategy("json_object", tsv_path)
    let p_obj = r_obj.split("\t")
    let obj_correct = int(p_obj[0])
    let obj_wall = int(p_obj[1])
    let obj_tok = int(p_obj[2])
    let obj_fb = int(p_obj[3])

    // json_strict
    let r_str = run_strategy("json_strict", tsv_path)
    let p_str = r_str.split("\t")
    let str_correct = int(p_str[0])
    let str_wall = int(p_str[1])
    let str_tok = int(p_str[2])
    let str_fb = int(p_str[3])

    teardown_server()

    // Reduction percentages (x100 for fixed-point % display).
    // reduction_pct = ((unc - x) / unc) * 100  →  positive means x is LESS than unc.
    let mut obj_tok_red_x100 = 0
    let mut str_tok_red_x100 = 0
    let mut obj_wall_red_x100 = 0
    let mut str_wall_red_x100 = 0
    if unc_tok > 0 {
        obj_tok_red_x100 = ((unc_tok - obj_tok) * 10000) / unc_tok
        str_tok_red_x100 = ((unc_tok - str_tok) * 10000) / unc_tok
    }
    if unc_wall > 0 {
        obj_wall_red_x100 = ((unc_wall - obj_wall) * 10000) / unc_wall
        str_wall_red_x100 = ((unc_wall - str_wall) * 10000) / unc_wall
    }

    let total = len(TASKS)
    let mut acc_preserved = "true"
    if obj_correct < unc_correct { acc_preserved = "false" }
    if str_correct < unc_correct { acc_preserved = "false" }

    // Average tokens (10x for "X.Y" display).
    let mut unc_avg_tok_x10 = 0
    let mut obj_avg_tok_x10 = 0
    let mut str_avg_tok_x10 = 0
    if total > 0 {
        unc_avg_tok_x10 = (unc_tok * 10) / total
        obj_avg_tok_x10 = (obj_tok * 10) / total
        str_avg_tok_x10 = (str_tok * 10) / total
    }

    println("")
    println("========================================================================")
    println("  SUMMARY — Stage 4 JSON-schema-constrained decoding")
    println("========================================================================")
    println("  unconstrained : correct=" + str(unc_correct) + "/" + str(total) + " wall_ms=" + str(unc_wall) + " out_tok=" + str(unc_tok) + " fb=" + str(unc_fb))
    println("  json_object   : correct=" + str(obj_correct) + "/" + str(total) + " wall_ms=" + str(obj_wall) + " out_tok=" + str(obj_tok) + " fb=" + str(obj_fb))
    println("  json_strict   : correct=" + str(str_correct) + "/" + str(total) + " wall_ms=" + str(str_wall) + " out_tok=" + str(str_tok) + " fb=" + str(str_fb))
    println("  json_object_output_tok_reduction_pct = " + str(obj_tok_red_x100 / 100) + "." + str(obj_tok_red_x100 % 100) + "%")
    println("  json_strict_output_tok_reduction_pct = " + str(str_tok_red_x100 / 100) + "." + str(str_tok_red_x100 % 100) + "%")
    println("  json_object_wall_ms_reduction_pct    = " + str(obj_wall_red_x100 / 100) + "." + str(obj_wall_red_x100 % 100) + "%")
    println("  json_strict_wall_ms_reduction_pct    = " + str(str_wall_red_x100 / 100) + "." + str(str_wall_red_x100 % 100) + "%")
    println("  accuracy_preserved                   = " + acc_preserved)
    println("")

    let summary_path = OUT_DIR + "/stage4_json_schema_summary.txt"
    exec("rm -f " + shq(summary_path))
    exec("echo " + shq("# model=" + MODEL_NAME) + " >> " + shq(summary_path))
    exec("echo " + shq("# endpoint=" + BASE_URL + "/v1/chat/completions") + " >> " + shq(summary_path))
    exec("echo " + shq("# total_tasks=" + str(total)) + " >> " + shq(summary_path))
    exec("echo " + shq("# unconstrained_accuracy=" + str(unc_correct) + "/" + str(total)) + " >> " + shq(summary_path))
    exec("echo " + shq("# json_object_accuracy=" + str(obj_correct) + "/" + str(total)) + " >> " + shq(summary_path))
    exec("echo " + shq("# json_strict_accuracy=" + str(str_correct) + "/" + str(total)) + " >> " + shq(summary_path))
    exec("echo " + shq("# unconstrained_total_wall_ms=" + str(unc_wall)) + " >> " + shq(summary_path))
    exec("echo " + shq("# json_object_total_wall_ms=" + str(obj_wall)) + " >> " + shq(summary_path))
    exec("echo " + shq("# json_strict_total_wall_ms=" + str(str_wall)) + " >> " + shq(summary_path))
    exec("echo " + shq("# unconstrained_avg_output_tokens=" + str(unc_avg_tok_x10 / 10) + "." + str(unc_avg_tok_x10 % 10)) + " >> " + shq(summary_path))
    exec("echo " + shq("# json_object_avg_output_tokens=" + str(obj_avg_tok_x10 / 10) + "." + str(obj_avg_tok_x10 % 10)) + " >> " + shq(summary_path))
    exec("echo " + shq("# json_strict_avg_output_tokens=" + str(str_avg_tok_x10 / 10) + "." + str(str_avg_tok_x10 % 10)) + " >> " + shq(summary_path))
    exec("echo " + shq("# json_object_output_tok_reduction_pct=" + str(obj_tok_red_x100 / 100) + "." + str(obj_tok_red_x100 % 100)) + " >> " + shq(summary_path))
    exec("echo " + shq("# json_strict_output_tok_reduction_pct=" + str(str_tok_red_x100 / 100) + "." + str(str_tok_red_x100 % 100)) + " >> " + shq(summary_path))
    exec("echo " + shq("# json_object_wall_ms_reduction_pct=" + str(obj_wall_red_x100 / 100) + "." + str(obj_wall_red_x100 % 100)) + " >> " + shq(summary_path))
    exec("echo " + shq("# json_strict_wall_ms_reduction_pct=" + str(str_wall_red_x100 / 100) + "." + str(str_wall_red_x100 % 100)) + " >> " + shq(summary_path))
    exec("echo " + shq("# json_object_fallback_rows=" + str(obj_fb)) + " >> " + shq(summary_path))
    exec("echo " + shq("# json_strict_fallback_rows=" + str(str_fb)) + " >> " + shq(summary_path))
    exec("echo " + shq("# accuracy_preserved=" + acc_preserved) + " >> " + shq(summary_path))
    exec("echo " + shq("# reduction_target_pct=" + str(REDUCTION_TARGET_PCT)) + " >> " + shq(summary_path))
    exec("echo " + shq("# llama_server_json_schema_exposed=true") + " >> " + shq(summary_path))
    exec("echo " + shq("# scorer=byte_exact_subset_caseinsensitive_on_.answer_field_then_fallback_raw") + " >> " + shq(summary_path))
    exec("echo " + shq("# host=mac-mini-m3 (brew llama-server b9150 + Metal)") + " >> " + shq(summary_path))
    exec("echo " + shq("# cost_usd=0  (local serving; wall_ms is the proxy cost surface)") + " >> " + shq(summary_path))

    println("  tsv     persisted: " + tsv_path)
    println("  summary persisted: " + summary_path)
    println("")
    println("__HEXA_CODEX_BENCH_SANDBOX_STAGE4_JSON_SCHEMA__ PASS")
    exit(0)
}
