#!hexa strict
// hexa-codex/ENGINE/verify/numerics_engine_l1_cost_router.hexa
// ENGINE axis L1 — falsifier verifier for the cost-aware model-router wire.
//
// Asserts that route_cheapest_sufficient is a faithful, deterministic decision
// rule that CONSUMES the ECONOMICS/N1 COST-PERFORMANCE finding (50× same-acc-
// tier cost spread · GPT-5 $15 vs DeepSeek $0.30 · LXT 2026 + Artificial
// Analysis Index 2026):
//   (1) route identity — among acc_tier ≥ min, picks the cheapest model
//   (2) 50× saving realized — selects deepseek (cost 30) · AVOIDS gpt5 (1500)
//   (3) min_acc_tier exclusion — a below-tier cheaper model is NOT picked
//   (4) FALSIFIER wire — a finding-ignorant router (most-expensive-qualifying)
//       is detected as WRONG vs route_cheapest_sufficient's cheapest choice
//   (5) determinism (re-call → identical index)
//   (6) source-finding consistency — ECONOMICS/N1 spread = 1500×100/30 = 5000
//   (7) selected cost ≤ every qualifying candidate (cheapest guarantee)
// Any FAIL = wire contradicts the ECONOMICS/N1 finding ⇒ ENGINE L1 FALSIFIED.
//
// SOURCE.  ENGINE/wires/wire_l1_cost_router.hexa (verifier replicates the
// decision rule — closed-form recompute, no import of emitted state).
// ECONOMICS/N1 source: verify/numerics_economics_n1_cost_performance_spread.hexa
//
// NAMING (commons g61). Distinct `route_cheapest_sufficient` — NOT the bare
// stdlib `policy/dual_track::route(r: Router, key: string)` (unrelated hash-
// keyed A/B router · disjoint signature). No stdlib pub-fn shadow.
//
// @no-lock-needed
// @resolver-bypass(reason="Pure closed-form recompute of the L1 decision rule.")

let SENTINEL_NO_ROUTE = -1

// ECONOMICS/N1 same-acc-tier frontier pool (consumed ledger · cents × 100)
let MODEL_NAMES = [
    "gpt5_proprietary",
    "claude_5_proprietary",
    "gemma4_31b_self_hosted",
    "qwen3.6_72b_self_hosted",
    "deepseek_v4_api",
]
let MODEL_ACC_TIER_x100 = [8500, 8500, 8500, 8500, 8500]
let MODEL_COST_M_x100    = [1500, 1200,   40,   80,   30]

fn route_cheapest_sufficient(acc_tiers: [int], costs: [int], min_acc_tier: int) -> int {
    let n = acc_tiers.len()
    let mut best = SENTINEL_NO_ROUTE
    let mut best_cost = 0
    let mut i = 0
    while i < n {
        if acc_tiers[i] >= min_acc_tier {
            if best == SENTINEL_NO_ROUTE || costs[i] < best_cost {
                best = i
                best_cost = costs[i]
            }
        }
        i = i + 1
    }
    return best
}

// FALSIFIER reference — a (deliberately wrong) router that IGNORES cost-aware
// economics: among qualifying models it picks the MOST EXPENSIVE (never saves).
fn route_finding_ignorant(acc_tiers: [int], costs: [int], min_acc_tier: int) -> int {
    let n = acc_tiers.len()
    let mut worst = SENTINEL_NO_ROUTE
    let mut worst_cost = 0
    let mut i = 0
    while i < n {
        if acc_tiers[i] >= min_acc_tier {
            if worst == SENTINEL_NO_ROUTE || costs[i] > worst_cost {
                worst = i
                worst_cost = costs[i]
            }
        }
        i = i + 1
    }
    return worst
}

// ECONOMICS/N1 spread identity helper (consumed datum recompute)
fn spread_x100(costs: [int]) -> int {
    let mut lo = costs[0]
    let mut hi = costs[0]
    let mut i = 1
    while i < costs.len() {
        if costs[i] < lo { lo = costs[i] }
        if costs[i] > hi { hi = costs[i] }
        i = i + 1
    }
    if lo <= 0 { return 0 }
    return (hi * 100) / lo
}

print("hexa-codex ENGINE L1 falsifier — cost-aware model-router (cycle-10)")
print("====================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0

// check 1 — route identity: among acc_tier ≥ min, picks the cheapest
checks_total = checks_total + 1
let idx_all = route_cheapest_sufficient(MODEL_ACC_TIER_x100, MODEL_COST_M_x100, 8000)
if idx_all == 4 && MODEL_COST_M_x100[idx_all] == 30 {
    print("  [PASS] route identity: min_acc 8000 → idx 4 (" + MODEL_NAMES[idx_all] +
          " · cost 30 = cheapest qualifying)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] route identity did not pick cheapest qualifying (got idx " + to_string(idx_all) + ")")
}

// check 2 — 50× saving realized: selects deepseek (30) · AVOIDS gpt5 (1500)
checks_total = checks_total + 1
let chosen_cost = MODEL_COST_M_x100[idx_all]
let gpt5_cost = MODEL_COST_M_x100[0]
if chosen_cost == 30 && gpt5_cost == 1500 && (gpt5_cost * 100) / chosen_cost == 5000 {
    print("  [PASS] 50× saving realized: router picks deepseek (30) · AVOIDS gpt5 (1500) · " +
          to_string((gpt5_cost * 100) / chosen_cost) + "/100 = 50.00× cheaper")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] 50× saving NOT realized (chosen=" + to_string(chosen_cost) + " gpt5=" + to_string(gpt5_cost) + ")")
}

// check 3 — min_acc_tier exclusion: a below-tier cheaper model is NOT picked.
//   Heterogeneous pool: cheapest (cost 10) is BELOW tier (8000 < min 8400);
//   only the costlier 8500-tier models qualify → router must pick cost 50, not 10.
checks_total = checks_total + 1
let HET_ACC  = [8500, 8000, 8500]   // mid model is sub-tier
let HET_COST = [  50,   10,   90]   // sub-tier model is cheapest
let idx_het = route_cheapest_sufficient(HET_ACC, HET_COST, 8400)
if idx_het == 0 && HET_COST[idx_het] == 50 {
    print("  [PASS] min_acc_tier exclusion: cheapest (cost 10 · acc 8000 < min 8400) EXCLUDED → idx 0 (cost 50 · qualifying-cheapest)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] sub-tier model not excluded (got idx " + to_string(idx_het) + ")")
}

// check 4 — FALSIFIER wire: finding-ignorant (max-cost) router detected WRONG
checks_total = checks_total + 1
let correct = route_cheapest_sufficient(MODEL_ACC_TIER_x100, MODEL_COST_M_x100, 8000)   // 4 (deepseek 30)
let ignorant = route_finding_ignorant(MODEL_ACC_TIER_x100, MODEL_COST_M_x100, 8000)     // 0 (gpt5 1500)
if correct == 4 && ignorant == 0 && correct != ignorant &&
   MODEL_COST_M_x100[correct] < MODEL_COST_M_x100[ignorant] {
    print("  [PASS] FALSIFIER caught: finding-ignorant max-cost router → idx 0 (gpt5 1500) ≠ " +
          "route_cheapest_sufficient → idx 4 (deepseek 30) · wire honors ECONOMICS/N1 cost-awareness")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] falsifier wire NOT detected (correct=" + to_string(correct) + " ignorant=" + to_string(ignorant) + ")")
}

// check 5 — determinism (re-call → identical index)
checks_total = checks_total + 1
if route_cheapest_sufficient(MODEL_ACC_TIER_x100, MODEL_COST_M_x100, 8000) ==
   route_cheapest_sufficient(MODEL_ACC_TIER_x100, MODEL_COST_M_x100, 8000) &&
   route_cheapest_sufficient(MODEL_ACC_TIER_x100, MODEL_COST_M_x100, 9000) ==
   route_cheapest_sufficient(MODEL_ACC_TIER_x100, MODEL_COST_M_x100, 9000) &&
   spread_x100(MODEL_COST_M_x100) == spread_x100(MODEL_COST_M_x100) {
    print("  [PASS] deterministic (re-call same routed index + same spread)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] non-deterministic")
}

// check 6 — source-finding consistency: ECONOMICS/N1 spread = 1500×100/30 = 5000
checks_total = checks_total + 1
let pool_spread = spread_x100(MODEL_COST_M_x100)
if pool_spread == 5000 {
    print("  [PASS] ECONOMICS/N1 consumed: max×100/min = 1500×100/30 = " + to_string(pool_spread) +
          " (= 50.00× · wire ↔ finding consistent · LXT 2026 + Artificial Analysis Index 2026)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] ECONOMICS/N1 spread mismatch (got " + to_string(pool_spread) + " ≠ 5000)")
}

// check 7 — selected cost ≤ every qualifying candidate (cheapest guarantee)
checks_total = checks_total + 1
let min_acc = 8000
let sel = route_cheapest_sufficient(MODEL_ACC_TIER_x100, MODEL_COST_M_x100, min_acc)
let mut cheapest_ok = true
let mut qualifying = 0
if sel == SENTINEL_NO_ROUTE {
    cheapest_ok = false
} else {
    let sel_cost = MODEL_COST_M_x100[sel]
    let mut k = 0
    while k < MODEL_NAMES.len() {
        if MODEL_ACC_TIER_x100[k] >= min_acc {
            qualifying = qualifying + 1
            if sel_cost > MODEL_COST_M_x100[k] { cheapest_ok = false }
        }
        k = k + 1
    }
}
if cheapest_ok {
    print("  [PASS] cheapest guarantee: selected cost ≤ all " + to_string(qualifying) +
          " qualifying candidates (cost " + to_string(MODEL_COST_M_x100[sel]) + " is the min · cost-sufficient routing)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] selected cost is NOT ≤ every qualifying candidate")
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 STRUCTURAL (decision rule 7/7) + 🟡 BY-CITATION (ECONOMICS/N1 finding consume · LXT 2026 + Artificial Analysis Index 2026) — route_cheapest_sufficient wires the 50× cost spread into a cheapest-sufficient serving model-router choice · daily-pricing dependent"
} else {
    verdict_tier = "🔴 FALSIFIED — decision rule contradicts ECONOMICS/N1 finding (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
}
print("  " + verdict_tier)
print("")
print("ENGINE L1 finding (closed-form decision rule · cycle-10):")
print("  - route_cheapest_sufficient(acc_tiers, costs, min_acc_tier) → cheapest model with acc_tier ≥ min_acc_tier (-1 if none)")
print("  - ECONOMICS/N1 50× spread → router selects deepseek (cost 30) · AVOIDS gpt5 (cost 1500) · 50.00× saving realized")
print("  - min_acc_tier exclusion: a cheaper sub-tier model is NOT picked (never undercut required accuracy)")
print("  - falsifier wire (finding-ignorant max-cost router) detected — proves the rule actually honors the measurement")
print("  - honest residual: live serving cost-router (lm_foundry · SANDBOX · Artificial Analysis daily-pricing fetch + same-acc-tier MMLU-pro validation) DEFERRED to cycle-11+ T4 (cx_lab_sandbox)")
print("")
print("__HEXA_CODEX_NUMERICS_ENGINE_L1__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/ENGINE/verdicts/l1_cost_router_verdict.txt"

let mut content = "# hexa-codex ENGINE L1 — cost-aware model-router verifier (cycle-10)\n"
content = content + "# axis=ENGINE/ENGINE.md::L1 (ECONOMICS/N1 COST-PERFORMANCE finding → serving cost-aware model-router decision rule)\n"
content = content + "# wire=ENGINE/wires/wire_l1_cost_router.hexa\n"
content = content + "# verifier=ENGINE/verify/numerics_engine_l1_cost_router.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# rule=route_cheapest_sufficient(acc_tiers, costs, min_acc_tier): among models with acc_tier >= min_acc_tier, pick lowest cost (cheapest-sufficient · ties -> lowest index); -1 if none qualify\n"
content = content + "# source_finding=ECONOMICS/N1 cost spread = max(cost_per_M_x100) x 100 / min(cost_per_M_x100) = 1500 x 100 / 30 = 5000 (= 50.00x · GPT-5 $15 vs DeepSeek V4 $0.30 · same-acc-tier)\n"
content = content + "# pool=gpt5 1500 · claude5 1200 · gemma4 40 · qwen3.6 80 · deepseek 30 (cents x 100 per M input tok · all acc_tier 8500 same-tier assumption)\n"
content = content + "# cases=all-qualify[min 8000]->idx4 deepseek(30) · exact-tier[min 8500]->idx4 deepseek(30) · above-all[min 9000]->-1 no-route\n"
content = content + "# saving=router picks deepseek(30) over gpt5(1500) -> 1500 x 100 / 30 = 5000/100 = 50.00x cost reduction at equal acc-tier\n"
content = content + "# exclusion=heterogeneous pool [acc 8500/8000/8500 · cost 50/10/90 · min 8400] -> sub-tier cheapest(10) EXCLUDED -> idx0 cost50 (never undercut required accuracy)\n"
content = content + "# falsifier=finding-ignorant max-cost router (picks most-expensive qualifying = gpt5 idx0 1500) detected as WRONG vs route_cheapest_sufficient deepseek idx4 30 (check 4)\n"
content = content + "# cheapest_guarantee=selected cost <= every qualifying candidate (check 7 · cost-sufficient routing invariant)\n"
content = content + "# external_anchor=LXT 2026 LLM benchmarks 50x cost variation · Artificial Analysis Index 2026 (artificialanalysis.ai) · OpenAI/Anthropic pricing pages 2026 · DeepSeek V4 release notes (April 2026) · consumed via ECONOMICS/N1\n"
content = content + "# naming_g61=distinct route_cheapest_sufficient — NOT bare stdlib policy/dual_track::route(r: Router, key: string) (unrelated hash-keyed A/B router · disjoint signature)\n"
content = content + "# honest_residual=live serving cost-router wiring (lm_foundry · SANDBOX local llama-server · Artificial Analysis daily-pricing fetch + same-acc-tier MMLU-pro/LMSys/LiveBench validation) DEFERRED to cycle-11+ T4 (cx_lab_sandbox · feedback_closure_is_physical_limit — rule close != measured close)\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
