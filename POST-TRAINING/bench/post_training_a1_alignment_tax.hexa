#!hexa strict
// POST-TRAINING/bench/post_training_a1_alignment_tax.hexa
// orchestra "Post-Training" 누락 흡수 (cycle-10 orchestra-research) — 신규 단독
// 도메인 POST-TRAINING 의 A1 (first probe). alignment tuning 이 capability 를
// 얼마나 희생하는가 (alignment tax) 의 closed-form 측정. helpfulness 가 오르는
// 대가로 base capability 가 떨어지는 trade 를 base − post capability drop 으로
// 정량화.
//
// Identity (closed-form · libm-free · × 100 ledger of pp):
//   alignment_tax_x100(method)  = base_capability_x100 − post_capability_x100
//   falsifier_fires(method)     = alignment_tax_x100 > THRESHOLD_x100 (> 5pp drop)
//
// Falsifier (POST-TRAINING A1): alignment tuning 후 capability drop > 5pp
// (helpfulness↑ 인데 능력 희생) → alignment tax 과다. helpfulness gain 이
// 아무리 커도 base capability 를 5pp 넘게 깎으면 over-aligned.
//
// Bidirectional discrimination:
//   good-DPO  : helpfulness↑ · capability drop < 5pp  → silent (좋은 alignment)
//   over-aligned : helpfulness↑ · capability drop > 5pp → fires (능력 희생)
//
// External anchors (citation tier · 🟡):
//   Ouyang 2022 — InstructGPT / RLHF (arXiv:2203.02155)
//   Rafailov 2023 — DPO (arXiv:2305.18290)
//   Shao 2024 — GRPO / DeepSeekMath (arXiv:2402.03300)
//   Bai 2022 — Constitutional AI (arXiv:2212.08073)
//
// Integer ledger (× 100 in pp) — libm-free closed-form. Placeholder per-method
// numbers — 실측 (base vs post capability bench: MMLU/GSM8K/HumanEval pre/post
// alignment on local SANDBOX stack) deferred (cycle-11+ T4 · `cx_lab_sandbox`).
//
// @no-lock-needed
// @resolver-bypass(reason="Pure capability-drop identity recompute — no runtime infer.")

// ────────────────────────────────────────────────────────────────────────
// Method registry (5 post-train methods · base/post capability + helpfulness)
//   base_capability_x100 : pre-alignment capability (MMLU/GSM8K/HumanEval avg, pp)
//   post_capability_x100 : post-alignment capability (same bench, pp)
//   helpfulness_gain_x100: post-alignment helpfulness gain vs base (pp)
//
// Method index: 0=sft_base · 1=good_dpo · 2=rlhf_ppo · 3=grpo · 4=over_aligned
//   sft_base     : SFT only      — base=80 post=79 (drop 1pp) · help_gain= 8 → silent
//   good_dpo     : DPO well-tuned — base=80 post=78 (drop 2pp) · help_gain=15 → silent
//   rlhf_ppo     : RLHF PPO       — base=80 post=76 (drop 4pp) · help_gain=20 → silent
//   grpo         : GRPO           — base=80 post=77 (drop 3pp) · help_gain=18 → silent
//   over_aligned : over-aligned   — base=80 post=68 (drop 12pp)· help_gain=25 → FIRES
//
// Stored × 100 (so 80 pp → 8000 ledger) — libm-free, matches the codex × 100
// pp ledger convention (MULTIMODAL/MULTILINGUAL/LONG-CONTEXT).
// ────────────────────────────────────────────────────────────────────────

let METHOD_NAMES = ["sft_base", "good_dpo", "rlhf_ppo", "grpo", "over_aligned"]

// base capability × 100 (pre-alignment · same 80pp baseline for clean drop comparison)
let BASE_CAP_x100 = [8000, 8000, 8000, 8000, 8000]
// post capability × 100 (post-alignment)
let POST_CAP_x100 = [7900, 7800, 7600, 7700, 6800]
// helpfulness gain × 100 (post-alignment helpfulness gain vs base, pp)
let HELP_GAIN_x100 = [800, 1500, 2000, 1800, 2500]

let N_METHODS = 5
let THRESHOLD_x100 = 500            // > 5pp capability drop → over-aligned (alignment tax 과다)
let CAP_MAX_x100 = 100 * 100        // capability ∈ [0, 100] pp · × 100 ledger ∈ [0, 10000]

fn base_cap_x100(method_i: int) -> int {
    return BASE_CAP_x100[method_i]
}
fn post_cap_x100(method_i: int) -> int {
    return POST_CAP_x100[method_i]
}
fn help_gain_x100(method_i: int) -> int {
    return HELP_GAIN_x100[method_i]
}

fn alignment_tax_x100(method_i: int) -> int {
    // capability drop induced by alignment (× 100 ledger).
    //   tax = base_capability − post_capability (positive = capability sacrificed)
    return base_cap_x100(method_i) - post_cap_x100(method_i)
}

fn capability_retention_x100(method_i: int) -> int {
    // post / base capability as a × 100 percentage (retention).
    //   retention_pct_x100 = post_capability × 10000 / base_capability
    return post_cap_x100(method_i) * 10000 / base_cap_x100(method_i)
}

fn alignment_passed(method_i: int) -> bool {
    return alignment_tax_x100(method_i) <= THRESHOLD_x100
}

fn falsifier_fires(method_i: int) -> bool {
    return alignment_tax_x100(method_i) > THRESHOLD_x100
}

print("hexa-codex POST-TRAINING A1 — alignment tax closed-form (orchestra Post-Training 흡수 · cycle-10)")
print("===================================================================================================")
print("")
print("per-method alignment profile (placeholder · × 100 ledger · libm-free):")
let n_methods = METHOD_NAMES.len()
let mut i = 0
while i < n_methods {
    let bc = base_cap_x100(i)
    let pc = post_cap_x100(i)
    let hg = help_gain_x100(i)
    let tax = alignment_tax_x100(i)
    let ret = capability_retention_x100(i)
    print("  " + METHOD_NAMES[i] + ":")
    print("    base_capability=" + to_string(bc) + "/100 (" + to_string(bc / 100) + " pp)" +
          " · post_capability=" + to_string(pc) + "/100 (" + to_string(pc / 100) + " pp)")
    print("    helpfulness_gain=" + to_string(hg) + "/100 (+" + to_string(hg / 100) + " pp)" +
          " · capability_retention=" + to_string(ret) + "/10000 (" + to_string(ret / 100) + "%)")
    let mut flag = "silent (alignment tax OK · drop ≤ 5pp)"
    if falsifier_fires(i) {
        flag = "FIRES (alignment tax > 5pp · capability 희생 · over-aligned)"
    }
    print("    → alignment_tax=" + to_string(tax) + "/100 (" + to_string(tax / 100) + " pp drop) · [" + flag + "]")
    i = i + 1
}
print("")
print("__HEXA_CODEX_POST_TRAINING_A1_ALIGNMENT_TAX__ DONE")
