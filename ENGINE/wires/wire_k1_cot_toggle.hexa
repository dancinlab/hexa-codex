#!hexa strict
// hexa-codex/ENGINE/wires/wire_k1_cot_toggle.hexa
// ENGINE axis K1 — HALLUCINATION/N1 REASONING-DEPTH finding → serving scratch-pad/CoT toggle.
//
// SOURCE FINDING (HALLUCINATION/N1 ⭐ NOVEL MAIN · reasoning-depth scratch-pad utility).
//   cot_delta_pp_x100(model) = scratchpad_x100 − direct_x100 (signed pp gain · × 100 ledger).
//   4 frontier thinking models carry HUGE scratch-pad utility (CoT load-bearing):
//     gpt5_o1 Δ44pp · claude_5 Δ42pp · gemma4_31b Δ47pp · qwen3.6_72b Δ40pp (all ≥ 5pp).
//   pattern_match_legacy carries NONE (Δ3pp < 5pp · scratch-pad utility ~ 0 · the model
//   already pattern-matches the answer; forcing CoT only burns tokens, doesn't fix 환각).
//   The 5pp (× 100 → 500) threshold = the scratch-pad-utility lower bound that separates
//   the deep-reasoning regime (CoT helps) from the pattern-matching regime (CoT inert).
//
// DECISION RULE (closed-form · this wire).  cot_toggle(cot_delta_pp_x100, task_complexity)
//   turns that measurement into an actual serving inference choice between a fast DIRECT
//   answer and an expensive THINKING (scratch-pad / extended-thinking) pass:
//     (1) cot_delta < 5pp (< 500 × 100)      → "direct"  — scratch-pad utility ~ 0
//                                                 (pattern_match). Forcing thinking is
//                                                 pure cost waste · no 환각 reduction.
//     (2) cot_delta ≥ 5pp AND complex task   → "thinking" — utility is real AND the task
//                                                 needs it · spend the scratch-pad tokens.
//     (3) cot_delta ≥ 5pp AND simple task    → "direct"  — utility exists but a simple
//                                                 query doesn't exercise it · save the cost.
//
// The rule consumes the SAME HALLUCINATION/N1 data (cot_delta × 100 ledger: 4400 · 4200 ·
// 4700 · 4000 frontier; 300 pattern_match) — wire ↔ finding consistency is asserted by
// check (6) of the verifier.
//
// FALSIFIER (paired verifier · check 4). A wire that IGNORED the finding — forcing
// "thinking" on a cot_delta<5pp (pattern_match) task — is constructed explicitly and
// MUST be detected as wrong against cot_toggle's "direct" (it would burn scratch-pad
// tokens for zero 환각 benefit · finding inverted).
//
// HONESTY. Closed-form decision rule only. Connecting this rule to a live serving
// CoT-toggle (lm_foundry · SANDBOX local llama-server thinking-mode switch) is a
// cost-bearing T4 contact DEFERRED to cycle-11+ (cx_lab_sandbox · per
// feedback_closure_is_physical_limit — rule close ≠ measured close).
//
// @no-lock-needed
// @resolver-bypass(reason="Pure decision-rule emission — no runtime infer call, no atlas atoms touched.")

// ────────────────────────────────────────────────────────────────────────
// Finding constants (HALLUCINATION/N1 · integer × 100 pp ledger · libm-free)
// ────────────────────────────────────────────────────────────────────────

let UTILITY_THRESHOLD_x100 = 500   // 5pp scratch-pad-utility lower bound (× 100 ledger)

// HALLUCINATION/N1 cot_delta × 100 ledger (scratchpad_x100 − direct_x100 · consumed data)
let N1_MODEL_NAMES = [
    "gpt5_o1_reasoning",
    "claude_5_thinking",
    "gemma4_31b_thinking",
    "qwen3.6_72b_thinking",
    "pattern_match_legacy",
]
let N1_COT_DELTA_x100 = [4400, 4200, 4700, 4000, 300]   // 44 · 42 · 47 · 40 · 3 pp

// ────────────────────────────────────────────────────────────────────────
// Decision rule — cot_toggle(cot_delta_pp_x100, task_complexity) → {direct, thinking}
// ────────────────────────────────────────────────────────────────────────

fn cot_toggle(cot_delta_pp_x100: int, task_complexity: str) -> str {
    // (1) scratch-pad utility below the 5pp lower bound → never force thinking.
    if cot_delta_pp_x100 < UTILITY_THRESHOLD_x100 {
        return "direct"
    }
    // (2) real utility AND a complex task that exercises it → spend scratch-pad.
    if task_complexity == "complex" {
        return "thinking"
    }
    // (3) real utility but a simple query → don't pay for it · save cost.
    return "direct"
}

// ────────────────────────────────────────────────────────────────────────
// Test cases — HALLUCINATION/N1-consistent (frontier Δ40-47 · pattern_match Δ3)
// ────────────────────────────────────────────────────────────────────────

let CASE_NAME = [
    "gpt5_o1_reasoning",      // Δ44 ≥ 5pp · complex → thinking (utility활용)
    "gpt5_o1_reasoning",      // SAME Δ44 · simple → direct (비용절감)
    "gemma4_31b_thinking",    // Δ47 ≥ 5pp · complex → thinking
    "pattern_match_legacy",   // Δ3 < 5pp · complex → direct (thinking 강제 무의미)
    "pattern_match_legacy",   // Δ3 < 5pp · simple → direct
]
let CASE_COT_DELTA_x100 = [
    4400,                     // gpt5_o1 Δ44pp (HALLUCINATION/N1)
    4400,
    4700,                     // gemma4_31b Δ47pp (HALLUCINATION/N1)
    300,                      // pattern_match_legacy Δ3pp (HALLUCINATION/N1)
    300,
]
let CASE_TASK_COMPLEXITY = [
    "complex",
    "simple",
    "complex",
    "complex",
    "simple",
]
let CASE_EXPECT = [
    "thinking",               // utility ≥ 5pp + complex
    "direct",                 // utility ≥ 5pp but simple → save cost
    "thinking",               // utility ≥ 5pp + complex
    "direct",                 // utility < 5pp → never force thinking (even if complex)
    "direct",                 // utility < 5pp + simple
]

print("hexa-codex ENGINE K1 — HALLUCINATION/N1 REASONING-DEPTH → serving CoT-toggle decision rule (cycle-10)")
print("====================================================================================================")
print("")
print("source finding: HALLUCINATION/N1 cot_delta (× 100 pp) = gpt5 4400 · claude5 4200 · gemma4 4700 · qwen3.6 4000 (≥ 5pp · CoT load-bearing) · pattern_match 300 (< 5pp · scratch-pad inert)")
print("decision rule:  cot_toggle(cot_delta_pp_x100, task_complexity) → {direct, thinking} · threshold = " + to_string(UTILITY_THRESHOLD_x100) + "/100 = 5pp")
print("")

let mut i = 0
while i < CASE_NAME.len() {
    let got = cot_toggle(CASE_COT_DELTA_x100[i], CASE_TASK_COMPLEXITY[i])
    let mut mark = "ok"
    if got != CASE_EXPECT[i] { mark = "MISMATCH" }
    print("  " + CASE_NAME[i] + " (cot_delta=" + to_string(CASE_COT_DELTA_x100[i]) +
          "/100 · task=" + CASE_TASK_COMPLEXITY[i] + ") → cot_toggle=" + got +
          " [expect " + CASE_EXPECT[i] + " · " + mark + "]")
    i = i + 1
}
print("")
print("__HEXA_CODEX_ENGINE_K1_COT_TOGGLE__ DONE")
