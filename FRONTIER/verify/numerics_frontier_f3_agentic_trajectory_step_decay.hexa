#!hexa strict
// FRONTIER/verify/numerics_frontier_f3_agentic_trajectory_step_decay.hexa
// FRONTIER F3 — closed-form verifier for agentic-trajectory step-decay identity
// + step-compounding falsifier semantics.
//
// Asserts the decay-ratio identity + monotone-step sanity + threshold:
//   (1) decay_ratio identity (acc_5step × 1000 / acc_1step) for all 5 agents
//   (2) all acc (1/3/5-step) ∈ [0, 100] (success-rate percentage range)
//   (3) zero-decay synthetic (acc_1step = acc_5step = 90) → ratio = 1000 (silent)
//   (4) weak_4b_legacy fires (214 < 300 · step-compounding broken · agent
//       능력 부족)
//   (5) all 4 frontier agents silent (≥ 300 · gpt5=782 · claude5=755 ·
//       gemma4_31b=564 · qwen3.6_72b=704 · bidirectional control)
//   (6) determinism (recompute identical · recursively delicious)
//   (7) monotone non-increase sanity (acc_5step ≤ acc_3step ≤ acc_1step for
//       each model · agentic step-compounding natural sanity)
//
// Source: FRONTIER/bench/frontier_f3_agentic_trajectory_step_decay.hexa
// External anchors:
//   Mialon 2023 — GAIA (arXiv:2311.12983)
//   ATBench 2026 (arXiv:2604.02022)
//   SWE-bench Pro / Terminal-Bench 2.0 (2026)
//   Yao 2022 — ReAct (arXiv:2210.03629)
//   Shinn 2023 — Reflexion (arXiv:2303.11366)
//
// @no-lock-needed

let MODEL_NAMES = [
    "gpt5_agent",
    "claude_5_agent",
    "gemma4_31b_agent",
    "qwen3.6_72b_agent",
    "weak_4b_legacy",
]
let ACC_1STEP_x100 = [92, 90, 85, 88, 70]
let ACC_3STEP_x100 = [80, 78, 65, 74, 30]
let ACC_5STEP_x100 = [72, 68, 48, 62, 15]

let DECAY_THRESHOLD_x1000 = 300
let ACC_MIN_x100 = 0
let ACC_MAX_x100 = 100

fn decay_ratio_x1000(i: int) -> int {
    let a1 = ACC_1STEP_x100[i]
    if a1 <= 0 { return 0 }
    return (ACC_5STEP_x100[i] * 1000) / a1
}

fn falsifier_fires(i: int) -> bool {
    return decay_ratio_x1000(i) < DECAY_THRESHOLD_x1000
}

print("hexa-codex FRONTIER F3 falsifier — Agentic-trajectory step-decay closed-form")
print("================================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0
let n = MODEL_NAMES.len()

// check 1 — decay_ratio identity for all 5 agents
checks_total = checks_total + 1
let mut id_ok = true
let mut i = 0
while i < n {
    let expect = (ACC_5STEP_x100[i] * 1000) / ACC_1STEP_x100[i]
    if decay_ratio_x1000(i) != expect { id_ok = false }
    i = i + 1
}
if id_ok {
    print("  [PASS] decay_ratio identity (acc_5step × 1000 / acc_1step) holds for all " + to_string(n) + " agents")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] decay_ratio identity broken")
}

// check 2 — all acc (1/3/5-step) ∈ [0, 100]
checks_total = checks_total + 1
let mut rb_ok = true
i = 0
while i < n {
    if ACC_1STEP_x100[i] < ACC_MIN_x100 || ACC_1STEP_x100[i] > ACC_MAX_x100 { rb_ok = false }
    if ACC_3STEP_x100[i] < ACC_MIN_x100 || ACC_3STEP_x100[i] > ACC_MAX_x100 { rb_ok = false }
    if ACC_5STEP_x100[i] < ACC_MIN_x100 || ACC_5STEP_x100[i] > ACC_MAX_x100 { rb_ok = false }
    i = i + 1
}
if rb_ok {
    print("  [PASS] all acc (1/3/5-step) ∈ [0, 100] (success-rate percentage range)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] some acc out of [0, 100]")
}

// check 3 — zero-decay synthetic (acc_1step = acc_5step = 90) → ratio = 1000
checks_total = checks_total + 1
let synth_decay = (90 * 1000) / 90
if synth_decay == 1000 {
    print("  [PASS] zero-decay synthetic edge (acc_1step = acc_5step = 90) → decay_ratio = 1000 (silent · neutral)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] zero-decay synthetic ≠ 1000 (got " + to_string(synth_decay) + ")")
}

// check 4 — weak_4b_legacy fires (214 < 300)
checks_total = checks_total + 1
let legacy_idx = 4
let legacy_decay = decay_ratio_x1000(legacy_idx)
if falsifier_fires(legacy_idx) && legacy_decay == 214 && legacy_decay < DECAY_THRESHOLD_x1000 {
    print("  [PASS] weak_4b_legacy FIRES 🔴 (decay_ratio=" + to_string(legacy_decay) +
          " < 300 · step-compounding broken · agent 능력 부족)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] legacy fires detection broken (decay=" + to_string(legacy_decay) + ")")
}

// check 5 — all 4 frontier agents silent (≥ 300 · bidirectional control)
checks_total = checks_total + 1
let mut frontier_silent_ok = true
let mut f_silent_count = 0
i = 0
while i < n {
    if i != legacy_idx {
        if falsifier_fires(i) { frontier_silent_ok = false }
        else { f_silent_count = f_silent_count + 1 }
    }
    i = i + 1
}
if frontier_silent_ok && f_silent_count == 4 {
    print("  [PASS] 4 frontier agents silent (≥ 300): gpt5=" + to_string(decay_ratio_x1000(0)) +
          " · claude5=" + to_string(decay_ratio_x1000(1)) +
          " · gemma4_31b=" + to_string(decay_ratio_x1000(2)) +
          " · qwen3.6_72b=" + to_string(decay_ratio_x1000(3)) +
          " (false-positive 회피 · bidirectional)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] frontier-silent detection broken (silent_count=" + to_string(f_silent_count) + ")")
}

// check 6 — determinism (recompute identical)
checks_total = checks_total + 1
if decay_ratio_x1000(4) == decay_ratio_x1000(4) &&
   falsifier_fires(4) == falsifier_fires(4) &&
   decay_ratio_x1000(0) == decay_ratio_x1000(0) {
    print("  [PASS] formula deterministic (re-call same decay_ratio + fires · recursively delicious)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] formula non-deterministic")
}

// check 7 — monotone non-increase sanity (acc_5step ≤ acc_3step ≤ acc_1step)
checks_total = checks_total + 1
let mut mono_ok = true
i = 0
while i < n {
    if ACC_3STEP_x100[i] > ACC_1STEP_x100[i] { mono_ok = false }
    if ACC_5STEP_x100[i] > ACC_3STEP_x100[i] { mono_ok = false }
    i = i + 1
}
if mono_ok {
    print("  [PASS] monotone non-increase: 5-step ≤ 3-step ≤ 1-step for all " + to_string(n) +
          " agents (agentic step-compounding natural sanity)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] monotone sanity broken (some 3-step > 1-step or 5-step > 3-step)")
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 STRUCTURAL (step-decay identity + monotone sanity 7/7) + 🟡 BY-CITATION (30% threshold + GAIA/ATBench/SWE-bench Pro anchor)"
} else {
    verdict_tier = "🔴 FALSIFIED — decay_ratio formula contradicts identity (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
}
print("  " + verdict_tier)
print("")
print("FRONTIER F3 finding (placeholder data · closed-form):")
print("  - decay_ratio = acc_5step × 1000 / acc_1step identity (7/7 closed-form checks)")
print("  - bidirectional discrimination: 4 frontier silent (564–782) · weak_4b_legacy fires (214)")
print("  - monotone non-increase sanity (5-step ≤ 3-step ≤ 1-step · agentic step-compounding natural sanity)")
print("  - external anchors: Mialon 2023 GAIA (2311.12983) · ATBench 2026 (2604.02022) · SWE-bench Pro / Terminal-Bench 2.0 · Yao 2022 ReAct (2210.03629) · Shinn 2023 Reflexion (2303.11366)")
print("  - step-compounding 한계: weak 4B legacy agent 가 5-step 에서 single-step × 0.3 미만 (15/70 = 0.214) — pre-agentic open weight 의 trajectory 붕괴")
print("  - 실측 GAIA · ATBench full-trajectory measured re-run on vast.ai pod (cycle-11+ T4 · cx_lab_sandbox)")
print("")
print("__HEXA_CODEX_NUMERICS_FRONTIER_F3__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/FRONTIER/verdicts/f3_agentic_trajectory_step_decay_verdict.txt"

let mut content = "# hexa-codex FRONTIER F3 — Agentic-trajectory step-decay verifier (cycle-10 round-3)\n"
content = content + "# axis=FRONTIER/FRONTIER.md::F3 AGENTIC-TRAJECTORY (multi-step trajectory degradation across tool-use task ladder)\n"
content = content + "# bench=FRONTIER/bench/frontier_f3_agentic_trajectory_step_decay.hexa\n"
content = content + "# verifier=FRONTIER/verify/numerics_frontier_f3_agentic_trajectory_step_decay.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# formula=decay_ratio_x1000 = acc_5step × 1000 / acc_1step; falsifier_fires = decay_ratio < 300 (step-compounding broken · 5-step < 1-step × 0.3)\n"
content = content + "# placeholder_data=5 agents × {1, 3, 5}-step ladder: gpt5_agent 92/80/72 · claude_5_agent 90/78/68 · gemma4_31b_agent 85/65/48 · qwen3.6_72b_agent 88/74/62 · weak_4b_legacy 70/30/15 (acc × 100)\n"
content = content + "# decay_ratios=gpt5=782 · claude5=755 · gemma4_31b=564 · qwen3.6_72b=704 · weak_4b_legacy=214 (× 1000)\n"
content = content + "# discrimination=4 frontier agents silent (≥ 300 · step-compounding 견딤) · weak_4b_legacy fires (214 < 300 · step-compounding broken · bidirectional)\n"
content = content + "# monotone_sanity=acc_5step ≤ acc_3step ≤ acc_1step for all 5 agents (agentic step-compounding natural sanity)\n"
content = content + "# zero_decay_edge=acc_1step = acc_5step = 90 → decay_ratio = 1000 (silent · neutral · proves no-decay regime)\n"
content = content + "# external_anchors=Mialon 2023 GAIA (arXiv:2311.12983) · ATBench 2026 (arXiv:2604.02022) · SWE-bench Pro / Terminal-Bench 2.0 · Yao 2022 ReAct (arXiv:2210.03629) · Shinn 2023 Reflexion (arXiv:2303.11366)\n"
content = content + "# step_compounding=weak 4B legacy agent 의 5-step success rate 가 single-step × 0.3 미만 (15/70 = 0.214) — pre-agentic open weight 의 multi-step trajectory 붕괴 · 4 frontier agents 모두 ≥ 0.564 (step-compounding 견딤 regime)\n"
content = content + "# substrate_fire=DEFERRED (cycle-11+ T4 · SANDBOX vast.ai pod + GAIA/ATBench full-trajectory measured re-run · cx_lab_sandbox · cx_empirical_contact)\n"
content = content + "# frontier_open=feedback_closure_is_physical_limit — identity close ≠ measured close · placeholder per-step success-rate ladder from GAIA/ATBench/SWE-bench Pro 2026 convention\n"
content = content + "# honest_residual=real GAIA · ATBench full-trajectory measured re-run on vast.ai pod DEFERRED to cycle-11+ T4 (cx_lab_sandbox · cx_empirical_contact)\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
