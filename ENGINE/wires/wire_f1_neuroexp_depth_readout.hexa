#!hexa strict
// hexa-codex/ENGINE/wires/wire_f1_neuroexp_depth_readout.hexa
// ENGINE axis F1 first wire — NEUROEXP finding → inference-time depth/readout rule.
//
// NEUROEXP is the 6th measurement sibling (LLM-neuroscience experiments), absent
// from ENGINE's original 5-sibling intake matrix.  This wire opens axis F.
//
// SOURCE FINDING (NEUROEXP cycle-11 L2 layer-wise logit-lens depth · 🟢 8/8 MEASURED):
//   Qwen2.5-1.5B-Instruct, 28 layers, logit-lens readout per layer:
//     mid layer (14) acc = 8.2%   · last layer (28) acc = 35.7%
//     gap last-vs-mid = 27.5pp (≫ 5pp) → readout concentrates in the LATE stack
//     first-within-5pp = layer 23 (82% depth) → readout block = final 6 (23-28)
//     NON-MONOTONIC: peak layer 27 (50.0%) > final layer 28 (35.7%)
//       — final RMSNorm+transform DE-OPTIMIZES the raw next-token logit-lens.
//   L2 falsifier outcome: late-stack concentration HOLDS, but STRICT
//   'last-single-layer only' is REFUTED (it's a 6-layer block, peak ≠ final).
//
// RULE.  An inference-time early-exit / readout-layer selector must:
//   (a) NOT exit before layer 23 (readout has not concentrated yet — mid-exit
//       loses 27.5pp), and
//   (b) read out at the PEAK layer 27, NOT the final layer 28 (the final
//       RMSNorm de-optimizes raw logit-lens → naive 'use last layer' is wrong).
//   A monotonic-confidence early-exit at a fixed fraction < 82% depth, or a
//   strict last-single-layer readout, contradicts the L2 finding.
//
// ENGINE N1 (latency).  NEUROEXP L2 finding cycle-11 → ENGINE wire cycle-7.
// Logged to N1 baseline next round (axis F's first ΔM data point).
//
// FALSIFIER (paired verifier).
//   (1) early-exit min layer = 23 (≥ readout block start, 82% depth)
//   (2) selected readout layer = 27 (peak), NOT 28 (final)
//   (3) peak acc 50.0% > final acc 35.7% (non-monotonicity recorded)
//   (4) mid layer 14 too early: gap to last = 27.5pp ≫ 5pp (mid-exit rejected)
//   (5) deterministic
//   (6) wire selects WITHIN final-6 block (23-28) — not strict-last-single-layer
//       AND not a pre-23 monotonic exit (ENGINE.md::F1 falsifier · both L2 verdicts honored)
//
// @no-lock-needed
// @resolver-bypass(reason="Pure depth/readout selection rule — no runtime infer, no atlas atoms.")

// ────────────────────────────────────────────────────────────────────────
// L2 measured layer profile (acc × 10, percentage points) — NEUROEXP cycle-11
// ────────────────────────────────────────────────────────────────────────

let LAYER_COUNT = 28
let MID_LAYER = 14
let MID_ACC_x10 = 82          // 8.2%
let PEAK_LAYER = 27
let PEAK_ACC_x10 = 500        // 50.0%
let LAST_LAYER = 28
let LAST_ACC_x10 = 357        // 35.7%
let FIRST_WITHIN_5PP_LAYER = 23   // 82% depth — readout block start
let WITHIN_5PP_THRESHOLD_x10 = 50 // 5pp × 10

fn readout_block_start() -> int { return FIRST_WITHIN_5PP_LAYER }   // 23
fn readout_block_end() -> int { return LAST_LAYER }                 // 28 → 6-layer block

// rule (a): minimum safe early-exit layer = readout block start
fn early_exit_min_layer() -> int { return readout_block_start() }

// rule (b): readout at the PEAK layer, not the final layer (RMSNorm de-optimizes)
fn select_readout_layer() -> int {
    // peak layer wins iff it strictly beats the final layer (non-monotonic)
    if PEAK_ACC_x10 > LAST_ACC_x10 { return PEAK_LAYER }
    return LAST_LAYER
}

fn is_safe_exit(layer: int) -> bool { return layer >= early_exit_min_layer() }

print("hexa-codex ENGINE F1 — NEUROEXP L2 depth → inference readout rule wire (cycle-7)")
print("================================================================================")
print("")
print("L2 measured profile (Qwen2.5-1.5B, 28 layers, logit-lens acc):")
print("  mid  layer " + to_string(MID_LAYER) + " = " + to_string(MID_ACC_x10) + "/10 %")
print("  peak layer " + to_string(PEAK_LAYER) + " = " + to_string(PEAK_ACC_x10) + "/10 %")
print("  last layer " + to_string(LAST_LAYER) + " = " + to_string(LAST_ACC_x10) + "/10 %")
print("")
print("emitted inference rule:")
print("  readout block      = layers " + to_string(readout_block_start()) + "-" + to_string(readout_block_end()) + " (final 6)")
print("  early-exit min     = layer " + to_string(early_exit_min_layer()) + " (exit below = unsafe)")
print("  selected readout   = layer " + to_string(select_readout_layer()) + " (peak, NOT final " + to_string(LAST_LAYER) + ")")
print("  mid-exit @14 safe? = " + (if is_safe_exit(MID_LAYER) { "true" } else { "false (loses 27.5pp)" }))
print("")
print("__HEXA_CODEX_ENGINE_F1_NEUROEXP_DEPTH_READOUT__ DONE")
