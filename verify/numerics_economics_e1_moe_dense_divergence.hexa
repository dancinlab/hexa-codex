content = content + "# dense_q1_x1000=" + to_string(DENSE_Q1) + "\n"
content = content + "# dense_median_x1000=" + to_string(DENSE_MED) + "\n"
content = content + "# dense_q3_x1000=" + to_string(DENSE_Q3) + "\n"
content = content + "# dense_min_x1000=" + to_string(DENSE_MIN) + "\n"
content = content + "# dense_max_x1000=" + to_string(DENSE_MAX) + "\n"
content = content + "# moe_n=" + to_string(N_MOE) + "\n"
content = content + "# moe_landing=deepseekv3-37B-active\n"
content = content + "# moe_d_over_n_x1000=" + to_string(MOE_RATIO) + "  (= exactly 20.000, Chinchilla rule-of-thumb)\n"
content = content + "# moe_empirical_pct_in_dense=" + to_string(MOE_PCT_x100) + "\n"
content = content + "# verdict_msg=" + verdict_msg + "\n"
content = content + "# next_probe=cycle-28 Mixtral 8x7B + Qwen3-MoE WebFetch → ≥3 MoE → KS-test enabled\n"

let wrote = write_file(OUT_PATH, content)
if wrote {
    print("verdict written: " + OUT_PATH)
} else {
    print("WARN: failed to write verdict file: " + OUT_PATH)
}
