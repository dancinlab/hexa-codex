#!hexa strict
// hexa-codex/lm_foundry/verify/numerics_bio_a2_vocab_size_capacity.hexa
// lm_foundry bio FINDING-A2 (absorbed from retired BIODATA domain · cycle-3 first probe) — vocab size effect on LLM capacity.
//
// CLAIM (BIO.md A2). 어휘 크기 V (text BPE 50000 vs protein 20-amino vs DNA 4-nt)
// 가 model capacity 요구에 미치는 닫힌형 영향. 반증자: V 와 model capacity 가
// 무관 → tokenization 이 BIO scaling 에 영향 없음.
//
// CLOSED-FORM (this verifier · 🔵 STRUCTURAL):
//   embedding params N_embed = V × d_model
//   output projection N_out = V × d_model (tied or untied)
//   total V-dependent = 2 × V × d (untied) or V × d (tied)
//
//   sequence length to encode same "info content":
//     text BPE (V=50k): ~ 30 tokens / sentence
//     protein (V=20):   ~ 300 amino / domain (1 amino ≈ 1 residue · 4.3 bits)
//     DNA (V=4):        ~ 900 nt / domain (3 nt per codon, 2 bits/nt)
//   attention compute O(n² · d): DNA pays 900² vs text 30² = 900× more attention cost
//
//   TRADE-OFF: smaller V saves embed params but pays sequence² in attention.
//   For protein/DNA LLMs at d ≥ 1024, embed savings are real (20k vs 50M)
//   but attention quadratic cost on longer sequences dominates above some threshold.
//
// FALSIFIER (BIO A2). "V 와 model capacity 무관" — this verifier shows V·d
// embed term is EXPLICIT in total params → REFUTED. V matters; the question
// is just how (embed vs attention vs sequence-length).
//
// HONESTY. Closed-form structural derivation only — no claim that one
// tokenization is universally optimal (operating-point dependent: d_model,
// task length, attention complexity).
//
// External anchor: Lin 2023 ESM2 (V=20 amino) · DNABERT / Caduceus
// (V=4 nt) · Llama3 tokenizer (V≈128k BPE).
//
// @no-lock-needed
// @resolver-bypass(reason="Closed-form vocab-capacity structural recompute.")

// vocab sizes (canonical)
let V_TEXT = 50000      // Llama2-like BPE (Llama3 ~ 128k, GPT2 ~ 50k)
let V_PROTEIN = 20      // 20 standard amino acids
let V_DNA = 4           // 4 nucleotides (A/C/G/T)

// per-domain typical sequence length (encoding same biological "fact")
let SEQ_TEXT = 30       // 1-2 sentence English description
let SEQ_PROTEIN = 300   // a typical protein domain (residues)
let SEQ_DNA = 900       // 3 nt per amino · same domain in DNA

// model dimension (typical modern LLM hidden size)
let D_MODEL = 1024

// embed params = V × d (untied output adds another V·d; here count both)
fn embed_params(v: int, d: int) -> int {
    return 2 * v * d   // input embed + output projection (untied)
}

// attention compute per layer ∝ n² · d (standard MHA)
fn attn_compute_per_layer(n: int, d: int) -> int {
    return n * n * d
}

print("hexa-codex lm_foundry bio A2 — vocab size effect on LLM capacity (cycle-3 first probe)")
print("============================================================================")
print("  text V=50000 (BPE) · protein V=20 (amino) · DNA V=4 (nt) · d_model=1024")
print("  seq-length (same content): text 30 · protein 300 · DNA 900")
print("")

let mut checks_passed = 0
let mut checks_total = 0

// ── check 1 — embed param counts
checks_total = checks_total + 1
let EMB_TEXT = embed_params(V_TEXT, D_MODEL)        // 2·50000·1024 = 102,400,000 (102.4M)
let EMB_PROTEIN = embed_params(V_PROTEIN, D_MODEL)   // 2·20·1024 = 40,960 (41K)
let EMB_DNA = embed_params(V_DNA, D_MODEL)           // 2·4·1024 = 8,192 (8K)
if EMB_TEXT == 102400000 && EMB_PROTEIN == 40960 && EMB_DNA == 8192 {
    print("  [PASS] embed params: text=" + to_string(EMB_TEXT) + " (102.4M) · protein=" + to_string(EMB_PROTEIN) + " (41K) · DNA=" + to_string(EMB_DNA) + " (8K)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] embed param compute")
}

// ── check 2 — text embed >> protein embed (V ratio 2500×)
checks_total = checks_total + 1
let RATIO_TEXT_PROTEIN_x10 = EMB_TEXT * 10 / EMB_PROTEIN   // 102400000·10/40960 = 25000 (×10) → 2500×
if RATIO_TEXT_PROTEIN_x10 == 25000 {
    print("  [PASS] text/protein embed ratio = " + to_string(RATIO_TEXT_PROTEIN_x10) + "/10 = 2500× (V_text/V_protein = 50000/20)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] ratio = " + to_string(RATIO_TEXT_PROTEIN_x10))
}

// ── check 3 — protein embed > DNA embed (V ratio 5×)
checks_total = checks_total + 1
let RATIO_PROTEIN_DNA = EMB_PROTEIN / EMB_DNA   // 5
if RATIO_PROTEIN_DNA == 5 {
    print("  [PASS] protein/DNA embed ratio = " + to_string(RATIO_PROTEIN_DNA) + "× (V_protein/V_DNA = 20/4)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] ratio = " + to_string(RATIO_PROTEIN_DNA))
}

// ── check 4 — attention compute per layer (n² · d)
checks_total = checks_total + 1
let ATTN_TEXT = attn_compute_per_layer(SEQ_TEXT, D_MODEL)        // 30²·1024 = 921,600
let ATTN_PROTEIN = attn_compute_per_layer(SEQ_PROTEIN, D_MODEL)   // 300²·1024 = 92,160,000 (100× text)
let ATTN_DNA = attn_compute_per_layer(SEQ_DNA, D_MODEL)           // 900²·1024 = 829,440,000 (900× text)
if ATTN_TEXT == 921600 && ATTN_PROTEIN == 92160000 && ATTN_DNA == 829440000 {
    print("  [PASS] attn/layer: text=" + to_string(ATTN_TEXT) + " · protein=" + to_string(ATTN_PROTEIN) + " · DNA=" + to_string(ATTN_DNA))
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] attn compute")
}

// ── check 5 — DNA attention = 900× text attention (sequence² scaling)
checks_total = checks_total + 1
let ATTN_RATIO_DNA_TEXT = ATTN_DNA / ATTN_TEXT   // 900
if ATTN_RATIO_DNA_TEXT == 900 {
    print("  [PASS] DNA attn = " + to_string(ATTN_RATIO_DNA_TEXT) + "× text attn (sequence² = (900/30)² = 900)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] attn ratio = " + to_string(ATTN_RATIO_DNA_TEXT))
}

// ── check 6 — V matters: V·d embed term is EXPLICIT in capacity formula
// A2 falsifier "V 무관" REFUTED — embed params depend linearly on V
checks_total = checks_total + 1
let DOUBLE_V_EMB = embed_params(V_TEXT * 2, D_MODEL)
if DOUBLE_V_EMB == 2 * EMB_TEXT {
    print("  [PASS] doubling V exactly doubles embed params → V is LOAD-BEARING in capacity (A2 falsifier 'V 무관' REFUTED)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] V not linearly affecting embed")
}

// ── check 7 — trade-off structure: small-V tokenizations pay attention cost
// total cost rough proxy = embed + n_layers · attn (n_layers=32 typical)
checks_total = checks_total + 1
let N_LAYERS = 32
let TOTAL_TEXT = EMB_TEXT + N_LAYERS * ATTN_TEXT       // 102.4M + 32·921k = 132M
let TOTAL_PROTEIN = EMB_PROTEIN + N_LAYERS * ATTN_PROTEIN   // 41k + 32·92M = 2.95G
let TOTAL_DNA = EMB_DNA + N_LAYERS * ATTN_DNA           // 8k + 32·829M = 26.5G
// DNA total >> protein total >> text total (attention quadratic dominates)
if TOTAL_DNA > TOTAL_PROTEIN && TOTAL_PROTEIN > TOTAL_TEXT {
    print("  [PASS] total cost (embed + 32·attn): DNA " + to_string(TOTAL_DNA / 1000000) + "M > protein " + to_string(TOTAL_PROTEIN / 1000000) + "M > text " + to_string(TOTAL_TEXT / 1000000) + "M (attn quadratic dominates at small V)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] expected DNA > protein > text total cost")
}

// ── check 8 — determinism
checks_total = checks_total + 1
let EMB_TEXT_RE = embed_params(V_TEXT, D_MODEL)
if EMB_TEXT_RE == EMB_TEXT {
    print("  [PASS] deterministic")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] non-deterministic")
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 SUPPORTED-FORMAL — V × d_model embed term + n²·d attention trade-off (8/8)"
} else {
    verdict_tier = "🔴 FALSIFIED — vocab capacity recompute disagrees (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
}
print("  " + verdict_tier)
print("")
print("KEY FINDING (closed-form):")
print("  - V is LOAD-BEARING: embed params = 2·V·d (linear) → A2 falsifier 'V 무관' REFUTED.")
print("  - text V=50k → 102.4M embed; protein V=20 → 41K (2500× less); DNA V=4 → 8K (12500× less).")
print("  - BUT small V means longer sequences for same content → attention pays n² cost:")
print("    DNA attn/layer = 900× text · protein attn = 100× text (sequence² scaling).")
print("  - Total cost (embed + 32·attn): DNA 26.5G > protein 2.95G > text 132M.")
print("  - Trade-off: small-V tokenizations save EMBED at SEQUENCE² cost in attention.")
print("    Small-V wins only if (a) attention is sparse/linear OR (b) sequences naturally short.")
print("")
print("OPERATIONAL IMPLICATION:")
print("  - ESM2 (V=20 amino) is the sweet spot for protein-LLMs: 41K embed vs ~300 seq is balanced.")
print("  - DNA-LLMs (V=4 nt) MUST pair with linear-attention (Mamba/Caduceus) to be tractable;")
print("    standard MHA on DNA = 900× text attention = prohibitive.")
print("  - 'tokenization is just preprocessing' folk view REFUTED — V choice cascades into")
print("    embed/attention compute trade-off that shapes which architectures are viable.")
print("")
print("HONEST RESIDUAL:")
print("  - V·d embed + n²·d attention = 🔵 closed-form structural identity.")
print("  - sequence lengths (text 30 / protein 300 / DNA 900) = TYPICAL operating points (not measured;")
print("    actual content-equivalent length varies by domain/task).")
print("  - d_model=1024 = mid-range modern LLM; larger d makes embed weight MORE dominant → V matters more.")
print("  - cycle-4+ T4: SANDBOX measure actual perplexity-per-byte across 3 tokenizations on equivalent corpus")
print("    → empirical V-vs-capacity-required curve.")
print("  - A2 frontier OPEN (feedback_closure_is_physical_limit): structural close ≠ measured close")
print("")
print("__HEXA_CODEX_NUMERICS_BIO_A2_VOCAB_SIZE_CAPACITY__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/lm_foundry/verdicts/bio_a2_vocab_size_capacity_verdict.txt"

let mut content = "# hexa-codex lm_foundry bio A2 — vocab size effect on LLM capacity (cycle-3 first probe)\n"
content = content + "# axis=lm_foundry/docs/bio-llm.md::FINDING-A2 (absorbed from retired BIODATA domain · cycle-3 first probe)\n"
content = content + "# verifier=lm_foundry/verify/numerics_bio_a2_vocab_size_capacity.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# vocab=text50000_BPE · protein20_amino · DNA4_nt\n"
content = content + "# seq_lengths_typical=text30 protein300 DNA900 (same content)\n"
content = content + "# d_model=1024\n"
content = content + "# embed_params=text102.4M · protein41K · DNA8K (2·V·d, untied)\n"
content = content + "# text_protein_embed_ratio=2500x · protein_DNA_ratio=5x\n"
content = content + "# attn_per_layer=text921k · protein92M (100x text) · DNA829M (900x text)\n"
content = content + "# total_cost_embed_plus_32attn=text132M · protein2.95G · DNA26.5G\n"
content = content + "# A2_falsifier=V 무관 REFUTED (V·d embed term LOAD-BEARING)\n"
content = content + "# operational=DNA-LLM needs linear-attn (Mamba/Caduceus); standard MHA prohibitive\n"
content = content + "# operational=ESM2 V=20 amino is sweet-spot for protein (balanced embed vs seq)\n"
content = content + "# external_anchor=Lin2023_ESM2 · DNABERT · Caduceus · Llama3_tokenizer\n"
content = content + "# next_probe=cycle-4+ T4 SANDBOX perplexity-per-byte measurement across 3 tokenizations\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
