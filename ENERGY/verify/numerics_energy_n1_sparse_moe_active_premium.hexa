#!hexa strict
// ENERGY/verify/numerics_energy_n1_sparse_moe_active_premium.hexa
// ENERGY N1 ⭐ NOVEL MAIN — absorbed from FRONTIER/F1 (cycle-10 reorg · 2026-05-28).
// Closed-form verifier for the Sparse-MoE active-parameter premium identity +
// anti-myth falsifier semantics (ENERGY 의 sparse-activation 연산 절감 NOVEL).
//
// Asserts the active-premium identity recompute + anti-myth falsifier:
//   (1) identity for Gemma 4 pair: 663 × 1000 / 675 == 982
//   (2) range bound — all weighted_acc ∈ [0, 1000] per-mille
//   (3) zero-premium synthetic edge (same perf both) → premium = 1000
//   (4) Gemma 4 controlled pair fires (982 < 1000 · anti-myth · myth FALSIFIED)
//   (5) synthetic strong-MoE silent (1333 ≥ 1000 · myth survives that regime)
//   (6) determinism (recompute identical · recursively delicious)
//   (7) sanity: integer × 1000 ledger has no overflow + per-mille range
//       invariant after multiplication for all (moe, dense) cross pairs
//
// Source: ENERGY/bench/energy_n1_sparse_moe_active_premium.hexa
// External anchors:
//   Fedus 2022 Switch Transformer (arXiv:2101.03961)
//   Lepikhin 2020 GShard (arXiv:2006.16668)
//   Du 2022 GLaM (arXiv:2112.06905)
//   2026 controlled paper (arXiv:2604.07035) — Gemma 4 / Phi-4 / Qwen 3 dense vs MoE
//
// @no-lock-needed

let MODEL_NAMES = [
    "gemma4_E4B",
    "gemma4_26B_A4B",
    "phi4_mini_reasoning",
    "qwen3_8B",
    "qwen3_30B_A3B",
]
let WEIGHTED_ACC_x1000 = [675, 663, 600, 640, 650]
let IS_MOE             = [false, true, false, false, true]

let MYTH_PREMIUM_THRESHOLD_x1000 = 1000
let ACC_MIN_x1000 = 0
let ACC_MAX_x1000 = 1000

fn active_premium_x1000(moe_idx: int, dense_idx: int) -> int {
    let dense_perf = WEIGHTED_ACC_x1000[dense_idx]
    if dense_perf <= 0 { return 0 }
    return (WEIGHTED_ACC_x1000[moe_idx] * 1000) / dense_perf
}

fn falsifier_fires(moe_idx: int, dense_idx: int) -> bool {
    return active_premium_x1000(moe_idx, dense_idx) < MYTH_PREMIUM_THRESHOLD_x1000
}

// closed-form pair premium — used by checks 1, 3, 5
fn pair_premium_x1000(moe_perf: int, dense_perf: int) -> int {
    if dense_perf <= 0 { return 0 }
    return (moe_perf * 1000) / dense_perf
}

print("hexa-codex ENERGY N1 falsifier — Sparse-MoE active-premium closed-form (absorbed from FRONTIER F1)")
print("============================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0

// check 1 — identity for Gemma 4 pair: 663 × 1000 / 675 == 982
checks_total = checks_total + 1
let g_expect = 982
let g_actual = active_premium_x1000(1, 0)   // MoE 26B-A4B vs dense E4B
if g_actual == g_expect {
    print("  [PASS] Gemma 4 identity: 663 × 1000 / 675 = " + to_string(g_actual) +
          " (anti-myth myth-breaker · arXiv:2604.07035)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] Gemma 4 identity expected " + to_string(g_expect) +
          " got " + to_string(g_actual))
}

// check 2 — range bound: all weighted_acc ∈ [0, 1000] per-mille
checks_total = checks_total + 1
let mut acc_range_ok = true
let mut j = 0
while j < MODEL_NAMES.len() {
    let a = WEIGHTED_ACC_x1000[j]
    if a < ACC_MIN_x1000 { acc_range_ok = false }
    if a > ACC_MAX_x1000 { acc_range_ok = false }
    j = j + 1
}
if acc_range_ok {
    print("  [PASS] all " + to_string(MODEL_NAMES.len()) +
          " weighted_acc ∈ [0, 1000] (per-mille range invariant)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] some weighted_acc out of [0, 1000] — per-mille ledger broken")
}

// check 3 — zero-premium synthetic edge (same perf both) → premium = 1000
checks_total = checks_total + 1
let zero_premium = pair_premium_x1000(700, 700)
if zero_premium == 1000 {
    print("  [PASS] zero-premium synthetic edge (700 vs 700) → premium = 1000 (neutral)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] zero-premium edge ≠ 1000 (got " + to_string(zero_premium) + ")")
}

// check 4 — Gemma 4 controlled pair fires (982 < 1000 · anti-myth)
checks_total = checks_total + 1
let g_fires = falsifier_fires(1, 0)
let g_premium = active_premium_x1000(1, 0)
if g_fires && g_premium < MYTH_PREMIUM_THRESHOLD_x1000 {
    print("  [PASS] Gemma 4 pair FIRES 🔴 (premium=" + to_string(g_premium) +
          " < 1000 · myth FALSIFIED · MoE 26B-A4B < dense E4B)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] Gemma 4 anti-myth falsifier broken (premium=" + to_string(g_premium) + ")")
}

// check 5 — synthetic strong-MoE silent (1333 ≥ 1000 · myth survives)
//   pair_premium_x1000(800, 600) = 800 × 1000 / 600 = 1333 (integer floor)
checks_total = checks_total + 1
let syn_premium = pair_premium_x1000(800, 600)
if syn_premium == 1333 && syn_premium >= MYTH_PREMIUM_THRESHOLD_x1000 {
    print("  [PASS] synthetic strong-MoE (800 vs 600) silent: premium=" + to_string(syn_premium) +
          " ≥ 1000 (myth survives in that regime · proves verifier is bidirectional)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] synthetic strong-MoE discrimination broken (got " + to_string(syn_premium) + ")")
}

// check 6 — determinism (recompute identical)
checks_total = checks_total + 1
if active_premium_x1000(1, 0) == active_premium_x1000(1, 0) &&
   falsifier_fires(1, 0) == falsifier_fires(1, 0) &&
   pair_premium_x1000(800, 600) == pair_premium_x1000(800, 600) {
    print("  [PASS] formula deterministic (re-call same premium + fires · recursively delicious)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] formula non-deterministic")
}

// check 7 — integer × 1000 ledger sanity: no overflow + range invariant.
//   For every (moe_idx, dense_idx) where dense_perf > 0:
//     numerator = WEIGHTED_ACC_x1000[moe] × 1000  ≤  1000 × 1000 = 1_000_000 (well within int)
//     premium   = numerator / dense_perf          ≥  0  (since both operands ≥ 0)
//   Plus: for every model i where IS_MOE[i] vs every j where !IS_MOE[j], compute premium
//   and assert ≥ 0 and ≤ a safe upper bound (1000 × 1000 = 1_000_000 if dense_perf ≥ 1).
checks_total = checks_total + 1
let mut ledger_ok = true
let mut a = 0
let n = MODEL_NAMES.len()
while a < n {
    if IS_MOE[a] {
        let mut b = 0
        while b < n {
            if IS_MOE[b] == false {
                let num = WEIGHTED_ACC_x1000[a] * 1000
                if num < 0 { ledger_ok = false }
                if num > 1000000 { ledger_ok = false }
                let p = active_premium_x1000(a, b)
                if p < 0 { ledger_ok = false }
                if p > 1000000 { ledger_ok = false }
            }
            b = b + 1
        }
    }
    a = a + 1
}
if ledger_ok {
    print("  [PASS] integer × 1000 ledger sanity — no overflow + premium ∈ [0, 1_000_000] across all MoE×dense cross pairs")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] integer × 1000 ledger overflow or out-of-range")
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 STRUCTURAL (active_premium identity 7/7) + 🟡 BY-CITATION (Gemma 4 controlled data from arXiv:2604.07035) — myth refuted in Gemma 4 family · myth survives in synthetic strong-MoE regime · task-class dependent"
} else {
    verdict_tier = "🔴 FALSIFIED — active-premium formula contradicts identity (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
}
print("  " + verdict_tier)
print("")
print("ENERGY N1 finding (placeholder data · closed-form · absorbed from FRONTIER F1):")
print("  - active_premium identity (perf(moe) × 1000 / perf(dense_same_active)) — 7/7 closed-form checks")
print("  - bidirectional discrimination: Gemma 4 controlled pair fires (982) · synthetic strong-MoE silent (1333)")
print("  - external anchors: Fedus 2022 Switch (2101.03961) · Lepikhin 2020 GShard (2006.16668) · Du 2022 GLaM (2112.06905) · arXiv:2604.07035 controlled paper")
print("  - anti-myth: 'MoE > same-active dense by ≥ 1.2×' 신화 — Gemma 4 family 에서 FALSIFIED (premium 982 < 1000)")
print("  - 실측 7-task weighted re-run on local Gemma 4 mac M3 GGUF (cycle-11+ T4 · `cx_lab_sandbox`)")
print("")
print("__HEXA_CODEX_NUMERICS_ENERGY_N1__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/ENERGY/verdicts/n1_sparse_moe_active_premium_verdict.txt"

let mut content = "# hexa-codex ENERGY N1 — Sparse-MoE active-premium verifier (cycle-10 reorg · absorbed from FRONTIER F1)\n"
content = content + "# axis=ENERGY/ENERGY.md::N1 SPARSE-MOE (active-param efficiency premium vs same-active dense · NOVEL MAIN)\n"
content = content + "# bench=ENERGY/bench/energy_n1_sparse_moe_active_premium.hexa\n"
content = content + "# verifier=ENERGY/verify/numerics_energy_n1_sparse_moe_active_premium.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# formula=active_premium_x1000 = perf(moe) × 1000 / perf(dense_same_active_size); falsifier_fires = premium < 1000 (anti-myth · MoE 가 same-active dense 보다 못함)\n"
content = content + "# placeholder_data=5 models (gemma4_E4B 675 · gemma4_26B_A4B 663 · phi4_mini_reasoning 600 · qwen3_8B 640 · qwen3_30B_A3B 650 · weighted_acc × 1000 per-mille)\n"
content = content + "# gemma4_controlled_pair=663 × 1000 / 675 = 982 (per-mille · = 0.982 · MoE 26B-A4B 1.8pp 낮음 vs dense E4B · 🔴 myth FALSIFIED)\n"
content = content + "# synthetic_silent_control=strong-MoE 800 vs weak-dense 600 → premium 1333 ≥ 1000 (myth survives in that regime · proves verifier is bidirectional · NOT one-sided)\n"
content = content + "# external_anchors=Fedus 2022 Switch (arXiv:2101.03961) · Lepikhin 2020 GShard (arXiv:2006.16668) · Du 2022 GLaM (arXiv:2112.06905) · arXiv:2604.07035 Gemma4/Phi4/Qwen3 controlled paper\n"
content = content + "# anti_myth=MoE > same-active-param dense by ≥ 1.2× 신화 — Gemma 4 family controlled benchmark 에서 FALSIFIED (premium 982 < 1000); task-class · family · scale 마다 frontier 재오픈\n"
content = content + "# absorbed_from=FRONTIER/F1 (cycle-10 reorg · 2026-05-28 · frontier 축 분산 흡수 → ENERGY NOVEL MAIN)\n"
content = content + "# substrate_fire=DEFERRED (cycle-11+ T4 · SANDBOX mac M3 llama-server + local Gemma 4 GGUF · 7-task weighted real measured re-run)\n"
content = content + "# frontier_open=feedback_closure_is_physical_limit — identity close ≠ measured close · placeholder weighted_acc × 1000 from arXiv:2604.07035 (Gemma 4 pair cited · Phi-4/Qwen 3 placeholder)\n"
content = content + "# honest_residual=real measured 7-task weighted re-run on local Gemma 4 mac M3 GGUF DEFERRED to cycle-11+ T4 (cx_lab_sandbox · cx_empirical_contact)\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
