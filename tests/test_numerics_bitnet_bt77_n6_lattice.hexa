#!hexa strict
// hexa-codex/tests/test_numerics_bitnet_bt77_n6_lattice.hexa — BITNET M5 BT-77 regression.
//
// Locks the BT-77 n=6 lattice recompute: the scorer must exit 0, emit its
// PASS sentinel, AND recompute K=25/26 (matching the BT-77 atlas headline).
// If a future BitNet config edit or a closure-generator change moves K off 25,
// this regression trips (the finding is load-bearing, not just the sentinel).
//
// Skips gracefully (PASS) if the BitNet 2B4T config.json is not on disk — the
// recompute reads $HOME/Models/bitnet-bf16/config.json which is a large local
// artifact not present in CI; absence is an honest skip, not a failure.

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()
let SCRIPT = ROOT + "/verify/numerics_bitnet_bt77_n6_lattice.hexa"
let HEXA = HOME + "/.hx/packages/hexa/hexa.real"
let CONFIG_PATH = HOME + "/Models/bitnet-bf16/config.json"

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn main() {
    println("[test_numerics_bitnet_bt77_n6_lattice] script: " + SCRIPT)

    // honest skip if the local model config is absent (CI has no BitNet bf16).
    let cfg = exec_with_status("test -f " + shq(CONFIG_PATH) + " && echo OK")
    if to_string(cfg[0]).find("OK") < 0 {
        println("[test_numerics_bitnet_bt77_n6_lattice] SKIP — config.json absent (" + CONFIG_PATH + ")")
        println("__HEXA_CODEX_TEST_NUMERICS_BITNET_BT77_N6_LATTICE__ PASS")
        exit(0)
    }

    let cmd = "HEXA_SHIM_NO_DARWIN_LANDING=1 RESOURCE_LOCAL_HEXA=1 HEXA_CODEX_ROOT=" +
              shq(ROOT) + " " + shq(HEXA) + " run " + shq(SCRIPT)
    let r = exec_with_status(cmd)
    let out = to_string(r[0])
    let code = r[1]
    let has_pass = out.find("__HEXA_CODEX_NUMERICS_BITNET_BT77_N6_LATTICE__ K=25/26 delta=0 PASS") >= 0
    let has_k25 = out.find("K/26 = 25/26") >= 0
    let pass = code == 0 && has_pass && has_k25
    if pass {
        println("[test_numerics_bitnet_bt77_n6_lattice] PASS — exit 0 + K=25/26 + sentinel")
        println("__HEXA_CODEX_TEST_NUMERICS_BITNET_BT77_N6_LATTICE__ PASS")
        exit(0)
    }
    eprintln("[test_numerics_bitnet_bt77_n6_lattice] FAIL — exit=" + str(code) +
             " sentinel=" + str(has_pass) + " k25=" + str(has_k25))
    eprintln("--- stdout ---")
    eprintln(out)
    eprintln("__HEXA_CODEX_TEST_NUMERICS_BITNET_BT77_N6_LATTICE__ FAIL")
    exit(1)
}
