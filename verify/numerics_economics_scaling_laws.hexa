#!hexa strict
// hexa-codex/verify/numerics_economics_scaling_laws.hexa — ECONOMICS scaling laws sweep.
//
// Companion of `verify/numerics_economics_cross_pillar.hexa`. The
// cross-pillar already verified ONE halving rule (quality) and ONE
// doubling rule (train). This script sweeps the FULL closed-form
// scaling-law surface of the three ECONOMICS verbs, plus the
// cost-vs-quality competition ratio that emerges from their distinct
// n=6 exponents.
//
//   train_cost      ratio = (N·D / 1e22)^N6_EXP     N6_EXP = 24/25 = 0.96
//   infer_cost      ratio = (ctx / 8192)^τ          τ      = 4
//   quality_scale   red_term(C, x, α) = C · x^-α    α      = 1/6
//
// Closed-form identities verified:
//
//   1. q-side N halving   : red_term(A, 2N, α) / red_term(A, N, α) = 2^-α
//   2. q-side D halving   : red_term(B, 2D, α) / red_term(B, D, α) = 2^-α
//   3. q-side N 4×        : red_term(A, 4N, α) / red_term(A, N, α) = 4^-α
//   4. q-side D 4×        : red_term(B, 4D, α) / red_term(B, D, α) = 4^-α
//   5. train N doubling   : train(2N, D)  / train(N, D) = 2^N6_EXP
//   6. train D doubling   : train(N, 2D)  / train(N, D) = 2^N6_EXP
//   7. train ND quadr.    : train(2N, 2D) / train(N, D) = 4^N6_EXP
//   8. infer ctx doubling : infer(2ctx)   / infer(ctx)  = 2^τ  = 16
//   9. infer ctx 4×       : infer(4ctx)   / infer(ctx)  = 4^τ  = 256
//  10. cost/quality ratio : N6_EXP / α = (24/25) / (1/6) = 144/25 = 5.76
//                           (per log doubling, train cost rises ~5.76× as
//                            fast as the quality reducible-loss term shrinks)
//
// PASS criterion: 10 checks pass at math_pure precision (drift < 1e-12
// for exact identities, < 1e-10 for those involving pow_pure roundoff).
//
// Run:
//   hexa run verify/numerics_economics_scaling_laws.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="Pure local verifier; integer + float arithmetic only.")

use "self/runtime/math_pure"

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()

// ── n=6 lattice ──────────────────────────────────────────────────────────
let SIGMA = 12.0
let PHI   = 2.0
let TAU   = 4.0
let N     = 6.0
let J2    = 24.0

let N6_EXP   = J2 / (J2 + 1.0)                    // 0.96  — train
let N6_TAU   = TAU                                 // 4     — infer
let N6_ALPHA = PHI / SIGMA                         // 1/6   — quality

// ── anchors ──────────────────────────────────────────────────────────────
let ND_REF   = 1.0e10 * 1.0e12                     // 1e22 — train anchor
let CTX_REF  = 8192.0                              // 8k   — infer anchor
let A_COEF   = 406.4                                // Chinchilla A
let B_COEF   = 410.7                                // Chinchilla B
let N_CHIN   = 70.0e9
let D_CHIN   = 1.4e12

let FALSIFIERS = [
    "ECONOMICS scaling-law sweep: q-side α=1/6, train N6_EXP=24/25, infer τ=4 — closed-form ratios",
]

// ── helpers ──────────────────────────────────────────────────────────────

let mut RUN = 0
let mut FAIL = 0
let mut FAILURES = []

fn _check(ok: bool, label: str, detail: str) {
    RUN = RUN + 1
    if ok {
        println("  [PASS] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    } else {
        FAIL = FAIL + 1
        FAILURES.push(label + " :: " + detail)
        println("  [FAIL] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    }
}

fn _abs(x: float) -> float { return abs_pure(x) }

fn red_term(coef: float, x: float, expo: float) -> float {
    return coef * pow_pure(x, 0.0 - expo)
}

fn train_cost_ratio(n: float, d: float) -> float {
    return pow_pure((n * d) / ND_REF, N6_EXP)
}

fn infer_cost_ratio(ctx: float) -> float {
    return pow_pure(ctx / CTX_REF, N6_TAU)
}

// Generic doubling/multiplier verifier. Returns ratio observed vs analytic.
fn _ratio_check(label: str, observed: float, analytic: float, tol: float) {
    let drift = _abs(observed - analytic)
    _check(drift < tol, label,
           "observed=" + to_string(observed) +
           " analytic=" + to_string(analytic) +
           " drift=" + to_string(drift))
}

// ── checks ───────────────────────────────────────────────────────────────

// Check 1: quality reducible-loss term in N — halving.
fn check_q_halving_N() {
    let lo = red_term(A_COEF, N_CHIN,         N6_ALPHA)
    let hi = red_term(A_COEF, 2.0 * N_CHIN,   N6_ALPHA)
    _ratio_check("q-side N halving: red_term(A,2N,α) / red_term(A,N,α) = 2^-α",
                 hi / lo, pow_pure(2.0, 0.0 - N6_ALPHA), 1.0e-12)
}

// Check 2: quality reducible-loss term in D — halving.
fn check_q_halving_D() {
    let lo = red_term(B_COEF, D_CHIN,         N6_ALPHA)
    let hi = red_term(B_COEF, 2.0 * D_CHIN,   N6_ALPHA)
    _ratio_check("q-side D halving: red_term(B,2D,α) / red_term(B,D,α) = 2^-α",
                 hi / lo, pow_pure(2.0, 0.0 - N6_ALPHA), 1.0e-12)
}

// Check 3: quality reducible-loss term in N — 4×.
fn check_q_4x_N() {
    let lo = red_term(A_COEF, N_CHIN,         N6_ALPHA)
    let hi = red_term(A_COEF, 4.0 * N_CHIN,   N6_ALPHA)
    _ratio_check("q-side N 4×: red_term(A,4N,α) / red_term(A,N,α) = 4^-α",
                 hi / lo, pow_pure(4.0, 0.0 - N6_ALPHA), 1.0e-12)
}

// Check 4: quality reducible-loss term in D — 4×.
fn check_q_4x_D() {
    let lo = red_term(B_COEF, D_CHIN,         N6_ALPHA)
    let hi = red_term(B_COEF, 4.0 * D_CHIN,   N6_ALPHA)
    _ratio_check("q-side D 4×: red_term(B,4D,α) / red_term(B,D,α) = 4^-α",
                 hi / lo, pow_pure(4.0, 0.0 - N6_ALPHA), 1.0e-12)
}

// Check 5: train cost doubling in N (D fixed).
fn check_train_doubling_N() {
    let lo = train_cost_ratio(N_CHIN,       D_CHIN)
    let hi = train_cost_ratio(2.0 * N_CHIN, D_CHIN)
    _ratio_check("train N doubling: train(2N,D) / train(N,D) = 2^N6_EXP",
                 hi / lo, pow_pure(2.0, N6_EXP), 1.0e-12)
}

// Check 6: train cost doubling in D (N fixed).
fn check_train_doubling_D() {
    let lo = train_cost_ratio(N_CHIN, D_CHIN)
    let hi = train_cost_ratio(N_CHIN, 2.0 * D_CHIN)
    _ratio_check("train D doubling: train(N,2D) / train(N,D) = 2^N6_EXP",
                 hi / lo, pow_pure(2.0, N6_EXP), 1.0e-12)
}

// Check 7: train cost ND quadrupling (both 2×).
fn check_train_ND_quadrupling() {
    let lo = train_cost_ratio(N_CHIN,       D_CHIN)
    let hi = train_cost_ratio(2.0 * N_CHIN, 2.0 * D_CHIN)
    _ratio_check("train ND 4× (both 2×): train(2N,2D) / train(N,D) = 4^N6_EXP",
                 hi / lo, pow_pure(4.0, N6_EXP), 1.0e-12)
}

// Check 8: infer cost ctx doubling — 2^τ = 16 exactly.
fn check_infer_doubling_ctx() {
    let lo = infer_cost_ratio(CTX_REF)
    let hi = infer_cost_ratio(2.0 * CTX_REF)
    _ratio_check("infer ctx doubling: infer(2c) / infer(c) = 2^τ = 16",
                 hi / lo, 16.0, 1.0e-12)
}

// Check 9: infer cost ctx 4× — 4^τ = 256 exactly.
fn check_infer_4x_ctx() {
    let lo = infer_cost_ratio(CTX_REF)
    let hi = infer_cost_ratio(4.0 * CTX_REF)
    _ratio_check("infer ctx 4×: infer(4c) / infer(c) = 4^τ = 256",
                 hi / lo, 256.0, 1.0e-12)
}

// Check 10: cost-vs-quality competition ratio — N6_EXP / α = 144/25 = 5.76.
//   Per log doubling, train_cost grows ~5.76× as fast as the quality
//   reducible-loss term shrinks. This is the ECONOMICS surface's
//   "diminishing returns" signature.
fn check_cost_quality_ratio() {
    let observed = N6_EXP / N6_ALPHA
    let analytic = 144.0 / 25.0                  // 5.76 EXACT
    _ratio_check("cost/quality ratio: N6_EXP / α = (24/25)/(1/6) = 144/25 = 5.76",
                 observed, analytic, 1.0e-12)
}

// ── main ─────────────────────────────────────────────────────────────────

fn main() {
    println("========================================================================")
    println("  hexa-codex ECONOMICS scaling-law sweep (math_pure)")
    println("  q-side α=1/6 · train N6_EXP=24/25 · infer τ=4 — closed-form ratios")
    println("========================================================================")
    println("  N6_EXP=" + to_string(N6_EXP) + "  τ=" + to_string(N6_TAU) +
            "  α=β=" + to_string(N6_ALPHA) + "  N6_EXP/α=" + to_string(N6_EXP / N6_ALPHA))
    println("")

    check_q_halving_N()
    check_q_halving_D()
    check_q_4x_N()
    check_q_4x_D()
    println("")
    check_train_doubling_N()
    check_train_doubling_D()
    check_train_ND_quadrupling()
    println("")
    check_infer_doubling_ctx()
    check_infer_4x_ctx()
    println("")
    check_cost_quality_ratio()

    println("========================================================================")
    let pass_n = RUN - FAIL
    println("  " + str(pass_n) + "/" + str(RUN) + " checks passed")
    if FAIL > 0 {
        println("  FAILURES:")
        for f in FAILURES { println("    ✗ " + f) }
        println("__HEXA_CODEX_NUMERICS_ECONOMICS_SCALING_LAWS__ FAIL")
        exit(1)
    }
    println("  ECONOMICS scaling-law sweep: closed.")
    println("__HEXA_CODEX_NUMERICS_ECONOMICS_SCALING_LAWS__ PASS")
    exit(0)
}
