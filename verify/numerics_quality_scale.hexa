#!hexa strict
// hexa-codex/verify/numerics_quality_scale.hexa — quality_scale T2 numerical.
//
// Beyond `verify/calc_quality_scale.hexa` (algebraic identities only),
// this script does the floating-point math on the Chinchilla loss-fit
// surface (Hoffmann et al. 2022, arxiv 2203.15556):
//
//     loss(N, D) = E + A·N^(-α) + B·D^(-β)
//
//   E = 1.69   (irreducible-loss anchor, nats/token)
//   A = 406.4, B = 410.7  (Chinchilla parametric-fit coefficients)
//   α = β = φ(6)/σ(6) = 2/12 = 1/6 ≈ 0.16667   (n=6 lattice exponent)
//
// HONESTY NOTE: A, B are the coefficients Chinchilla fitted *with* its
// measured exponent α≈0.34.  Pairing them with the n=6 exponent 1/6 does
// NOT yield a Chinchilla-calibrated loss number — the n=6 fit would
// re-fit A, B.  So this T2 verifies the loss-surface SHAPE — monotone
// decreasing, bounded below by E, asymptotic to E — which is
// exponent-driven and coefficient-independent.  Cross-fit exponent
// comparison (n6 vs Chinchilla vs Kaplan) lives in the _parity layer.
//
// PASS criterion (T2 numerical floor): 10 checks pass.
//
// Recipe T2 floor: uses `use "self/runtime/math_pure"` for raw float
// math (recipe §4 invariant 1).  T1 is calc_quality_scale.hexa; the
// ODE re-derivation is numerics_quality_scale_solver.hexa; the
// published-exponent parity is numerics_quality_scale_parity.hexa.
//
// Run:
//   hexa run verify/numerics_quality_scale.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="Pure local verifier; integer + float arithmetic only.")

use "self/runtime/math_pure"

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()

// ── n=6 lattice ──────────────────────────────────────────────────────────
let SIGMA_6 = 12.0
let PHI_6   = 2.0
// n=6 loss-scaling exponent — symmetric: α = β = φ/σ = 1/6.
let N6_ALPHA = PHI_6 / SIGMA_6            // 0.16666… exact-ish in IEEE 754
let N6_BETA  = PHI_6 / SIGMA_6            // identical (n=6 collapses α=β)

// ── Chinchilla loss-fit constants (Hoffmann 2022, arxiv 2203.15556) ───────
let E_LOSS = 1.69                          // irreducible loss (nats/token)
let A_COEF = 406.4                         // N-term coefficient
let B_COEF = 410.7                         // D-term coefficient

// Published measured exponents (for the shallower/steeper envelope check).
let CHINCHILLA_ALPHA = 0.34                // Hoffmann 2022 measured N-exponent
let KAPLAN_ALPHA_N   = 0.076               // Kaplan 2020 measured N-exponent

// Anchors (10B params · 1T tokens reference scale).
let N_REF = 1.0e10
let D_REF = 1.0e12

// FALSIFIERS list (recipe §4 invariant 3).
let FALSIFIERS = ["quality_scale loss-fit loss=E+A·N^-α+B·D^-β surface shape (monotone / floored / asymptotic), n=6 exponent α=β=1/6, T2 numerical"]

// ── helpers ──────────────────────────────────────────────────────────────

let mut RUN = 0
let mut FAIL = 0
let mut FAILURES = []

fn _check(ok: bool, label: str, detail: str) {
    RUN = RUN + 1
    if ok {
        println("  [PASS] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    } else {
        FAIL = FAIL + 1
        FAILURES.push(label + " :: " + detail)
        println("  [FAIL] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    }
}

fn _abs(x: float) -> float {
    return abs_pure(x)
}

// Reducible loss term: coef · x^(-exponent).
fn red_term(coef: float, x: float, expo: float) -> float {
    return coef * pow_pure(x, 0.0 - expo)
}

// Full n=6 loss-fit surface: loss(N,D) = E + A·N^-α + B·D^-β, α=β=1/6.
fn loss_n6(n: float, d: float) -> float {
    return E_LOSS + red_term(A_COEF, n, N6_ALPHA) + red_term(B_COEF, d, N6_BETA)
}

// ── anchor grid ──────────────────────────────────────────────────────────
// N grid spans the spec S7.3 size ladder (7B .. 400B).
let N_7B   = 7.0e9
let N_30B  = 30.0e9
let N_70B  = 70.0e9
let N_175B = 175.0e9
let N_400B = 400.0e9
// D grid spans GPT-3 (0.3T) .. frontier (15T).
let D_0   = 3.0e11
let D_1   = 1.0e12
let D_2   = 2.0e12
let D_3   = 8.0e12
let D_4   = 1.5e13

// ── checks ───────────────────────────────────────────────────────────────

// Check 1: irreducible floor — loss(N_REF, D_REF) strictly above E.
fn check_anchor_floor() {
    let l = loss_n6(N_REF, D_REF)
    _check(l > E_LOSS,
           "loss(N_REF, D_REF) > E : reducible terms strictly positive",
           "loss=" + to_string(l) + " E=" + to_string(E_LOSS))
}

// Check 2: monotone decreasing in N — bigger model ⇒ lower loss (D fixed).
fn check_monotone_in_n() {
    let l1 = loss_n6(N_7B,   D_REF)
    let l2 = loss_n6(N_30B,  D_REF)
    let l3 = loss_n6(N_70B,  D_REF)
    let l4 = loss_n6(N_175B, D_REF)
    let l5 = loss_n6(N_400B, D_REF)
    let mono = (l1 > l2) && (l2 > l3) && (l3 > l4) && (l4 > l5)
    _check(mono,
           "monotone: loss strictly decreases over 7B→400B N grid (D fixed)",
           "loss=[" + to_string(l1) + "," + to_string(l2) + "," + to_string(l3) +
           "," + to_string(l4) + "," + to_string(l5) + "]")
}

// Check 3: monotone decreasing in D — more tokens ⇒ lower loss (N fixed).
fn check_monotone_in_d() {
    let l1 = loss_n6(N_REF, D_0)
    let l2 = loss_n6(N_REF, D_1)
    let l3 = loss_n6(N_REF, D_2)
    let l4 = loss_n6(N_REF, D_3)
    let l5 = loss_n6(N_REF, D_4)
    let mono = (l1 > l2) && (l2 > l3) && (l3 > l4) && (l4 > l5)
    _check(mono,
           "monotone: loss strictly decreases over 0.3T→15T D grid (N fixed)",
           "loss=[" + to_string(l1) + "," + to_string(l2) + "," + to_string(l3) +
           "," + to_string(l4) + "," + to_string(l5) + "]")
}

// Check 4: asymptotic floor — loss → E as N,D → ∞.
fn check_asymptotic_floor() {
    let l = loss_n6(1.0e26, 1.0e26)
    let gap = l - E_LOSS
    _check((gap > 0.0) && (gap < 0.1),
           "asymptotic: loss → E as N,D → ∞ (gap < 0.1 at N=D=1e26)",
           "loss=" + to_string(l) + " gap=" + to_string(gap))
}

// Check 5: both reducible terms strictly positive at the anchor.
fn check_reducible_terms_positive() {
    let tn = red_term(A_COEF, N_REF, N6_ALPHA)
    let td = red_term(B_COEF, D_REF, N6_BETA)
    _check((tn > 0.0) && (td > 0.0),
           "reducible terms A·N^-α and B·D^-β both strictly positive",
           "N-term=" + to_string(tn) + " D-term=" + to_string(td))
}

// Check 6: n=6 exponent is SHALLOWER than Chinchilla's measured 0.34 —
//   smaller exponent ⇒ slower decay ⇒ larger residual loss term.  The
//   n=6 fit is the conservative (pessimistic) one above the data range.
fn check_n6_shallower_than_chinchilla() {
    let t_n6  = red_term(A_COEF, N_400B, N6_ALPHA)
    let t_chn = red_term(A_COEF, N_400B, CHINCHILLA_ALPHA)
    _check(t_n6 > t_chn,
           "n6 N-term > Chinchilla N-term at 400B (1/6 shallower than 0.34)",
           "n6=" + to_string(t_n6) + " chinchilla=" + to_string(t_chn))
}

// Check 7: n=6 exponent is STEEPER than Kaplan's measured 0.076 —
//   together with check 6 this brackets n=6 between the two published
//   measurements: Kaplan-term > n6-term > Chinchilla-term.
fn check_n6_steeper_than_kaplan() {
    let t_n6  = red_term(A_COEF, N_400B, N6_ALPHA)
    let t_kap = red_term(A_COEF, N_400B, KAPLAN_ALPHA_N)
    _check(t_n6 < t_kap,
           "n6 N-term < Kaplan N-term at 400B (1/6 steeper than 0.076)",
           "n6=" + to_string(t_n6) + " kaplan=" + to_string(t_kap))
}

// Check 8: exponent identity — N6_ALPHA = φ(6)/σ(6) = 1/6, and α = β.
fn check_exponent_identity() {
    let computed = PHI_6 / SIGMA_6
    let one_sixth = 1.0 / 6.0
    let drift = _abs(computed - one_sixth)
    let symmetric = (N6_ALPHA == N6_BETA)
    _check((drift < 1.0e-12) && symmetric,
           "n6 exponent α = φ/σ = 1/6 (float) and α = β (n=6 symmetry)",
           "computed=" + to_string(computed) + " drift=" + to_string(drift) +
           " α==β=" + str(symmetric))
}

// Check 9: numerical stability — loss finite and positive over the grid.
fn check_numerical_stability() {
    let ns = [N_7B, N_30B, N_70B, N_175B, N_400B]
    let ds = [D_0, D_1, D_2, D_3, D_4]
    let mut all_ok = true
    let mut i = 0
    while i < len(ns) {
        let l = loss_n6(ns[i], ds[i])
        // finite iff l == l (NaN-trap), positive, generously bounded.
        let ok = (l == l) && (l > 0.0) && (l < 1.0e6)
        if ok == false { all_ok = false }
        i = i + 1
    }
    _check(all_ok,
           "loss finite and positive over the full 5-anchor grid (no NaN/Inf)",
           "7B/30B/70B/175B/400B paired with 0.3T..15T all 0 < loss < 1e6")
}

// Check 10: α = β symmetry consequence — at N = D the two reducible
//   terms differ only by the A/B coefficient ratio (exponent identical).
fn check_symmetry_consequence() {
    let x = 1.0e11
    let tn = red_term(A_COEF, x, N6_ALPHA)
    let td = red_term(B_COEF, x, N6_BETA)
    let ratio = tn / td
    let expected = A_COEF / B_COEF
    let drift = _abs(ratio - expected)
    _check(drift < 1.0e-9,
           "at N=D: (A·N^-α)/(B·D^-β) = A/B exactly (α=β cancels)",
           "ratio=" + to_string(ratio) + " A/B=" + to_string(expected) +
           " drift=" + to_string(drift))
}

// ── main ─────────────────────────────────────────────────────────────────

fn main() {
    println("========================================================================")
    println("  hexa-codex quality_scale loss-fit numerics (T2 numerical, math_pure)")
    println("  loss(N,D) = E + A·N^-α + B·D^-β ; α = β = φ(6)/σ(6) = 1/6")
    println("========================================================================")
    println("  E = " + to_string(E_LOSS) + "  A = " + to_string(A_COEF) +
            "  B = " + to_string(B_COEF))
    println("  n6 exponent α = β = " + to_string(N6_ALPHA))
    println("")

    check_anchor_floor()
    check_monotone_in_n()
    check_monotone_in_d()
    check_asymptotic_floor()
    check_reducible_terms_positive()
    println("")
    check_n6_shallower_than_chinchilla()
    check_n6_steeper_than_kaplan()
    check_exponent_identity()
    check_numerical_stability()
    check_symmetry_consequence()

    println("========================================================================")
    let pass_n = RUN - FAIL
    println("  " + str(pass_n) + "/" + str(RUN) + " checks passed")
    if FAIL > 0 {
        println("  FAILURES:")
        for f in FAILURES { println("    ✗ " + f) }
        println("__HEXA_CODEX_NUMERICS_QUALITY_SCALE__ FAIL")
        exit(1)
    }
    println("  quality_scale T2 numerical floor: closed.")
    println("__HEXA_CODEX_NUMERICS_QUALITY_SCALE__ PASS")
    exit(0)
}
