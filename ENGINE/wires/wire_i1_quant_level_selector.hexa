#!hexa strict
// hexa-codex/ENGINE/wires/wire_i1_quant_level_selector.hexa
// ENGINE axis I1 wire — ENERGY/N2 quantization finding → serving quant-level selector.
//
// SOURCE FINDING (ENERGY/N2 QUANTIZATION · cycle-10 reorg Batch B):
//   per-level (size_gb×100, quality_loss_pct×100) trade-off, 7B placeholder tiers
//   from GPTQ/AWQ/LLM.int8/GGUF published data:
//     fp16    (1400,   0)   lossless · baseline
//     int8    ( 700,  50)   0.5% loss
//     gguf_q8 ( 715,  50)   0.5% loss
//     gguf_q4 ( 350, 300)   3.0% loss  (silent — ≤ 5%)
//     gguf_q2 ( 175,1500)   15.0% loss (FIRES — over-compression > 5%)
//   monotonic: 압축 클수록 손실 monotone 비감소 (loss q2 ≥ q4 ≥ q8 · 압축은 공짜가 아니다).
//
// DECISION RULE.  Given a serving QUALITY BUDGET (허용 손실 · pct × 100), the
// selector picks the MAXIMALLY-COMPRESSED level whose quality_loss does NOT exceed
// the budget:
//       select_quant(budget) = argmin_size { level : loss(level) ≤ budget }
// i.e. among all levels that stay within the loss budget, take the SMALLEST size
// (= maximum compression).  This wires the ENERGY/N2 measurement (per-level loss)
// directly into a serving-time precision decision: "how aggressively can I quantize
// without blowing the quality budget?"
//
// WORKED EXAMPLES (per ENGINE.md::I1 spec):
//   budget  500 (5.0%)  → gguf_q4 (loss 300 ≤ 500 · size 350 — best compression in budget)
//   budget   50 (0.5%)  → int8    (loss  50 ≤ 50  · size 700 — smallest size at loss ≤ 50)
//   budget 2000 (20%)   → gguf_q2 (loss 1500 ≤ 2000 · size 175 — maximum compression)
// (gguf_q2 only becomes admissible once the budget tolerates ≥ 15% loss — the
//  ENERGY/N2 anti-overcompression boundary is respected automatically.)
//
// CONSTRAINT (always-satisfied invariant).  loss(select_quant(budget)) ≤ budget
// whenever ANY level fits (fp16 loss=0 fits every non-negative budget, so the
// selector never returns "none" for a sane budget).
//
// ENGINE N1 (latency).  ENERGY/N2 discovered cycle-10 reorg Batch B → ENGINE wire
// cycle-10 (same-session ΔM ≈ 0). Logged to N1 baseline next round.
//
// FALSIFIER (paired verifier).  A selector that picks a level whose loss EXCEEDS
// the budget (e.g. budget 100 but returns gguf_q2 loss 1500) MUST be detected as
// FAIL — the constraint loss ≤ budget is the falsifiable contract (ENGINE.md::I1).
//
// HONESTY.  Closed-form decision rule over ENERGY/N2 placeholder tiers. Actual
// serving quant connection (real per-level MMLU/GSM8K re-eval driving live model
// load) is cost-bearing — DEFERRED to cycle-11+ (feedback_closure_is_physical_limit).
// External anchors: ENERGY/N2 · Frantar 2023 GPTQ (2210.17323) · Lin 2023 AWQ (2306.00978).
//
// @no-lock-needed
// @resolver-bypass(reason="Pure quant-level selection recompute — no runtime serving, no model load, no atlas atoms.")

// ────────────────────────────────────────────────────────────────────────
// ENERGY/N2 per-level ledger (integer × 100 · libm-free)
//   size_gb_x100 = GB × 100 · loss_pct_x100 = (100% − quality%) × 100
// ────────────────────────────────────────────────────────────────────────

let LEVEL_NAMES   = ["fp16", "int8", "gguf_q8", "gguf_q4", "gguf_q2"]
let SIZE_GB_x100  = [1400,    700,    715,       350,       175]
let LOSS_PCT_x100 = [0,       50,     50,        300,       1500]

let N_LEVELS = LEVEL_NAMES.len()
let NONE_IDX = -1   // sentinel: no level fits the budget

// decision rule — argmin size over { level : loss ≤ budget }
fn select_quant(budget_x100: int) -> int {
    let mut best = NONE_IDX
    let mut best_size = 0
    let mut i = 0
    while i < N_LEVELS {
        if LOSS_PCT_x100[i] <= budget_x100 {
            if best == NONE_IDX {
                best = i
                best_size = SIZE_GB_x100[i]
            } else {
                if SIZE_GB_x100[i] < best_size {
                    best = i
                    best_size = SIZE_GB_x100[i]
                }
            }
        }
        i = i + 1
    }
    return best
}

fn selected_loss(budget_x100: int) -> int {
    let idx = select_quant(budget_x100)
    if idx == NONE_IDX { return -1 }
    return LOSS_PCT_x100[idx]
}

fn selected_size(budget_x100: int) -> int {
    let idx = select_quant(budget_x100)
    if idx == NONE_IDX { return -1 }
    return SIZE_GB_x100[idx]
}

print("hexa-codex ENGINE I1 — ENERGY/N2 → serving quant-level selector wire (cycle-10)")
print("===============================================================================")
print("")
print("ENERGY/N2 per-level ledger (size_gb×100 · loss_pct×100):")
let mut i = 0
while i < N_LEVELS {
    print("  " + LEVEL_NAMES[i] + ": size=" + to_string(SIZE_GB_x100[i]) +
          " · loss=" + to_string(LOSS_PCT_x100[i]))
    i = i + 1
}
print("")
print("decision rule: select_quant(budget) = argmin size { level : loss ≤ budget } (최대 압축)")
print("")

let BUDGETS = [50, 100, 300, 500, 1000, 2000]
let mut b = 0
while b < BUDGETS.len() {
    let bud = BUDGETS[b]
    let idx = select_quant(bud)
    if idx == NONE_IDX {
        print("  budget " + to_string(bud) + " → (none fits)")
    } else {
        print("  budget " + to_string(bud) + " (" + to_string(bud / 100) + "." + to_string((bud / 10) % 10) +
              "%) → " + LEVEL_NAMES[idx] + " (loss=" + to_string(LOSS_PCT_x100[idx]) +
              " ≤ " + to_string(bud) + " · size=" + to_string(SIZE_GB_x100[idx]) + " — max compression in budget)")
    }
    b = b + 1
}
print("")
print("__HEXA_CODEX_ENGINE_I1_QUANT_LEVEL_SELECTOR__ DONE")
