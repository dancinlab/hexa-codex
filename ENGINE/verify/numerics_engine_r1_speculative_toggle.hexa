#!hexa strict
// hexa-codex/ENGINE/verify/numerics_engine_r1_speculative_toggle.hexa
// ENGINE axis R1 — falsifier verifier for the speculative-decode auto-toggle wire.
//
// Asserts that spec_toggle is a faithful, deterministic decision rule that
// CONSUMES the BATCH-COMPOSITION/N1 SPECULATIVE-DECODING finding (acceptance ≥ 50%
// → predicted speedup ≥ 1.2× · acceptance < 50% → speedup < 1.2× · speculation
// 무의미 · arXiv:2211.17192 Leviathan · arXiv:2401.10774 Medusa):
//   (1) toggle identity — acceptance ≥ 50% (5000) → "enable"
//   (2) good drafts — tiny(80%) · medium(70%) · self_spec(75%) → "enable"
//   (3) bad_draft — 30% < 50% → "disable" (mismatched 45% disables too)
//   (4) FALSIFIER wire — a rule that ignores the finding (keeps acceptance<50%
//       ENABLED, where speedup<1.2× = pure overhead) is detected as WRONG vs
//       spec_toggle's "disable"
//   (5) determinism (re-call → identical decision)
//   (6) source-finding consistency — BATCH-COMP/N1 accept_threshold = 5000 (50%)
//       AND the 5 combos' acceptance ledger (8000/7000/7500/4500/3000) intact
//   (7) decision ∈ {enable, disable} for every test case (valid output domain)
// Any FAIL = wire contradicts the BATCH-COMP/N1 finding ⇒ ENGINE R1 FALSIFIED.
//
// SOURCE.  ENGINE/wires/wire_r1_speculative_toggle.hexa (verifier replicates the
// decision rule — closed-form recompute, no import of emitted state).
// BATCH-COMP/N1 source: BATCH-COMPOSITION/verify/numerics_batch_composition_n1_speculative_decoding.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="Pure closed-form recompute of the R1 decision rule.")

let ACCEPT_THRESHOLD_x100 = 5000   // 50% — speculative-decode enable boundary (BATCH-COMP/N1)

// BATCH-COMP/N1 draft-target combos (consumed acceptance data · accept_x100)
let TINY_DRAFT_GOOD_ACCEPT_x100   = 8000   // 80%
let MEDIUM_DRAFT_ACCEPT_x100      = 7000   // 70%
let SELF_SPEC_MEDUSA_ACCEPT_x100  = 7500   // 75%
let MISMATCHED_DRAFT_ACCEPT_x100  = 4500   // 45% — fires
let BAD_DRAFT_ACCEPT_x100         = 3000   // 30% — fires

fn spec_toggle(acceptance_rate_x100: int) -> str {
    if acceptance_rate_x100 >= ACCEPT_THRESHOLD_x100 { return "enable" }
    return "disable"
}

// FALSIFIER reference — a (deliberately wrong) rule that IGNORES the finding:
// it always ENABLES speculative decode, even for acceptance < 50% where the
// finding says predicted speedup < 1.2× (pure draft/verify overhead).
fn spec_toggle_finding_ignorant(acceptance_rate_x100: int) -> str {
    return "enable"
}

print("hexa-codex ENGINE R1 falsifier — speculative-decode auto-toggle (cycle-10)")
print("==========================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0

// check 1 — toggle identity: acceptance ≥ 50% (5000) → "enable"
checks_total = checks_total + 1
if spec_toggle(5000) == "enable" &&
   spec_toggle(6000) == "enable" &&
   spec_toggle(10000) == "enable" {
    print("  [PASS] identity: acceptance ≥ 5000 (50%) → enable (5000 boundary · 6000 · 10000)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] acceptance ≥ 50% did not map to enable")
}

// check 2 — good drafts: tiny(80%) · medium(70%) · self_spec(75%) → "enable"
checks_total = checks_total + 1
if spec_toggle(TINY_DRAFT_GOOD_ACCEPT_x100) == "enable" &&
   spec_toggle(MEDIUM_DRAFT_ACCEPT_x100) == "enable" &&
   spec_toggle(SELF_SPEC_MEDUSA_ACCEPT_x100) == "enable" {
    print("  [PASS] good drafts enable: tiny(80%) · medium(70%) · self_spec(75%) → enable (speedup ≥ 1.2× · 가치 있음)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] a good draft (accept ≥ 50%) did not map to enable")
}

// check 3 — bad_draft: 30% < 50% → "disable" (mismatched 45% disables too)
checks_total = checks_total + 1
let bad_dec = spec_toggle(BAD_DRAFT_ACCEPT_x100)
let mis_dec = spec_toggle(MISMATCHED_DRAFT_ACCEPT_x100)
if bad_dec == "disable" && mis_dec == "disable" &&
   BAD_DRAFT_ACCEPT_x100 < ACCEPT_THRESHOLD_x100 &&
   MISMATCHED_DRAFT_ACCEPT_x100 < ACCEPT_THRESHOLD_x100 {
    print("  [PASS] bad_draft accept=" + to_string(BAD_DRAFT_ACCEPT_x100) +
          " (30%) < 5000 → disable; mismatched (45%) → disable too (speedup < 1.2× · 오버헤드 회피)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] sub-50% draft did not map to disable (bad=" + bad_dec + " mismatched=" + mis_dec + ")")
}

// check 4 — FALSIFIER wire: finding-ignorant rule detected as WRONG
checks_total = checks_total + 1
let correct = spec_toggle(BAD_DRAFT_ACCEPT_x100)                    // "disable" (finding honored)
let ignorant = spec_toggle_finding_ignorant(BAD_DRAFT_ACCEPT_x100)  // "enable"  (finding ignored)
if correct == "disable" && ignorant == "enable" && correct != ignorant {
    print("  [PASS] FALSIFIER caught: finding-ignorant rule → enable ≠ spec_toggle → disable " +
          "(accept 3000<5000 MUST disable · speedup<1.2× = pure overhead · wire honors BATCH-COMP/N1)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] falsifier wire NOT detected (correct=" + correct + " ignorant=" + ignorant + ")")
}

// check 5 — determinism (re-call → identical)
checks_total = checks_total + 1
if spec_toggle(8000) == spec_toggle(8000) &&
   spec_toggle(3000) == spec_toggle(3000) &&
   spec_toggle(5000) == spec_toggle(5000) {
    print("  [PASS] deterministic (re-call same decision)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] non-deterministic")
}

// check 6 — source-finding consistency: BATCH-COMP/N1 threshold + acceptance ledger
checks_total = checks_total + 1
if ACCEPT_THRESHOLD_x100 == 5000 &&
   TINY_DRAFT_GOOD_ACCEPT_x100 == 8000 &&
   MEDIUM_DRAFT_ACCEPT_x100 == 7000 &&
   SELF_SPEC_MEDUSA_ACCEPT_x100 == 7500 &&
   MISMATCHED_DRAFT_ACCEPT_x100 == 4500 &&
   BAD_DRAFT_ACCEPT_x100 == 3000 {
    print("  [PASS] BATCH-COMP/N1 consumed: accept_threshold=5000 (50%) · accept ledger " +
          "tiny:8000 medium:7000 self_spec:7500 mismatched:4500 bad:3000 (wire ↔ finding consistent)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] BATCH-COMP/N1 acceptance ledger mismatch")
}

// check 7 — decision ∈ {enable, disable} for every test case (valid output domain)
checks_total = checks_total + 1
let CASE_ACCEPT = [8000, 7000, 7500, 4500, 3000]
let mut domain_ok = true
let mut k = 0
while k < CASE_ACCEPT.len() {
    let d = spec_toggle(CASE_ACCEPT[k])
    if d != "enable" && d != "disable" { domain_ok = false }
    k = k + 1
}
if domain_ok {
    print("  [PASS] decision ∈ {enable, disable} for all " + to_string(CASE_ACCEPT.len()) + " combos (valid output domain)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] a decision escaped {enable, disable}")
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 STRUCTURAL (decision rule 7/7) + 🟡 BY-CITATION (BATCH-COMP/N1 finding consume · Leviathan 2023 arXiv:2211.17192 · Cai 2024 Medusa arXiv:2401.10774) — spec_toggle wires draft-acceptance into a serving speculative-decode enable/disable choice · acceptance-gated"
} else {
    verdict_tier = "🔴 FALSIFIED — decision rule contradicts BATCH-COMP/N1 finding (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
}
print("  " + verdict_tier)
print("")
print("ENGINE R1 finding (closed-form decision rule · cycle-10):")
print("  - spec_toggle(acceptance_rate_x100) → {enable, disable}; accept ≥ 5000 (50%) → enable · accept < 50% → disable")
print("  - good drafts tiny(80%)/medium(70%)/self_spec(75%) → ENABLE (predicted speedup ≥ 1.2× · draft FLOPs repaid)")
print("  - bad_draft(30%)/mismatched(45%) → DISABLE (speedup < 1.2× · draft/verify overhead 회피 · plain AR decode)")
print("  - falsifier wire (finding-ignorant enable-always) detected — proves the rule actually honors the measurement")
print("  - honest residual: live serving speculative-decode toggle (vLLM/TGI · lm_foundry · SANDBOX) wiring DEFERRED to cycle-11+ T4 (cx_lab_sandbox)")
print("")
print("__HEXA_CODEX_NUMERICS_ENGINE_R1__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/ENGINE/verdicts/r1_speculative_toggle_verdict.txt"

let mut content = "# hexa-codex ENGINE R1 — speculative-decode auto-toggle verifier (cycle-10)\n"
content = content + "# axis=ENGINE/ENGINE.md::R1 (BATCH-COMPOSITION/N1 SPECULATIVE-DECODING finding → serving spec-decode auto-toggle decision rule)\n"
content = content + "# wire=ENGINE/wires/wire_r1_speculative_toggle.hexa\n"
content = content + "# verifier=ENGINE/verify/numerics_engine_r1_speculative_toggle.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# rule=spec_toggle(acceptance_rate_x100): accept>=5000 (50%) -> enable (speedup>=1.2x · 가치 있음); accept<5000 -> disable (speedup<1.2x · 오버헤드 회피)\n"
content = content + "# source_finding=BATCH-COMP/N1 accept_threshold_x100=5000 (50%) · predicted_speedup_x100 = 100 + accept_x100*(k-1)/k (k_draft=5) · accept<50% fires falsifier (speedup<1.2x · speculation 무의미)\n"
content = content + "# cases=tiny_draft_good[8000=80%]->enable · medium_draft[7000=70%]->enable · self_spec_medusa[7500=75%]->enable · mismatched_draft[4500=45%]->disable · bad_draft[3000=30%]->disable\n"
content = content + "# falsifier=finding-ignorant rule (enable-always for accept<50%, ignoring speedup<1.2x overhead) detected as WRONG vs spec_toggle disable (check 4)\n"
content = content + "# external_anchor=Leviathan 2023 arXiv:2211.17192 (ICML speculative decoding) · Chen 2023 arXiv:2302.01318 (DeepMind speculative sampling) · Cai 2024 Medusa arXiv:2401.10774 (consumed via BATCH-COMP/N1)\n"
content = content + "# acceptance_gated=speculative decode ENABLED only for draft-target pairs clearing 50% acceptance (predicted speedup >= 1.2x) · DISABLED below (draft FLOPs + KV-cache rollback > gain)\n"
content = content + "# honest_residual=live serving speculative-decode toggle wiring (vLLM/TGI · lm_foundry · SANDBOX local llama-server · measured wall-clock tokens/s per draft-target pair) DEFERRED to cycle-11+ T4 (cx_lab_sandbox · feedback_closure_is_physical_limit — rule close != measured close)\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
