#!hexa strict
// HALLUCINATION/verify/numerics_hallucination_a1_confident_wrong_rate.hexa
// HALLUCINATION A1 — closed-form falsifier verifier for confident-wrong rate.
//
// Independently REPLICATES the bench identity (no runtime import of bench state)
// and asserts the 7 invariants:
//   (1) rate identity        rate_x100 == (N_confident_wrong · 100) / N_total
//   (2) range bound          rate_x100 ∈ [0, 100]
//   (3) zero-hallucination model Z → rate_x100 == 0
//   (4) heavy model D (42 > 20) → falsifier fires
//   (5) borderline A (18 ≤ 20) → silent (false-positive 회피)
//   (6) determinism          same input → same rate (re-call invariance)
//   (7) confidence-weighted ≤ raw       structural sanity (high-conf wrong full,
//                                       borderline wrong partial)
//
// Any FAIL = bench encoding contradicts the closed-form identity → HALLUCINATION
// A1 FALSIFIED.
//
// SOURCE.  bench/hallucination_a1_confident_wrong_rate.hexa (this verifier
// replicates the formula independently — closed-form recompute, no runtime
// import of the bench file's emitted state; same inputs by construction).
//
// External anchors:
//   Lin 2022 — TruthfulQA (arXiv:2109.07958)
//   Kadavath 2022 — language models (mostly) know what they know (arXiv:2207.05221)
//   Yin 2023 — Do LLMs Know What They Don't Know? (arXiv:2305.18153)
//
// @no-lock-needed
// @resolver-bypass(reason="Pure closed-form rate recompute on integer ×100 ledger.")

// ────────────────────────────────────────────────────────────────────────
// Replicated registry (independent · parallel to bench by construction)
// ────────────────────────────────────────────────────────────────────────

let MODEL_NAMES        = ["A",   "B",   "C",   "D",   "Z"]
let N_CONFIDENT_WRONG  = [ 18,    25,    12,    42,     0]
let N_TOTAL            = [100,   100,   100,   100,   100]
let SUM_CONF_x100      = [1620, 2375,  960,  4116,    0]
let THRESHOLD_x100 = 20

fn raw_rate_x100_v(i: int) -> int {
    return (N_CONFIDENT_WRONG[i] * 100) / N_TOTAL[i]
}

fn weighted_rate_x100_v(i: int) -> int {
    return SUM_CONF_x100[i] / N_TOTAL[i]
}

fn falsifier_fires_v(i: int) -> bool {
    return raw_rate_x100_v(i) > THRESHOLD_x100
}

print("hexa-codex HALLUCINATION A1 falsifier — confident-wrong rate closed-form")
print("=========================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0
let n = MODEL_NAMES.len()

// ────────────────────────────────────────────────────────────────────────
// check 1 — rate identity: rate_x100 == (N_confident_wrong · 100) / N_total
//   recomputed inline (no helper) so identity is testable end-to-end.
// ────────────────────────────────────────────────────────────────────────
checks_total = checks_total + 1
let mut identity_ok = true
let expected_raw = [18, 25, 12, 42, 0]
let mut i = 0
while i < n {
    let recompute = (N_CONFIDENT_WRONG[i] * 100) / N_TOTAL[i]
    let helper = raw_rate_x100_v(i)
    if recompute != helper { identity_ok = false }
    if recompute != expected_raw[i] { identity_ok = false }
    i = i + 1
}
if identity_ok {
    print("  [PASS] (1) rate identity: rate_x100 == (N_confident_wrong · 100) / N_total for all 5 models")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] (1) rate identity broken — helper disagrees with inline recompute")
}

// ────────────────────────────────────────────────────────────────────────
// check 2 — range bound: rate_x100 ∈ [0, 100] (probability semantics).
// ────────────────────────────────────────────────────────────────────────
checks_total = checks_total + 1
let mut range_ok = true
i = 0
while i < n {
    let r = raw_rate_x100_v(i)
    if r < 0 || r > 100 { range_ok = false }
    i = i + 1
}
if range_ok {
    print("  [PASS] (2) rate_x100 ∈ [0, 100] for all 5 models (probability semantics)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] (2) rate_x100 out of [0, 100]")
}

// ────────────────────────────────────────────────────────────────────────
// check 3 — zero-hallucination model Z (idx 4) → rate_x100 == 0
// ────────────────────────────────────────────────────────────────────────
checks_total = checks_total + 1
let z_idx = 4
let z_raw = raw_rate_x100_v(z_idx)
let z_fires = falsifier_fires_v(z_idx)
if z_raw == 0 && z_fires == false {
    print("  [PASS] (3) zero-hallucination model Z → rate_x100 = 0 · silent (no fire)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] (3) Z rate=" + to_string(z_raw) + " fires=" + to_string(z_fires) + " — expected 0/silent")
}

// ────────────────────────────────────────────────────────────────────────
// check 4 — heavy-hallucination model D (idx 3, raw=42 > 20) → falsifier fires
// ────────────────────────────────────────────────────────────────────────
checks_total = checks_total + 1
let d_idx = 3
let d_raw = raw_rate_x100_v(d_idx)
let d_fires = falsifier_fires_v(d_idx)
if d_raw == 42 && d_fires {
    print("  [PASS] (4) heavy model D (raw=42 > 20) → falsifier fires correctly")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] (4) D raw=" + to_string(d_raw) + " fires=" + to_string(d_fires) + " — expected 42/true")
}

// ────────────────────────────────────────────────────────────────────────
// check 5 — borderline model A (idx 0, raw=18 ≤ 20) → silent
//   verifies the threshold's lower edge: 18 < 20 must NOT fire (false-positive 회피).
// ────────────────────────────────────────────────────────────────────────
checks_total = checks_total + 1
let a_idx = 0
let a_raw = raw_rate_x100_v(a_idx)
let a_fires = falsifier_fires_v(a_idx)
if a_raw == 18 && a_fires == false {
    print("  [PASS] (5) borderline model A (raw=18 ≤ 20) → silent · false-positive 회피")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] (5) A raw=" + to_string(a_raw) + " fires=" + to_string(a_fires) + " — expected 18/false")
}

// ────────────────────────────────────────────────────────────────────────
// check 6 — determinism: re-call same input → same rate and same fire decision
// ────────────────────────────────────────────────────────────────────────
checks_total = checks_total + 1
let mut det_ok = true
i = 0
while i < n {
    let r1 = raw_rate_x100_v(i)
    let r2 = raw_rate_x100_v(i)
    let f1 = falsifier_fires_v(i)
    let f2 = falsifier_fires_v(i)
    if r1 != r2 { det_ok = false }
    if f1 != f2 { det_ok = false }
    i = i + 1
}
if det_ok {
    print("  [PASS] (6) deterministic (re-call same input → same rate · same fire)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] (6) non-deterministic — same input differs")
}

// ────────────────────────────────────────────────────────────────────────
// check 7 — confidence-weighted vs raw sanity:
//   weighted_x100(m) ≤ raw_x100(m) for every model whose confident-wrong
//   samples all have conf_x100 ≤ 100 — structural since
//     weighted = Σ conf / N_total ≤ (count · 100) / N_total = raw.
//   Strict ≤ (equality only when every wrong sample has conf=100).
// ────────────────────────────────────────────────────────────────────────
checks_total = checks_total + 1
let mut wgt_ok = true
i = 0
while i < n {
    let raw = raw_rate_x100_v(i)
    let wgt = weighted_rate_x100_v(i)
    if wgt > raw { wgt_ok = false }
    if wgt < 0 || wgt > 100 { wgt_ok = false }
    i = i + 1
}
if wgt_ok {
    print("  [PASS] (7) weighted_x100 ≤ raw_x100 for all 5 models · weighted ∈ [0, 100] (structural sanity)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] (7) weighted > raw or out of range — high-conf-only invariant broken")
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
let mut verdict_class = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 STRUCTURAL (confident-wrong rate identity + threshold 7/7) + 🟡 BY-CITATION (20% threshold = TruthfulQA / Kadavath self-eval convention)"
    verdict_class = "SUPPORTED-NUMERICAL"
} else {
    verdict_tier = "🔴 FALSIFIED — confident-wrong rate encoding contradicts identity (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
    verdict_class = "FALSIFIED"
}
print("  " + verdict_tier)
print("")
print("worked example summary:")
print("  A (mid, raw=18)   silent · honest mid-tier (false-positive 회피)")
print("  B (over, raw=25)  FIRES · over-confident")
print("  C (low, raw=12)   silent · IDK-rich")
print("  D (heavy, raw=42) FIRES heavily · 2× threshold")
print("  Z (zero, raw=0)   silent · zero-hallucination control")
print("")
print("external anchor:")
print("  - Lin 2022 'TruthfulQA: Measuring How Models Mimic Human Falsehoods' (arXiv:2109.07958)")
print("  - Kadavath 2022 'Language Models (Mostly) Know What They Know' (arXiv:2207.05221)")
print("  - Yin 2023 'Do Large Language Models Know What They Don't Know?' (arXiv:2305.18153)")
print("")
print("honest residual (frontier OPEN — perpetual axis, feedback_closure_is_physical_limit):")
print("  - this verifier encodes the FORMULA only (closed-form 🔵 + 🟡) — substrate fire")
print("    on TruthfulQA · SimpleQA deferred to A1 measured-tier (mac M3 local llama-server")
print("    / ubu-1 HF transformers · cycle-10+ cost-bearing round).")
print("  - integer ×100 ledger truncates rate at .01 — coarser than literature float % (3-4 sig)")
print("    — acceptable for falsifier semantics, not fine-grained model comparison.")
print("  - 'confidence' here is a per-sample weight; real-fire wires it to logit margin /")
print("    self-eval probe (Kadavath 2022 'P(True)') — definition narrows at measured-tier.")
print("  - axis N (knowledge-boundary IDK rate · ⭐ MAIN NOVEL lane) opens next.")
print("")
print("__HEXA_CODEX_NUMERICS_HALLUCINATION_A1_CONFIDENT_WRONG_RATE__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

// ────────────────────────────────────────────────────────────────────────
// Verdict file persistence — under HALLUCINATION/verdicts/
// ────────────────────────────────────────────────────────────────────────

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/HALLUCINATION/verdicts/a1_confident_wrong_rate_verdict.txt"

let a_raw_out = raw_rate_x100_v(0)
let b_raw_out = raw_rate_x100_v(1)
let c_raw_out = raw_rate_x100_v(2)
let d_raw_out = raw_rate_x100_v(3)
let z_raw_out = raw_rate_x100_v(4)

let mut content = "# hexa-codex HALLUCINATION A1 — confident-wrong rate closed-form verifier (cycle-9 round-4)\n"
content = content + "# axis=HALLUCINATION/HALLUCINATION.md::A1 (confident-wrong rate first probe, closed-form)\n"
content = content + "# formula=rate_x100(m) = (N_confident_wrong[m] · 100) / N_total[m]; falsifier_fires = rate_x100 > 20\n"
content = content + "# bench=HALLUCINATION/bench/hallucination_a1_confident_wrong_rate.hexa\n"
content = content + "# verifier=HALLUCINATION/verify/numerics_hallucination_a1_confident_wrong_rate.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# verdict_class=" + verdict_class + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# placeholder_models=5 (A=18 silent · B=25 fires · C=12 silent · D=42 fires · Z=0 zero-hall control)\n"
content = content + "# rates_x100=A:" + to_string(a_raw_out) + " B:" + to_string(b_raw_out) + " C:" + to_string(c_raw_out) + " D:" + to_string(d_raw_out) + " Z:" + to_string(z_raw_out) + "\n"
content = content + "# threshold_x100=20 (> 20% with high confidence → falsifier fires)\n"
content = content + "# external_anchors=Lin 2022 TruthfulQA (arXiv:2109.07958) · Kadavath 2022 self-eval (arXiv:2207.05221) · Yin 2023 do-LLMs-know (arXiv:2305.18153)\n"
content = content + "# substrate_fire=DEFERRED (cycle-10+ · TruthfulQA · SimpleQA × abstention extractor + self-eval gating on mac M3 / ubu-1 HF)\n"
content = content + "# honest_residual=integer_x100_ledger_truncation_at_0.01 · 'confidence' as per-sample weight (logit-margin / Kadavath P(True) narrows at measured-tier) · axis_N_knowledge_boundary_IDK_next\n"
content = content + "# frontier=OPEN (feedback_closure_is_physical_limit — perpetual axis · new cutoff / domain reopens cells)\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
