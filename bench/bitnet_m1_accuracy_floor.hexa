#!hexa strict
// bench/bitnet_m1_accuracy_floor.hexa — BITNET M1 + M2 bench.
//
// QUESTION (M1 Surface): can Microsoft BitNet b1.58 2B4T — a 1.58-bit ternary
// -weight LLM — reach the SANDBOX "usable" accuracy floor on the SAME canonical
// 20-task economics-routing manifest used by bench/sandbox_stage0_baseline.hexa
// (clean Qwen2.5-0.5B-Q4 baseline = 16/20)? Engine: stock brew llama.cpp via its
// native ternary path. The official microsoft i2_s GGUF does NOT load in stock
// llama.cpp (ggml type-id collision: TYPE_IQ4_NL_4_4 REMOVED) — it targets
// bitnet.cpp. HONEST PATH: convert the bf16 safetensors → TQ2_0 (llama.cpp
// native 2.06-bpw ternarization, BitnetForCausalLM arch supported by
// convert_hf_to_gguf.py build 9150) and run that.
//
// QUESTION (M2 Memory): resident memory (RSS) of BitNet 1.58-bit serving vs the
// Qwen2.5-1.5B-Q4 baseline already on the substrate. Falsifier: accuracy gap
// vs the 0.5B/1.5B baselines unexpectedly large, OR BitNet RSS not below the
// Q4 baseline RSS.
//
// SCORER is byte-identical to sandbox_stage0_baseline.hexa (case-insensitive
// substring on expected_kw, with the 2026-05-23 stderr-trailer strip), so the
// BitNet number is DIRECTLY comparable to the SANDBOX stage-0 floor.
//
// Parameterized by env (one harness, two roles):
//   BITNET_MODEL_PATH   absolute .gguf path        (required)
//   BITNET_MODEL_NAME   label for the summary      (required)
//   BITNET_OUT_PREFIX   .verdicts/bitnet/<prefix>  (default m1_accuracy_floor)
//
// Output:
//   .verdicts/bitnet/<prefix>.tsv          (per-task rows incl. per-task RSS)
//   .verdicts/bitnet/<prefix>_summary.txt  (aggregate accuracy + peak RSS)
//
// Run:
//   HEXA_SHIM_NO_DARWIN_LANDING=1 RESOURCE_LOCAL_HEXA=1 \
//     HEXA_CODEX_ROOT="$PWD" \
//     BITNET_MODEL_PATH="$HOME/Models/gguf/bitnet/ggml-model-tq2_0.gguf" \
//     BITNET_MODEL_NAME="BitNet-b1.58-2B-4T-TQ2_0" \
//     ~/.hx/packages/hexa/hexa.real run bench/bitnet_m1_accuracy_floor.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="External CLI subprocess (llama-completion + /usr/bin/time) + filesystem write — no atlas atoms touched.")

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()
let OUT_DIR = ROOT + "/.verdicts/bitnet"

fn _model_path() -> str {
    let p = env("BITNET_MODEL_PATH")
    if p.len() > 0 { return p }
    return HOME + "/Models/gguf/bitnet/ggml-model-tq2_0.gguf"
}
fn _model_name() -> str {
    let n = env("BITNET_MODEL_NAME")
    if n.len() > 0 { return n }
    return "BitNet-b1.58-2B-4T-TQ2_0"
}
fn _out_prefix() -> str {
    let p = env("BITNET_OUT_PREFIX")
    if p.len() > 0 { return p }
    return "m1_accuracy_floor"
}

let MODEL_PATH = _model_path()
let MODEL_NAME = _model_name()
let OUT_PREFIX = _out_prefix()
let MAX_TOK = 96            // identical headroom to sandbox_stage0_baseline
let USABLE_THRESHOLD = 15   // >= 15/20 = usable floor reached (SANDBOX parity)

// Extra flags. BitNet TQ2_0 requires CPU (-ngl 0; the brew Metal backend has no
// TQ2_0 type-35 kernel — asserts on GPU) + --jinja (the 2B4T "User:/Assistant:"
// chat template is not a llama.cpp built-in). Default carries both; set to ""
// (e.g. for the Qwen-Q4 baseline role, which uses Metal + a built-in template).
fn _extra_flags() -> str {
    let e = env("BITNET_EXTRA_FLAGS")
    if e.len() > 0 {
        if e == "NONE" { return "" }
        return e
    }
    return "-ngl 0 --jinja"
}
let EXTRA_FLAGS = _extra_flags()

// Output layout selector. BitNet --jinja emits a single line
// "User: <prompt>Assistant: <answer> [end of text]"; the SANDBOX baseline
// (Qwen, no jinja) emits the "assistant\n<answer>\n> EOF by user" block.
// BITNET_PARSE=assistant_block uses the baseline marker parser.
fn _parse_mode() -> str {
    let m = env("BITNET_PARSE")
    if m.len() > 0 { return m }
    return "assistant_prefix"
}
let PARSE_MODE = _parse_mode()

// 20-task fixed manifest — VERBATIM from bench/sandbox_stage0_baseline.hexa
// (itself verbatim from economics_routing_2tier.hexa) for direct comparability.
let TASKS = [
    ["What is 2+2? Reply with the digit only.",                                                    "4"],
    ["Capital of France? One word.",                                                                "paris"],
    ["Reverse the string 'hello'. Reply with the reversed string only.",                            "olleh"],
    ["Square of 7? Reply with the number only.",                                                    "49"],
    ["First prime number greater than 10? Reply with the number only.",                             "11"],
    ["Smallest prime number? Reply with the number only.",                                          "2"],
    ["How many continents? Reply with the number only.",                                            "7"],
    ["Boiling point of water in Celsius at sea level? Reply with the number only.",                 "100"],
    ["ASCII decimal code for 'A'? Reply with the number only.",                                     "65"],
    ["Days in February 2024? Reply with the number only.",                                          "29"],
    ["Write a Python one-liner that sums integers 1..100. Reply with code only.",                   "sum(range"],
    ["Time complexity of binary search? Reply with big-O only.",                                    "log n"],
    ["Python: reverse a list lst in one expression. Reply with the expression only.",               "[::-1]"],
    ["Sort {3,1,2} ascending. Reply with the result only.",                                         "1, 2, 3"],
    ["TCP vs UDP in one sentence — which is connection-oriented?",                                  "tcp"],
    ["Explain BFS vs DFS in 2 sentences.",                                                          "breadth"],
    ["Write Python Fibonacci with memoization (use functools.cache).",                              "fib"],
    ["Convert binary 1101 to decimal, show one-line sum.",                                          "13"],
    ["Why is mergesort O(n log n)? One-sentence justification.",                                    "merge"],
    ["Halting problem — what is it? One sentence.",                                                  "halt"],
]

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

// Run one task via llama-completion, wrapped in /usr/bin/time -l for RSS.
// Returns tab-separated:
//   wall_ms \t prompt_wc \t output_tok_est \t correct(1|0) \t rss_bytes \t output_snippet
//
// Parser + scorer byte-identical to sandbox_stage0_baseline.hexa run_one():
// extract text between literal lines `assistant` and `> EOF by user`, strip the
// [end of text] / common_perf_print stderr trailer, case-insensitive substring
// match on expected_kw. RSS comes from `maximum resident set size` printed by
// /usr/bin/time -l on stderr (captured separately so it never pollutes $ans).
fn run_one(prompt: str, expected_kw: str) -> str {
    let wc = str(prompt.len())   // byte-length; cheap proxy for word-count

    // Parser stage: isolate the model's answer text. Two modes (see PARSE_MODE):
    //   assistant_prefix : BitNet --jinja "...Assistant: <answer>" single line —
    //                      strip everything up to and incl. the LAST "Assistant:".
    //   assistant_block  : SANDBOX baseline "assistant\n<answer>\n> EOF by user".
    let mut extract = ""
    if PARSE_MODE == "assistant_block" {
        extract = "awk '/^assistant$/{flag=1; next} /^> EOF by user/{flag=0} flag{print}' | tr '\\n' ' '"
    } else {
        // assistant_prefix: collapse to one line, then strip up to last "Assistant:".
        extract = "tr '\\n' ' ' | sed 's/.*Assistant: *//'"
    }

    let cmd = "t_start=$(date +%s%N); " +
              "tmperr=$(mktemp); " +
              "out=$(/usr/bin/time -l llama-completion -m " + shq(MODEL_PATH) +
              " " + EXTRA_FLAGS +
              " -p " + shq(prompt) +
              " -n " + str(MAX_TOK) + " --temp 0 -st 2>\"$tmperr\"); " +
              "t_end=$(date +%s%N); " +
              "wall_ms=$(( (t_end - t_start) / 1000000 )); " +
              "rss=$(grep 'maximum resident set size' \"$tmperr\" | awk '{print $1}' | tail -1); " +
              "rm -f \"$tmperr\"; " +
              "ans_raw=$(printf '%s\\n' \"$out\" | " + extract + " | sed 's/  */ /g; s/^ //; s/ $//'); " +
              // SCORER FIX 2026-05-23 parity: strip [end of text] + common_perf_print trailer
              "ans=$(printf '%s' \"$ans_raw\" | sed 's/ *\\[end of text\\].*$//' | sed 's/ *common_perf_print:.*$//'); " +
              "tok_est=$(printf '%s' \"$ans\" | wc -w | tr -d ' '); " +
              "low=$(printf '%s' \"$ans\" | tr 'A-Z' 'a-z'); " +
              "kw=$(printf '%s' " + shq(expected_kw) + " | tr 'A-Z' 'a-z'); " +
              "if printf '%s' \"$low\" | grep -qF \"$kw\"; then correct=1; else correct=0; fi; " +
              "snippet=$(printf '%s' \"$ans\" | cut -c1-120); " +
              "printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s' \"$wall_ms\" \"" + wc + "\" \"$tok_est\" \"$correct\" \"${rss:-0}\" \"$snippet\""
    return exec(cmd).trim()
}

fn main() {
    println("========================================================================")
    println("  bench/bitnet_m1_accuracy_floor — BitNet 1.58-bit accuracy floor + RSS")
    println("  model:    " + MODEL_NAME)
    println("  path:     " + MODEL_PATH)
    println("  tool:     llama-completion (stock brew llama.cpp, native ternary)")
    println("  manifest: 20 tasks (VERBATIM from sandbox_stage0_baseline.hexa)")
    println("  threshold: >= " + str(USABLE_THRESHOLD) + "/20 = usable floor reached")
    println("========================================================================")

    exec("mkdir -p " + shq(OUT_DIR))
    let tsv_path = OUT_DIR + "/" + OUT_PREFIX + ".tsv"
    exec("rm -f " + shq(tsv_path))
    exec("echo 'idx\tprompt_wc\toutput_tok_est\twall_ms\tcorrect\trss_bytes\toutput_snippet' >> " + shq(tsv_path))

    let mut total_ms = 0
    let mut n_correct = 0
    let mut peak_rss = 0
    let mut i = 0
    while i < len(TASKS) {
        let task = TASKS[i]
        let prompt = task[0]
        let expected = task[1]
        println("  [" + str(i+1) + "/" + str(len(TASKS)) + "] kw=" + expected + " prompt=" + prompt.substr(0, 50))
        let line = run_one(prompt, expected)
        let parts = line.split("\t")
        if parts.len() < 6 {
            println("    ! parse error, raw=" + line)
            let bad = str(i+1) + "\t" + str(prompt.len()) + "\t0\t0\t0\t0\tPARSE_ERROR:" + line.substr(0, 80)
            exec("echo " + shq(bad) + " >> " + shq(tsv_path))
            i = i + 1
            continue
        }
        let wall_ms = int(parts[0])
        let prompt_wc = parts[1]
        let tok_est = parts[2]
        let correct = parts[3]
        let rss = int(parts[4])
        let snippet = parts[5].replace("\t", " ")
        total_ms = total_ms + wall_ms
        if correct == "1" { n_correct = n_correct + 1 }
        if rss > peak_rss { peak_rss = rss }
        let row = str(i+1) + "\t" + prompt_wc + "\t" + tok_est + "\t" + str(wall_ms) + "\t" + correct + "\t" + str(rss) + "\t" + snippet.substr(0, 120)
        exec("echo " + shq(row) + " >> " + shq(tsv_path))
        println("    -> wall_ms=" + str(wall_ms) + " correct=" + correct + " rss=" + str(rss) + " ans=" + snippet.substr(0, 50))
        i = i + 1
    }

    let total = len(TASKS)
    let mut acc_pct_x100 = 0
    if total > 0 { acc_pct_x100 = (n_correct * 10000) / total }
    let mut floor_ok = "false"
    if n_correct >= USABLE_THRESHOLD { floor_ok = "true" }

    // peak RSS in MB (integer) for the readable summary.
    let peak_rss_mb = peak_rss / 1048576

    println("")
    println("========================================================================")
    println("  SUMMARY — BITNET M1 accuracy floor + M2 RSS")
    println("========================================================================")
    println("  model            : " + MODEL_NAME)
    println("  total_tasks      : " + str(total))
    println("  correct          : " + str(n_correct) + "/" + str(total))
    println("  accuracy_pct     : " + str(acc_pct_x100 / 100) + "." + str(acc_pct_x100 % 100) + "%")
    println("  total_wall_ms    : " + str(total_ms))
    println("  peak_rss_bytes   : " + str(peak_rss))
    println("  peak_rss_mb      : " + str(peak_rss_mb))
    println("  threshold        : >= " + str(USABLE_THRESHOLD) + "/20")
    println("  usable_floor     : " + floor_ok)
    println("")

    let summary_path = OUT_DIR + "/" + OUT_PREFIX + "_summary.txt"
    exec("rm -f " + shq(summary_path))
    exec("echo " + shq("# model=" + MODEL_NAME) + " >> " + shq(summary_path))
    exec("echo " + shq("# model_path=" + MODEL_PATH) + " >> " + shq(summary_path))
    exec("echo " + shq("# total_tasks=" + str(total)) + " >> " + shq(summary_path))
    exec("echo " + shq("# correct=" + str(n_correct) + "/" + str(total)) + " >> " + shq(summary_path))
    exec("echo " + shq("# accuracy_pct=" + str(acc_pct_x100 / 100) + "." + str(acc_pct_x100 % 100)) + " >> " + shq(summary_path))
    exec("echo " + shq("# total_wall_ms=" + str(total_ms)) + " >> " + shq(summary_path))
    exec("echo " + shq("# peak_rss_bytes=" + str(peak_rss)) + " >> " + shq(summary_path))
    exec("echo " + shq("# peak_rss_mb=" + str(peak_rss_mb)) + " >> " + shq(summary_path))
    exec("echo " + shq("# usable_threshold=" + str(USABLE_THRESHOLD)) + " >> " + shq(summary_path))
    exec("echo " + shq("# usable_floor_reached=" + floor_ok) + " >> " + shq(summary_path))
    exec("echo " + shq("# tool=llama-completion (stock brew llama.cpp 9150, native TQ2_0 ternary)") + " >> " + shq(summary_path))
    exec("echo " + shq("# extra_flags=" + EXTRA_FLAGS + "  (BitNet TQ2_0: CPU-only -ngl 0 — Metal lacks type-35 kernel; --jinja for 2B4T chat template)") + " >> " + shq(summary_path))
    exec("echo " + shq("# parse_mode=" + PARSE_MODE) + " >> " + shq(summary_path))
    exec("echo " + shq("# host=mac-mini-m3 (brew llama.cpp, CPU/NEON+ACCELERATE, UMA)") + " >> " + shq(summary_path))
    exec("echo " + shq("# scorer=byte_exact_subset (case-insensitive, VERBATIM from sandbox_stage0_baseline.hexa)") + " >> " + shq(summary_path))
    exec("echo " + shq("# cost_usd=0  (local serving; wall_ms is the proxy cost surface)") + " >> " + shq(summary_path))

    println("  tsv     persisted: " + tsv_path)
    println("  summary persisted: " + summary_path)
    println("")
    println("__HEXA_CODEX_BENCH_BITNET_M1__ PASS")
    exit(0)
}
