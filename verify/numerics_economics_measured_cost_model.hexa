#!hexa strict
// hexa-codex/verify/numerics_economics_measured_cost_model.hexa — M3.ECON
// POSITIVE measured-latency cost model — the substrate's REAL latency law,
// independent of the n=6 lattice (which is irrelevant here).
//
// PURPOSE.  M3.ECON's M5-release OR-branch reads (SANDBOX.md M5.ECON):
// "v1.3.0 must EITHER re-derive a measured-τ̂ cost model OR ship the
// falsification."  The self-generated n=6 lattice number τ=4 does NOT fit
// the substrate (measured τ̂=0.524, residual 3.476 ≫ ε) — recorded as an
// INTERNAL verdict `.verdicts/sandbox/m3_econ_fcodex2_latency_fit.txt`
// (recomputed by `verify/numerics_economics_empirical_landing.hexa`, 10/10
// 🔴).  NOTE: no paper — refuting a self-generated pre-LATTICE_POLICY
// number is not paper-worthy (the `economics-lattice-falsified` paper was
// REVOKED, cx_paper_violation).  THIS verifier supplies the OTHER half — the
// POSITIVE measured cost model — so the OR-branch is satisfied with a
// REAL law (not merely a negative).
//
// CLAIM (the load-bearing positive finding).  The substrate's per-request
// wall_ms is NOT a pure power-law in context length.  It is a 2-component
// PHYSICAL model:
//
//     wall_ms = decode_fixed + prefill_slope · input_tokens
//
//   • decode_fixed — a context-INVARIANT floor (ms) set by the fixed
//     max_tokens≈64 decode phase, which is memory-bandwidth-bound: each
//     decoded token reloads the full weight matrix once (Theorem I-1
//     wall, infer_cost/ai-inference-cost.md §S7.6), so the decode cost
//     does not grow with prompt length.
//   • prefill_slope · input_tokens — the prefill (TTFT) phase, which is
//     ~LINEAR in input length in the paged-attention regime (vLLM /
//     llama.cpp KV-cache scheduler), §S7.6 "TTFT linear in input length".
//
// This is exactly the functional family the falsification's WHY-section
// named: "per-request total wall is dominated by the FIXED max_tokens=64
// decode + the cached-boilerplate prefill". The pure power-law
// wall ∝ context^τ̂ is a descriptive single-exponent fit that conflates
// the two phases; the 2-component model separates them and fits better.
//
// REQUIRES.  Closed-form float arithmetic only — log_pure / pow_pure /
// abs_pure from `self/runtime/math_pure`.  NO model spawn, NO llama-server,
// NO API, NO exec subprocess.  Mirrors the closed-form OLS structure of
// `verify/numerics_economics_empirical_landing.hexa`.
//
// FIT METHODS.
//   (a) single power-law  wall_ms = a · context^τ̂ :
//         log-log OLS slope τ̂ on (log context, log wall_ms);
//         a = exp( mean(log wall) − τ̂·mean(log context) ).
//         R² reported in LINEAR (wall_ms) space — same response scale as
//         model (b), so the two R² are directly comparable.
//   (b) 2-component       wall_ms = β0 + β1 · input_tokens :
//         ordinary least squares on (input_tokens, wall_ms):
//           β1 = ( k·Σ(x·y) − Σx·Σy ) / ( k·Σx² − (Σx)² )
//           β0 = ( Σy − β1·Σx ) / k
//         decode_fixed = β0, prefill_slope = β1.  R² in linear space.
//
// MEASURED DATA — bench TSV verbatim, confirmed against
// `.verdicts/sandbox/stage4_context_scaling.tsv` (Qwen2.5-1.5B-Instruct
// -Q4_K_M, mac-mini-m3 Metal, -np 1 -cb port 8091, 20 tasks × 4 rungs,
// $0 local, cycle-16).  accuracy FLAT 17/20 every rung (no long-context
// collapse), so the latency law stands with no accuracy-floor caveat.
//
//   context_len   mean_wall_ms   mean_input_tokens   throughput_tok_per_s
//          1024            569                 987                  22.80
//          2048            670                1947                  17.60
//          4096           1005                3867                  11.98
//          8192           1668                7647                   7.31
//
// STRUCTURAL CHECKS (8, closed-form, 🟢-tier numerical):
//   1. wall_ms strictly monotone-increasing in context_len.
//   2. throughput_tok_per_s strictly monotone-DECREASING in context_len.
//   3. 2-component model R² ≥ 0.98 (the load-bearing positive finding).
//   4. 2-component R² > single-power-law R² (physical beats descriptive).
//   5. per-rung 2-component predicted-vs-measured residual ≤ tolerance.
//   6. decode_fixed > 0  (a real positive fixed-decode floor).
//   7. prefill_slope > 0 (prefill cost rises with input length).
//   8. single power-law τ̂ reproduces the falsification's 0.524 (provenance
//      cross-check — same data, same OLS, the negative half is consistent).
//
// EXIT CODES.  0 when all checks pass (🟢 SUPPORTED-NUMERICAL); 1 on any fail.
//
// Run:
//   POOL_DISABLE=1 hexa run verify/numerics_economics_measured_cost_model.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="Pure local verifier; float arithmetic only on committed bench TSV rows. No atlas atoms touched, no model/GPU/API. Positive companion to the F-CODEX-2 falsification — satisfies M3.ECON M5-release OR-branch with a measured cost model.")

use "self/runtime/math_pure"

// ── MEASURED DATA — bench TSV verbatim ───────────────────────────────────
// Source: `.verdicts/sandbox/stage4_context_scaling.tsv` (confirmed row-for-row).
// 4 context rungs: {1k, 2k, 4k, 8k}.
let CONTEXT_LEN = [
    1024.0,   // 1k
    2048.0,   // 2k
    4096.0,   // 4k
    8192.0,   // 8k
]
let WALL_MS = [
    569.0,    // 1k  — mean_wall_ms
    670.0,    // 2k
    1005.0,   // 4k
    1668.0,   // 8k
]
let INPUT_TOKENS = [
    987.0,    // 1k  — mean_input_tokens
    1947.0,   // 2k
    3867.0,   // 4k
    7647.0,   // 8k
]
let THROUGHPUT_TOK_S = [
    22.80,    // 1k  — throughput_tok_per_s
    17.60,    // 2k
    11.98,    // 4k
    7.31,     // 8k
]
let N_RUNGS = 4

// ── tolerances / reference constants ─────────────────────────────────────
let R2_FLOOR_2COMP   = 0.98       // load-bearing 2-component R² gate
let RESID_PCT_TOL    = 8.0        // per-rung |pred−meas|/meas ≤ 8%  (max observed ≈5.8%)
let TAU_FALSIFIED    = 0.523982   // the falsification's log-log OLS slope (provenance)
let TAU_PROV_TOL     = 0.001      // cross-check tolerance vs the falsification fit

// ── helpers ──────────────────────────────────────────────────────────────

let mut RUN = 0
let mut FAIL = 0
let mut FAILURES = []

fn _check(ok: bool, label: str, detail: str) {
    RUN = RUN + 1
    if ok {
        println("  [PASS] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    } else {
        FAIL = FAIL + 1
        FAILURES.push(label + " :: " + detail)
        println("  [FAIL] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    }
}

fn _abs(x: float) -> float { return abs_pure(x) }

fn _mean(xs: [float]) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < xs.len() {
        s = s + xs[i]
        i = i + 1
    }
    return s / (xs.len() as float)
}

// ── model (a): single power-law  wall = a · ctx^τ̂  (log-log OLS) ─────────
// Returns [tau_hat, a].  log-space OLS slope + intercept, intercept exp'd.
fn fit_powerlaw() -> [float] {
    let k = CONTEXT_LEN.len()
    let mut su = 0.0
    let mut sv = 0.0
    let mut suv = 0.0
    let mut suu = 0.0
    let mut i = 0
    while i < k {
        let u = log_pure(CONTEXT_LEN[i])
        let v = log_pure(WALL_MS[i])
        su = su + u
        sv = sv + v
        suv = suv + (u * v)
        suu = suu + (u * u)
        i = i + 1
    }
    let kf = k as float
    let denom = (kf * suu) - (su * su)
    let tau = ((kf * suv) - (su * sv)) / denom
    let b = (sv - (tau * su)) / kf      // log-space intercept
    let a = exp_pure(b)
    return [tau, a]
}

// Linear-space R² of the power-law model on the wall_ms axis.
fn r2_powerlaw(tau: float, a: float) -> float {
    let mean_w = _mean(WALL_MS)
    let mut ss_tot = 0.0
    let mut ss_res = 0.0
    let mut i = 0
    while i < N_RUNGS {
        let pred = a * pow_pure(CONTEXT_LEN[i], tau)
        ss_tot = ss_tot + ((WALL_MS[i] - mean_w) * (WALL_MS[i] - mean_w))
        ss_res = ss_res + ((WALL_MS[i] - pred) * (WALL_MS[i] - pred))
        i = i + 1
    }
    return 1.0 - (ss_res / ss_tot)
}

// ── model (b): 2-component  wall = decode_fixed + prefill_slope·input ────
// OLS on (input_tokens, wall_ms).  Returns [decode_fixed, prefill_slope].
fn fit_2component() -> [float] {
    let k = INPUT_TOKENS.len()
    let mut sx = 0.0
    let mut sy = 0.0
    let mut sxy = 0.0
    let mut sxx = 0.0
    let mut i = 0
    while i < k {
        let x = INPUT_TOKENS[i]
        let y = WALL_MS[i]
        sx = sx + x
        sy = sy + y
        sxy = sxy + (x * y)
        sxx = sxx + (x * x)
        i = i + 1
    }
    let kf = k as float
    let denom = (kf * sxx) - (sx * sx)
    let slope = ((kf * sxy) - (sx * sy)) / denom
    let intercept = (sy - (slope * sx)) / kf
    return [intercept, slope]   // decode_fixed, prefill_slope
}

fn pred_2component(decode_fixed: float, prefill_slope: float, idx: int) -> float {
    return decode_fixed + (prefill_slope * INPUT_TOKENS[idx])
}

fn r2_2component(decode_fixed: float, prefill_slope: float) -> float {
    let mean_w = _mean(WALL_MS)
    let mut ss_tot = 0.0
    let mut ss_res = 0.0
    let mut i = 0
    while i < N_RUNGS {
        let pred = pred_2component(decode_fixed, prefill_slope, i)
        ss_tot = ss_tot + ((WALL_MS[i] - mean_w) * (WALL_MS[i] - mean_w))
        ss_res = ss_res + ((WALL_MS[i] - pred) * (WALL_MS[i] - pred))
        i = i + 1
    }
    return 1.0 - (ss_res / ss_tot)
}

// ── checks ───────────────────────────────────────────────────────────────

// Check 1: wall_ms strictly monotone-increasing in context_len.
fn check_wall_monotone_up() {
    let mut ok = true
    let mut bad = -1
    let mut i = 1
    while i < N_RUNGS {
        if !(WALL_MS[i] > WALL_MS[i - 1]) {
            ok = false
            if bad < 0 { bad = i }
        }
        i = i + 1
    }
    _check(ok,
           "wall_ms strictly monotone-increasing with context_len (569<670<1005<1668)",
           "first_violation_at=" + str(bad))
}

// Check 2: throughput strictly monotone-DECREASING in context_len.
fn check_throughput_monotone_down() {
    let mut ok = true
    let mut bad = -1
    let mut i = 1
    while i < N_RUNGS {
        if !(THROUGHPUT_TOK_S[i] < THROUGHPUT_TOK_S[i - 1]) {
            ok = false
            if bad < 0 { bad = i }
        }
        i = i + 1
    }
    _check(ok,
           "throughput_tok_per_s strictly monotone-decreasing with context_len (22.80>17.60>11.98>7.31)",
           "first_violation_at=" + str(bad))
}

// Check 3: 2-component R² ≥ 0.98 — the load-bearing positive finding.
fn check_2comp_r2_floor(r2: float) {
    _check(r2 >= R2_FLOOR_2COMP,
           "2-component model R² ≥ 0.98 (measured cost model fits the curve)",
           "r2_2comp=" + to_string(r2) + "  floor=" + to_string(R2_FLOOR_2COMP))
}

// Check 4: 2-component R² > single power-law R² (physical beats descriptive).
fn check_2comp_beats_powerlaw(r2_2: float, r2_pow: float) {
    _check(r2_2 > r2_pow,
           "2-component R² > single-power-law R² (decode-fixed + linear-prefill beats pure ctx^τ̂)",
           "r2_2comp=" + to_string(r2_2) + "  r2_powerlaw=" + to_string(r2_pow) +
           "  delta=" + to_string(r2_2 - r2_pow))
}

// Check 5: per-rung 2-component residual ≤ tolerance (% of measured).
fn check_2comp_per_rung_residual(decode_fixed: float, prefill_slope: float) {
    let mut ok = true
    let mut worst = 0.0
    let mut worst_at = -1
    let mut i = 0
    while i < N_RUNGS {
        let pred = pred_2component(decode_fixed, prefill_slope, i)
        let pct = (_abs(pred - WALL_MS[i]) / WALL_MS[i]) * 100.0
        if pct > worst {
            worst = pct
            worst_at = i
        }
        if pct > RESID_PCT_TOL { ok = false }
        i = i + 1
    }
    _check(ok,
           "per-rung 2-component predicted-vs-measured residual ≤ " + to_string(RESID_PCT_TOL) + "%",
           "worst_pct=" + to_string(worst) + "  at_rung_idx=" + str(worst_at) +
           "  tol=" + to_string(RESID_PCT_TOL))
}

// Check 6: decode_fixed > 0 — a real positive fixed-decode floor.
fn check_decode_fixed_positive(decode_fixed: float) {
    _check(decode_fixed > 0.0,
           "decode_fixed > 0 (context-invariant fixed-decode floor, mem-bandwidth wall)",
           "decode_fixed=" + to_string(decode_fixed) + " ms")
}

// Check 7: prefill_slope > 0 — prefill cost rises with input length.
fn check_prefill_slope_positive(prefill_slope: float) {
    _check(prefill_slope > 0.0,
           "prefill_slope > 0 (prefill TTFT linear in input_tokens, paged-attention regime)",
           "prefill_slope=" + to_string(prefill_slope) + " ms/tok")
}

// Check 8: single power-law τ̂ reproduces the falsification's 0.524.
fn check_powerlaw_tau_provenance(tau: float) {
    let drift = _abs(tau - TAU_FALSIFIED)
    _check(drift < TAU_PROV_TOL,
           "single power-law τ̂ reproduces F-CODEX-2 falsification fit (0.524) — same data, same OLS",
           "tau_hat=" + to_string(tau) + "  falsified_ref=" + to_string(TAU_FALSIFIED) +
           "  drift=" + to_string(drift))
}

// ── main ─────────────────────────────────────────────────────────────────

fn main() {
    println("========================================================================")
    println("  hexa-codex ECONOMICS measured-cost-model harness — M3.ECON OR-branch")
    println("  POSITIVE companion to the F-CODEX-2 falsification (τ=4 → measured law)")
    println("  cycle-18: wall_ms = decode_fixed + prefill_slope·input_tokens (OLS)")
    println("========================================================================")
    println("  data source: .verdicts/sandbox/stage4_context_scaling.tsv (verbatim)")
    println("  Qwen2.5-1.5B-Instruct-Q4_K_M · mac-mini-m3 Metal · -np 1 -cb · $0 · accuracy 17/20 flat")
    println("")

    // Fit both models.
    let pw = fit_powerlaw()
    let tau = pw[0]
    let a   = pw[1]
    let r2_pow = r2_powerlaw(tau, a)

    let cm = fit_2component()
    let decode_fixed  = cm[0]
    let prefill_slope = cm[1]
    let r2_2 = r2_2component(decode_fixed, prefill_slope)

    println("  ── model (a) single power-law: wall_ms = a · context^τ̂")
    println("       τ̂ = " + to_string(tau) + "   a = " + to_string(a) +
            "   R²(linear) = " + to_string(r2_pow))
    println("  ── model (b) 2-component:      wall_ms = decode_fixed + prefill_slope·input_tokens")
    println("       decode_fixed  = " + to_string(decode_fixed) + " ms")
    println("       prefill_slope = " + to_string(prefill_slope) + " ms/tok")
    println("       R²(linear)    = " + to_string(r2_2))
    println("")
    println("  per-rung fit table (ctx · input_tok · measured · pred_2comp · pred_pow):")
    let mut i = 0
    while i < N_RUNGS {
        let p2 = pred_2component(decode_fixed, prefill_slope, i)
        let pp = a * pow_pure(CONTEXT_LEN[i], tau)
        println("    ctx=" + to_string(CONTEXT_LEN[i]) +
                "  in_tok=" + to_string(INPUT_TOKENS[i]) +
                "  meas=" + to_string(WALL_MS[i]) +
                "  2comp=" + to_string(p2) +
                "  pow=" + to_string(pp))
        i = i + 1
    }
    println("")

    check_wall_monotone_up()
    check_throughput_monotone_down()
    check_2comp_r2_floor(r2_2)
    check_2comp_beats_powerlaw(r2_2, r2_pow)
    check_2comp_per_rung_residual(decode_fixed, prefill_slope)
    check_decode_fixed_positive(decode_fixed)
    check_prefill_slope_positive(prefill_slope)
    check_powerlaw_tau_provenance(tau)

    println("")
    println("========================================================================")
    let pass_n = RUN - FAIL
    println("  " + str(pass_n) + "/" + str(RUN) + " checks passed")
    if FAIL > 0 {
        println("  FAILURES:")
        for ff in FAILURES { println("    ✗ " + ff) }
        println("__HEXA_CODEX_NUMERICS_ECONOMICS_MEASURED_COST_MODEL__ FAIL")
        exit(1)
    }
    println("  🟢 SUPPORTED-NUMERICAL — measured 2-component cost model landed")
    println("  · wall_ms = " + to_string(decode_fixed) + " + " + to_string(prefill_slope) +
            "·input_tokens   (R²=" + to_string(r2_2) + ")")
    println("  · beats single power-law (R²=" + to_string(r2_pow) +
            ", τ̂=" + to_string(tau) + " — the falsified n=6 τ=4 fit)")
    println("  · M3.ECON M5-release OR-branch satisfied with a REAL measured law")
    println("__HEXA_CODEX_NUMERICS_ECONOMICS_MEASURED_COST_MODEL__ PASS")
    exit(0)
}
