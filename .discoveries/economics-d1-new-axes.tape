@V := "tape" :: spec [active]
  version = "1.2"

@I := "discoveries-log" :: identity [active]
  slug   = "economics-d1-new-axes"
  source = "ECONOMICS perpetual axis D1 — '신규 비용 축 seed' first sweep (cycle-26, lane E4)"
  date   = "2026-05-26"
  flow   = "perpetual-frontier-retrofit -> D1 (new cost axes the metered-API can not expose) seed batch (cx_discovery_log)"

# ════════════════════════════════════════════════════════════════════
# CONTEXT — what ECONOMICS D1 is and how it relates to SANDBOX P4
# ════════════════════════════════════════════════════════════════════
# ECONOMICS.md §축 D — 신규 비용 축 (seed 백로그) D1 = "토큰당 에너지/$ ·
# KV-cache 비용곡선 · speculative-decoding 비용모델 — 새 falsifiable 축
# seed → .discoveries/". This tape is the first concrete population of
# that lane in the wake of the perpetual-frontier retrofit (PR #66).
#
# Relation to SANDBOX P4 (.discoveries/sandbox-p4-new-axes.tape, cycle-21):
# P4 is the SUBSTRATE-PHYSICS view of the same physical surface (J/tok,
# spec-decode speedup, KV-cache, batching, quant-band).  D1 is the
# COST-AXIS REFRAMING — every D1 seed multiplies the P4 physical quantity
# by an economic anchor ($/kWh local, GPU $/hr amortized, deployment
# lifetime, batch saturation) to land at $/tok or $/decoded-token.
#
# Sibling pairings:
#   d_econ_d1_energy_per_dollar             ↔ d_p4_energy_per_token       (P4 J/tok × $/kWh)
#   d_econ_d1_speculative_decoding_$_saving ↔ d_p4_speculative_decoding   (P4 speedup s × $/tok)
#   d_econ_d1_kv_cache_amortization         ↔ d_p4_kv_eviction_attention_sink (P4 cache policy × $)
#   d_econ_d1_continuous_batching_$_eff     ↔ d_p4_quantization_band_ladder + vLLM (P4 saturation × $/hr)
#   d_econ_d1_inference_amortization_envelope (NEW — no P4 sibling; pure cost-axis)
#
# Falsifier discipline (cx_lab_falsifiable + feedback_negative_paper_external_claim):
# every seed names an INDEPENDENT external anchor (Leviathan-Kalman 2023,
# Hoffmann 2022 Chinchilla, Sardana 2024 "Beyond Chinchilla", Kwon 2023
# vLLM/PagedAttention, Xiao 2024 StreamingLLM) so the falsifier targets a
# published cost-side claim rather than a self-generated strawman.

@C d_econ_d1_energy_per_dollar := "J/tok × ($/kWh + GPU $/hr) → $/tok at substrate (NEW cost-axis combining energy with electricity + amortized hardware)" :: seed [verified_tier_target=GREEN status=open]
  cmd     = "harness bench/economics_d1_energy_per_dollar.hexa — reuse the per-token energy curve from SANDBOX P4 d_p4_energy_per_token (J/tok per quant band from ubu-1 nvidia-smi --query-gpu=power.draw --loop-ms=100); multiply by (a) local US average $/kWh = $0.16 (EIA 2025 residential) and (b) GPU $/hr amortized over a 3-yr depreciation window for A100-40GB ($0.48/hr Vast.ai spot, reference reference_vastai_cli); ladder 4 quant bands {Q3_K_M, Q4_K_M, Q6_K, Q8_0} on Qwen2.5-1.5B with the Stage-2 N=200 manifest; recompute by verify/numerics_economics_d1_energy_per_dollar.hexa producing $/tok = (J/tok × $/kWh / 3.6e6) + (GPU_$_per_hr / tok_per_hr_throughput)"
  hyp     = "$/tok decreases monotonically Q8→Q4 with a knee at Q4 — i.e. $/tok(Q4) ≤ 0.5 × $/tok(Q8) — confirming Q4 default is COST-justified (not only accuracy-justified) on a self-hosted substrate"
  verdict = "PENDING — first cost-axis probe combining substrate energy + electricity + amortized hardware. The cost split is dominated by GPU $/hr at low batch (idle GPU pays full $/hr regardless of token throughput), and by J/tok × $/kWh only above the throughput knee. Falsifier: if $/tok does NOT decrease >2× going Q8→Q4 on the same hardware, then Q4 default is NOT cost-justified — quantization is purely an ACCURACY/memory-footprint trade and the SANDBOX/ECONOMICS guideline 'Q4 = default' needs requalification with an accuracy-only justification. External anchor: EIA 2025 residential $/kWh + Vast.ai spot A100 $/hr (independent published rates, not self-generated)."

@C d_econ_d1_speculative_decoding_dollar_saving := "Leviathan-Kalman speedup s × baseline $/tok → $/tok with speculative decoding (NEW cost-axis — speedup ≠ saving when α is low)" :: seed [verified_tier_target=GREEN status=open]
  cmd     = "harness bench/economics_d1_speculative_decoding_dollar_saving.hexa — reuse SANDBOX P4 d_p4_speculative_decoding measured wall-ms-per-token + acceptance-rate α on the same 4 manifest classes (arith / definition / long-form / code) with Qwen2.5-3B-Instruct-Q4_K_M target + Qwen2.5-0.5B-Instruct-Q4_K_M draft at draft-len N ∈ {4, 8, 16}; convert to $/tok = (wall_ms × GPU_$_per_hr / 3.6e6) and INCLUDE draft-model GPU residency (draft model occupies GPU memory during the verify phase, blocking other workloads → opportunity-cost addition c_draft × $/hr); recompute by verify/numerics_economics_d1_spec_dec_$.hexa against the cost-model $/tok_spec = $/tok_target × (1/s) + c_draft × $/hr where s = (1 − α^(N+1))/((1 − α)·(c·N + 1)) from Leviathan-Kalman 2023"
  hyp     = "speculative decoding gives ≥1.5× $/tok reduction over baseline target-only decoding ONLY when α ≥ 0.6 AND draft model is co-resident (no extra GPU pulled in); at α < 0.4 the draft model's GPU residency overhead OUTWEIGHS the speedup and $/tok INCREASES"
  verdict = "PENDING — distinct from P4's pure speedup measurement: P4 verifies the speedup law, D1 verifies the COST law (speedup is necessary but not sufficient for $/tok reduction once draft-model residency is priced in). Falsifier: if measured $/tok INCREASES at any α < 0.4 (low-acceptance prompt class — e.g. code/long-form with high lexical novelty), then the deployment guideline 'enable speculative-decoding by default' is FALSIFIED at the cost axis even when the physical speedup is positive — speculative-decoding becomes a per-prompt-class routing decision, not a global toggle. External anchor: Leviathan & Kalman, 'Fast Inference from Transformers via Speculative Decoding' (ICML 2023, https://arxiv.org/abs/2211.17192) — the published speedup law is INDEPENDENT of the cost-axis claim being tested here."

@C d_econ_d1_kv_cache_amortization := "KV-cache reuse shifts dominant cost from compute to memory bandwidth at long context → $/decoded-token curve (NEW cost-axis — context-length cost regime change)" :: seed [verified_tier_target=GREEN status=open]
  cmd     = "harness bench/economics_d1_kv_cache_amortization.hexa — measure $/decoded-token across 5 context rungs {1k, 2k, 4k, 8k, 16k} on Qwen2.5-1.5B-Q4_K_M with prefix-cached vs cold-start dispatch (llama-server --prompt-cache <file> reuses KV across same-prefix requests); fix decode length at 128 tok per request, vary prefix length; measure (a) wall_ms_per_decoded_token, (b) effective $/decoded-token = wall_ms × GPU_$_per_hr / 3.6e6, (c) memory bandwidth utilization (nvidia-smi dmon -s u --count 30) to identify compute-vs-bandwidth regime; recompute by verify/numerics_economics_d1_kv_amortize.hexa against the closed-form $/tok_decode_with_cache = (compute_cost / decode_tokens) + (bandwidth_cost × kv_size_bytes / decode_tokens) where bandwidth_cost dominates above a crossover context length L*"
  hyp     = "KV-cache reuse cuts $/decoded-token by ≥10× at context = 4k (prefix amortized over many decodes) BUT the marginal saving plateaus above L* ≈ 16k as memory-bandwidth-bound KV transfer dominates compute — i.e. the $/decoded-token curve is U-shaped against context length when cache reuse is held fixed"
  verdict = "PENDING — D1's cost-axis lens on P4's cache-policy axis (P4 measures recall vs eviction; D1 measures $ vs context-length regime change). The crossover L* is hardware-specific (A100 HBM2e ≈ 1.5 TB/s; Qwen2.5-1.5B Q4_K_M KV ≈ 0.13 MB/tok at fp16 K/V) — closed-form prediction L* ≈ compute_per_tok / (bandwidth_per_byte × KV_bytes_per_tok). Falsifier: if KV-cache reuse saving does NOT plateau or worsen past L* on real hardware (i.e. $/tok keeps decreasing with longer context indefinitely), the bandwidth-wall claim is FALSIFIED and KV-cache-aware routing should be a no-op at any context budget — the operational guideline shifts to 'always extend context'. External anchor: Xiao et al., 'Efficient Streaming Language Models with Attention Sinks' (ICLR 2024, https://arxiv.org/abs/2309.17453) characterizes the eviction-policy frontier; Pope et al., 'Efficiently Scaling Transformer Inference' (MLSys 2023, https://arxiv.org/abs/2211.05102) establishes the memory-bandwidth-bound regime for decode."

@C d_econ_d1_continuous_batching_dollar_efficiency := "vLLM/paged-attention continuous-batching cost-efficiency (saturated throughput / hardware $/hr) → $/tok saturation curve vs batch size (NEW cost-axis — saturation knee on $/hr basis, not just tok/s basis)" :: seed [verified_tier_target=GREEN status=open]
  cmd     = "harness bench/economics_d1_continuous_batching_$_eff.hexa — vLLM 0.7.3 (from the lm_foundry GRPO stack on ubu-1) serving Qwen2.5-1.5B-Q4_K_M with concurrent_requests ∈ {1, 2, 4, 8, 16, 32, 64}; for each B measure (a) sat_throughput_tok_per_sec, (b) GPU_$_per_hr (A100-40GB Vast.ai spot $0.48/hr, reference reference_vastai_cli), (c) cost_efficiency_$_per_Mtok = (GPU_$_per_hr × 1e6) / (sat_throughput × 3600); identify the cost-efficiency knee B* where adding more concurrency yields <10% additional $/Mtok improvement; recompute by verify/numerics_economics_d1_batching_pareto.hexa fitting the closed-form $/Mtok(B) = α + β/B + γ·max(0, B − B_mem_wall) where B_mem_wall is the memory-bandwidth wall above which throughput stops scaling"
  hyp     = "cost-efficiency $/Mtok improves monotonically with batch B up to a knee B* (predicted B* ≈ 16 for Qwen2.5-1.5B on A100-40GB based on HBM2e bandwidth × KV-cache footprint per slot) and PLATEAUS thereafter regardless of more GPU added — i.e. the memory bandwidth wall sets the cost-efficiency ceiling, not raw compute"
  verdict = "PENDING — D1's cost-axis reframing of vLLM throughput claims (Kwon et al. PagedAttention 2023): the published throughput curves are tok/s vs batch, not $/Mtok vs batch — the cost-axis turn changes the optimal operating point from 'max batch' to 'batch at knee, then add GPUs for latency only'. Falsifier: if $/Mtok keeps improving (>10% drop per doubling) past B = 64 on a single A100-40GB, the memory-bandwidth-wall claim is FALSIFIED for this model size and the operational guideline shifts to 'push batch as high as VRAM allows'. Conversely, if the knee sits at B* ≤ 4 (much earlier than predicted), then continuous-batching's cost advantage over naive sync dispatch is materially smaller than headline tok/s numbers suggest — a published-claim refutation. External anchor: Kwon et al., 'Efficient Memory Management for Large Language Model Serving with PagedAttention' (SOSP 2023, https://arxiv.org/abs/2309.06180) — vLLM's published throughput curves are the INDEPENDENT claim being reframed at the cost axis."

@C d_econ_d1_inference_amortization_envelope := "Sardana 'Beyond Chinchilla' inference-amortized optimal model size — total training+inference $ over N-month deployment → different optimal N vs Chinchilla compute-only (NEW cost-axis with NO P4 physics sibling)" :: seed [verified_tier_target=BLUE status=open]
  cmd     = "harness verify/numerics_economics_d1_sardana_envelope.hexa — closed-form recomputation of Sardana et al. 2024 inference-aware scaling law: minimize total_cost(N, D, T_inf) = C_train(N, D) + T_inf × C_inf_per_tok(N) subject to fixed loss target L*, where C_train uses Chinchilla's C ≈ 6ND and C_inf_per_tok(N) is the per-token inference FLOP cost ≈ 2N; sweep T_inf ∈ {1e9, 1e10, 1e11, 1e12, 1e13} tokens (1B → 10T inference tokens over deployment lifetime); compute N* that minimizes total cost at each T_inf and compare against Chinchilla's compute-optimal N_chinchilla(D) for the same training budget; recompute on a reference grid using Sardana 2024 Table 2 closed-form to verify the harness matches published N* values within ε = 5%"
  hyp     = "Sardana-optimal N* is MEANINGFULLY SMALLER than Chinchilla-optimal N at any production inference volume T_inf ≥ 1e11 tokens (~3 months of moderate API serving at 30M tok/day) — i.e. the cost-optimal production model is SMALLER and TRAINED LONGER (more D per N) than the Chinchilla compute-optimal point because inference cost scales linearly with N over the deployment lifetime while training cost is paid once"
  verdict = "PENDING — distinct cost-axis seed with NO P4 physics sibling (pure economics; T_BLUE recompute, no substrate run needed). The recompute target is closed-form; the cheapest first probe is a 5-point grid sweep on the published Sardana 2024 formula with verification against their Table 2 values. Falsifier: if N*_Sardana = N_Chinchilla within ε = 5% across all T_inf ≥ 1e9 (i.e. inference volume does not move the optimum), then Sardana's central claim is FALSIFIED on its own formulation and the ECONOMICS group should KEEP Chinchilla as the optimization target for production-scale training. Conversely, if N*_Sardana < 0.5 × N_Chinchilla at T_inf ≥ 1e11, the ECONOMICS group MUST reject Chinchilla as the optimization target for any production deployment — the falsification is bidirectional and decisive. External anchor: Sardana, Portes, Doubov & Frankle, 'Beyond Chinchilla-Optimal: Accounting for Inference in Language Model Scaling Laws' (ICML 2024, https://arxiv.org/abs/2401.00448); Hoffmann et al., 'Training Compute-Optimal Large Language Models' (NeurIPS 2022, https://arxiv.org/abs/2203.15556) — Chinchilla — is the independent claim being challenged."
