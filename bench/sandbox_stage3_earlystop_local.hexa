#!hexa strict
// SCORER FIX 2026-05-23: strip stderr [end of text] + common_perf_print trailer
// per cycle-4 finding (commit d79306e). The line-based awk already stripped
// common_perf_print lines, but the inline `[end of text]` marker (and any
// trailer content on the same line) leaked into the substring scorer. Adding
// sed strip for full parity with sandbox_stage3_maxtokens_cap.hexa. Old
// verdict in git history.
//
// bench/sandbox_stage3_earlystop_local.hexa — SANDBOX Stage 3 PoC: local stop-sequence A/B.
//
// QUESTION: cycle-2 `d_early_stop` was BLOCKED at the `claude --bare -p`
// 2.1.150 dispatch surface (no `--stop-sequences` flag). With SANDBOX Stage 0
// live (Qwen2.5-0.5B-Instruct-Q4_K_M on llama.cpp, 19/20 @ $0), the same
// lever is testable locally — `llama-completion` exposes stop-sequence
// control via `-r/--reverse-prompt`.
//
// Strategies (× 20 canonical manifest tasks each):
//   nostop          — no -r; equivalent to Stage 0 baseline
//   stop_dblnl      — -r "\n\n" (paragraph break)
//   stop_dot        — -r "." (first sentence end)
//   stop_eos_marker — prompt prepends `Answer with "FINAL: <answer>".`,
//                     then -r "\n" (trailing line)
//
// Scorer: byte_exact_subset on expected_kw, case-insensitive — parity with
// Stage 0. For stop_eos_marker the expected_kw still needs to appear in
// the answer body for the row to be correct.
//
// Output:
//   .verdicts/sandbox/stage3_earlystop_local.tsv         (per-task per-strategy rows)
//   .verdicts/sandbox/stage3_earlystop_local_summary.txt (per-strategy aggregate + verdict)
//
// Run:
//   HEXA_SHIM_NO_DARWIN_LANDING=1 RESOURCE_LOCAL_HEXA=1 \
//     HEXA_CODEX_ROOT="$PWD" \
//     ~/.hx/packages/hexa/hexa.real run bench/sandbox_stage3_earlystop_local.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="External CLI subprocess (llama-completion) + filesystem write — no atlas atoms touched.")

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()
let OUT_DIR = ROOT + "/.verdicts/sandbox"
let MODEL_PATH = HOME + "/Models/gguf/Qwen2.5-0.5B-Instruct-Q4_K_M.gguf"
let MODEL_NAME = "Qwen2.5-0.5B-Instruct-Q4_K_M"
let MAX_TOK = 96   // parity with Stage 0

// 20-task fixed manifest — verbatim from bench/sandbox_stage0_baseline.hexa.
let TASKS = [
    ["What is 2+2? Reply with the digit only.",                                                    "4"],
    ["Capital of France? One word.",                                                                "paris"],
    ["Reverse the string 'hello'. Reply with the reversed string only.",                            "olleh"],
    ["Square of 7? Reply with the number only.",                                                    "49"],
    ["First prime number greater than 10? Reply with the number only.",                             "11"],
    ["Smallest prime number? Reply with the number only.",                                          "2"],
    ["How many continents? Reply with the number only.",                                            "7"],
    ["Boiling point of water in Celsius at sea level? Reply with the number only.",                 "100"],
    ["ASCII decimal code for 'A'? Reply with the number only.",                                     "65"],
    ["Days in February 2024? Reply with the number only.",                                          "29"],
    ["Write a Python one-liner that sums integers 1..100. Reply with code only.",                   "sum(range"],
    ["Time complexity of binary search? Reply with big-O only.",                                    "log n"],
    ["Python: reverse a list lst in one expression. Reply with the expression only.",               "[::-1]"],
    ["Sort {3,1,2} ascending. Reply with the result only.",                                         "1, 2, 3"],
    ["TCP vs UDP in one sentence — which is connection-oriented?",                                  "tcp"],
    ["Explain BFS vs DFS in 2 sentences.",                                                          "breadth"],
    ["Write Python Fibonacci with memoization (use functools.cache).",                              "fib"],
    ["Convert binary 1101 to decimal, show one-line sum.",                                          "13"],
    ["Why is mergesort O(n log n) ? One-sentence justification.",                                   "merge"],
    ["Halting problem — what is it? One sentence.",                                                 "halt"],
]

// strategy ↦ [prompt_prefix, reverse_prompt_arg]
//   reverse_prompt_arg empty means "no -r flag"
let STRATEGIES = [
    ["nostop",          "",                            ""],
    ["stop_dblnl",      "",                            "\n\n"],
    ["stop_dot",        "",                            "."],
    ["stop_eos_marker", "Answer with \"FINAL: <answer>\".\n",   "\n"],
]

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn avg(sum: int, n: int) -> int {
    if n <= 0 { return 0 }
    return sum / n
}

// Run one task under one strategy. Returns tab-separated:
//   wall_ms \t output_tok_est \t correct(1|0) \t output_snippet
fn run_one(prompt: str, expected_kw: str, prompt_prefix: str, rstop: str) -> str {
    let full_prompt = prompt_prefix + prompt
    let mut rflag = ""
    if rstop.len() > 0 {
        rflag = " -r " + shq(rstop)
    }
    let cmd = "t_start=$(date +%s%N); " +
              "out=$(llama-completion -m " + shq(MODEL_PATH) +
              " -p " + shq(full_prompt) +
              " -n " + str(MAX_TOK) + " --temp 0 -st" + rflag + " 2>&1); " +
              "t_end=$(date +%s%N); " +
              "wall_ms=$(( (t_end - t_start) / 1000000 )); " +
              "ans_raw=$(printf '%s\\n' \"$out\" | awk '/^assistant$/{flag=1; next} /^> EOF by user/{flag=0} /^common_perf_print/{flag=0} flag{print}' | tr '\\n' ' ' | sed 's/  */ /g; s/^ //; s/ $//'); " +
              // SCORER FIX 2026-05-23: strip inline [end of text] + any common_perf_print residue for honest scoring
              "ans=$(printf '%s' \"$ans_raw\" | sed 's/ *\\[end of text\\].*$//' | sed 's/ *common_perf_print:.*$//'); " +
              "tok_est=$(printf '%s' \"$ans\" | wc -w | tr -d ' '); " +
              "low=$(printf '%s' \"$ans\" | tr 'A-Z' 'a-z'); " +
              "kw=$(printf '%s' " + shq(expected_kw) + " | tr 'A-Z' 'a-z'); " +
              "if printf '%s' \"$low\" | grep -qF \"$kw\"; then correct=1; else correct=0; fi; " +
              "snippet=$(printf '%s' \"$ans\" | cut -c1-120); " +
              "if [ -z \"$snippet\" ]; then snippet='(empty)'; fi; " +
              "printf '%s\\t%s\\t%s\\t%s' \"$wall_ms\" \"$tok_est\" \"$correct\" \"$snippet\""
    return exec(cmd).trim()
}

fn main() {
    println("========================================================================")
    println("  bench/sandbox_stage3_earlystop_local — local stop-sequence A/B")
    println("  model:    " + MODEL_NAME)
    println("  tool:     llama-completion (-r reverse-prompt = stop-sequence)")
    println("  manifest: 20 tasks (verbatim Stage 0)")
    println("  strategies: nostop | stop_dblnl | stop_dot | stop_eos_marker")
    println("========================================================================")

    exec("mkdir -p " + shq(OUT_DIR))
    let tsv_path = OUT_DIR + "/stage3_earlystop_local.tsv"
    exec("rm -f " + shq(tsv_path))
    exec("echo 'strategy\tidx\toutput_tok_est\twall_ms\tcorrect\toutput_snippet' >> " + shq(tsv_path))

    // Aggregates indexed by strategy index (parallel arrays grown to fit).
    let n_strategies = len(STRATEGIES)
    let n_tasks = len(TASKS)
    let mut sum_ms = []
    let mut sum_tok = []
    let mut n_correct = []
    let mut k = 0
    while k < n_strategies {
        sum_ms = sum_ms + [0]
        sum_tok = sum_tok + [0]
        n_correct = n_correct + [0]
        k = k + 1
    }

    let mut s = 0
    while s < n_strategies {
        let strat = STRATEGIES[s]
        let strat_name = strat[0]
        let prompt_prefix = strat[1]
        let rstop = strat[2]
        println("")
        println("---- strategy " + str(s+1) + "/" + str(n_strategies) + ": " + strat_name + " ----")
        let mut i = 0
        while i < n_tasks {
            let task = TASKS[i]
            let prompt = task[0]
            let expected = task[1]
            let line = run_one(prompt, expected, prompt_prefix, rstop)
            let parts = line.split("\t")
            if parts.len() < 4 {
                println("  ! parse error idx=" + str(i+1) + " raw=" + line.substr(0, 80))
                let bad = strat_name + "\t" + str(i+1) + "\t0\t0\t0\tPARSE_ERROR:" + line.substr(0, 80)
                exec("echo " + shq(bad) + " >> " + shq(tsv_path))
                i = i + 1
                continue
            }
            let wall_ms = int(parts[0])
            let tok_est_str = parts[1]
            let correct = parts[2]
            let snippet = parts[3].replace("\t", " ")
            let mut tok_est = 0
            if tok_est_str.len() > 0 { tok_est = int(tok_est_str) }
            sum_ms[s] = sum_ms[s] + wall_ms
            sum_tok[s] = sum_tok[s] + tok_est
            if correct == "1" { n_correct[s] = n_correct[s] + 1 }
            let row = strat_name + "\t" + str(i+1) + "\t" + str(tok_est) + "\t" + str(wall_ms) + "\t" + correct + "\t" + snippet.substr(0, 120)
            exec("echo " + shq(row) + " >> " + shq(tsv_path))
            println("  [" + str(i+1) + "/20] kw=" + expected + " wall_ms=" + str(wall_ms) + " tok=" + str(tok_est) + " correct=" + correct + " ans=" + snippet.substr(0, 50))
            i = i + 1
        }
        println("  -> " + strat_name + ": correct=" + str(n_correct[s]) + "/20 total_wall_ms=" + str(sum_ms[s]) + " sum_tok=" + str(sum_tok[s]))
        s = s + 1
    }

    // Compute per-strategy averages and select best.
    // Best = highest saving (lowest total_wall_ms) among strategies with accuracy >= nostop.
    let nostop_idx = 0
    let nostop_acc = n_correct[nostop_idx]
    let nostop_ms = sum_ms[nostop_idx]
    let nostop_tok = sum_tok[nostop_idx]
    let mut best_idx = nostop_idx
    let mut best_ms = nostop_ms
    let mut s2 = 1
    while s2 < n_strategies {
        if n_correct[s2] >= nostop_acc {
            if sum_ms[s2] < best_ms {
                best_ms = sum_ms[s2]
                best_idx = s2
            }
        }
        s2 = s2 + 1
    }
    let best_name = STRATEGIES[best_idx][0]
    let best_acc = n_correct[best_idx]
    let best_tok = sum_tok[best_idx]
    let accuracy_preserved_str = "false"
    if best_acc >= nostop_acc { accuracy_preserved_str = "true" }

    // % reduction × 100 for integer rendering (e.g. 4237 = 42.37%).
    let mut wall_red_x100 = 0
    if nostop_ms > 0 { wall_red_x100 = ((nostop_ms - best_ms) * 10000) / nostop_ms }
    let mut tok_red_x100 = 0
    if nostop_tok > 0 { tok_red_x100 = ((nostop_tok - best_tok) * 10000) / nostop_tok }

    println("")
    println("========================================================================")
    println("  SUMMARY — Stage 3 early-stop local")
    println("========================================================================")
    let mut s3 = 0
    while s3 < n_strategies {
        let name = STRATEGIES[s3][0]
        println("  " + name + ": correct=" + str(n_correct[s3]) + "/20 total_wall_ms=" + str(sum_ms[s3]) + " avg_out_tok=" + str(avg(sum_tok[s3], n_tasks)))
        s3 = s3 + 1
    }
    println("")
    println("  best_strategy           : " + best_name)
    println("  best_accuracy           : " + str(best_acc) + "/20")
    println("  wall_ms_reduction_pct   : " + str(wall_red_x100 / 100) + "." + str(wall_red_x100 % 100) + "%")
    println("  output_tok_reduction_pct: " + str(tok_red_x100 / 100) + "." + str(tok_red_x100 % 100) + "%")
    println("  accuracy_preserved      : " + accuracy_preserved_str)
    println("")

    let summary_path = OUT_DIR + "/stage3_earlystop_local_summary.txt"
    exec("rm -f " + shq(summary_path))
    exec("echo " + shq("# model=" + MODEL_NAME) + " >> " + shq(summary_path))
    exec("echo " + shq("# manifest=20 (canonical, verbatim Stage 0)") + " >> " + shq(summary_path))
    exec("echo " + shq("# tool=llama-completion (-r reverse-prompt)") + " >> " + shq(summary_path))
    let mut s4 = 0
    while s4 < n_strategies {
        let name = STRATEGIES[s4][0]
        exec("echo " + shq("# " + name + "_accuracy=" + str(n_correct[s4]) + "/20") + " >> " + shq(summary_path))
        exec("echo " + shq("# " + name + "_total_wall_ms=" + str(sum_ms[s4])) + " >> " + shq(summary_path))
        exec("echo " + shq("# " + name + "_avg_out_tok_est=" + str(avg(sum_tok[s4], n_tasks))) + " >> " + shq(summary_path))
        s4 = s4 + 1
    }
    exec("echo " + shq("# best_strategy=" + best_name) + " >> " + shq(summary_path))
    exec("echo " + shq("# output_tok_reduction_pct=" + str(tok_red_x100 / 100) + "." + str(tok_red_x100 % 100)) + " >> " + shq(summary_path))
    exec("echo " + shq("# wall_ms_reduction_pct=" + str(wall_red_x100 / 100) + "." + str(wall_red_x100 % 100)) + " >> " + shq(summary_path))
    exec("echo " + shq("# accuracy_preserved=" + accuracy_preserved_str) + " >> " + shq(summary_path))
    exec("echo " + shq("# host=mac-mini-m3 (brew llama.cpp + Metal)") + " >> " + shq(summary_path))
    exec("echo " + shq("# cost_usd=0  (local serving; wall_ms is the proxy cost surface)") + " >> " + shq(summary_path))

    println("  tsv     persisted: " + tsv_path)
    println("  summary persisted: " + summary_path)
    println("")
    println("__HEXA_CODEX_BENCH_SANDBOX_STAGE3_EARLYSTOP_LOCAL__ PASS")
    exit(0)
}
