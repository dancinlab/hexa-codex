#!hexa strict
// LONG-CONTEXT/verify/numerics_long_context_a1_niah_drop.hexa
// LONG-CONTEXT A1 — closed-form verifier for NIAH drop_ratio identity.
//
// Asserts the ratio identity + monotone-drop sanity + threshold:
//   (1) drop_ratio identity (acc_64k × 1000 / acc_4k) for all models
//   (2) all acc ∈ [0, 100] (NIAH percentage range)
//   (3) baseline-equal model → drop_ratio = 1000 (no drop)
//   (4) drop_ratio < 500 → falsifier fires (degrades, breaks)
//   (5) drop_ratio ≥ 500 → silent (solid, ok)
//   (6) monotone non-increase sanity (16k ≤ 4k AND 64k ≤ 16k for each model)
//   (7) determinism
//
// Source: LONG-CONTEXT/bench/long_context_a1_niah_drop.hexa
// External anchors: Liu 2023 lost-in-the-middle · Kamradt 2023 NIAH · Bai 2023 LongBench · An 2023 L-Eval
//
// @no-lock-needed

let MODEL_NAMES = ["solid",  "ok",   "degrades", "breaks"]
let ACC_4K_x100  = [95, 92, 88, 90]
let ACC_16K_x100 = [93, 80, 70, 65]
let ACC_64K_x100 = [88, 65, 38, 20]
let DROP_THRESHOLD_x1000 = 500

fn drop_ratio_x1000(i: int) -> int { return (ACC_64K_x100[i] * 1000) / ACC_4K_x100[i] }
fn falsifier_fires(i: int) -> bool { return drop_ratio_x1000(i) < DROP_THRESHOLD_x1000 }

print("hexa-codex LONG-CONTEXT A1 falsifier — NIAH drop ratio closed-form")
print("===================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0
let n = MODEL_NAMES.len()

// check 1 — drop_ratio identity for all
checks_total = checks_total + 1
let mut id_ok = true
let mut i = 0
while i < n {
    if drop_ratio_x1000(i) != (ACC_64K_x100[i] * 1000) / ACC_4K_x100[i] { id_ok = false }
    i = i + 1
}
if id_ok {
    print("  [PASS] drop_ratio identity (acc_64k · 1000 / acc_4k) holds for all " + to_string(n) + " models")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] drop_ratio identity broken")
}

// check 2 — all acc ∈ [0, 100]
checks_total = checks_total + 1
let mut rb_ok = true
i = 0
while i < n {
    if ACC_4K_x100[i] < 0 || ACC_4K_x100[i] > 100 { rb_ok = false }
    if ACC_16K_x100[i] < 0 || ACC_16K_x100[i] > 100 { rb_ok = false }
    if ACC_64K_x100[i] < 0 || ACC_64K_x100[i] > 100 { rb_ok = false }
    i = i + 1
}
if rb_ok {
    print("  [PASS] all acc (4k/16k/64k) ∈ [0, 100] (NIAH percentage range)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] acc out of range")
}

// check 3 — synthetic baseline-equal (acc_64k = acc_4k = 90) → drop_ratio = 1000
checks_total = checks_total + 1
let synth_drop = (90 * 1000) / 90
if synth_drop == 1000 {
    print("  [PASS] synthetic baseline-equal (acc_64k = acc_4k) → drop_ratio = 1000 (no drop)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] baseline-equal synthetic ≠ 1000")
}

// check 4 — degrades + breaks fire (< 500)
checks_total = checks_total + 1
// degrades: 38·1000/88 = 431 < 500 → fires
// breaks: 20·1000/90 = 222 < 500 → fires
if falsifier_fires(2) && falsifier_fires(3) {
    print("  [PASS] degrades (drop=" + to_string(drop_ratio_x1000(2)) + ") · breaks (drop=" + to_string(drop_ratio_x1000(3)) + ") fire (< 500)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] degrades/breaks fire detection broken")
}

// check 5 — solid + ok silent (≥ 500)
checks_total = checks_total + 1
// solid: 88·1000/95 = 926 ≥ 500
// ok: 65·1000/92 = 706 ≥ 500
if falsifier_fires(0) == false && falsifier_fires(1) == false {
    print("  [PASS] solid (drop=" + to_string(drop_ratio_x1000(0)) + ") · ok (drop=" + to_string(drop_ratio_x1000(1)) + ") silent (≥ 500) — false-positive 회피")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] solid/ok silent detection broken")
}

// check 6 — monotone non-increase sanity (16k ≤ 4k AND 64k ≤ 16k for each model)
checks_total = checks_total + 1
let mut mono_ok = true
i = 0
while i < n {
    if ACC_16K_x100[i] > ACC_4K_x100[i] { mono_ok = false }
    if ACC_64K_x100[i] > ACC_16K_x100[i] { mono_ok = false }
    i = i + 1
}
if mono_ok {
    print("  [PASS] monotone non-increase: 16k ≤ 4k AND 64k ≤ 16k for all models (NIAH curve sanity)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] monotone sanity broken (some 16k > 4k or 64k > 16k)")
}

// check 7 — determinism
checks_total = checks_total + 1
if drop_ratio_x1000(2) == drop_ratio_x1000(2) && falsifier_fires(3) == falsifier_fires(3) {
    print("  [PASS] deterministic (re-call same drop_ratio + fires)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] non-deterministic")
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 STRUCTURAL (drop_ratio identity + monotone sanity 7/7) + 🟡 BY-CITATION (50% drop threshold = Liu 2023 / Kamradt NIAH convention)"
} else {
    verdict_tier = "🔴 FALSIFIED — drop_ratio formula contradicts identity (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
}
print("  " + verdict_tier)
print("")
print("LONG-CONTEXT A1 finding (placeholder · closed-form):")
print("  - NIAH drop_ratio = acc_64k / acc_4k identity (7/7 closed-form checks)")
print("  - bidirectional discrimination: solid · ok silent · degrades · breaks fire (< 0.5)")
print("  - monotone non-increase sanity (NIAH curve = expected loss with longer context)")
print("  - external anchor: Liu 2023 lost-in-the-middle · Kamradt 2023 NIAH · Bai 2023 LongBench · An 2023 L-Eval")
print("  - 실측 (cycle-10+ T4): NIAH on mac M3 llama-server · Qwen2.5/Llama-3.x scale ladder")
print("")
print("__HEXA_CODEX_NUMERICS_LONG_CONTEXT_A1_NIAH_DROP__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/LONG-CONTEXT/verdicts/a1_niah_drop_verdict.txt"

let mut content = "# hexa-codex LONG-CONTEXT A1 — NIAH drop ratio verifier (cycle-9 round-5)\n"
content = content + "# axis=LONG-CONTEXT/LONG-CONTEXT.md::A1 (needle-in-haystack accuracy @ context-len curve)\n"
content = content + "# bench=LONG-CONTEXT/bench/long_context_a1_niah_drop.hexa\n"
content = content + "# verifier=LONG-CONTEXT/verify/numerics_long_context_a1_niah_drop.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# formula=drop_ratio = acc_64k / acc_4k (× 1000); falsifier_fires = drop_ratio < 0.5\n"
content = content + "# placeholder_data=4 models × {4k, 16k, 64k} context ladder; solid · ok silent (≥0.5) · degrades · breaks fire (<0.5)\n"
content = content + "# monotone_sanity=16k ≤ 4k AND 64k ≤ 16k (NIAH curve expected loss)\n"
content = content + "# external_anchors=Liu 2023 lost-in-the-middle (arXiv:2307.03172) · Kamradt 2023 NIAH · Bai 2023 LongBench · An 2023 L-Eval\n"
content = content + "# substrate_fire=DEFERRED (cycle-10+ · NIAH on mac M3 llama-server · Qwen2.5/Llama-3.x scale ladder)\n"
content = content + "# frontier_open=feedback_closure_is_physical_limit — identity close ≠ measured close\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
