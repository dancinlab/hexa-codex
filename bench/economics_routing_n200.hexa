#!hexa strict
// bench/economics_routing_n200.hexa — N=200 scale replication of the
// economics-routing-savings benchmark.
//
// Two strategies on a 200-task fixed manifest:
//   baseline : every task → claude --bare -p --model opus (always-opus)
//   router   : every task → tier picked by prompt-length heuristic
//                 len <=  30  → haiku
//                 len <=  80  → sonnet
//                 else        → opus
//
// Cost target: ~$3.5 total (baseline ≈ $3.0, router ≈ $0.8 — extrapolated
// linearly from the N=20 run which produced $0.30 / $0.08).
//
// Run:
//   ANTHROPIC_API_KEY=$(secret get anthropic.api_key) \
//     HEXA_SHIM_NO_DARWIN_LANDING=1 RESOURCE_LOCAL_HEXA=1 \
//     HEXA_CODEX_ROOT="$PWD" \
//     ~/.hx/packages/hexa/hexa.real run bench/economics_routing_n200.hexa
//
// Output:
//   .verdicts/economics-routing-savings/baseline_n200.tsv
//   .verdicts/economics-routing-savings/router_n200.tsv
//
// @no-lock-needed
// @resolver-bypass(reason="External CLI subprocess + JSON parse — no atlas atoms touched.")

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()
let OUT_DIR = ROOT + "/.verdicts/economics-routing-savings"

