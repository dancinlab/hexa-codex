#!hexa strict
// lm_foundry/tool/route_dispatch.hexa — unified dispatch wrapper.
//
// SANDBOX deliverable I8. The single source-of-truth for dispatching a
// prompt to ONE backend and returning a tab-separated audit row. Future
// SANDBOX benches (cycle-3+) call `route_dispatch(...)` instead of
// re-implementing the `claude --bare -p --output-format json | jq` pattern
// that currently lives, duplicated, in:
//   - bench/economics_routing_2tier.hexa
//   - bench/economics_routing_confgate.hexa
//   - bench/economics_routing_threshold_sweep.hexa
//   - bench/economics_routing_speculative.hexa
//   - bench/economics_routing_cache.hexa
//
// ============================================================================
// INTERFACE
// ============================================================================
//   route_dispatch(
//       prompt:        str,    // user content
//       backend:       str,    // "claude" | "llama_cpp"
//       model:         str,    // e.g. "claude-haiku-4-5-..." (claude)
//                              //   or "Qwen2.5-0.5B-Instruct-Q4_K_M" (llama_cpp,
//                              //   resolved against $LLAMA_MODEL_DIR or absolute path)
//       temperature:   float,  // 0.0 default; claude backend may ignore (bare CLI
//                              //   surface does not expose --temperature today)
//       max_tokens:    int,    // -1 = backend default
//       stop_seq:      str,    // ""  = no stop; llama_cpp maps to --reverse-prompt;
//                              //   claude --bare DOES NOT expose stop sequences
//                              //   (see SANDBOX north-star "BLOCKED surface")
//       seed:          int,    // -1 = unseeded; llama_cpp maps to --seed;
//                              //   claude --bare does NOT expose seed pinning
//       expected_kw:   str,    // for substring-match correctness (case-insensitive)
//   ) -> str
//
// RETURN (tab-separated, 7 fields, identical to cycle-1/2 run_one() shape):
//   cost_usd \t duration_ms \t input_tokens \t output_tokens \t
//   output_snippet \t model_used \t correct(1|0)
//
// ============================================================================
// BACKEND MATRIX
// ============================================================================
//   feature              | "claude"                | "llama_cpp"
//   ---------------------+-------------------------+--------------------------
//   transport            | `claude --bare -p`      | `llama-cli`
//   output format        | --output-format json    | stdout (last line = answer)
//   cost_usd             | metered (jq .total_cost_usd) | 0.0 (HONEST — see caveat)
//   duration_ms          | metered (jq .duration_ms)    | wall-clock (date +%s%3N)
//   input_tokens         | metered (jq .usage.input_tokens)  | ESTIMATE (words×1.3)
//   output_tokens        | metered (jq .usage.output_tokens) | ESTIMATE (words×1.3)
//   model_used           | metered (jq .modelUsage|keys[0])  | passed `model` arg
//   stop_seq             | IGNORED (surface BLOCKED)         | --reverse-prompt
//   seed                 | IGNORED (surface BLOCKED)         | --seed
//   temperature          | IGNORED (surface BLOCKED)         | --temp
//   max_tokens           | IGNORED (surface BLOCKED)         | -n
//   --system-prompt      | optional (env: ROUTE_SYSTEM_PROMPT) | NOT WIRED (Stage 0)
//   --max-budget-usd     | optional (env: ROUTE_MAX_BUDGET_USD) | N/A
//
// ============================================================================
// COST + TOKEN ESTIMATE CAVEATS
// ============================================================================
//   1. `cost_usd = 0.0` for backend="llama_cpp" is HONEST.
//      Local serving is NOT free — true cost is wall-clock × $/GPU-hour
//      (mac-mini idle ≈ free; A100 80GB ≈ $1.07/hr on Vast.ai per
//      reference_vastai_cli memory). Stage 0 does not measure this; downstream
//      benches that need $/task for the local backend must multiply
//      `duration_ms` by an externally-provided $/ms rate.
//
//   2. `input_tokens` / `output_tokens` for backend="llama_cpp" are ESTIMATES.
//      Formula: ceil(word_count × 1.3). True tokenization depends on the model's
//      vocab; for Qwen2.5 the 1.3 multiplier is within ~10% on English code-task
//      manifests. Anyone needing exact token counts must pipe through the
//      model's tokenizer (out of scope for the dispatch primitive).
//
//   3. `claude --bare -p` is the only Anthropic CLI surface available; it
//      EXPOSES only --model, --system-prompt, --max-budget-usd. Stop sequences,
//      temperature, max_tokens, seed are all BLOCKED — this is the SANDBOX's
//      raison d'être (Stage 3 revives them via llama.cpp serving).
//
// ============================================================================
// REQUIRES
// ============================================================================
//   - For backend="claude":   `claude` CLI on PATH, ANTHROPIC_API_KEY set.
//   - For backend="llama_cpp": `llama-cli` on PATH. NOT installed by this
//     wrapper — see sibling Stage 0 PoC agent.
//   - `jq` on PATH (claude JSON parsing).
//
// @no-lock-needed
// @resolver-bypass(reason="External CLI subprocess + JSON parse — no atlas atoms touched.")

let HOME = env("HOME")

// shq — shell-quote a string for safe embedding in a /bin/sh -c command.
// Copied verbatim from bench/economics_routing_confgate.hexa for behavioral
// parity with the cycle-1/2 benches this wrapper generalizes.
fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

// ---------------------------------------------------------------------------
// llama_cpp helpers
// ---------------------------------------------------------------------------

// Resolve a llama_cpp model arg to a filesystem path. If `model` is absolute
// (starts with "/"), use as-is; else look under $LLAMA_MODEL_DIR (default
// $HOME/.cache/llama-models) and append a .gguf suffix if absent.
fn _resolve_llama_model(model: str) -> str {
    if model.len() > 0 && model.substr(0, 1) == "/" { return model }
    let dir = env("LLAMA_MODEL_DIR")
    let mut base = dir
    if base.len() == 0 { base = HOME + "/.cache/llama-models" }
    let mut name = model
    if name.len() < 5 || name.substr(name.len() - 5, 5) != ".gguf" {
        name = name + ".gguf"
    }
    return base + "/" + name
}

// Cheap whitespace-split word count for the token estimate.
fn _word_count(s: str) -> int {
    if s.len() == 0 { return 0 }
    // collapse runs of whitespace via tr -s, then count tokens via wc -w.
    let n = exec("printf %s " + shq(s) + " | wc -w").trim()
    return int(n)
}

// 1.3× word_count, rounded up. Honest estimate, NOT a metered token count.
fn _token_estimate(s: str) -> int {
    let w = _word_count(s)
    // ceil(w * 1.3) = (w*13 + 9) / 10  with integer arithmetic.
    return (w * 13 + 9) / 10
}

// ---------------------------------------------------------------------------
// claude backend
// ---------------------------------------------------------------------------

// Build the optional system-prompt + max-budget flags from environment.
// Empty strings = flag omitted (matches cycle-1/2 cache bench behavior).
fn _claude_extra_flags() -> str {
    let mut flags = ""
    let sp = env("ROUTE_SYSTEM_PROMPT")
    if sp.len() > 0 {
        flags = flags + " --system-prompt " + shq(sp)
    }
    let bg = env("ROUTE_MAX_BUDGET_USD")
    if bg.len() > 0 {
        flags = flags + " --max-budget-usd " + bg
    }
    return flags
}

// Run via `claude --bare -p`. Mirrors run_one() in
// bench/economics_routing_confgate.hexa lines 102-113.
fn _dispatch_claude(prompt: str, model: str, expected_kw: str) -> str {
    let extra = _claude_extra_flags()
    let cmd = "claude --bare -p --output-format json --model " + model + extra +
              " " + shq(prompt) +
              " 2>/dev/null | jq -r --arg kw " + shq(expected_kw) +
              " '[" +
              ".total_cost_usd, .duration_ms, .usage.input_tokens, .usage.output_tokens, " +
              "(.result // \"\" | gsub(\"[\\n\\t]\"; \" \")), " +
              "(.modelUsage | keys[0]), " +
              "((.result // \"\") | ascii_downcase | contains($kw | ascii_downcase) | " +
              "if . then \"1\" else \"0\" end)" +
              "] | @tsv'"
    return exec(cmd).trim()
}

// ---------------------------------------------------------------------------
// llama_cpp backend
// ---------------------------------------------------------------------------

// Run via `llama-cli`. Returns the same 7-field TSV shape as _dispatch_claude.
// cost_usd is 0.0 (HONEST — local serving, not metered here).
// input/output_tokens are word_count × 1.3 ESTIMATES.
fn _dispatch_llama_cpp(
    prompt: str,
    model: str,
    temperature: float,
    max_tokens: int,
    stop_seq: str,
    seed: int,
    expected_kw: str
) -> str {
    let model_path = _resolve_llama_model(model)

    let mut n_flag = ""
    if max_tokens > 0 { n_flag = " -n " + str(max_tokens) }

    let mut seed_flag = ""
    if seed >= 0 { seed_flag = " --seed " + str(seed) }

    let mut stop_flag = ""
    if stop_seq.len() > 0 { stop_flag = " --reverse-prompt " + shq(stop_seq) }

    // llama-cli writes the generated text to stdout (with the prompt echoed by
    // default unless --no-display-prompt). Stage 0 honest path: pass
    // --no-display-prompt so stdout contains only the completion, then strip.
    let cmd_base = "llama-cli -m " + shq(model_path) +
                   " -p " + shq(prompt) +
                   " --temp " + to_string(temperature) +
                   " --no-display-prompt" +
                   n_flag + seed_flag + stop_flag +
                   " 2>/dev/null"

    // Wall-clock duration via date +%s%3N (ms precision; GNU coreutils).
    // BSD `date` (macOS default) lacks %3N — fall back to python3 millis.
    let t0 = exec("python3 -c 'import time; print(int(time.time()*1000))'").trim()
    let raw_out = exec(cmd_base)
    let t1 = exec("python3 -c 'import time; print(int(time.time()*1000))'").trim()

    let dur_ms = int(t1) - int(t0)

    // Sanitize: collapse newlines/tabs, trim, cap snippet for the TSV row.
    let clean = raw_out.replace("\t", " ").replace("\n", " ").trim()
    let mut snippet = clean
    if snippet.len() > 200 { snippet = snippet.substr(0, 200) }

    let in_tok  = _token_estimate(prompt)
    let out_tok = _token_estimate(clean)

    // Case-insensitive substring correctness — parity with cycle-1/2 scorer.
    let lc_out = clean.lower()
    let lc_kw  = expected_kw.lower()
    let mut correct = "0"
    if lc_kw.len() > 0 && lc_out.contains(lc_kw) { correct = "1" }

    return "0.0\t" + str(dur_ms) + "\t" + str(in_tok) + "\t" + str(out_tok) +
           "\t" + snippet + "\t" + model + "\t" + correct
}

// ---------------------------------------------------------------------------
// PUBLIC: route_dispatch
// ---------------------------------------------------------------------------

fn route_dispatch(
    prompt: str,
    backend: str,
    model: str,
    temperature: float,
    max_tokens: int,
    stop_seq: str,
    seed: int,
    expected_kw: str
) -> str {
    if backend == "claude" {
        // claude --bare -p ignores temperature/max_tokens/stop_seq/seed at the
        // surface level (BLOCKED — see top-of-file caveat). We DO NOT silently
        // drop them; the caller can inspect this comment and the SANDBOX.md
        // north-star to understand why these args are unused on this path.
        return _dispatch_claude(prompt, model, expected_kw)
    }
    if backend == "llama_cpp" {
        return _dispatch_llama_cpp(prompt, model, temperature, max_tokens,
                                    stop_seq, seed, expected_kw)
    }
    // Unknown backend → return an honest error row (parses into 7 fields so
    // downstream tab-split readers don't crash).
    return "0.0\t0\t0\t0\tERROR_UNKNOWN_BACKEND=" + backend + "\t" + model + "\t0"
}

// ---------------------------------------------------------------------------
// Self-test main — no API calls, no llama-cli calls. Just confirms the file
// parses, the public signature is callable on the unknown-backend path, and
// the helpers (shq, _resolve_llama_model, _token_estimate) behave.
// ---------------------------------------------------------------------------
fn main() {
    println("route_dispatch.hexa — self-test (no network, no GPU)")

    // shq round-trip
    let q = shq("it's a test")
    println("  shq(\"it's a test\") = " + q)

    // _resolve_llama_model: relative name → $HOME/.cache/llama-models/<name>.gguf
    let mp = _resolve_llama_model("Qwen2.5-0.5B-Instruct-Q4_K_M")
    println("  resolve(Qwen2.5-0.5B-Instruct-Q4_K_M) = " + mp)

    // _resolve_llama_model: absolute path → passthrough
    let mp2 = _resolve_llama_model("/tmp/foo.gguf")
    println("  resolve(/tmp/foo.gguf) = " + mp2)

    // _token_estimate: empty / short
    let te0 = _token_estimate("")
    let te1 = _token_estimate("hello world foo bar baz")
    println("  token_estimate(\"\") = " + str(te0))
    println("  token_estimate(\"hello world foo bar baz\") = " + str(te1))

    // Unknown-backend path returns a valid 7-field TSV row.
    let row = route_dispatch("ping", "bogus", "x", 0.0, -1, "", -1, "pong")
    println("  unknown-backend row = " + row)
    let parts = row.split("\t")
    if parts.len() != 7 {
        println("  ! self-test FAIL: expected 7 fields, got " + str(parts.len()))
        exit(1)
    }

    println("__HEXA_CODEX_ROUTE_DISPATCH_SELFTEST__ PASS")
    exit(0)
}
