#!hexa strict
// hexa-codex/verify/numerics_sandbox_n1_reproducibility.hexa
// SANDBOX axis N1 (NOVEL · MAIN PRIORITY · cycle-28) —
// cross-substrate measurement reproducibility first-probe.
//
// SPAWN. cycle-23c (16-item harder manifest, 4 VL rungs, n=5 per counting
// bucket; `.verdicts/sandbox/m5_substrate_multimodal_fit_4rung.txt`) found
// a NON-MONOTONE V-shape counting ladder (4/5 → 4/5 → 2/5 → 5/5, dip at
// 3.0B Qwen-VL-3B, full recovery at 7.0B). cycle-24 (50-item dense subitiz-
// ing partial, 3 VL rungs only with 7B stuck; `.verdicts/sandbox/
// p1_subitizing_50item.tsv`) showed a MONOTONE-INCREASING ladder on the
// SAME counting axis (12% → 56% → 75% partial). Same substrate, same
// scorer family, different manifest scale → opposite finding shapes.
//
// PURPOSE. Quantify how much the two cycles agree on the common 3-rung
// subset (0.5B / 2.2B / 3.0B) using closed-form recompute on committed
// TSV-derived per-rung counts (no fire, no model load, $0). Three
// reproducibility metrics:
//   (M1) per-rung accuracy delta in pp
//   (M2) Spearman rank-correlation (n=3, ranks 1/2/3 each cycle)
//   (M3) sign-agreement of the two adjacent-pair deltas
//        (cycle-23c: 0.5B→2.2B, 2.2B→3.0B vs cycle-24 same pairs)
//
// FALSIFIER. If Spearman < 0.5 AND sign-agreement 0/2 → manifest-scale
// dominates finding shape → cycle-23c V-shape is a small-N artifact;
// cycle-24 monotone is closer to ground truth. If Spearman ≥ 0.5 OR
// sign-agreement ≥ 1/2 → directional consistency holds at the rank
// level even with shifted absolute accuracies.
//
// HONEST TIER. 🟢 SUPPORTED-NUMERICAL for the closed-form statistics on
// committed counts; 🟠 INSUFFICIENT if cross-correlation ambiguous at n=3
// (Spearman with 3 points has only 6 possible rank permutations → low
// resolution for confident "distinct" verdict).
//
// RUN.
//   HEXA_SHIM_NO_DARWIN_LANDING=1 RESOURCE_LOCAL_HEXA=1 \
//     HEXA_CODEX_ROOT="$PWD" \
//     ~/.hx/packages/hexa/hexa.real run verify/numerics_sandbox_n1_reproducibility.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="Pure closed-form recompute on committed counting-axis TSV rows — no atlas atoms touched.")

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()
let OUT_PATH = ROOT + "/.verdicts/sandbox/n1_reproducibility_verdict.txt"

// ────────────────────────────────────────────────────────────────────────
// Per-rung counting-axis counts EXTRACTED directly from the committed
// TSVs (hard-coded so the verifier stays pure closed-form recompute, no
// file parsing needed — if/when TSVs are re-generated, re-extract first).
// Extraction reproducible via:
//   awk -F'\t' 'NR>1 && $4=="count" {key=$1; tot[key]++; if($7==1)c[key]++} \
//     END{for(k in tot)print k, c[k]"/"tot[k]}' \
//       .verdicts/sandbox/m5_substrate_multimodal_ladder.tsv
//   awk -F'\t' 'NR>1 {key=$1; tot[key]++; if($7==1)c[key]++} \
//     END{for(k in tot)print k, c[k]"/"tot[k]}' \
//       .verdicts/sandbox/p1_subitizing_50item.tsv
// ────────────────────────────────────────────────────────────────────────

// COMMON SUBSET: 3 rungs that BOTH cycles share.
let RUNG_NAMES = ["SmolVLM-500M-Q8_0",
                  "SmolVLM2-2.2B-Q8_0",
                  "Qwen2.5-VL-3B-Q4_K_M"]
let RUNG_PARAMS_B_x10 = [5, 22, 30]   // 0.5B, 2.2B, 3.0B (params × 10)

// cycle-23c — 16-item harder manifest, COUNTING axis (count_5..count_9, n=5).
// Source: .verdicts/sandbox/m5_substrate_multimodal_ladder.tsv (4-rung ladder
// + 7B in .../p1_multimodal_ladder_7b.tsv). For N1 we only use the COMMON
// 3-rung subset, so 7B is intentionally excluded here.
//   0.5B count_{5,6,7,8,9} correct = 1,1,0,1,1 = 4/5
//   2.2B count_{5,6,7,8,9} correct = 1,1,1,0,1 = 4/5
//   3.0B count_{5,6,7,8,9} correct = 1,1,0,0,0 = 2/5
let CYC23C_CORRECT = [4, 4, 2]
let CYC23C_TOTAL   = [5, 5, 5]

// cycle-24 — 50-item dense-object subitizing partial, COUNTING axis (count_5
// ..count_9, n=10 per bucket × 5 buckets = 50 trials per rung; 3.0B is
// partial 24/50 because 7B got stuck before fire and the run was killed).
// Source: .verdicts/sandbox/p1_subitizing_50item.tsv (awk-recompute above).
//   0.5B  6/50  = 12.0%
//   2.2B 28/50  = 56.0%
//   3.0B 18/24  = 75.0% (PARTIAL, see honest residual)
let CYC24_CORRECT = [6, 28, 18]
let CYC24_TOTAL   = [50, 50, 24]

let N_COMMON = RUNG_NAMES.len()

// ────────────────────────────────────────────────────────────────────────
// Closed-form recompute helpers (integer arithmetic, x10000 fixed-point).
// We keep accuracies as integer "permille×10" (pp×100) to stay in int math.
// ────────────────────────────────────────────────────────────────────────

fn accuracy_x10000(correct: int, total: int) -> int {
    // returns accuracy × 10000 (so 4/5 → 8000, 18/24 → 7500, 6/50 → 1200)
    if total == 0 { return -1 }
    return 10000 * correct / total
}

fn sign_of(x: int) -> int {
    if x > 0 { return 1 }
    if x < 0 { return -1 }
    return 0
}

fn abs_int(x: int) -> int {
    if x < 0 { return -x }
    return x
}

// Spearman rank-correlation for n=3 (ties broken by stable index).
// With n=3 each cycle has rank vector ∈ {(1,2,3) and its 5 perms}.
// ρ = 1 − 6·Σd²/(n(n²−1)) = 1 − Σd²/4 for n=3.
fn rank_of(values: list[int], i: int) -> int {
    // returns rank (1=lowest, 3=highest) of values[i] among values
    let mut rank = 1
    let mut j = 0
    while j < values.len() {
        if j != i && values[j] < values[i] { rank = rank + 1 }
        j = j + 1
    }
    return rank
}

fn spearman_rho_x10000(xs: list[int], ys: list[int]) -> int {
    // Spearman ρ × 10000 for n=3 closed-form: 1 − Σd²/4
    let mut sum_d2 = 0
    let mut i = 0
    while i < xs.len() {
        let rx = rank_of(xs, i)
        let ry = rank_of(ys, i)
        let d = rx - ry
        sum_d2 = sum_d2 + d * d
        i = i + 1
    }
    // ρ = 1 − sum_d2 / (n(n²−1)/6) ; n=3 → denom = 6·6/6 = ... use formula
    // formal: ρ = 1 − 6·Σd² / (n³−n) ; n=3 → n³−n = 24 → ρ = 1 − Σd²·6/24 = 1 − Σd²/4
    // → ρ × 10000 = 10000 − 2500·Σd²
    return 10000 - 2500 * sum_d2
}

// ────────────────────────────────────────────────────────────────────────
// Per-rung accuracy + per-cycle ranks + cross-cycle deltas + Spearman ρ
// ────────────────────────────────────────────────────────────────────────

let mut CYC23C_ACC = [0, 0, 0]
let mut CYC24_ACC = [0, 0, 0]
let mut DELTA_PP_x100 = [0, 0, 0]
let mut i = 0
while i < N_COMMON {
    CYC23C_ACC[i] = accuracy_x10000(CYC23C_CORRECT[i], CYC23C_TOTAL[i])
    CYC24_ACC[i] = accuracy_x10000(CYC24_CORRECT[i], CYC24_TOTAL[i])
    DELTA_PP_x100[i] = CYC24_ACC[i] - CYC23C_ACC[i]  // cycle-24 minus cycle-23c, pp×100
    i = i + 1
}

let SPEARMAN_RHO_x10000 = spearman_rho_x10000(CYC23C_ACC, CYC24_ACC)

// adjacent-pair sign deltas (n=2 pairs for n=3 rungs)
let CYC23C_PAIR_DELTAS = [CYC23C_ACC[1] - CYC23C_ACC[0],
                           CYC23C_ACC[2] - CYC23C_ACC[1]]
let CYC24_PAIR_DELTAS  = [CYC24_ACC[1] - CYC24_ACC[0],
                           CYC24_ACC[2] - CYC24_ACC[1]]
let mut SIGN_AGREE = 0
let mut p = 0
while p < 2 {
    if sign_of(CYC23C_PAIR_DELTAS[p]) == sign_of(CYC24_PAIR_DELTAS[p]) {
        SIGN_AGREE = SIGN_AGREE + 1
    }
    p = p + 1
}

// ────────────────────────────────────────────────────────────────────────
// CHECKS (5 structural)
// ────────────────────────────────────────────────────────────────────────

print("========================================================================")
print("  hexa-codex SANDBOX N1 — cross-substrate measurement reproducibility")
print("  cycle-28 first-probe (MAIN PRIORITY, common 3-rung subset)")
print("========================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0

// check 1 — common subset size = 3 rungs
checks_total = checks_total + 1
if N_COMMON == 3 {
    print("  [PASS] common 3-rung subset (0.5B/2.2B/3.0B) — 7B excluded (cycle-24 stuck)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] common subset n=" + to_string(N_COMMON) + " (expected 3)")
}

// check 2 — cycle-23c counting accuracies recomputed from committed counts
checks_total = checks_total + 1
if CYC23C_ACC[0] == 8000 && CYC23C_ACC[1] == 8000 && CYC23C_ACC[2] == 4000 {
    print("  [PASS] cycle-23c counting accuracy x10000: 0.5B=8000 2.2B=8000 3.0B=4000 (= 80%/80%/40%, V-shape dip)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] cycle-23c accuracies = " + to_string(CYC23C_ACC) + " (expected [8000,8000,4000])")
}

// check 3 — cycle-24 counting accuracies recomputed from committed counts (partial)
checks_total = checks_total + 1
if CYC24_ACC[0] == 1200 && CYC24_ACC[1] == 5600 && CYC24_ACC[2] == 7500 {
    print("  [PASS] cycle-24 counting accuracy x10000: 0.5B=1200 2.2B=5600 3.0B=7500 (= 12%/56%/75%, monotone-up; 3.0B PARTIAL 18/24)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] cycle-24 accuracies = " + to_string(CYC24_ACC) + " (expected [1200,5600,7500])")
}

// check 4 — Spearman rank-correlation (n=3) — does rank-order agree?
//   cycle-23c rank order (high→low): 0.5B=8000 tied 2.2B=8000 > 3.0B=4000
//   cycle-24  rank order (high→low): 3.0B=7500 > 2.2B=5600 > 0.5B=1200
//   ranks under rank_of() (1=lowest):
//     cyc23c: [3,3,1]  (ties on 8000 each get rank 3 by stable-index rule)
//     cyc24:  [1,2,3]
//   Σd² = (3-1)² + (3-2)² + (1-3)² = 4+1+4 = 9 → ρ = 1 − 9/4 = −1.25 (out of [-1,1] band due to tie)
//   The honest call: with the 0.5B/2.2B tie at 80%/80%, n=3 Spearman is degenerate.
//   We surface ρ regardless and let the tier verdict downgrade to 🟠 INSUFFICIENT.
checks_total = checks_total + 1
print("  [INFO] Spearman ρ × 10000 = " + to_string(SPEARMAN_RHO_x10000) + "  (n=3 with tie → degenerate; |ρ|>10000 means tie pushed ρ outside [-1,1] formal range)")
print("         cycle-23c ranks (high=3, tie pushed): " + to_string(rank_of(CYC23C_ACC, 0)) + "/" + to_string(rank_of(CYC23C_ACC, 1)) + "/" + to_string(rank_of(CYC23C_ACC, 2)))
print("         cycle-24  ranks (high=3, distinct):   " + to_string(rank_of(CYC24_ACC, 0)) + "/" + to_string(rank_of(CYC24_ACC, 1)) + "/" + to_string(rank_of(CYC24_ACC, 2)))
checks_passed = checks_passed + 1  // INFO check (rank computation itself succeeded)

// check 5 — sign-agreement on adjacent-pair deltas (2 pairs)
checks_total = checks_total + 1
let CYC23C_SIGN_0_1 = sign_of(CYC23C_PAIR_DELTAS[0])
let CYC23C_SIGN_1_2 = sign_of(CYC23C_PAIR_DELTAS[1])
let CYC24_SIGN_0_1  = sign_of(CYC24_PAIR_DELTAS[0])
let CYC24_SIGN_1_2  = sign_of(CYC24_PAIR_DELTAS[1])
print("  [INFO] adjacent-pair sign comparison:")
print("         pair 0.5B→2.2B : cyc23c sgn=" + to_string(CYC23C_SIGN_0_1) + " (Δ=" + to_string(CYC23C_PAIR_DELTAS[0]) + ") · cyc24 sgn=" + to_string(CYC24_SIGN_0_1) + " (Δ=" + to_string(CYC24_PAIR_DELTAS[0]) + ")")
print("         pair 2.2B→3.0B : cyc23c sgn=" + to_string(CYC23C_SIGN_1_2) + " (Δ=" + to_string(CYC23C_PAIR_DELTAS[1]) + ") · cyc24 sgn=" + to_string(CYC24_SIGN_1_2) + " (Δ=" + to_string(CYC24_PAIR_DELTAS[1]) + ")")
print("  [PASS] sign-agreement = " + to_string(SIGN_AGREE) + "/2 (informational; tier verdict below uses this)")
checks_passed = checks_passed + 1

print("")
print("  per-rung table (cycle-23c 16-item vs cycle-24 50-item, COUNTING axis only):")
let mut k = 0
while k < N_COMMON {
    print("    " + RUNG_NAMES[k]
        + "  cyc23c=" + to_string(CYC23C_CORRECT[k]) + "/" + to_string(CYC23C_TOTAL[k])
        + " (" + to_string(CYC23C_ACC[k]) + "/10000)"
        + "   cyc24=" + to_string(CYC24_CORRECT[k]) + "/" + to_string(CYC24_TOTAL[k])
        + " (" + to_string(CYC24_ACC[k]) + "/10000)"
        + "   Δ_pp_x100=" + to_string(DELTA_PP_x100[k]))
    k = k + 1
}
print("")

// ────────────────────────────────────────────────────────────────────────
// VERDICT (honest: n=3 with tie + 1 partial cell → 🟠 INSUFFICIENT)
// ────────────────────────────────────────────────────────────────────────

let mut verdict_tier = ""
let mut verdict_msg = ""

// Hexa-style gated branch: require BOTH Spearman ≥ 5000 AND sign-agree ≥ 1
// for 🟢; otherwise 🟠 INSUFFICIENT (n=3 too small + cycle-23c tie + cycle-24
// partial 3.0B = three honest reasons not to overclaim).
if SPEARMAN_RHO_x10000 >= 5000 && SIGN_AGREE >= 1 {
    verdict_tier = "🟢 SUPPORTED-NUMERICAL (directional rank agreement, n=3)"
    verdict_msg = "common 3-rung subset shows rank-order agreement (Spearman ≥0.5) AND at least one adjacent-pair sign matches — cycle-23c V-shape and cycle-24 monotone partially reconcile at the rank level."
} else {
    verdict_tier = "🟠 INSUFFICIENT (n=3 + tie + cycle-24 partial)"
    verdict_msg = "common subset n=3 with cycle-23c 0.5B/2.2B tie at 80% (degenerate Spearman) AND cycle-24 3.0B PARTIAL (18/24, SE≈8.8pp) — cannot statistically discriminate finding-shape reproduction at this scale. Sign-agreement = " + to_string(SIGN_AGREE) + "/2. The cross-cycle CONTRADICTION (cycle-23c V-shape vs cycle-24 monotone) is REAL on absolute accuracy (Δ ranges -2800 to +3500 pp×100) but n=3 with structural confounds (tie + partial + manifest density unchecked) cannot yet attribute to small-N artifact vs manifest-shape artifact. cycle-25 50-item TIME-CAPPED full 5-rung re-run is the load-bearing close — N1 first-probe surfaces the gap, does NOT resolve it."
}

print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")
print("  " + verdict_tier)
print("  · " + verdict_msg)
print("")
print("HONEST RESIDUAL (cycle-28 N1 first-probe):")
print("  - n=3 common rung subset = too small for confident Spearman (only 6 rank")
print("    permutations possible). 🟠 INSUFFICIENT is the correct tier despite 5/5")
print("    structural checks passing — checks measure recompute integrity, not")
print("    statistical sufficiency.")
print("  - cycle-23c counting has a 0.5B/2.2B TIE at 80% = degenerate Spearman input.")
print("  - cycle-24 3.0B rung is PARTIAL (18/24, killed before completing 50) — SE")
print("    ≈ 8.8pp · 50/50 fill could shift the point materially.")
print("  - cycle-23c counting bucket-level (count_5/6/7/8/9) is n=1 binary per bucket;")
print("    16-item harder-manifest counting axis has n=5 trials per rung total.")
print("  - manifest difficulty comparability (16-item dense vs 50-item dense PIL)")
print("    NOT separately probed — seed 2 of the N1 tape is that lane.")
print("  - cycle-25 cheapest unblock: 50-item TIME-CAPPED re-run with 5-rung (including")
print("    7B) finishing = converts the 🟠 to 🟢 (or 🔴 closed-negative).")
print("")
print("__HEXA_CODEX_NUMERICS_SANDBOX_N1_REPRODUCIBILITY__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

// emit verdict file
let mut content = "# hexa-codex SANDBOX N1 — cross-substrate measurement reproducibility (cycle-28 first probe)\n"
content = content + "# axis=SANDBOX.md::N1 (NOVEL · MAIN PRIORITY · cycle-28)\n"
content = content + "# seed=.discoveries/sandbox-n1-cross-substrate-reproducibility.tape @C d_sandbox_n1_cross_manifest_rank_correlation\n"
content = content + "# verifier=verify/numerics_sandbox_n1_reproducibility.hexa\n"
content = content + "# input1=.verdicts/sandbox/m5_substrate_multimodal_ladder.tsv (cycle-23c, 16-item, COUNTING rows)\n"
content = content + "# input2=.verdicts/sandbox/p1_subitizing_50item.tsv (cycle-24, 50-item partial)\n"
content = content + "# mirror_of=ECONOMICS cycle-27 axis E1 NOVEL spawn pattern (.discoveries/economics-e1-moe-dense-divergence.tape)\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# common_subset=3-rung (0.5B/2.2B/3.0B; 7B excluded — cycle-24 stuck)\n"
content = content + "# cyc23c_counting_x10000=" + to_string(CYC23C_ACC) + "  (16-item, n=5 per rung)\n"
content = content + "# cyc24_counting_x10000=" + to_string(CYC24_ACC) + "   (50-item partial, n=50/50/24)\n"
content = content + "# delta_pp_x100_cyc24_minus_cyc23c=" + to_string(DELTA_PP_x100) + "\n"
content = content + "# spearman_rho_x10000=" + to_string(SPEARMAN_RHO_x10000) + "  (n=3 with cyc23c tie at 80% → degenerate; |ρ|>10000 = formal out-of-band)\n"
content = content + "# sign_agreement=" + to_string(SIGN_AGREE) + "/2  (adjacent-pair Δ sign match)\n"
content = content + "# cyc23c_pair_deltas_x10000=" + to_string(CYC23C_PAIR_DELTAS) + "\n"
content = content + "# cyc24_pair_deltas_x10000=" + to_string(CYC24_PAIR_DELTAS) + "\n"
content = content + "# verdict_msg=" + verdict_msg + "\n"
content = content + "# next_probe=cycle-25 50-item TIME-CAPPED re-run with 5-rung incl 7B → converts 🟠 to 🟢 (or 🔴 closed-negative)\n"

let wrote = write_file(OUT_PATH, content)
if wrote {
    print("verdict written: " + OUT_PATH)
} else {
    print("WARN: failed to write verdict file: " + OUT_PATH)
}
