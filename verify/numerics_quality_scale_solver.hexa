#!hexa strict
// hexa-codex/verify/numerics_quality_scale_solver.hexa — quality_scale T2 ODE solver.
//
// Beyond `verify/numerics_quality_scale.hexa` (loss-surface shape) and
// `verify/numerics_quality_scale_parity.hexa` (published-exponent
// parity), this script re-derives the n=6 reducible-loss decay law by
// NUMERICALLY INTEGRATING the underlying first-order ODE with a cascade
// of solvers (Euler / midpoint-RK2 / RK4).
//
// The reducible N-loss term R(N) = A·N^(-α) becomes, with u = log(N):
//
//     R(u) = A·exp(-α·u)   ⇒   dR/du = -α·R,   R(0) = 1  (normalized)
//
// (separable; analytic solution R(u) = exp(-α·u), a DECAYING exponential
// since α = φ(6)/σ(6) = 1/6 > 0).  This is the train_cost ODE with the
// sign of the rate flipped — quality improves (loss decays) as scale
// grows, where cost grows.
//
// Verifies:
//   · RK4 reproduces the closed-form at the anchor grid within 1e-9
//   · Midpoint within 1e-5, Euler within 1e-1 (large h)
//   · convergence ordering at fixed h: |err_euler| > |err_mid| > |err_rk4|
//   · halving the step h scales errors as 2 / 4 / 16 (orders 1 / 2 / 4)
//   · forward (u > 0, decay) and backward (u < 0, growth) integration agree
//   · all solver outputs are positive and finite
//
// PASS criterion (T2 solver floor): 10 checks pass.
//
// Recipe T2 floor: §1 row 7 — `numerics_<verb>_solver.hexa`, the ODE
// re-derivation layer.  The decay law is first-order linear (separable),
// so RK4 is the natural integrator.
//
// Run:
//   hexa run verify/numerics_quality_scale_solver.hexa
//
// @no-lock-needed
// @resolver-bypass(reason="Pure local verifier; integer + float arithmetic only.")

use "self/runtime/math_pure"

let HOME = env("HOME")

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let pwd = exec("pwd").trim()
    if pwd.len() > 0 { return pwd }
    return HOME + "/core/hexa-codex"
}

let ROOT = _root()

// ── n=6 lattice ──────────────────────────────────────────────────────────
let SIGMA_6 = 12.0
let PHI_6   = 2.0
let ALPHA   = PHI_6 / SIGMA_6             // 1/6 — the loss-decay rate
let N_REF   = 1.0e10                       // 10B-param reference scale

// FALSIFIERS list (recipe §4 invariant 3).
let FALSIFIERS = ["quality_scale loss-decay ODE solver re-derivation dR/du=-α·R (α=1/6), Euler/midpoint/RK4 cascade"]

// ── helpers ──────────────────────────────────────────────────────────────

let mut RUN = 0
let mut FAIL = 0
let mut FAILURES = []

fn _check(ok: bool, label: str, detail: str) {
    RUN = RUN + 1
    if ok {
        println("  [PASS] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    } else {
        FAIL = FAIL + 1
        FAILURES.push(label + " :: " + detail)
        println("  [FAIL] " + label)
        if detail.len() > 0 { println("         · " + detail) }
    }
}

fn _abs(x: float) -> float {
    return abs_pure(x)
}

// Closed-form analytic solution: R(u) = exp(-α·u)  (decaying exponential).
fn closed_form(u: float) -> float {
    return exp_pure((0.0 - ALPHA) * u)
}

// ODE right-hand side: dR/du = -α·R.
fn rhs(c: float) -> float {
    return (0.0 - ALPHA) * c
}

// ── solvers ──────────────────────────────────────────────────────────────

// Forward Euler: c_{n+1} = c_n + h·f(c_n)  — 1st-order, error O(h).
fn euler_step(c: float, h: float) -> float {
    return c + h * rhs(c)
}

// Midpoint (explicit RK2) — 2nd-order, error O(h²).
fn midpoint_step(c: float, h: float) -> float {
    let k1 = rhs(c)
    let k2 = rhs(c + 0.5 * h * k1)
    return c + h * k2
}

// Classical RK4 — 4th-order, error O(h⁴).
fn rk4_step(c: float, h: float) -> float {
    let k1 = rhs(c)
    let k2 = rhs(c + 0.5 * h * k1)
    let k3 = rhs(c + 0.5 * h * k2)
    let k4 = rhs(c + h * k3)
    return c + (h / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4)
}

// Drive a solver for n_steps from u=0, c=1 to u=u_target (signed).
//   step_id: 0=Euler, 1=midpoint, 2=RK4.
fn integrate(step_id: int, u_target: float, n_steps: int) -> float {
    let h = u_target / to_float(n_steps)
    let mut c = 1.0
    let mut i = 0
    while i < n_steps {
        if step_id == 0 {
            c = euler_step(c, h)
        } else {
            if step_id == 1 {
                c = midpoint_step(c, h)
            } else {
                c = rk4_step(c, h)
            }
        }
        i = i + 1
    }
    return c
}

// ── anchor grid (5 points, 0.01× .. 100× of N_REF) ───────────────────────
let N_TINY   = 1.0e8       // u = log(0.01)  ≈ -4.605
let N_SMALL  = 1.0e9       // u = log(0.1)   ≈ -2.303
let N_ANCHOR = 1.0e10      // u = 0
let N_LARGE  = 1.0e11      // u = log(10)    ≈ +2.303
let N_HUGE   = 1.0e12      // u = log(100)   ≈ +4.605

fn u_of(n: float) -> float {
    return log_pure(n / N_REF)
}

// ── checks ───────────────────────────────────────────────────────────────

// Check 1: anchor identity — integrating to u=0 returns c=1 (h=0 no-op).
fn check_anchor_identity() {
    let c_eul = integrate(0, 0.0, 8)
    let c_mid = integrate(1, 0.0, 8)
    let c_rk4 = integrate(2, 0.0, 8)
    let drift = max_pure(_abs(c_eul - 1.0),
                         max_pure(_abs(c_mid - 1.0), _abs(c_rk4 - 1.0)))
    _check(drift < 1.0e-15,
           "anchor identity: integrate(u=0) = 1.0 across all 3 solvers",
           "Eul=" + to_string(c_eul) + " Mid=" + to_string(c_mid) +
           " RK4=" + to_string(c_rk4) + " max_drift=" + to_string(drift))
}

// Check 2: RK4 forward to N_HUGE (loss decays) within 1e-9 of closed-form.
fn check_rk4_forward_huge() {
    let u = u_of(N_HUGE)
    let c_solver = integrate(2, u, 512)
    let c_ref = closed_form(u)
    let drift = _abs(c_solver - c_ref) / c_ref
    _check(drift < 1.0e-9,
           "RK4 forward to N_HUGE: relative error < 1e-9 (n=512 steps)",
           "solver=" + to_string(c_solver) + " ref=" + to_string(c_ref) +
           " rel_err=" + to_string(drift))
}

// Check 3: RK4 backward to N_TINY (loss grows) within 1e-9 of closed-form.
fn check_rk4_backward_tiny() {
    let u = u_of(N_TINY)            // negative
    let c_solver = integrate(2, u, 512)
    let c_ref = closed_form(u)
    let drift = _abs(c_solver - c_ref) / c_ref
    _check(drift < 1.0e-9,
           "RK4 backward to N_TINY: relative error < 1e-9 (n=512 steps)",
           "solver=" + to_string(c_solver) + " ref=" + to_string(c_ref) +
           " rel_err=" + to_string(drift))
}

// Check 4: Midpoint reaches N_LARGE within 1e-5 of closed-form.
fn check_midpoint_large() {
    let u = u_of(N_LARGE)
    let c_solver = integrate(1, u, 512)
    let c_ref = closed_form(u)
    let drift = _abs(c_solver - c_ref) / c_ref
    _check(drift < 1.0e-5,
           "Midpoint forward to N_LARGE: relative error < 1e-5 (n=512 steps)",
           "solver=" + to_string(c_solver) + " ref=" + to_string(c_ref) +
           " rel_err=" + to_string(drift))
}

// Check 5: Euler reaches N_LARGE within 1e-1 of closed-form (loose, h large).
fn check_euler_large() {
    let u = u_of(N_LARGE)
    let c_solver = integrate(0, u, 64)
    let c_ref = closed_form(u)
    let drift = _abs(c_solver - c_ref) / c_ref
    _check(drift < 1.0e-1,
           "Euler forward to N_LARGE: relative error < 0.1 (n=64 steps, 1st order)",
           "solver=" + to_string(c_solver) + " ref=" + to_string(c_ref) +
           " rel_err=" + to_string(drift))
}

// Check 6: convergence ordering at fixed h: |err_euler| > |err_mid| > |err_rk4|.
fn check_convergence_ordering() {
    let u = u_of(N_LARGE)
    let n = 64
    let c_ref = closed_form(u)
    let e_eul = _abs(integrate(0, u, n) - c_ref)
    let e_mid = _abs(integrate(1, u, n) - c_ref)
    let e_rk4 = _abs(integrate(2, u, n) - c_ref)
    _check((e_eul > e_mid) && (e_mid > e_rk4),
           "convergence ordering: |Euler| > |Midpoint| > |RK4| at h fixed",
           "Euler=" + to_string(e_eul) + " Mid=" + to_string(e_mid) +
           " RK4=" + to_string(e_rk4))
}

// Check 7: Halving Euler step → error ratio ≈ 2 (1st-order).  Tol [1.5, 2.5].
fn check_euler_order_one() {
    let u = u_of(N_LARGE)
    let c_ref = closed_form(u)
    let e_coarse = _abs(integrate(0, u, 256) - c_ref)
    let e_fine   = _abs(integrate(0, u, 512) - c_ref)
    let ratio = e_coarse / e_fine
    _check((ratio > 1.5) && (ratio < 2.5),
           "Euler 1st-order convergence: error ratio ≈ 2 on halving h",
           "256→512 steps, ratio=" + to_string(ratio))
}

// Check 8: Halving Midpoint step → error ratio ≈ 4 (2nd-order).  Tol [3.0, 5.0].
fn check_midpoint_order_two() {
    let u = u_of(N_LARGE)
    let c_ref = closed_form(u)
    let e_coarse = _abs(integrate(1, u, 64)  - c_ref)
    let e_fine   = _abs(integrate(1, u, 128) - c_ref)
    let ratio = e_coarse / e_fine
    _check((ratio > 3.0) && (ratio < 5.0),
           "Midpoint 2nd-order convergence: error ratio ≈ 4 on halving h",
           "64→128 steps, ratio=" + to_string(ratio))
}

// Check 9: Halving RK4 step → error ratio ≈ 16 (4th-order).  Tol [10.0, 22.0].
fn check_rk4_order_four() {
    let u = u_of(N_LARGE)
    let c_ref = closed_form(u)
    let e_coarse = _abs(integrate(2, u, 8)  - c_ref)
    let e_fine   = _abs(integrate(2, u, 16) - c_ref)
    let ratio = e_coarse / e_fine
    _check((ratio > 10.0) && (ratio < 22.0),
           "RK4 4th-order convergence: error ratio ≈ 16 on halving h",
           "8→16 steps, ratio=" + to_string(ratio))
}

// Check 10: positivity & finiteness — RK4 outputs positive finite values
//   over the full 5-anchor grid (sanity floor invariant).
fn check_positivity_finiteness() {
    let mut all_ok = true
    let ns = [N_TINY, N_SMALL, N_ANCHOR, N_LARGE, N_HUGE]
    let mut i = 0
    while i < len(ns) {
        let u = u_of(ns[i])
        let c = integrate(2, u, 64)
        let bounded = (c == c) && (_abs(c) < 1.0e30) && (c > 0.0)
        if bounded == false { all_ok = false }
        i = i + 1
    }
    _check(all_ok,
           "all RK4 outputs over 5-anchor grid are positive and finite",
           "tiny / small / anchor / large / huge all > 0, |c|<1e30, no NaN")
}

// ── main ─────────────────────────────────────────────────────────────────

fn main() {
    println("========================================================================")
    println("  hexa-codex quality_scale loss-decay solver (T2 stack #3, ODE cascade)")
    println("  ODE: dR/du = -α·R,  R(0)=1,  closed-form R(u)=exp(-α·u),  α=1/6")
    println("========================================================================")
    println("  ALPHA  = " + to_string(ALPHA))
    println("  N_REF  = " + to_string(N_REF))
    println("  solvers = Euler (1st) | Midpoint-RK2 (2nd) | RK4 (4th)")
    println("")

    check_anchor_identity()
    check_rk4_forward_huge()
    check_rk4_backward_tiny()
    check_midpoint_large()
    check_euler_large()
    println("")
    check_convergence_ordering()
    check_euler_order_one()
    check_midpoint_order_two()
    check_rk4_order_four()
    check_positivity_finiteness()

    println("========================================================================")
    let pass_n = RUN - FAIL
    println("  " + str(pass_n) + "/" + str(RUN) + " checks passed")
    if FAIL > 0 {
        println("  FAILURES:")
        for f in FAILURES { println("    ✗ " + f) }
        println("__HEXA_CODEX_NUMERICS_QUALITY_SCALE_SOLVER__ FAIL")
        exit(1)
    }
    println("  quality_scale T2 ODE solver layer: closed.")
    println("__HEXA_CODEX_NUMERICS_QUALITY_SCALE_SOLVER__ PASS")
    exit(0)
}
