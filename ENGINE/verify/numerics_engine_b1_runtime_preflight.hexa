#!hexa strict
// hexa-codex/ENGINE/verify/numerics_engine_b1_runtime_preflight.hexa
// ENGINE axis B1 — CYCLE-4 runtime PREFLIGHT (asset survey, READ-ONLY).
//
// CONTEXT.  ENGINE cycle-2 emitted the B1 SPEC wire (layer=19, intervention=
//   projection_out, rank=1, source_model=qwen2.5-1.5b-instruct, ±10pp tol).
//   Actual runtime fire — load model + register forward hooks + measure
//   post-intervention adv/benign refusal rate — is COST-BEARING and was
//   deferred to ENGINE cycle-5+. This cycle-4 verifier is a CLOSED-FORM
//   PREFLIGHT: it enumerates the 5 assets required for the cycle-5 fire,
//   probes whether each currently exists, and emits a PASS/FAIL per asset.
//
// PRINCIPLE.  PREFLIGHT IS NOT AN AXIS [x] FLIP. Axis B1 stays [x] from the
//   cycle-2 SPEC close. This file produces a GAP REPORT for cycle-5 readiness
//   ("blocked-until" list). It is forbidden to download models, install
//   venvs, capture activations, or load the model — all probes are read-only
//   filesystem / shell checks. See feedback_closure_is_physical_limit:
//   preflight = frontier instrumentation, not closure.
//
// 5 ASSETS:
//   1. Qwen2.5-1.5B-Instruct model — present on ubu-1 (HF cache) AND/OR mac local
//   2. r̂ direction vector pre-computed — full 1536-dim hidden-state direction
//      at L19, persisted as numerical artifact (NOT just scalar norms)
//   3. 200-sample adv+benign prompt set cached — locate the prompt source used
//      by the refusal-matrix bench (committed under cx_hf_safety_private)
//   4. transformers HF clean venv on ubu-1 — transformers==4.51.3, numpy<2
//      per reference_activation_capture_env (venv name may vary)
//   5. Custom forward-hook code path — existing .hexa/python that registers
//      torch.register_forward_hook and projects out the direction
//
// @no-lock-needed
// @resolver-bypass(reason="Read-only filesystem + pool probes; no model load, no install, no activation capture.")

let HOME = env("HOME")

fn _root() -> str {
    // explicit env wins
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    // hexa CLI cd's to the .hexa file's grandparent — when invoked from
    // ENGINE/verify/<file>.hexa that's ENGINE/, NOT repo root. detect by
    // walking up to find DOMAINS.tape marker.
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()

print("hexa-codex ENGINE B1 cycle-4 runtime PREFLIGHT — asset survey")
print("===============================================================")
print("axis B1 SPEC close was cycle-2; this is the cycle-5 fire readiness gate.")
print("")

let mut assets_present = 0
let mut assets_total = 0
let mut gaps = ""

fn _gap_add(prev: str, slug: str) -> str {
    if prev.len() == 0 { return slug }
    return prev + "," + slug
}

// ──────────────────────────────────────────────────────────────────────
// Asset 1 — Qwen2.5-1.5B-Instruct on ubu-1 (HF cache) OR mac local
// ──────────────────────────────────────────────────────────────────────
assets_total = assets_total + 1
let ubu_check = exec("pool on ubu-1 \"ls -d ~/.cache/huggingface/hub/models--Qwen--Qwen2.5-1.5B-Instruct 2>/dev/null || ls ~/models/Qwen2.5-1.5B-Instruct 2>/dev/null\" 2>/dev/null").trim()
let mac_check = exec("ls -d ~/.cache/huggingface/hub/models--Qwen--Qwen2.5-1.5B-Instruct 2>/dev/null || true").trim()
let ubu_present = ubu_check.len() > 0
let mac_present = mac_check.len() > 0
let mut asset1_status = "FAIL"
if ubu_present || mac_present {
    let mut loc = ""
    if ubu_present { loc = "ubu-1:" + ubu_check }
    if mac_present {
        if loc.len() > 0 { loc = loc + " · " }
        loc = loc + "mac:" + mac_check
    }
    print("  [PASS] asset 1/5 — Qwen2.5-1.5B-Instruct model present")
    print("         loc=" + loc)
    assets_present = assets_present + 1
    asset1_status = "PASS"
} else {
    print("  [FAIL] asset 1/5 — Qwen2.5-1.5B-Instruct NOT FOUND on ubu-1 or mac (HF cache + ~/models probed)")
    gaps = _gap_add(gaps, "qwen2.5-1.5b-model")
}

// ──────────────────────────────────────────────────────────────────────
// Asset 2 — r̂ direction vector (full hidden-state, NOT norms)
// ──────────────────────────────────────────────────────────────────────
// Search repo for any file that could hold the 1536-dim L19 direction.
// Acceptance = a numerical artifact (.npy / .pt / dense numeric .tsv with
// 1536 cols) OR a verdict explicitly referencing a persisted direction.
// Norms-only files (m2_safety_refusal_norms.tsv = 84 cols) do NOT count.
assets_total = assets_total + 1
let direction_probe = exec(
    "find " + ROOT + "/.verdicts " + ROOT + "/ENGINE " + ROOT + "/bench " +
    "-type f \\( -name '*direction*.npy' -o -name '*refusal_direction*.pt' " +
    "-o -name '*r_hat*' -o -name '*safety*direction*tensor*' \\) 2>/dev/null"
).trim()
// Also probe ubu-1 for persisted full direction artifact (read-only)
let ubu_dir_probe = exec(
    "pool on ubu-1 \"find ~/sandbox_probe -maxdepth 2 -type f " +
    "\\( -name '*direction*.npy' -o -name '*r_hat*' -o -name '*refusal_direction*.pt' \\) 2>/dev/null\" 2>/dev/null"
).trim()
let direction_found = direction_probe.len() > 0 || ubu_dir_probe.len() > 0
if direction_found {
    print("  [PASS] asset 2/5 — r̂ direction vector persisted")
    if direction_probe.len() > 0 { print("         repo: " + direction_probe) }
    if ubu_dir_probe.len() > 0 { print("         ubu-1: " + ubu_dir_probe) }
    assets_present = assets_present + 1
} else {
    print("  [FAIL] asset 2/5 — no full r̂ direction vector found")
    print("         only present surface: .verdicts/sandbox/m2_safety_refusal_norms.tsv (84-col NORMS, NOT 1536-dim direction)")
    print("         + ~/sandbox_probe/causal_ablation_summary.json (scalar dir_norm only, vector NOT saved)")
    print("         GAP: cycle-5 must re-run extraction (bench/sandbox_m5_safety_causal_ablation.hexa STEP-1 logic)")
    print("              to re-extract + persist r̂ at L19 from full hidden states; this is part of cycle-5 cost.")
    gaps = _gap_add(gaps, "rhat-vector")
}

// ──────────────────────────────────────────────────────────────────────
// Asset 3 — adversarial + benign prompt set
// ──────────────────────────────────────────────────────────────────────
// SPEC mentioned "200-sample" but the canonical SAFETY refusal-matrix is
// 40 prompts (20 adv × 4 categories of 5 each + 20 benign-matched). The
// adv strings are intentionally embedded ONLY in two bench files (per
// cx_hf_safety_private); a 200-sample superset would be a NEW asset.
assets_total = assets_total + 1
let bench_a = ROOT + "/bench/sandbox_stage4_refusal_matrix.hexa"
let bench_b = ROOT + "/bench/sandbox_m5_safety_causal_ablation.hexa"
let bench_a_present = exec("test -f " + bench_a + " && echo y").trim() == "y"
let bench_b_present = exec("test -f " + bench_b + " && echo y").trim() == "y"
// count adv prompt rows in bench_a (rows declared with category label, 1..5 idx)
let adv_count = if bench_a_present {
    let s = exec("grep -cE '^\\s+\\[\"(hate|violence|self_harm|medical_advice_risk)\",' " + bench_a + " 2>/dev/null || echo 0").trim()
    s
} else { "0" }
let benign_marker = if bench_a_present {
    exec("grep -cE 'benign|BENIGN' " + bench_a + " 2>/dev/null || echo 0").trim()
} else { "0" }
if bench_a_present && bench_b_present {
    print("  [PASS] asset 3/5 — 40-prompt adv+benign set committed (20 adv + 20 benign) — PRIVATE, embedded in bench source")
    print("         bench/sandbox_stage4_refusal_matrix.hexa     adv_rows≈" + adv_count + " · benign_marker_hits=" + benign_marker)
    print("         bench/sandbox_m5_safety_causal_ablation.hexa ADV/BENIGN embedded tuples (L66-67)")
    print("         note: task brief said 200-sample; actual cached canonical set is 40 (cycle-19/20 ground truth basis).")
    print("               cycle-5 fire can run on 40; scaling to 200 = separate asset (cycle-5b).")
    assets_present = assets_present + 1
} else {
    print("  [FAIL] asset 3/5 — prompt-set bench source missing")
    if !bench_a_present { print("         missing: " + bench_a) }
    if !bench_b_present { print("         missing: " + bench_b) }
    gaps = _gap_add(gaps, "prompt-set")
}

// ──────────────────────────────────────────────────────────────────────
// Asset 4 — transformers HF clean venv on ubu-1
// ──────────────────────────────────────────────────────────────────────
// reference_activation_capture_env names ~/venv-hf-clean but the cycle-19
// causal ablation actually used ~/sandbox_probe/venv with the SAME pins
// (transformers==4.51.3 numpy==1.26.4). Probe both; accept either iff
// pins match.
assets_total = assets_total + 1
let venv_probe_clean = exec(
    "pool on ubu-1 \"source ~/venv-hf-clean/bin/activate 2>/dev/null && python -c 'import transformers,numpy; print(transformers.__version__, numpy.__version__)' 2>/dev/null\" 2>/dev/null"
).trim()
let venv_probe_sandbox = exec(
    "pool on ubu-1 \"source ~/sandbox_probe/venv/bin/activate 2>/dev/null && python -c 'import transformers,numpy; print(transformers.__version__, numpy.__version__)' 2>/dev/null\" 2>/dev/null"
).trim()
let venv_clean_ok = venv_probe_clean == "4.51.3 1.26.4"
let venv_sandbox_ok = venv_probe_sandbox == "4.51.3 1.26.4"
if venv_clean_ok || venv_sandbox_ok {
    print("  [PASS] asset 4/5 — HF clean venv on ubu-1 (transformers==4.51.3 · numpy==1.26.4)")
    if venv_clean_ok { print("         ~/venv-hf-clean → " + venv_probe_clean) }
    if venv_sandbox_ok { print("         ~/sandbox_probe/venv → " + venv_probe_sandbox + "  [actually-used cycle-19 venv; reference_activation_capture_env naming differs]") }
    assets_present = assets_present + 1
} else {
    print("  [FAIL] asset 4/5 — no venv with transformers==4.51.3 + numpy==1.26.4 found on ubu-1")
    print("         ~/venv-hf-clean probe → '" + venv_probe_clean + "'")
    print("         ~/sandbox_probe/venv probe → '" + venv_probe_sandbox + "'")
    gaps = _gap_add(gaps, "hf-venv")
}

// ──────────────────────────────────────────────────────────────────────
// Asset 5 — Custom forward-hook code path (projection-out at L19)
// ──────────────────────────────────────────────────────────────────────
assets_total = assets_total + 1
let hook_grep_causal = exec(
    "grep -l 'register_forward_hook' " + ROOT + "/bench/sandbox_m5_safety_causal_ablation.hexa 2>/dev/null"
).trim()
let proj_grep = exec(
    "grep -cE 'h\\s*-\\s*\\(h.*r_hat\\)|projection_out' " + ROOT + "/bench/sandbox_m5_safety_causal_ablation.hexa 2>/dev/null || echo 0"
).trim()
if hook_grep_causal.len() > 0 {
    print("  [PASS] asset 5/5 — forward-hook + projection-out code path EXISTS")
    print("         bench/sandbox_m5_safety_causal_ablation.hexa registers hooks on embed + all 28 decoder layers (L89-90)")
    print("         projection-out line count (h - (h·r̂)r̂ / projection_out): " + proj_grep)
    print("         cycle-5 = reuse this exact harness with the SPEC layer=19 single-source (not the 3-layer scan); SPEC reduction = trivial.")
    assets_present = assets_present + 1
} else {
    print("  [FAIL] asset 5/5 — no projection-out forward-hook code found in bench/")
    gaps = _gap_add(gaps, "hook-code")
}

// ──────────────────────────────────────────────────────────────────────
// Verdict
// ──────────────────────────────────────────────────────────────────────
print("")
print("  " + to_string(assets_present) + "/" + to_string(assets_total) + " assets present")
print("  gaps: " + (if gaps.len() == 0 { "(none)" } else { gaps }))

let mut readiness = ""
if assets_present == assets_total {
    readiness = "🟢 READY — cycle-5 runtime fire unblocked"
} else if assets_present >= 3 {
    readiness = "🟠 PARTIAL — cycle-5 fire blocked-until: " + gaps + " resolved (most are re-runnable in cycle-5 itself)"
} else {
    readiness = "🔴 NOT READY — cycle-5 fire needs majority of assets first"
}
print("  " + readiness)
print("")
print("PRINCIPLE (feedback_closure_is_physical_limit):")
print("  PREFLIGHT 는 axis [x] flip 아님. B1 axis 는 cycle-2 SPEC close 로 이미 [x].")
print("  이 cycle-4 = cycle-5+ cost-bearing fire 의 readiness 측정. frontier OPEN 유지.")
print("")
print("RECOMMENDED NEXT STEP:")
if gaps.len() == 0 {
    print("  → cycle-5 fire: run bench/sandbox_m5_safety_causal_ablation.hexa with SPEC-locked src=[19] only;")
    print("    persist r̂ as .npy at .verdicts/sandbox/m5_safety_refusal_direction_L19.npy;")
    print("    verify SPEC ±10pp band (adv_after ≤ 10, benign_after ≤ 10).")
} else {
    print("  → cycle-5 = fire IS the gap resolution. The 'gaps' above are NOT prereqs to install separately;")
    print("    re-extracting r̂ (gap=rhat-vector) is STEP-1 of the cycle-5 fire itself. asset survey shows")
    print("    no foreign install is needed beyond the cycle-19 venv that's already on ubu-1.")
}
print("")
print("__HEXA_CODEX_NUMERICS_ENGINE_B1_RUNTIME_PREFLIGHT__ " + (if assets_present == assets_total { "DONE" } else { "PARTIAL" }))

let OUT_PATH = ROOT + "/ENGINE/verdicts/b1_runtime_preflight_verdict.txt"

let mut content = "# hexa-codex ENGINE B1 — runtime PREFLIGHT (cycle-4)\n"
content = content + "# axis=ENGINE/ENGINE.md::B1 (SAFETY finding → inference-time intervention)\n"
content = content + "# axis_state=[x] unchanged (cycle-2 SPEC wire close; this preflight does NOT flip axis)\n"
content = content + "# scope=cycle-5+ runtime-fire readiness survey, READ-ONLY (no model load, no install, no capture)\n"
content = content + "# verifier=ENGINE/verify/numerics_engine_b1_runtime_preflight.hexa\n"
content = content + "# readiness=" + readiness + "\n"
content = content + "# assets=" + to_string(assets_present) + "/" + to_string(assets_total) + "\n"
content = content + "# gaps=" + (if gaps.len() == 0 { "none" } else { gaps }) + "\n"
content = content + "# asset_1_model=" + (if ubu_present || mac_present { "PASS" } else { "FAIL" }) + " (ubu-1:" + (if ubu_present { "yes" } else { "no" }) + " mac:" + (if mac_present { "yes" } else { "no" }) + ")\n"
content = content + "# asset_2_rhat_vector=" + (if direction_found { "PASS" } else { "FAIL · only-norms-and-summary-metadata, full-1536-dim-vector-not-persisted" }) + "\n"
content = content + "# asset_3_prompt_set=" + (if bench_a_present && bench_b_present { "PASS · 40-prompt-canonical-cached-in-bench-sources-PRIVATE" } else { "FAIL" }) + "\n"
content = content + "# asset_4_venv=" + (if venv_clean_ok || venv_sandbox_ok { "PASS" } else { "FAIL" }) + " (venv-hf-clean:" + (if venv_clean_ok { "yes" } else { "no" }) + " sandbox_probe/venv:" + (if venv_sandbox_ok { "yes" } else { "no" }) + ")\n"
content = content + "# asset_5_hook_code=" + (if hook_grep_causal.len() > 0 { "PASS" } else { "FAIL" }) + " (bench/sandbox_m5_safety_causal_ablation.hexa)\n"
content = content + "# principle=feedback_closure_is_physical_limit (preflight = readiness measure, not axis-flip)\n"
content = content + "# next_cycle_5_fire=run-causal-ablation-with-src-locked-19 · persist-rhat-as-npy · verify-SPEC-tolerance\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
