#!hexa strict
// TEMPORAL/verify/numerics_temporal_a1_post_cutoff_wrong.hexa
// TEMPORAL A1 — closed-form falsifier verifier for post-cutoff confident-
// wrong rate.
//
// Independently REPLICATES the bench identity (no runtime import of bench state)
// and asserts the 7 invariants:
//   (1) rate identity        rate_x100 == (N_confident_wrong · 100) / N_post_cutoff
//   (2) range bound          rate_x100 ∈ [0, 100]
//   (3) zero-control Z (raw=0) → silent (perfect-IDK abstention)
//   (4) > 30 models fire     OC (raw=40 > 30) AND CL (raw=60 > 30) both fire
//   (5) ≤ 30 models silent   CA (raw=15 ≤ 30) AND PA (raw=25 ≤ 30) both silent
//   (6) determinism          same input → same rate · same fire (re-call invariance)
//   (7) cutoff-aware ≤ over-confident sanity (cutoff awareness reduces
//                                              confident-wrong: CA ≤ OC)
//
// Any FAIL = bench encoding contradicts the closed-form identity → TEMPORAL
// A1 FALSIFIED.
//
// SOURCE.  bench/temporal_a1_post_cutoff_wrong.hexa (this verifier replicates
// the formula independently — closed-form recompute, no runtime import of
// the bench file's emitted state; same inputs by construction).
//
// External anchors:
//   Dhingra 2022 — TimeQA: Time-Sensitive Question Answering (arXiv:2108.06314)
//   Chen 2023 — temporal reasoning gap in LLMs
//   Zhao 2024 — cutoff awareness in LLMs
//
// @no-lock-needed
// @resolver-bypass(reason="Pure closed-form rate recompute on integer ×100 ledger.")

// ────────────────────────────────────────────────────────────────────────
// Replicated registry (independent · parallel to bench by construction)
//   indices: 0 = CA · 1 = PA · 2 = OC · 3 = CL · 4 = Z (perfect-IDK control)
// ────────────────────────────────────────────────────────────────────────

let MODEL_NAMES        = ["CA",   "PA",   "OC",   "CL",   "Z"]
let N_CONFIDENT_WRONG  = [  15,     25,     40,     60,    0]
let N_POST_CUTOFF      = [ 100,    100,    100,    100,  100]
let THRESHOLD_x100 = 30

fn raw_rate_x100_v(i: int) -> int {
    return (N_CONFIDENT_WRONG[i] * 100) / N_POST_CUTOFF[i]
}

fn falsifier_fires_v(i: int) -> bool {
    return raw_rate_x100_v(i) > THRESHOLD_x100
}

print("hexa-codex TEMPORAL A1 falsifier — post-cutoff confident-wrong rate closed-form")
print("================================================================================")
print("")

let mut checks_passed = 0
let mut checks_total = 0
let n = MODEL_NAMES.len()

// ────────────────────────────────────────────────────────────────────────
// check 1 — rate identity: rate_x100 == (N_confident_wrong · 100) / N_post_cutoff
//   recomputed inline (no helper) so identity is testable end-to-end.
// ────────────────────────────────────────────────────────────────────────
checks_total = checks_total + 1
let mut identity_ok = true
let expected_raw = [15, 25, 40, 60, 0]
let mut i = 0
while i < n {
    let recompute = (N_CONFIDENT_WRONG[i] * 100) / N_POST_CUTOFF[i]
    let helper = raw_rate_x100_v(i)
    if recompute != helper { identity_ok = false }
    if recompute != expected_raw[i] { identity_ok = false }
    i = i + 1
}
if identity_ok {
    print("  [PASS] (1) rate identity: rate_x100 == (N_confident_wrong · 100) / N_post_cutoff for all 5 models")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] (1) rate identity broken — helper disagrees with inline recompute")
}

// ────────────────────────────────────────────────────────────────────────
// check 2 — range bound: rate_x100 ∈ [0, 100] (probability semantics).
// ────────────────────────────────────────────────────────────────────────
checks_total = checks_total + 1
let mut range_ok = true
i = 0
while i < n {
    let r = raw_rate_x100_v(i)
    if r < 0 || r > 100 { range_ok = false }
    i = i + 1
}
if range_ok {
    print("  [PASS] (2) rate_x100 ∈ [0, 100] for all 5 models (probability semantics)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] (2) rate_x100 out of [0, 100]")
}

// ────────────────────────────────────────────────────────────────────────
// check 3 — zero-control Z (idx 4) → rate_x100 == 0 · silent
//   structural floor: perfect-IDK model never fires (no confident-wrong samples).
// ────────────────────────────────────────────────────────────────────────
checks_total = checks_total + 1
let z_idx = 4
let z_raw = raw_rate_x100_v(z_idx)
let z_fires = falsifier_fires_v(z_idx)
if z_raw == 0 && z_fires == false {
    print("  [PASS] (3) zero-control Z → rate_x100 = 0 · silent (perfect-IDK abstention)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] (3) Z rate=" + to_string(z_raw) + " fires=" + to_string(z_fires) + " — expected 0/silent")
}

// ────────────────────────────────────────────────────────────────────────
// check 4 — > 30 models fire: OC (idx 2, raw=40) AND CL (idx 3, raw=60)
//   both must fire (true-positive capture above threshold).
// ────────────────────────────────────────────────────────────────────────
checks_total = checks_total + 1
let oc_idx = 2
let cl_idx = 3
let oc_raw = raw_rate_x100_v(oc_idx)
let cl_raw = raw_rate_x100_v(cl_idx)
let oc_fires = falsifier_fires_v(oc_idx)
let cl_fires = falsifier_fires_v(cl_idx)
if oc_raw == 40 && oc_fires && cl_raw == 60 && cl_fires {
    print("  [PASS] (4) over-confident OC (raw=40 > 30) AND clueless CL (raw=60 > 30) → falsifier fires correctly")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] (4) OC raw=" + to_string(oc_raw) + " fires=" + to_string(oc_fires) +
          " · CL raw=" + to_string(cl_raw) + " fires=" + to_string(cl_fires) + " — expected 40/true · 60/true")
}

// ────────────────────────────────────────────────────────────────────────
// check 5 — ≤ 30 models silent: CA (idx 0, raw=15) AND PA (idx 1, raw=25)
//   both must be silent (false-positive 회피 below threshold).
// ────────────────────────────────────────────────────────────────────────
checks_total = checks_total + 1
let ca_idx = 0
let pa_idx = 1
let ca_raw = raw_rate_x100_v(ca_idx)
let pa_raw = raw_rate_x100_v(pa_idx)
let ca_fires = falsifier_fires_v(ca_idx)
let pa_fires = falsifier_fires_v(pa_idx)
if ca_raw == 15 && ca_fires == false && pa_raw == 25 && pa_fires == false {
    print("  [PASS] (5) cutoff-aware CA (raw=15 ≤ 30) AND partial PA (raw=25 ≤ 30) → silent · false-positive 회피")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] (5) CA raw=" + to_string(ca_raw) + " fires=" + to_string(ca_fires) +
          " · PA raw=" + to_string(pa_raw) + " fires=" + to_string(pa_fires) + " — expected 15/false · 25/false")
}

// ────────────────────────────────────────────────────────────────────────
// check 6 — determinism: re-call same input → same rate · same fire decision
// ────────────────────────────────────────────────────────────────────────
checks_total = checks_total + 1
let mut det_ok = true
i = 0
while i < n {
    let r1 = raw_rate_x100_v(i)
    let r2 = raw_rate_x100_v(i)
    let f1 = falsifier_fires_v(i)
    let f2 = falsifier_fires_v(i)
    if r1 != r2 { det_ok = false }
    if f1 != f2 { det_ok = false }
    i = i + 1
}
if det_ok {
    print("  [PASS] (6) deterministic (re-call same input → same rate · same fire)")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] (6) non-deterministic — same input differs")
}

// ────────────────────────────────────────────────────────────────────────
// check 7 — cutoff-aware ≤ over-confident sanity:
//   structural invariant — cutoff awareness REDUCES confident-wrong on
//   post-cutoff queries (a cutoff-aware model knows to abstain).
//   CA (raw=15) ≤ OC (raw=40) must hold; otherwise the cutoff-awareness
//   semantics are inverted and the falsifier loses its meaning.
//   Strict ≤ (equality possible only when cutoff-awareness yields zero gain).
// ────────────────────────────────────────────────────────────────────────
checks_total = checks_total + 1
let mut sanity_ok = true
let ca_for_sanity = raw_rate_x100_v(ca_idx)
let oc_for_sanity = raw_rate_x100_v(oc_idx)
if ca_for_sanity > oc_for_sanity { sanity_ok = false }
// also: cutoff-aware ≤ clueless (transitive guard)
let cl_for_sanity = raw_rate_x100_v(cl_idx)
if ca_for_sanity > cl_for_sanity { sanity_ok = false }
if sanity_ok {
    print("  [PASS] (7) cutoff-aware CA (raw=15) ≤ over-confident OC (raw=40) ≤ clueless CL (raw=60) — cutoff awareness reduces confident-wrong")
    checks_passed = checks_passed + 1
} else {
    print("  [FAIL] (7) cutoff-aware > over-confident — semantics inverted, falsifier meaning broken")
}

print("")
print("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

let mut verdict_tier = ""
let mut verdict_class = ""
if checks_passed == checks_total {
    verdict_tier = "🔵 STRUCTURAL (post-cutoff confident-wrong rate identity + threshold 7/7) + 🟡 BY-CITATION (30% threshold = TimeQA / cutoff-awareness literature convention)"
    verdict_class = "SUPPORTED-NUMERICAL"
} else {
    verdict_tier = "🔴 FALSIFIED — post-cutoff confident-wrong rate encoding contradicts identity (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
    verdict_class = "FALSIFIED"
}
print("  " + verdict_tier)
print("")
print("worked example summary:")
print("  CA (cutoff-aware,   raw=15) silent · honest IDK on post-cutoff (false-positive 회피)")
print("  PA (partial,        raw=25) silent · some cutoff sense (below threshold 30)")
print("  OC (over-confident, raw=40) FIRES · confident wrong post-cutoff")
print("  CL (clueless,       raw=60) FIRES heavily · 2× threshold")
print("  Z  (perfect-IDK,    raw=0)  silent · zero-control floor")
print("")
print("external anchor:")
print("  - Dhingra 2022 'Time-Aware Language Models as Temporal Knowledge Bases / TimeQA' (arXiv:2108.06314)")
print("  - Chen 2023 — temporal reasoning gap in LLMs (date · duration · ordering)")
print("  - Zhao 2024 — cutoff awareness in LLMs (post-cutoff abstention boundary)")
print("")
print("honest residual (frontier OPEN — perpetual axis, feedback_closure_is_physical_limit):")
print("  - this verifier encodes the FORMULA only (closed-form 🔵 + 🟡) — substrate fire")
print("    on TimeQA · post-cutoff date probe deferred to A1 measured-tier (mac M3 local")
print("    llama-server / ubu-1 HF transformers · cycle-10+ cost-bearing round).")
print("  - integer ×100 ledger truncates rate at .01 — coarser than literature float % (3-4 sig)")
print("    — acceptable for falsifier semantics, not fine-grained model comparison.")
print("  - 'confident-wrong' here is binary per query; real-fire wires it to confidence")
print("    probe (Kadavath 2022 P(True)) × cutoff-aware abstention extractor at measured-tier.")
print("  - axis B (relative vs absolute time accuracy) and axis N ⭐ MAIN NOVEL (relative-vs-")
print("    absolute reasoning gap) open next.")
print("")
print("__HEXA_CODEX_NUMERICS_TEMPORAL_A1_POST_CUTOFF_WRONG__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

// ────────────────────────────────────────────────────────────────────────
// Verdict file persistence — under TEMPORAL/verdicts/
// ────────────────────────────────────────────────────────────────────────

let HOME = env("HOME")
fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    return HOME + "/core/hexa-codex"
}
let ROOT = _root()
let OUT_PATH = ROOT + "/TEMPORAL/verdicts/a1_post_cutoff_wrong_verdict.txt"

let ca_raw_out = raw_rate_x100_v(0)
let pa_raw_out = raw_rate_x100_v(1)
let oc_raw_out = raw_rate_x100_v(2)
let cl_raw_out = raw_rate_x100_v(3)
let z_raw_out  = raw_rate_x100_v(4)

let mut content = "# hexa-codex TEMPORAL A1 — post-cutoff confident-wrong rate closed-form verifier (cycle-9 round-7)\n"
content = content + "# axis=TEMPORAL/TEMPORAL.md::A1 (post-cutoff confident-wrong rate first probe, closed-form)\n"
content = content + "# formula=rate_x100(m) = (N_confident_wrong[m] · 100) / N_post_cutoff[m]; falsifier_fires = rate_x100 > 30\n"
content = content + "# bench=TEMPORAL/bench/temporal_a1_post_cutoff_wrong.hexa\n"
content = content + "# verifier=TEMPORAL/verify/numerics_temporal_a1_post_cutoff_wrong.hexa\n"
content = content + "# tier=" + verdict_tier + "\n"
content = content + "# verdict_class=" + verdict_class + "\n"
content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
content = content + "# placeholder_models=5 (CA=15 silent · PA=25 silent · OC=40 fires · CL=60 fires · Z=0 perfect-IDK control)\n"
content = content + "# rates_x100=CA:" + to_string(ca_raw_out) + " PA:" + to_string(pa_raw_out) + " OC:" + to_string(oc_raw_out) + " CL:" + to_string(cl_raw_out) + " Z:" + to_string(z_raw_out) + "\n"
content = content + "# threshold_x100=30 (> 30% confident-wrong on post-cutoff queries → falsifier fires)\n"
content = content + "# external_anchors=Dhingra 2022 TimeQA (arXiv:2108.06314) · Chen 2023 temporal reasoning · Zhao 2024 cutoff awareness\n"
content = content + "# substrate_fire=DEFERRED (cycle-10+ · TimeQA · post-cutoff date probe × abstention extractor + self-eval gating on mac M3 / ubu-1 HF)\n"
content = content + "# honest_residual=integer_x100_ledger_truncation_at_0.01 · 'confident-wrong' binary per query (Kadavath P(True) × cutoff-aware abstention narrows at measured-tier) · axis_B_relative_vs_absolute_and_axis_N_reasoning_gap_next\n"
content = content + "# frontier=OPEN (feedback_closure_is_physical_limit — perpetual axis · new cutoff / task tense / time expression reopens cells)\n"
write_file(OUT_PATH, content)
print("verdict written: " + OUT_PATH)
