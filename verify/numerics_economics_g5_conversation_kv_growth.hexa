content = content + "# MLA_vs_MHA_ratio_x1000=" + to_string(MLA_RATIO_x1000) + " (0.06× · DeepSeek-V2 architecture)\n"
content = content + "# external_anchor=StreamingLLM_arXiv2309.17453 · H2O_arXiv2306.14048 · Scissorhands_arXiv2305.17118 · MLA_arXiv2405.04434\n"
content = content + "# next_probe=cycle-51+ T4 SANDBOX KV growth measurement on Qwen2.5-1.5B-Q4 over 30 turns\n"
write_file(OUT_PATH, content)
