#!hexa strict
// DATA-EFFICIENCY/bench/data_efficiency_a1_curriculum_delta.hexa
// DATA-EFFICIENCY A1 first probe (cycle-9 round-8 · CODEX bg) — curriculum 순서
// 효과 (easy-to-hard · hard-to-easy · interleaved · random) · sample-efficiency
// 곡선 closed-form first probe.
//
// Identity (closed-form · libm-free · × 100 ledger of final accuracy):
//   final_acc_x100(c, s)            = FINAL_ACC_x100[c][s]              (per-config per-sample-size)
//   peak_acc_x100(c)                = max_over_s FINAL_ACC_x100[c][s]   (best final acc across sweep)
//   curriculum_delta_x100(c)        = peak_acc_x100(c) − peak_acc_x100(RANDOM_IDX)  (signed pp × 100)
//   falsifier_fires(c)              = curriculum_delta_x100(c) < THRESHOLD_x100  (silent ⇒ curriculum helps; fire ⇒ no signal)
//
// Falsifier (CODEX DATA-EFFICIENCY A1): curriculum-ordered training delta < 5pp
//   vs random-order baseline → curriculum 효과 illusory (순서 무관 가설).
//
// External anchors (citation tier · 🟡):
//   Bengio 2009 — Curriculum learning (ICML)
//   Hacohen 2019 — On the power of curriculum learning in training deep networks (ICML)
//   Wu 2021 — When do curricula work? (ICLR)
//   Soviany 2022 — Curriculum learning: A survey (IJCV)
//
// Integer ledger (× 100 of final accuracy) — libm-free. Placeholder per-config
// per-sample-size accuracy. 실측 (cycle-10+ T4 · lm_foundry SFT · vast.ai pod
// curriculum-ordered run) deferred. SANDBOX 측정 substrate (`cx_lab_sandbox`).
//
// @no-lock-needed
// @resolver-bypass(reason="Pure delta identity recompute — no runtime infer.")

// ────────────────────────────────────────────────────────────────────────
// Config registry (4 curriculum strategies × 4 sample-size sweep points)
//   sample sizes (× 1k tokens): [10, 30, 100, 300]
//   configs (rows in FINAL_ACC_x100):
//     0 random          (baseline) — peak 6500 (= 65.00%)
//     1 easy-to-hard               — peak 7200 (= 72.00%)        Δ = +700 = +7.00pp → SILENT (curriculum helps)
//     2 hard-to-easy               — peak 6300 (= 63.00%)        Δ = −200 = −2.00pp → FIRES (no signal · curriculum hurts)
//     3 interleaved                — peak 6700 (= 67.00%)        Δ = +200 = +2.00pp → FIRES (< 5pp · null effect)
//
// Bidirectional discrimination:
//   silent (curriculum helps · delta ≥ 5pp): easy-to-hard
//   fires  (no signal · delta < 5pp):        hard-to-easy · interleaved · random-vs-self (delta = 0)
// ────────────────────────────────────────────────────────────────────────

let CONFIG_NAMES   = ["random", "easy-to-hard", "hard-to-easy", "interleaved"]
let SAMPLE_SIZES   = [10, 30, 100, 300]  // × 1k training tokens

// FINAL_ACC_x100[config][sample_size] — × 100 ledger of final accuracy (0..10000)
let FINAL_ACC_x100 = [
    [4200, 5400, 6200, 6500],   // random        — monotonic, peak at largest sample
    [4800, 6100, 6900, 7200],   // easy-to-hard  — fastest climb, peak +700 vs random
    [3500, 4900, 5800, 6300],   // hard-to-easy  — slow start, peak −200 vs random
    [4400, 5700, 6400, 6700],   // interleaved   — small delta, peak +200 vs random
]

let RANDOM_IDX           = 0
let THRESHOLD_x100       = 500          // < 500 (× 100 ledger of 5pp) → falsifier fires
let ACC_MAX_x100         = 10000        // accuracy ∈ [0, 100] in × 100 ledger ∈ [0, 10000]

fn peak_acc_x100(c: int) -> int {
    // max over sample-size sweep
    let row_len = SAMPLE_SIZES.len()
    let mut best = FINAL_ACC_x100[c][0]
    let mut s = 1
    while s < row_len {
        let v = FINAL_ACC_x100[c][s]
        if v > best { best = v }
        s = s + 1
    }
    return best
}

fn curriculum_delta_x100(c: int) -> int {
    // signed pp delta vs random baseline (× 100 ledger)
    return peak_acc_x100(c) - peak_acc_x100(RANDOM_IDX)
}

fn falsifier_fires(c: int) -> bool {
    // fires when delta < 5pp (× 100 ledger: < 500) — curriculum 효과 illusory
    return curriculum_delta_x100(c) < THRESHOLD_x100
}

print("hexa-codex DATA-EFFICIENCY A1 — curriculum order delta closed-form (cycle-9 round-8)")
print("=====================================================================================")
print("")
print("per-config sweep + peak + delta (placeholder · × 100 ledger · libm-free):")
let n = CONFIG_NAMES.len()
let mut i = 0
while i < n {
    let p = peak_acc_x100(i)
    let d = curriculum_delta_x100(i)
    let mut flag = "silent (Δ ≥ 5pp · curriculum 효과 ≠ illusory)"
    if falsifier_fires(i) {
        flag = "FIRES (Δ < 5pp · 순서 무관 가설 · curriculum signal illusory)"
    }
    print("  " + CONFIG_NAMES[i] +
          ": sweep=[" + to_string(FINAL_ACC_x100[i][0]) +
          "," + to_string(FINAL_ACC_x100[i][1]) +
          "," + to_string(FINAL_ACC_x100[i][2]) +
          "," + to_string(FINAL_ACC_x100[i][3]) + "]/10000" +
          " · peak=" + to_string(p) + "/10000" +
          " · Δ=" + to_string(d) + "/100pp" +
          " · [" + flag + "]")
    i = i + 1
}
print("")
print("__HEXA_CODEX_DATA_EFFICIENCY_A1_CURRICULUM_DELTA__ DONE")
