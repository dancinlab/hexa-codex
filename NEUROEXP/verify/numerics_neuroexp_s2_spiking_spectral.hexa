#!hexa strict
// hexa-codex/NEUROEXP/verify/numerics_neuroexp_s2_spiking_spectral.hexa
// NEUROEXP axis S2 (cycle-12 first probe · T4 MEASURED) — spiking-neuron firing
// pattern vs transformer attention activation spectral comparison on Qwen2.5-1.5B.
//
// CLAIM (NEUROEXP.md S2). spiking neuron (LIF · Izhikevich) firing pattern 과
// transformer attention activation 의 spectral 비교. 반증자: transformer
// activation 스펙트럼이 spiking 와 power-law 다른 가족 → "neuron-style
// activation" 통념 부정.
//
// MEASUREMENT (🟢 NUMERICAL · real model, not closed-form):
//   capture: mid-layer (14) hidden-state activations across all token positions →
//   matrix A [N_tokens × d_model]. Covariance eigenvalue spectrum
//   eigvalsh(A^T A / N) sorted descending; power-law fit slope of
//   log(eigenvalue) vs log(rank) over the bulk (ranks 2..768) →
//   alpha_transformer = -slope. Activation sparsity = fraction of |activation|
//   below 0.01. Run on Qwen2.5-1.5B-Instruct (28 layers, d_model 1536), 8 mixed
//   English+code prompts, 87 token positions, RTX 5070 / torch 2.12 cu130 /
//   transformers 4.51.3 (clean venv on ubu-1).
//   capture artifact (repo-external, hexa-only repo rule): ubu-1
//   /tmp/nex_s2_spectral.py → /tmp/s2_spectral_result.json.
//   This verifier checks the emitted measurement against the S2 claim.
//
// MEASURED VALUES (x1000, from s2_spectral_result.json):
//   n_tokens = 87 · d_model = 1536 · layer_used = 14
//   alpha_transformer (bulk ranks 2..768) = 4542 (4.542)
//   alpha_transformer (full range)         = 8866 (8.866)
//   spiking reference alpha (~1/f cortical) = 1000 (1.000)
//   exponent gap |alpha_T - alpha_spike|   = 3542 (3.542)
//   activation sparsity fraction           = 10   (0.95% — essentially DENSE)
//   top eigenvalue dominates (1.06e7) ≫ rank-2 (1041) — one huge mode then steep tail
//
// FINDING (🟢 measured): the transformer mid-layer activation covariance spectrum
// is a power-law form (heavy-tailed, Martin & Mahoney 2021) BUT with exponent
// alpha ≈ 4.5 — over 4× STEEPER than the biological spiking ~1/f exponent (≈1.0).
// AND the transformer activation is essentially DENSE (sparsity 0.95%, continuous
// float), the categorical opposite of sparse binary spike trains. Same broad
// "power-law" descriptor, DIFFERENT power-law family + DIFFERENT structural class.
//
// FALSIFIER VERDICT (S2). "transformer activation 스펙트럼이 spiking 와 power-law
// 다른 가족 → 'neuron-style activation' 통념 부정" — the measured exponent gap is
// 3.54 (alpha_T 4.5 vs spiking 1.0), and sparsity differs by ~99pp (dense vs
// sparse). The S2 falsifier HOLDS — the spectra are a DIFFERENT power-law family
// and the activations are a DIFFERENT structural class. "transformer activation is
// neuron-style" folk belief is REFUTED at the spectral + sparsity level.
//
// CLASS. system-comparison (biological spiking system vs transformer system, NOT a
// method-transfer). Consistent with the cross-axis pattern: system-comparison axes
// (S1 · N2 · Φ2) SEPARATE; method-transfer axes (N1 · Φ1 · L1 · C1 · L2) MATCH.
// S2 = system-comparison → MISMATCH, extending the running tally.
//
// HONESTY. 🟢 single-model (Qwen2.5-1.5B), single-layer (14), single prompt-set (8
// prompts / 87 positions), single sparsity threshold (0.01). The spiking alpha≈1.0
// is the literature anchor (cortical LFP / spike-train ~1/f), not a same-rig
// measurement — a true matched comparison would run an LIF/Izhikevich simulator on
// the same analysis pipeline (cycle-13+ open ladder). Reproducible from the JSON +
// documented prompt set.
//
// External anchor:
//   - Bedard & Destexhe 2006 (cortical LFP ~1/f power spectrum)
//   - He 2014 (scale-free brain activity, ~1/f neural dynamics)
//   - Beggs & Plenz 2003 (neuronal avalanches, power-law)
//   - Martin & Mahoney 2021 (arXiv:1810.01075, heavy-tailed self-regularization in NN spectra)
//   - Qwen2.5 technical report (model under test)
//
// @no-lock-needed
// @resolver-bypass(reason="Verifies real activation-spectrum measurement against S2 spectral claim.")

// ── measured values (x1000), from s2_spectral_result.json (Qwen2.5-1.5B) ──
let N_TOKENS = 87
let D_MODEL = 1536
let LAYER_USED = 14
let ALPHA_T = 4542          // bulk power-law exponent (ranks 2..768)
let ALPHA_T_FULL = 8866     // full-range exponent (steeper)
let ALPHA_SPIKE = 1000      // spiking ~1/f reference exponent = 1.0
let EXP_GAP = 3542          // |4542 - 1000|
let SPARSITY = 10           // 0.95% activations below 0.01 (essentially dense)
let GAP_THRESHOLD = 300     // a >0.3 exponent gap = different power-law family
let SPARSE_THRESHOLD = 500  // <50% sparsity = dense (NOT spike-sparse)

fn main() {
    println("hexa-codex NEUROEXP S2 — spiking↔transformer activation spectral (cycle-12 · 🟢 MEASURED)")
    println("==========================================================================================")
    println("  Qwen2.5-1.5B-Instruct · layer 14 · 87 token positions · d_model 1536")
    println("  covariance eigenvalue power-law: alpha_transformer = 4.542 (bulk) / 8.866 (full)")
    println("  spiking ~1/f reference alpha = 1.000 · exponent gap = 3.542 · sparsity = 0.95% (DENSE)")
    println("")

    let mut checks_passed = 0
    let mut checks_total = 0

    // check 1 — measurement sane: transformer alpha is a positive power-law exponent
    checks_total = checks_total + 1
    if ALPHA_T > 1000 && ALPHA_T < 20000 {
        println("  [PASS] alpha_transformer = 4.542 (sane positive power-law exponent for activation covariance)")
        checks_passed = checks_passed + 1
    } else {
        println("  [FAIL] alpha_transformer out of band: " + to_string(ALPHA_T))
    }

    // check 2 — spiking reference fixed at ~1/f (alpha = 1.0)
    checks_total = checks_total + 1
    if ALPHA_SPIKE == 1000 {
        println("  [PASS] spiking reference alpha = 1.000 (~1/f cortical LFP / spike-train, Bedard&Destexhe 2006)")
        checks_passed = checks_passed + 1
    } else {
        println("  [FAIL] spiking ref alpha mismatch: " + to_string(ALPHA_SPIKE))
    }

    // check 3 — exponent gap arithmetic consistent
    checks_total = checks_total + 1
    let gap_calc = ALPHA_T - ALPHA_SPIKE   // 4542 - 1000 = 3542
    if gap_calc == EXP_GAP {
        println("  [PASS] exponent gap = |4.542 - 1.000| = 3.542 (arithmetic consistent)")
        checks_passed = checks_passed + 1
    } else {
        println("  [FAIL] gap arithmetic: " + to_string(gap_calc) + " vs " + to_string(EXP_GAP))
    }

    // check 4 — DIFFERENT power-law family: exponent gap >> 0.3
    checks_total = checks_total + 1
    if EXP_GAP > GAP_THRESHOLD {
        println("  [PASS] exponent gap 3.542 ≫ 0.3 → transformer spectrum is a DIFFERENT power-law family than spiking")
        checks_passed = checks_passed + 1
    } else {
        println("  [FAIL] exponent gap not large enough: " + to_string(EXP_GAP))
    }

    // check 5 — transformer alpha steeper (larger) than spiking (steeper covariance decay)
    checks_total = checks_total + 1
    if ALPHA_T > ALPHA_SPIKE {
        println("  [PASS] alpha_transformer 4.542 > spiking 1.000 → transformer spectrum decays >4× steeper than 1/f")
        checks_passed = checks_passed + 1
    } else {
        println("  [FAIL] transformer alpha not steeper than spiking")
    }

    // check 6 — DENSE structure: activation sparsity far below spike-sparse regime
    checks_total = checks_total + 1
    if SPARSITY < SPARSE_THRESHOLD {
        println("  [PASS] sparsity 0.95% ≪ 50% → transformer activation is DENSE (continuous float), NOT sparse binary spikes")
        checks_passed = checks_passed + 1
    } else {
        println("  [FAIL] sparsity unexpectedly high: " + to_string(SPARSITY))
    }

    // check 7 — full-range exponent ALSO far from spiking (robustness to fit window)
    checks_total = checks_total + 1
    if ALPHA_T_FULL > ALPHA_T && ALPHA_T_FULL > ALPHA_SPIKE + GAP_THRESHOLD {
        println("  [PASS] full-range alpha 8.866 also ≫ spiking 1.000 → MISMATCH robust to fit-window choice")
        checks_passed = checks_passed + 1
    } else {
        println("  [FAIL] full-range fit not robustly far from spiking")
    }

    // check 8 — S2 falsifier verdict: different family AND different structure → HOLDS
    checks_total = checks_total + 1
    let mut family_differs = 0
    if EXP_GAP > GAP_THRESHOLD && SPARSITY < SPARSE_THRESHOLD {
        family_differs = 1
    }
    if family_differs == 1 {
        println("  [PASS] S2 falsifier HOLDS: DIFFERENT power-law family (gap 3.54) + DIFFERENT structure (dense vs sparse) → 'neuron-style activation' REFUTED")
        checks_passed = checks_passed + 1
    } else {
        println("  [FAIL] S2 falsifier logic")
    }

    println("")
    println("  " + to_string(checks_passed) + "/" + to_string(checks_total) + " checks passed")

    let mut verdict_tier = ""
    if checks_passed == checks_total {
        verdict_tier = "🟢 SUPPORTED-NUMERICAL — Qwen2.5-1.5B activation spectrum: alpha 4.54 ≫ spiking 1.0 (gap 3.54) + dense 0.95% vs sparse → DIFFERENT family, S2 falsifier HOLDS (8/8)"
    } else {
        verdict_tier = "🔴 FALSIFIED — measurement check disagrees (" + to_string(checks_passed) + "/" + to_string(checks_total) + ")"
    }
    println("  " + verdict_tier)
    println("")
    println("KEY FINDING (🟢 measured · Qwen2.5-1.5B layer-14 activation covariance):")
    println("  - transformer activation covariance spectrum IS power-law (heavy-tailed) but exponent")
    println("    alpha ≈ 4.5 (bulk) / 8.9 (full) — over 4× STEEPER than the spiking ~1/f exponent (≈1.0).")
    println("  - activation is essentially DENSE: only 0.95% of |activations| below 0.01 (continuous float),")
    println("    the categorical opposite of sparse binary spike trains (low firing rate).")
    println("  - exponent gap 3.54 + sparsity gap ~99pp → SAME 'power-law' descriptor, DIFFERENT family + class.")
    println("")
    println("FALSIFIER VERDICT (S2 · HOLDS):")
    println("  - the spectra are a DIFFERENT power-law family (alpha 4.5 vs 1.0) and the activations are a")
    println("    DIFFERENT structural class (dense continuous vs sparse binary) → S2 falsifier HOLDS.")
    println("  - 'transformer activation is neuron-style' folk belief REFUTED at the spectral + sparsity level.")
    println("")
    println("CLASS (cross-axis):")
    println("  - S2 = system-comparison (biological spiking system vs transformer system, NOT method-transfer).")
    println("  - consistent with the cross-axis pattern: system-comparison axes (S1·N2·Φ2) SEPARATE;")
    println("    method-transfer axes (N1·Φ1·L1·C1·L2) MATCH. S2 → MISMATCH extends the tally:")
    println("    method-transfer 5/5 MATCH · system-comparison 4/4 MISMATCH (S1·N2·Φ2·S2).")
    println("")
    println("OPERATIONAL IMPLICATION:")
    println("  - 'spiking-neuron-inspired' transformer activation regularizers (1/f / scale-free priors)")
    println("    are NOT a natural fit — the trained transformer's native spectrum is far steeper.")
    println("  - dense activation ≠ sparse spike code: SNN↔transformer conversion must IMPOSE sparsity,")
    println("    it does not emerge (consistent w/ ANN-to-SNN conversion needing explicit thresholding).")
    println("")
    println("HONEST RESIDUAL:")
    println("  - 🟢 single model (Qwen2.5-1.5B), single layer (14), single prompt-set (8 prompts / 87 positions),")
    println("    single sparsity threshold (0.01).")
    println("  - spiking alpha≈1.0 is the LITERATURE anchor (cortical LFP/spike ~1/f), NOT a same-rig run;")
    println("    a true matched comparison runs an LIF/Izhikevich simulator through the SAME eigenspectrum")
    println("    pipeline — cycle-13+ open ladder.")
    println("  - layer/model/threshold sweep (Qwen2.5-{0.5B,1.5B,3B,7B} × layer × threshold) not yet measured.")
    println("  - power-law fit window (bulk 2..768 vs full) changes alpha but BOTH stay far from 1.0 (robust).")
    println("  - capture is repo-external (.py, ubu-1 /tmp) per hexa-only rule; reproducible from the")
    println("    documented prompt set + venv pin (transformers 4.51.3 · numpy<2 · torch 2.12 cu130).")
    println("  - S2 frontier OPEN ([[feedback_closure_is_physical_limit]]): single-point measurement,")
    println("    model/layer/threshold sweep + same-rig spiking-simulator comparison is the open ladder.")
    println("")
    println("__HEXA_CODEX_NUMERICS_NEUROEXP_S2_SPIKING_SPECTRAL__ " + (if checks_passed == checks_total { "DONE" } else { "FAIL" }))

    let ROOT = _root()
    let OUT_PATH = ROOT + "/NEUROEXP/verdicts/s2_spiking_spectral_verdict.txt"

    let mut content = "# hexa-codex NEUROEXP S2 — spiking↔transformer activation spectral (cycle-12 first probe · 🟢 MEASURED)\n"
    content = content + "# axis=NEUROEXP.md::S2 (cycle-12 first probe · S = Spike/Dynamical-system · T4 cost-bearing)\n"
    content = content + "# verifier=NEUROEXP/verify/numerics_neuroexp_s2_spiking_spectral.hexa\n"
    content = content + "# capture=ubu-1 /tmp/nex_s2_spectral.py (repo-external · hexa-only rule · user-approved capture-only .py)\n"
    content = content + "# tier=" + verdict_tier + "\n"
    content = content + "# checks=" + to_string(checks_passed) + "/" + to_string(checks_total) + "\n"
    content = content + "# model=Qwen2.5-1.5B-Instruct · n_layers=28 · layer_used=14 · n_tokens=87 · d_model=1536\n"
    content = content + "# env=RTX5070 · torch2.12.0+cu130 · transformers4.51.3 · numpy1.26.4 (clean venv ubu-1)\n"
    content = content + "# alpha_transformer=4.542 (bulk ranks 2..768) · alpha_transformer_fullrange=8.866\n"
    content = content + "# spiking_ref_alpha=1.000 (~1/f cortical LFP/spike) · exponent_gap=3.542\n"
    content = content + "# sparsity_fraction=0.0095 (0.95% — essentially DENSE, continuous float)\n"
    content = content + "# top5_eigenvalues=[1.06e7, 1041, 600, 509, 352] (one huge mode, then steep power-law tail)\n"
    content = content + "# S2_falsifier=HOLDS — DIFFERENT power-law family (alpha 4.54 vs 1.0, gap 3.54) + DIFFERENT structure (dense vs sparse) → 'neuron-style activation' REFUTED\n"
    content = content + "# operational=spiking 1/f priors NOT a natural fit (transformer native spectrum far steeper) · SNN↔transformer needs IMPOSED sparsity (not emergent)\n"
    content = content + "# class=system-comparison (biological spiking system vs transformer system · MISMATCH · consistent w/ S1/N2/Φ2 SEPARATE)\n"
    content = content + "# cross_axis_tally=method-transfer 5/5 MATCH (N1·Φ1·L1·C1·L2) · system-comparison 4/4 MISMATCH (S1·N2·Φ2·S2)\n"
    content = content + "# external_anchor=Bedard&Destexhe2006_LFP_1/f · He2014_scalefree_brain · Beggs&Plenz2003_avalanches · Martin&Mahoney2021_arXiv1810.01075 · Qwen2.5_tech_report\n"
    content = content + "# next_probe=cycle-13+ same-rig LIF/Izhikevich simulator through identical eigenspectrum pipeline + Qwen2.5-{0.5B,1.5B,3B,7B}×layer×threshold sweep\n"
    write_file(OUT_PATH, content)
    println("verdict written: " + OUT_PATH)
}

fn _root() -> str {
    let r = env("HEXA_CODEX_ROOT")
    if r.len() > 0 { return r }
    let mut p = exec("pwd").trim()
    let mut depth = 0
    while depth < 6 {
        if exec("test -f " + p + "/DOMAINS.tape && echo y").trim() == "y" { return p }
        p = exec("dirname " + p).trim()
        depth = depth + 1
    }
    let HOME = env("HOME")
    return HOME + "/core/hexa-codex"
}
